# ==============================================================================
# AUTOPILOT OOBE COMMAND HUB - CONFIGURATION TEMPLATE (.env)
# ==============================================================================
# Place this file as '.env' in:
#   1. Current Working Directory (where technician runs script)
#   2. Script Directory ($PSScriptRoot)
#   3. Parent Directory (e.g., when placed as a sub-engine under a UFW / wrapper script)
#   4. Root of USB Flash Drive (e.g., E:\.env)
#   5. User Profile ($HOME\.env)
#
# Settings are automatically loaded on script launch and applied across both CLI
# and WinUI 3 Fluent Dark GUI modes.

# --- Device Renaming Configuration ---
# Enable or disable computer renaming by default (true / false)
AUTOPILOT_RENAME_ENABLED=false

# Default prefix for new computer name (e.g. WS, LT, DT, CORP)
AUTOPILOT_NAME_PREFIX=WS

# Full machine naming template. Tokens supported:
#   %SERIAL% = Host BIOS Serial Number / Service Tag
#   %RAND%   = 4-digit random number (1000-9999)
# Note: NetBIOS computer names are limited to 15 characters max.
AUTOPILOT_NAME_TEMPLATE=WS-%SERIAL%

# --- Microsoft Intune & Autopilot Defaults ---
# Default Group Tag for device assignment (e.g. Standard-Workstations, Corporate-Laptops, Kiosk)
AUTOPILOT_GROUP_TAG=Standard-Workstations

# Default Assigned User UPN (optional, e.g. user@yourdomain.com)
AUTOPILOT_ASSIGNED_USER=

# Wait for Autopilot profile assignment polling in cloud registration (true / false)
AUTOPILOT_WAIT_FOR_SYNC=true

# Reboot into ESP upon profile assignment completion (true / false)
AUTOPILOT_AUTO_REBOOT=false

# Auto-detect USB flash drive for CSV device export priority (true / false)
AUTOPILOT_AUTO_DETECT_USB=true

# --- Character Encoding & File Export Charset ---
# Charset used when exporting CSVs, saving logs, and writing configuration.
# Options:
#   native  - System ANSI code page (e.g., Windows-1252 / Western European/US/AU)
#   utf-8   - UTF-8 without BOM
#   ascii   - Standard 7-bit ASCII
#   oem     - Console OEM code page (e.g., CP437/CP850)
AUTOPILOT_CHARSET=native

# --- Network & Diagnostic Overrides ---
# Custom default gateway IP override (optional; automatically detected via routing table if blank)
DEFAULT_GATEWAY=

# --- Dell Technologies Warranty & Lifecycle Engine (Optional) ---
# OAuth 2.0 Credentials for Dell Enterprise Warranty API (v5)
DELL_CLIENT_ID=
DELL_CLIENT_SECRET=
DELL_TOKEN_URL=https://apigtwb2c.us.dell.com/auth/oauth/v2/token
DELL_WARRANTY_URL=https://apigtwb2c.us.dell.com/PROD/sbil/eapi/v5/asset-entitlements
DELL_COMPONENTS_URL=https://apigtwb2c.us.dell.com/PROD/sbil/eapi/v5/asset-entitlement-components

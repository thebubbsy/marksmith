<Window
    x:Class="MdToPdf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:MdToPdf.Converters"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:localcontrols="using:MdToPdf.Controls">

    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control,Menu" Key="T" Invoked="OnToggleDebugModeInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OnOpenFileAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="E" Invoked="OnGeneratePdfAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="D" Invoked="OnExportDocxAcceleratorInvoked" />
            <!-- Instant-export shortcuts (QODER task 8): Ctrl+Shift+E = DOCX, Ctrl+Shift+P = PDF
                 (PPTX moved to Ctrl+Shift+T to free Ctrl+Shift+P), Ctrl+Shift+M = Mermaid Studio. -->
            <KeyboardAccelerator Modifiers="Control,Shift" Key="E" Invoked="OnExportDocxAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="P" Invoked="OnGeneratePdfAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="T" Invoked="OnExportPptxAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="M" Invoked="OnMermaidStudioAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="OnCommandPaletteInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnSaveDocumentAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFindAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="H" Invoked="OnReplaceAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="P" Invoked="OnPrintAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="D" Invoked="OnDuplicateLineAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Menu" Key="Up" Invoked="OnMoveLineUpAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Menu" Key="Down" Invoked="OnMoveLineDownAcceleratorInvoked" />
            <KeyboardAccelerator Key="F11" Invoked="OnFocusModeAcceleratorInvoked" />
            <!-- Portal focus-blur toggle (Looking Glass): Ctrl+Alt+X switches an open portal between
                 "focus with blur" (rendered preview behind the aperture blurs) and "focus without
                 blur" (sharp preview). -->
            <KeyboardAccelerator Modifiers="Control,Menu" Key="X" Invoked="OnTogglePortalBlurInvoked" />
            <KeyboardAccelerator Key="F1" Invoked="OnShortcutsCheatsheetInvoked" />
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <conv:StatusSeverityConverter x:Key="StatusSeverityConverter" />
            <conv:StatusSeverityToBrushConverter x:Key="StatusSeverityToBrushConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:ThemeNameToSwatchConverter x:Key="ThemeNameToSwatchConverter" />
            <conv:LevelToIndentConverter x:Key="LevelToIndentConverter" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- Persistent status-bar row along the bottom of the window: the changing status
                 text sits bottom-left like a typical status bar, with the Ln/Col readout on the
                 right. Replaced the ISS-013 floating pill that overlapped the editor's bottom
                 buttons at the default launch size. -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Spacing="6">
            <!-- Trial / upgrade banner (shown only when the trial is low or ended) -->
            <InfoBar x:Name="LicenseBanner" Margin="16,0,16,0" IsOpen="False" IsClosable="True">
                <InfoBar.ActionButton>
                    <Button Content="Upgrade to Pro" Click="OnUpgradeClick"
                            ToolTipService.ToolTip="Unlock MarkSmith Pro — DOCX export, automation and no export footer" />
                </InfoBar.ActionButton>
            </InfoBar>
            <!-- Shown once per session when a paste looks like plain text: the browser extension's
                 "Copy as Markdown" button would have kept the formatting. -->
            <localcontrols:ExtensionHintBar x:Name="ExtensionHintBar" Margin="16,0,16,0" />
        </StackPanel>

        <!-- Custom title bar so Mica shows through behind it; extended via Window.ExtendsContentIntoTitleBar in code-behind.
             Issue #6: the row is split — only the branding grid (AppTitleBar) is the drag region
             (SetTitleBar target), so the quick-action buttons in the right half stay clickable. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="AppTitleBar" Grid.Column="0" Padding="16,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/logo.png" Width="26" Height="26" />
                    <TextBlock Text="MarkSmith" FontWeight="SemiBold"
                               Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="·" Opacity="0.4" VerticalAlignment="Center" />
                    <TextBlock Text="AI chats &#x2192; polished documents" Opacity="0.55"
                               Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- ISS-008: the tip jar now lives in the ⋯ menu next to Settings (the title-bar button
                     overlapped the system caption buttons at narrow widths). -->
            </Grid>

            <!-- Issue #6: primary quick actions surfaced in the title bar's empty right half.
                 Right margin clears the system caption buttons (min/max/close overlay). -->
            <StackPanel x:Name="TitleBarActions" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center" Margin="0,0,150,0">
                <Button Height="30" Padding="8,0" Background="Transparent" BorderThickness="0"
                        Click="OnConvertPdfClick" IsEnabled="{Binding IsNotBusy}"
                        ToolTipService.ToolTip="Export as PDF (.pdf)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE749;" FontSize="12" />
                        <TextBlock Text="Export PDF" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Height="30" Padding="8,0" Background="Transparent" BorderThickness="0"
                        Click="OnConvertDocxClick" IsEnabled="{Binding IsNotBusy}"
                        ToolTipService.ToolTip="Export as Word (.docx)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="12" />
                        <TextBlock Text="Export Word" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Height="30" Padding="8,0" Background="Transparent" BorderThickness="0"
                        Click="OnImportDocumentClick" IsEnabled="{Binding IsNotBusy}"
                        ToolTipService.ToolTip="Import a DOCX or PDF document into Markdown">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B5;" FontSize="12" />
                        <TextBlock Text="Import" FontSize="12" />
                    </StackPanel>
                </Button>
                <Border Width="1" Height="16" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />
                <Button Height="30" Padding="8,0" Background="Transparent" BorderThickness="0"
                        Click="OnOpenMermaidStudioClick"
                        ToolTipService.ToolTip="Open the visual Mermaid Diagram Studio">
                    <TextBlock Text="Diagram Studio 🎨" FontSize="12" />
                </Button>
                <Button Height="30" Width="34" Padding="0" Background="Transparent" BorderThickness="0"
                        Click="OnSettingsClick"
                        ToolTipService.ToolTip="Settings (Ctrl+,)">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
                <Border Width="1" Height="16" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />
                <!-- Focus mode moved up from the centre pane header (declutter): it's a window-level
                     action, and the title bar stays visible even while the side panels are hidden. -->
                <ToggleButton x:Name="FocusModeToggle" Height="30" Width="34" Padding="0"
                              Background="Transparent" BorderThickness="0"
                              ToolTipService.ToolTip="Focus mode — hide the side panels (F11)"
                              Checked="OnFocusModeToggled" Unchecked="OnFocusModeToggled">
                    <FontIcon Glyph="&#xE740;" FontSize="14" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Left-to-right pipeline: 1 Source -> 2 Style -> 3 Preview & Export -->
        
        <!-- 3-Pane Looking Glass Layout -->
        <Grid x:Name="MainLayoutGrid" Grid.Row="2" Padding="16,6,16,16" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaneCol" Width="320" MinWidth="250" /> <!-- Left: Source/Files -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="400" /> <!-- Center: Looking Glass (Editor/Preview) -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightPaneCol" Width="380" MinWidth="250" /> <!-- Right: Style/Export -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE -->
            <Grid x:Name="LeftPane" Grid.Column="0" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                    <Border Style="{StaticResource StepBadgeStyle}">
                        <TextBlock Text="1" Style="{StaticResource StepBadgeTextStyle}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Source" Style="{StaticResource StepTitleStyle}" />
                        <TextBlock Text="Pick a file or paste Markdown" Style="{StaticResource StepCaptionStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- One-time tip: the browser extension lets users send AI chats here in one click. -->
                <localcontrols:ExtensionTip Grid.Row="1" x:Name="ExtensionTip" 
                                            Closed="OnExtensionTipClosed" />

                <Border Grid.Row="2" Style="{StaticResource PipelineCardStyle}"
                        AllowDrop="True" DragOver="OnSourceDragOver" Drop="OnSourceDrop">
                    <ScrollViewer x:Name="SourceScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                    <Grid Padding="14" RowSpacing="12"
                          MinHeight="{Binding ViewportHeight, ElementName=SourceScroll}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <SelectorBar x:Name="SourceSelector" Grid.Row="0" SelectionChanged="OnSourceSelectorChanged">
                            <SelectorBarItem x:Name="FileTab" Text="File">
                                <SelectorBarItem.Icon>
                                    <FontIcon Glyph="&#xE8A5;" />
                                </SelectorBarItem.Icon>
                            </SelectorBarItem>
                            
                        </SelectorBar>

                        <!-- File mode -->
                        <StackPanel x:Name="FilePanel" Grid.Row="1" Spacing="12">
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16,24">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE896;" FontSize="26" Opacity="0.6" HorizontalAlignment="Center" />
                                    <TextBlock Text="Drop a .md file here" HorizontalAlignment="Center" Opacity="0.75" />
                                    <TextBlock Text="or" HorizontalAlignment="Center" Opacity="0.4"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                    <Button Content="Browse files" Click="OnBrowseFileClick" HorizontalAlignment="Center"
                                            ToolTipService.ToolTip="Browse for a Markdown file to open" />
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="Selected file" Text="{Binding InputFilePath, Mode=TwoWay}"
                                         PlaceholderText="No file selected" IsSpellCheckEnabled="False" />
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnTogglePinFileClick"
                                        ToolTipService.ToolTip="Pin/unpin this file to the top of the file list">
                                    <Grid>
                                        <FontIcon Glyph="&#xE734;" FontSize="14"
                                                  Visibility="{Binding IsCurrentFilePinned, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <FontIcon Glyph="&#xE735;" FontSize="14"
                                                  Visibility="{Binding IsCurrentFilePinned, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                    </Grid>
                                </Button>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Recent &amp; found .md files" VerticalAlignment="Bottom"
                                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8" />
                                <HyperlinkButton x:Name="RescanButton" Grid.Column="1" Click="OnRescanMarkdownClick" Padding="4,0"
                                                 ToolTipService.ToolTip="Rescan your PC for recent Markdown files">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                        <TextBlock Text="Rescan" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </HyperlinkButton>
                            </Grid>
                            <ComboBox x:Name="MarkdownFilesCombo" ItemsSource="{Binding MarkdownFiles}"
                                      SelectionChanged="OnMarkdownFileSelected" Margin="0,-8,0,0"
                                      ToolTipService.ToolTip="Recent and discovered Markdown files on this PC"
                                      PlaceholderText="Pick a Markdown file from your PC..." HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="0,2">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Opacity="0.6"
                                                       Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="ScanningLabel" Text="Scanning your files…" Opacity="0.6" Margin="2,-6,0,0"
                                       Style="{StaticResource CaptionTextBlockStyle}" Visibility="Collapsed" />
                        </StackPanel>

                        

                        <!-- Automated ingest: clipboard watcher, watched folder, local REST API -->
                        <Expander x:Name="AutomationExpander" Grid.Row="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE945;" FontSize="14" />
                                    <TextBlock Text="Automation" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Spacing="12">
                                
                                <!-- Box 1: Extension & AI Chats -->
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="12">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Browser Extension &amp; AI Chats" FontWeight="SemiBold" />
                                        
                                        <ToggleSwitch Header="Auto-ingest AI chats from clipboard"
                                                      OnContent="Watching" OffContent="Off"
                                                      IsOn="{Binding AutoClipboardIngest, Mode=TwoWay}" />
                                        <TextBlock Text="Copy a reply in ChatGPT / Gemini / Claude and it lands here, detected and cleaned."
                                                   Style="{StaticResource StepCaptionStyle}" Margin="0,-6,0,0" />

                                        <ToggleSwitch Header="Auto-generate PDF from AI-chat ingests"
                                                      OnContent="On" OffContent="Off"
                                                      IsOn="{Binding AutoConvertIngests, Mode=TwoWay}" />
                                        <TextBlock Text="Every chat sent here (clipboard, API, or the extension at end of conversation) is exported to a PDF automatically."
                                                   Style="{StaticResource StepCaptionStyle}" Margin="0,-6,0,0" />

                                        <ToggleSwitch Header="Append DOCX ingests to a running document"
                                                      OnContent="On" OffContent="Off"
                                                      IsOn="{Binding AppendToRunningDoc, Mode=TwoWay}" />
                                        <TextBlock Text="When a DOCX is auto-generated, add it as a dated section to one growing .docx instead of a new file — a living compendium of your AI work."
                                                   Style="{StaticResource StepCaptionStyle}" Margin="0,-6,0,0" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding RunningDocPath, Mode=TwoWay}"
                                                     PlaceholderText="e.g. C:\Docs\AI-notebook.docx" IsSpellCheckEnabled="False" />
                                            <Button Grid.Column="1" Click="OnBrowseRunningDocClick"
                                                    ToolTipService.ToolTip="Choose the running .docx document">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Box 2: Local Folder Watcher & Batch -->
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="12">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Folder Watcher &amp; Batching" FontWeight="SemiBold" />
                                        
                                        <ToggleSwitch Header="Watch a folder for Markdown exports"
                                                      OnContent="Watching" OffContent="Off"
                                                      IsOn="{Binding WatchFolderEnabled, Mode=TwoWay}" />
                                        <ToggleSwitch Header="Auto-convert watched files to PDF"
                                                      OnContent="Hands-free" OffContent="Ingest only"
                                                      IsOn="{Binding WatchFolderAutoConvert, Mode=TwoWay}" />
                                        <TextBlock Text="New .md files become PDFs in your output folder automatically, with a toast when done."
                                                   Style="{StaticResource StepCaptionStyle}" Margin="0,-6,0,0" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding WatchFolder, Mode=TwoWay}"
                                                     PlaceholderText="e.g. your Downloads folder" IsSpellCheckEnabled="False" />
                                            <Button Grid.Column="1" Click="OnBrowseWatchFolderClick"
                                                    ToolTipService.ToolTip="Choose the folder to watch">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                            </Button>
                                        </Grid>

                                        <!-- ISS-011: one-click presets for the folders local AI agents
                                             (Gemini CLI, Ollama, Claude Desktop, …) export to. -->
                                        <ComboBox x:Name="WatchFolderPresets" HorizontalAlignment="Stretch"
                                                  PlaceholderText="Quick pick an AI agent folder…"
                                                  ToolTipService.ToolTip="Pre-configured export folders for local AI agents and CLIs"
                                                  SelectionChanged="OnWatchFolderPresetSelected">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Spacing="1">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" />
                                                        <TextBlock Text="{Binding Path}" FontSize="10" Opacity="0.6" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <Button Click="OnBatchConvertClick" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                                ToolTipService.ToolTip="Pick a folder — every .md file inside becomes a themed PDF">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE8B9;" FontSize="14" />
                                                <TextBlock Text="Batch convert a folder to PDF…" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="Every .md file in the folder becomes a themed PDF in your output folder — detection and cleanup applied to each."
                                                   Style="{StaticResource StepCaptionStyle}" Margin="0,-6,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Box 3: System Services -->
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="12">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="System Services" FontWeight="SemiBold" />

                                        <ToggleSwitch Header="Local REST API" OnContent="Running" OffContent="Off"
                                                      IsOn="{Binding ApiEnabled, Mode=TwoWay}" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <NumberBox Grid.Column="0" Header="Port" Value="{Binding ApiPort, Mode=TwoWay}"
                                                       Minimum="1024" Maximum="65535" />
                                            <TextBlock x:Name="ApiUrlText" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                                       Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                                                       IsTextSelectionEnabled="True" />
                                        </Grid>

                                        <ToggleSwitch Header="Keep running in system tray when closed"
                                                      OnContent="Tray mode" OffContent="Off"
                                                      IsOn="{Binding MinimizeToTray, Mode=TwoWay}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Expander>
                    </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>

            

            <controls:GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="16" Background="Transparent" ResizeBehavior="BasedOnAlignment" ResizeDirection="Auto"
                                   ToolTipService.ToolTip="Drag to resize the Source pane" />

            <!-- CENTER PANE: LOOKING Glass -->
            
            <Grid Grid.Column="2" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource StepBadgeStyle}">
                            <TextBlock Text="2" Style="{StaticResource StepBadgeTextStyle}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Editor / Preview" Style="{StaticResource StepTitleStyle}" />
                            <TextBlock Text="Looking Glass Layer" Style="{StaticResource StepCaptionStyle}" />
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Decluttered header: Copy HTML / Print moved to the pane's bottom bar, the
                         portal shape + size dials moved to the portal bar (shown while portal mode
                         is on), focus mode moved to the title bar, and the detected-source badge
                         moved to the status bar. Only the portal toggle + view switcher remain, so
                         this row can no longer overflow into the step title on the left at the
                         default 1220×800 launch size. -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ToggleButton x:Name="LookingGlassToggle" ToolTipService.ToolTip="Looking Glass portal mode — click the preview to reveal the editable Markdown behind it"
                                      Height="32" Width="32" Padding="0" VerticalAlignment="Center"
                                      Checked="OnLookingGlassToggled" Unchecked="OnLookingGlassToggled">
                            <FontIcon Glyph="&#xE7B3;" FontSize="13" />
                        </ToggleButton>
                        <SelectorBar x:Name="CenterViewSelector" SelectionChanged="OnCenterViewSelectorChanged">
                            <SelectorBarItem x:Name="ViewCodeTab" Text="Code" IsSelected="True"
                                             ToolTipService.ToolTip="Markdown editor only" />
                            <SelectorBarItem x:Name="ViewSplitTab" Text="Split"
                                             ToolTipService.ToolTip="Editor and live preview side by side" />
                            <SelectorBarItem x:Name="ViewPreviewTab" Text="Preview"
                                             ToolTipService.ToolTip="Rendered preview only" />
                        </SelectorBar>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" x:Name="LookingGlassGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SplitLeftCol" Width="*" />
                            <ColumnDefinition x:Name="SplitMidCol" Width="Auto" />
                            <ColumnDefinition x:Name="SplitRightCol" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="PastePanel" Grid.Column="0" RowSpacing="8" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Find & replace bar (Ctrl+F / Ctrl+H): search and replace in the Markdown source. -->
                            <Border x:Name="FindBar" Grid.Row="0" Visibility="Collapsed"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="8,6">
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="FindTextBox" Grid.Column="0" PlaceholderText="Find in document..."
                                                 Height="30" FontSize="13" KeyDown="OnFindTextBoxKeyDown"
                                                 TextChanged="OnFindTextChanged" />
                                        <TextBlock x:Name="FindCountText" Grid.Column="1" VerticalAlignment="Center"
                                                   FontSize="12" Opacity="0.7" MinWidth="52" TextAlignment="Center" />
                                        <CheckBox x:Name="MatchCaseCheck" Grid.Column="2" Content="Aa" MinWidth="0"
                                                  VerticalAlignment="Center" ToolTipService.ToolTip="Match case"
                                                  Checked="OnMatchCaseChanged" Unchecked="OnMatchCaseChanged" />
                                        <Button Grid.Column="3" Height="30" Padding="8,0" Click="OnFindPrevClick"
                                                ToolTipService.ToolTip="Previous match (Shift+Enter)">
                                            <FontIcon Glyph="&#xE70E;" FontSize="13" />
                                        </Button>
                                        <Button Grid.Column="4" Height="30" Padding="8,0" Click="OnFindNextClick"
                                                ToolTipService.ToolTip="Next match (Enter)">
                                            <FontIcon Glyph="&#xE70D;" FontSize="13" />
                                        </Button>
                                        <Button Grid.Column="5" Height="30" Padding="8,0" Click="OnFindCloseClick"
                                                ToolTipService.ToolTip="Close (Escape)">
                                            <FontIcon Glyph="&#xE711;" FontSize="13" />
                                        </Button>
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ReplaceTextBox" Grid.Column="0" PlaceholderText="Replace with..."
                                                 Height="30" FontSize="13" KeyDown="OnReplaceTextBoxKeyDown" />
                                        <Button Grid.Column="1" Height="30" Padding="12,0" Click="OnReplaceClick"
                                                ToolTipService.ToolTip="Replace the current match (Enter)">
                                            <TextBlock Text="Replace" FontSize="12" />
                                        </Button>
                                        <Button Grid.Column="2" Height="30" Padding="12,0" Click="OnReplaceAllClick"
                                                ToolTipService.ToolTip="Replace every match">
                                            <TextBlock Text="Replace all" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Line-number gutter: only shown when word wrap is off (wrapping would break the
                                     alignment). Its scroll is synced to the editor's from code-behind. -->
                                <Border x:Name="LineNumberGutter" Grid.Column="0" Width="46" Visibility="Collapsed"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                                    <ScrollViewer x:Name="LineNumberScroll" VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="False">
                                        <TextBlock x:Name="LineNumberText" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextAlignment="Right" Padding="4,5,8,0" Text="1" />
                                    </ScrollViewer>
                                </Border>
                                <TextBox x:Name="PasteTextBox" Grid.Column="1" MinHeight="180"
                                         Text="{Binding CurrentMarkdown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         FontFamily="Cascadia Mono, Consolas, monospace" FontSize="13"
                                         PlaceholderText="Paste or type Markdown here... (drop an image to embed it)"
                                         VerticalContentAlignment="Top" IsSpellCheckEnabled="False"
                                         AllowDrop="True" DragOver="OnEditorDragOver" Drop="OnEditorDrop"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </Grid>
                            
                            <Grid Grid.Row="2">
                                <!-- Editor font-size zoom (persisted): A− / A+ buttons plus Ctrl+wheel in the
                                     editor. The % readout is relative to the 13px default. -->
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Button ToolTipService.ToolTip="Decrease editor font size (Ctrl+wheel down)" Width="28" Height="24" Padding="0" Click="OnEditorZoomOutClick">
                                        <TextBlock Text="A&#x2212;" FontSize="12" />
                                    </Button>
                                    <TextBlock x:Name="EditorZoomText" Text="100%" VerticalAlignment="Center" FontSize="11"
                                               Opacity="0.6" MinWidth="42" TextAlignment="Center"
                                               ToolTipService.ToolTip="Editor font size" />
                                    <Button ToolTipService.ToolTip="Increase editor font size (Ctrl+wheel up)" Width="28" Height="24" Padding="0" Click="OnEditorZoomInClick">
                                        <TextBlock Text="A+" FontSize="12" />
                                    </Button>
                                    <Border Width="1" Height="14" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />
                                    <ToggleButton x:Name="WordWrapToggle" ToolTipService.ToolTip="Word wrap — turn off to show line numbers"
                                                  Height="24" Padding="6,0" Checked="OnWordWrapToggled" Unchecked="OnWordWrapToggled">
                                        <TextBlock Text="Wrap" FontSize="11" />
                                    </ToggleButton>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Markdown lint: live issue count; the flyout lists issues and jumps to them. -->
                                    <Button x:Name="LintButton" Height="24" Padding="6,0"
                                            ToolTipService.ToolTip="Markdown issues — click to review and jump">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="12" />
                                            <TextBlock x:Name="LintCountText" Text="No issues" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout x:Name="LintFlyout" Placement="Top">
                                                <Grid Width="340" RowSpacing="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="Markdown issues" FontWeight="SemiBold" />
                                                    <ListView x:Name="LintList" Grid.Row="1" MaxHeight="300" SelectionMode="None"
                                                              IsItemClickEnabled="True" ItemClick="OnLintItemClick">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,2">
                                                                    <TextBlock Text="{Binding Line}" FontFamily="Consolas" FontSize="12"
                                                                               Opacity="0.55" MinWidth="34" />
                                                                    <TextBlock Text="{Binding Message}" FontSize="12" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </Grid>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBlock Text="{Binding WordCountText}" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"
                                               ToolTipService.ToolTip="{Binding DocumentStatsDetail}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <controls:GridSplitter x:Name="SplitViewSplitter" Grid.Column="1" Width="16" Visibility="Collapsed"
                                               Background="Transparent" ResizeBehavior="BasedOnAlignment" ResizeDirection="Auto"
                                               ToolTipService.ToolTip="Drag to resize the editor / preview split" />
                        <Border x:Name="PreviewCard" Grid.Column="2" Visibility="Collapsed" Style="{StaticResource PipelineCardStyle}">
                    <Grid>
                        <WebView2 x:Name="PreviewWebView" Margin="1" />

                        <!-- Live-preview loading spinner: the logo, animated in code-behind. Shown on
                             every refresh with a minimum visible time so quick renders read as a smooth
                             animation, not a white flash. Two styles, alternating each time (not random):
                             (0) the logo spinning about its centre, (1) the upright logo tracing a
                             figure-eight. -->
                        <Grid x:Name="PreviewSpinner" Visibility="Collapsed" Background="#14000000">
                            <Image x:Name="SpinnerLogo" Source="ms-appx:///Assets/logo.png"
                                   Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <CompositeTransform x:Name="SpinnerLogoTransform" />
                                </Image.RenderTransform>
                            </Image>
                        </Grid>
                    </Grid>
                </Border>
                <!-- ISS-014: the width ruler + preview-zoom bar is scoped to the preview column
                     (LookingGlassGrid column 2, bottom-aligned) so it tracks the preview pane's exact
                     width and no longer stretches under the editor pane in Split view. -->
                <Grid Grid.Column="2" VerticalAlignment="Bottom" Visibility="Collapsed" x:Name="PreviewWidthContainer">
                    <!-- Live width ruler for the preview pane: a hairline spanning the column with end
                     ticks and the current CSS-pixel width in a centred chip. PreviewWidthText is
                     updated from code-behind on the WebView's SizeChanged. Lets the user see exactly
                     how wide the rendered document is as they resize. -->
                <Grid Height="24" Margin="2,-4,2,-2" ToolTipService.ToolTip="Width of the live preview">
                    <Rectangle Height="1" VerticalAlignment="Center"
                               Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.35" />
                    <Rectangle Width="1" Height="7" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.55" />
                    <Rectangle Width="1" Height="7" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.55" />
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="4" Padding="8,0"
                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                        <TextBlock x:Name="PreviewWidthText" Text="— px" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <!-- Preview zoom (persisted): the WebView also honors the browser's native Ctrl+wheel;
                         the readout stays in sync via a light poll in code-behind. -->
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button ToolTipService.ToolTip="Zoom preview out" Width="24" Height="22" Padding="0" Click="OnPreviewZoomOutClick">
                            <FontIcon Glyph="&#xE738;" FontSize="11" />
                        </Button>
                        <TextBlock x:Name="PreviewZoomText" Text="100%" VerticalAlignment="Center" FontSize="11"
                                   Opacity="0.65" MinWidth="40" TextAlignment="Center" ToolTipService.ToolTip="Preview zoom (Ctrl+wheel)" />
                        <Button ToolTipService.ToolTip="Zoom preview in" Width="24" Height="22" Padding="0" Click="OnPreviewZoomInClick">
                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Grid>
                </Grid>
                </Grid>

                <!-- Centre pane bottom bar: Copy HTML / Print stay one click away in every mode,
                     the editing clusters show whenever the editor is visible or portal mode turns
                     the preview into an editor, and the portal shape + size dials live on their
                     own row while portal mode is on (visibility managed from code-behind). Hosting
                     the clusters here — instead of inside the editor pane — is what lets portal
                     mode reuse them: the preview shrinks vertically to make room, the same way a
                     writing app's formatting bar claims its strip. -->
                <Grid x:Name="CenterBottomBar" Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ISS-004: portal shape + size — only relevant while portal mode is on, so the
                         dials moved out of the always-visible header down to this portal-only row.
                         Shape: circle spotlight, focus bands, square, or logo cutout; the slider
                         scales the active shape live on every tick. -->
                    <StackPanel x:Name="PortalControlsRow" Grid.Row="0" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,6"
                                Visibility="Collapsed">
                        <FontIcon Glyph="&#xE7B3;" FontSize="13" VerticalAlignment="Center" Opacity="0.7"
                                  ToolTipService.ToolTip="Looking Glass portal dials" />
                        <ComboBox x:Name="PortalShapeCombo" ToolTipService.ToolTip="Looking Glass shape — circle spotlight, focus band, square, or Marksmith logo cutout"
                                  Width="125" Height="32" VerticalAlignment="Center" SelectionChanged="OnPortalShapeChanged">
                            <ComboBoxItem Content="Circle" Tag="circle" />
                            <ComboBoxItem Content="Focus" Tag="focus1" />
                            <ComboBoxItem Content="Square" Tag="square" />
                            <ComboBoxItem Content="Logo Cutout" Tag="logo" />
                        </ComboBox>
                        <Slider x:Name="PortalRevealSlider" ToolTipService.ToolTip="Looking Glass size — scales the active shape (circle diameter / focus band height)"
                                Width="110" Minimum="0" Maximum="100" StepFrequency="5" SmallChange="5" LargeChange="10"
                                VerticalAlignment="Center" ValueChanged="OnPortalRevealChanged" />
                        <ToggleButton ToolTipService.ToolTip="Blur the preview behind the portal (Ctrl+Alt+X)"
                                      IsChecked="{Binding PortalFocusBlur, Mode=TwoWay}"
                                      Click="OnPortalBlurToggled" VerticalAlignment="Center" Height="32" Padding="8,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8FD;" FontSize="13" />
                                <TextBlock Text="Blur" FontSize="12" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <Button ToolTipService.ToolTip="Copy the rendered HTML to the clipboard" Height="32" Width="32" Padding="0"
                                Click="OnCopyHtmlClick" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                        </Button>
                        <Button ToolTipService.ToolTip="Print the rendered document (Ctrl+P)" Height="32" Width="32" Padding="0"
                                Click="OnPrintClick" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE749;" FontSize="13" />
                        </Button>

                        <!-- Issue #6: the old two rows of 20+ buttons, consolidated into dropdown
                             clusters (every action keeps its original Click handler). The retired
                             "View &amp; Zoom" cluster was redundant: editor font size lives on the
                             A− / A+ strip under the editor, preview zoom on the width ruler under
                             the preview. -->
                        <StackPanel x:Name="EditingClustersPanel" Orientation="Horizontal" Spacing="4">
                            <Border Width="1" Height="16" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                            <DropDownButton ToolTipService.ToolTip="Text style — bold, italic, strikethrough, headings" Height="32" Padding="8,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE19B;" FontSize="14" />
                                    <TextBlock Text="Text Style" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Bold" Click="OnBoldClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE19B;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Italic" Click="OnItalicClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE19D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Strikethrough" Click="OnStrikethroughClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE19E;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Heading 1 (#)" Click="OnH1Click" />
                                        <MenuFlyoutItem Text="Heading 2 (##)" Click="OnH2Click" />
                                        <MenuFlyoutItem Text="Heading 3 (###)" Click="OnH3Click" />
                                        <MenuFlyoutItem Text="Heading 4 (####)" Click="OnH4Click" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <DropDownButton ToolTipService.ToolTip="Lists — bullet, numbered, task list, blockquote" Height="32" Padding="8,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE292;" FontSize="14" />
                                    <TextBlock Text="Lists" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Bullet List" Click="OnBulletListClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE292;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Numbered List" Click="OnNumberedListClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE293;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Task List" Click="OnTaskListClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73A;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Blockquote" Click="OnBlockquoteClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9F9;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <DropDownButton ToolTipService.ToolTip="Insert — links, media, tables, rich components, diagrams" Height="32" Padding="8,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="Insert" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Link" Click="OnLinkClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Image" Click="OnImageClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Table" Click="OnTableClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEA37;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Code Block" Click="OnCodeBlockClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE943;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutSubItem Text="Rich Components">
                                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE71D;" /></MenuFlyoutSubItem.Icon>
                                            <MenuFlyoutItem Text="Tab Group" Click="OnInsertTabsClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF7ED;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Web Embed" Click="OnInsertEmbedClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEE7A;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Native Chart" Click="OnInsertChartClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE99A;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Data Grid" Click="OnInsertDatagridClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF0E2;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="From Spreadsheet…" Click="OnInsertSpreadsheetClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80A;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Table to Excel…" Click="OnExportTableClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE3;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Multi-column Section" Click="OnInsertColumnsClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F1;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Drawing Canvas" Click="OnInsertCanvasClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEE56;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSubItem Text="Diagram">
                                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8DA;" /></MenuFlyoutSubItem.Icon>
                                            <MenuFlyoutItem Text="Visual Diagram Studio..." Click="OnOpenMermaidStudioClick" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Workflow / Flowchart" Click="OnInsertWorkflowClick" />
                                            <MenuFlyoutItem Text="Timeline" Click="OnInsertTimelineClick" />
                                            <MenuFlyoutItem Text="SmartArt" Click="OnInsertSmartArtClick" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Bibliography / References" Click="OnInsertReferencesClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE113;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="AI Context metadata" Click="OnInsertAiContextClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE945;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <DropDownButton ToolTipService.ToolTip="Tools — transform selected text, sort lines, clean up the document" Height="32" Padding="8,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE90F;" FontSize="14" />
                                    <TextBlock Text="Tools" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="UPPERCASE" Click="OnTransformUpperClick" />
                                        <MenuFlyoutItem Text="lowercase" Click="OnTransformLowerClick" />
                                        <MenuFlyoutItem Text="Title Case" Click="OnTransformTitleClick" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Sort lines A to Z" Click="OnSortLinesAscClick" />
                                        <MenuFlyoutItem Text="Sort lines Z to A" Click="OnSortLinesDescClick" />
                                        <MenuFlyoutItem Text="Remove duplicate lines" Click="OnDedupeLinesClick" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Clean up document" Click="OnCleanupClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>


            <controls:GridSplitter x:Name="RightSplitter" Grid.Column="3" Width="16" Background="Transparent" ResizeBehavior="BasedOnAlignment" ResizeDirection="Auto"
                                               ToolTipService.ToolTip="Drag to resize the Style &amp; Export pane" />

            <!-- RIGHT PANE -->
            
            <Grid x:Name="RightPane" Grid.Column="4" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource StepBadgeStyle}">
                            <TextBlock Text="3" Style="{StaticResource StepBadgeTextStyle}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Style &amp; Export" Style="{StaticResource StepTitleStyle}" />
                            <TextBlock Text="Finish the document" Style="{StaticResource StepCaptionStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- The old row of four (history / tour / shortcuts / settings) overlapped the
                             step header at narrow widths, so everything lives in one ⋯ menu now — the
                             tip jar too (it used to float in the title bar). The history ListView keeps
                             its rich flyout, re-shown as an attached flyout from the menu item. -->
                        <!-- Document outline (Task 17): H1–H6 flyout; clicking a node scrolls the
                             preview to that heading. Its own Button.Flyout (not an attached flyout)
                             so it doesn't collide with the ⋯ menu's history attached flyout. -->
                        <Button x:Name="OutlineButton" ToolTipService.ToolTip="Document outline (H1–H6)">
                            <FontIcon Glyph="&#xE8A4;" FontSize="14" />
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <Grid RowSpacing="8" Width="340">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Document outline" FontWeight="SemiBold" />
                                        <ListView x:Name="TocList" Grid.Row="1" MaxHeight="420"
                                                  SelectionMode="None" IsItemClickEnabled="True"
                                                  ItemClick="OnTocItemClick">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                                               Margin="{Binding Level, Converter={StaticResource LevelToIndentConverter}}" />
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="MoreMenuButton" ToolTipService.ToolTip="More — history, tour, shortcuts, settings, support">
                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="Export history" Click="OnExportHistoryMenuClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Take a quick tour" Click="OnTakeTourClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE897;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Keyboard shortcuts" Click="OnShortcutsButtonClick" KeyboardAcceleratorTextOverride="F1">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Settings" Click="OnSettingsClick" KeyboardAcceleratorTextOverride="Ctrl+,">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="☕ Buy Me a Coffee" Click="OnBuyCoffeeClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE76E;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <FlyoutBase.AttachedFlyout>
                                <Flyout Placement="Bottom">
                                    <Grid RowSpacing="8" Width="380">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Export history" FontWeight="SemiBold" />
                                        <ListView x:Name="HistoryList" Grid.Row="1" MaxHeight="420"
                                                  SelectionMode="None" IsItemClickEnabled="True"
                                                  ItemClick="OnHistoryItemClick">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Padding="0,6" Spacing="2"
                                                                ToolTipService.ToolTip="{Binding OutputPath}">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding OutputPath}" Opacity="0.4" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Flyout>
                            </FlyoutBase.AttachedFlyout>
                        </Button>
                    </StackPanel>
                    <!-- Called out once after the first-run tour, and once more on the third launch
                         (the tip-jar nudge). Title/subtitle are set in code before opening. -->
                    <TeachingTip x:Name="MoreMenuTip" Target="{x:Bind MoreMenuButton}"
                                 PreferredPlacement="BottomLeft" IsLightDismissEnabled="True" />
                </Grid>
<Border x:Name="StyleCard" Grid.Row="1" Style="{StaticResource PipelineCardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="14" Spacing="14">
                            <!-- Export presets: save the current look, re-apply in one click. -->
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="PresetsCombo" Grid.Column="0" Header="Preset"
                                          ItemsSource="{Binding Presets}" DisplayMemberPath="Name"
                                          PlaceholderText="Apply a saved preset…" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnPresetSelected" />
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnSavePresetClick"
                                        ToolTipService.ToolTip="Save current settings as a preset">
                                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                </Button>
                                <Button Grid.Column="4" VerticalAlignment="Bottom" Click="OnDeletePresetClick"
                                        ToolTipService.ToolTip="Delete the selected preset">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Header="Theme" ItemsSource="{Binding ThemeNames}"
                                          SelectedItem="{Binding SelectedThemeName, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3"
                                                           VerticalAlignment="Center"
                                                           Fill="{Binding Converter={StaticResource ThemeNameToSwatchConverter}}" />
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Click="OnToggleThemeFavoriteClick" VerticalAlignment="Bottom"
                                        ToolTipService.ToolTip="Pin/unpin the selected theme to the top of the list">
                                    <Grid>
                                        <FontIcon Glyph="&#xE734;" FontSize="14"
                                                  Visibility="{Binding IsCurrentThemeFavorite, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <FontIcon Glyph="&#xE735;" FontSize="14"
                                                  Visibility="{Binding IsCurrentThemeFavorite, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                    </Grid>
                                </Button>
                                <Button Grid.Column="2" Content="🎨" Click="OnCreateThemeClick"
                                        VerticalAlignment="Bottom" ToolTipService.ToolTip="Create a theme — pick your own colors for every element (starts from the selected theme)" />
                            </Grid>

                            <ToggleSwitch Header="Light Theme Influence"
                                          IsOn="{Binding ThemeLightInfluence, Mode=TwoWay}" />
                            <TextBlock Text="When enabled, the page uses a light center gradient with theme colors on the margins, automatically adjusting text for readability."
                                       Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" TextWrapping="Wrap" />

                            <NumberBox Header="Page width (px)" Value="{Binding ContentWidth, Mode=TwoWay}"
                                       SpinButtonPlacementMode="Inline" Minimum="400" Maximum="2400" SmallChange="50" />

                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <ToggleSwitch Header="Lock to A4 width" IsOn="{Binding A4FixedWidth, Mode=TwoWay}" />
                            <ToggleSwitch Header="Single continuous page (no page breaks)"
                                          OnContent="On · PDF only" OffContent="Off"
                                          IsOn="{Binding UnlimitedHeight, Mode=TwoWay}" />
                            <TextBlock Text="A PDF-only layout. In DOCX there's no page-less print mode, so Word opens the file in Web Layout view instead — one continuous flow, not meant for printing."
                                       Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" TextWrapping="Wrap" />

                            <ToggleSwitch Header="Page border (DOCX)" IsOn="{Binding PageBorder, Mode=TwoWay}" />
                            <TextBlock Text="Draws a decorative full-page frame around the content in Word exports."
                                       Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" TextWrapping="Wrap" />
                            <ToggleSwitch Header="Track Changes (DOCX)" IsOn="{Binding TrackChanges, Mode=TwoWay}" />
                            <TextBlock Text="Turns on Word revision tracking in the exported file so edits are visible."
                                       Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" TextWrapping="Wrap" />

                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <TextBlock Text="AI documents" FontWeight="SemiBold" />
                            <ToggleSwitch Header="Normalize AI formatting quirks"
                                          IsOn="{Binding NormalizeLlm, Mode=TwoWay}" />
                            <TextBlock Text="Fixes ChatGPT LaTeX + citation pips, Gemini pseudo-headings, Claude tag remnants."
                                       Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" />
                            <ToggleSwitch Header="Source attribution strip in export"
                                          IsOn="{Binding ShowAttribution, Mode=TwoWay}" />
                            <ToggleSwitch Header="Table of contents"
                                          IsOn="{Binding IncludeToc, Mode=TwoWay}" />

                            <ToggleSwitch Header="Render Mermaid diagrams" IsOn="{Binding MermaidEnabled, Mode=TwoWay}" />
                            <TextBlock Text="When off, mermaid code fences are shown as plain code blocks instead of rendered diagrams."
                                       Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" TextWrapping="Wrap" />

                            <ComboBox Header="Diagrams in Word exports" HorizontalAlignment="Stretch"
                                      SelectedIndex="{Binding MermaidDocxMode, Mode=TwoWay}">
                                <x:String>Snapshot — picture of the diagram</x:String>
                                <x:String>ShapeForge™ — editable Word shapes</x:String>
                            </ComboBox>
                            <TextBlock Text="ShapeForge rebuilds Mermaid diagrams from Word's own shapes — flowcharts, sequence, class/ER, pie, gantt, mindmap, timeline, quadrant — every box and arrow editable. Anything it can't parse falls back to the snapshot."
                                       Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" TextWrapping="Wrap" />

                            <ToggleSwitch Header="Use Smart Connectors (Glued Edges)"
                                          IsOn="{Binding SmartConnectors, Mode=TwoWay}" />
                            <TextBlock Text="When enabled, lines stay glued to shapes when dragged in Word."
                                       Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" />

                            <ComboBox Header="Connector arrowheads" HorizontalAlignment="Stretch"
                                      SelectedItem="{Binding ConnectorArrowhead, Mode=TwoWay}">
                                <x:String>default</x:String>
                                <x:String>triangle</x:String>
                                <x:String>open</x:String>
                                <x:String>diamond</x:String>
                                <x:String>oval</x:String>
                                <x:String>stealth</x:String>
                                <x:String>none</x:String>
                            </ComboBox>
                            <TextBlock Text="Fallback arrowhead style for connectors that don't specify one in the diagram source."
                                       Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" TextWrapping="Wrap" />

                            <InfoBar IsOpen="{Binding HasMermaidDiagram}"
                                     Severity="{Binding DiagramHintSeverity, Converter={StaticResource StatusSeverityConverter}}"
                                     Message="{Binding DiagramHintText}"
                                     IsClosable="False" Margin="0,0,0,8">
                                <InfoBar.ActionButton>
                                    <Button Content="Diagram Studio 🎨" Click="OnOpenMermaidStudioClick" ToolTipService.ToolTip="Open the visual Mermaid Diagram Studio" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                            <ComboBox Header="Large diagrams (won't fit a page)" HorizontalAlignment="Stretch"
                                      SelectedIndex="{Binding OversizedDiagramMode, Mode=TwoWay}">
                                <x:String>Ask me each time</x:String>
                                <x:String>Keep Original Size (Web Layout)</x:String>
                                <x:String>Gentle Shrink (Max 75%, Web Layout if needed)</x:String>
                                <x:String>Slice Vertically (Multiple pages)</x:String>
                                <x:String>Enlarge Page Size (2x2 Poster)</x:String>
                                <x:String>Aggressive Shrink (Force to 1 page)</x:String>
                                <x:String>Compress Gaps (ShapeForge native shapes)</x:String>
                                <x:String>Compress Nodes (ShapeForge native shapes)</x:String>
                                <x:String>Compress Both (ShapeForge native shapes)</x:String>
                            </ComboBox>
                            <TextBlock Text="When a diagram is too big to fit a printed page: keep Mermaid's exact layout (opens in Word's Web Layout, scrolls) or let MarkSmith re-wrap it to fit standard pages."
                                       Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" TextWrapping="Wrap" />
                            <NumberBox Header="Poster grid size (Enlarge Page mode)" Value="{Binding DiagramGridSize, Mode=TwoWay}"
                                       SpinButtonPlacementMode="Inline" Minimum="2" Maximum="3" SmallChange="1" />
                            <TextBlock Text="2 = 2×2 poster (4 pages), 3 = 3×3 (9 pages). Only used by the Enlarge Page Size strategy."
                                       Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" TextWrapping="Wrap" />
                            <Expander x:Name="ExportBrandingExpander" HorizontalAlignment="Stretch" Margin="0,10,0,0">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8D4;" FontSize="14" />
                                        <TextBlock Text="Export Branding" />
                                        <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="4" Padding="5,1"
                                                VerticalAlignment="Center" Visibility="{Binding ShowProBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Spacing="14">
                                    <ToggleSwitch Header="Include Cover Page (Logo, Title, Date)"
                                                  IsOn="{Binding BrandCoverPage, Mode=TwoWay}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Header="Company Logo (PNG/JPEG)" 
                                                 Text="{Binding BrandLogoPath, Mode=TwoWay}"
                                                 PlaceholderText="Select logo image..." IsSpellCheckEnabled="False" />
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnBrowseLogoClick"
                                                ToolTipService.ToolTip="Choose a logo image (PNG/JPEG)">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                    <TextBox Header="Custom Document Font Family" 
                                             Text="{Binding BrandFontFamily, Mode=TwoWay}"
                                             PlaceholderText="e.g. Segoe UI, Inter (leave blank for default)" IsSpellCheckEnabled="False" />
                                    <TextBox Header="Author name (document metadata)"
                                             Text="{Binding AuthorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Shown as the document's author in Word/PDF properties" IsSpellCheckEnabled="False" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Header="Custom font file (TTF/OTF)"
                                                 Text="{Binding CustomFontPath, Mode=TwoWay}"
                                                 PlaceholderText="Embed a font that isn't installed system-wide" IsSpellCheckEnabled="False" />
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnBrowseFontClick"
                                                ToolTipService.ToolTip="Choose a .ttf or .otf font file">
                                            <FontIcon Glyph="&#xE8D4;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="Requires MarkSmith Pro license to apply to DOCX exports."
                                               Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" />
                                </StackPanel>
                            </Expander>
                                      <!-- Power-user styling — revealed by Advanced mode (Settings cog). -->
                              <Expander x:Name="AdvancedStyleExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,10,0,0">
                                  <Expander.Header>
                                      <StackPanel Orientation="Horizontal" Spacing="8">
                                          <FontIcon Glyph="&#xE90F;" FontSize="14" />
                                          <TextBlock Text="Advanced Options" />
                                      </StackPanel>
                                  </Expander.Header>
                                  <StackPanel Spacing="14">
                                      <CheckBox Content="No emoji mode"
                                                IsChecked="{Binding NoEmoji, Mode=TwoWay}" />
                                      <TextBlock Text="Strips every emoji from the document — whatever the input — in preview, PDF and DOCX."
                                                 Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" />

                                      <ComboBox Header="Em dashes (—)" HorizontalAlignment="Stretch"
                                                SelectedIndex="{Binding DashMode, Mode=TwoWay}">
                                          <x:String>Keep as-is</x:String>
                                          <x:String>Replace with hyphen (-)</x:String>
                                          <x:String>Replace with spaced ( - )</x:String>
                                          <x:String>Custom…</x:String>
                                      </ComboBox>
                                      <TextBox PlaceholderText="Custom replacement (used when 'Custom…' is selected)"
                                               Text="{Binding DashCustom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               IsSpellCheckEnabled="False" />
                                      <TextBlock Text="Swaps AI-style em-dashes throughout preview, PDF and DOCX. Code blocks are left untouched."
                                                 Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" />

                                      <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                                      <TextBlock Text="Formatting" FontWeight="SemiBold" />
                                      <TextBlock Text="Make the formatting yours instead of the model's default — structure, not cleanup."
                                                 Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" />

                                      <NumberBox Header="Heading level shift" Value="{Binding HeadingShift, Mode=TwoWay}"
                                                 SpinButtonPlacementMode="Inline" Minimum="-5" Maximum="5" SmallChange="1" />
                                      <TextBlock Text="Promote (−) or demote (+) every heading, e.g. +1 turns # into ##. Clamped to 1–6."
                                                 Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" />

                                      <ComboBox Header="Bold" HorizontalAlignment="Stretch"
                                                SelectedIndex="{Binding BoldMode, Mode=TwoWay}">
                                          <x:String>Keep</x:String>
                                          <x:String>Remove (plain text)</x:String>
                                          <x:String>Convert to italic</x:String>
                                      </ComboBox>

                                      <ComboBox Header="Italic" HorizontalAlignment="Stretch"
                                                SelectedIndex="{Binding ItalicMode, Mode=TwoWay}">
                                          <x:String>Keep</x:String>
                                          <x:String>Remove (plain text)</x:String>
                                      </ComboBox>

                                      <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                                      <TextBlock Text="Branding kit" FontWeight="SemiBold" />
                                      <TextBlock Text="Turn a converted chat into a client-ready deliverable — cover page, your logo, your typeface (Word exports)."
                                                 Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" />
                                      <ToggleSwitch Header="Cover page (title, logo, date)"
                                                    IsOn="{Binding BrandCoverPage, Mode=TwoWay}" />
                                      <Grid ColumnSpacing="8">
                                          <Grid.ColumnDefinitions>
                                              <ColumnDefinition Width="*" />
                                              <ColumnDefinition Width="Auto" />
                                          </Grid.ColumnDefinitions>
                                          <TextBox Grid.Column="0" Header="Logo (PNG/JPEG)" Text="{Binding BrandLogoPath, Mode=TwoWay}"
                                                   PlaceholderText="Optional — shown on the cover" IsSpellCheckEnabled="False" />
                                          <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnBrowseBrandLogoClick"
                                                  ToolTipService.ToolTip="Choose a logo image (PNG/JPEG)">
                                              <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                          </Button>
                                      </Grid>
                                      <TextBox Header="Document font" Text="{Binding BrandFontFamily, Mode=TwoWay}"
                                               PlaceholderText="Default (Calibri) — e.g. Georgia, Garamond, Segoe UI"
                                               IsSpellCheckEnabled="False" />
                                  </StackPanel>
                              </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            
<Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding OutputFolder, Mode=TwoWay}"
                             PlaceholderText="Output folder (defaults to next to the input file)"
                             IsSpellCheckEnabled="False" ToolTipService.ToolTip="Output folder" />

                    <Button Grid.Column="1" VerticalAlignment="Stretch" Click="OnBrowseFolderClick"
                            ToolTipService.ToolTip="Choose output folder">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    </Button>

                    <Button Grid.Column="2" VerticalAlignment="Stretch" Click="OnOpenOutputClick"
                            IsEnabled="{Binding HasOutput}" ToolTipService.ToolTip="Open last output">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                            <TextBlock Text="Open output" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- ISS-016: export actions collapsed into a single SplitButton so the toolbar
                         no longer overflows the window at narrow widths / in Split View. -->
                    <!-- ISS-019: Word (.docx) is the default export — the primary click generates
                         a .docx; PDF and the rest live in the chevron flyout. -->
                    <SplitButton x:Name="ExportSplitButton" Grid.Column="0" Height="40"
                                 Click="OnPrimaryExportClick" IsEnabled="{Binding IsNotBusy}"
                                 ToolTipService.ToolTip="Generate a Word document — use the chevron for other formats">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="16" />
                            <TextBlock Text="Generate Word (.docx)" FontWeight="SemiBold" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Export as Word (.docx)" Click="OnConvertDocxClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Export as PDF (.pdf)" Click="OnConvertPdfClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE749;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Export as PowerPoint (.pptx)" Click="OnConvertPptxClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Export as EPUB (.epub)" Click="OnExportEpubClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE82D;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Export as Markdown (.md)" Click="OnExportMarkdownClick"
                                                ToolTipService.ToolTip="Save the recovered/cleaned source as a Markdown file — the counterpart to importing a .docx">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C3;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Export all licensed formats" Click="OnExportAllClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71D;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <Button Grid.Column="1" Height="40" Content="Cancel"
                            Command="{Binding CancelConversionCommand}" IsEnabled="{Binding IsBusy}"
                            ToolTipService.ToolTip="Cancel the export in progress" />

                    <ProgressRing Grid.Column="2" IsActive="{Binding IsBusy}" Width="22" Height="22"
                                  VerticalAlignment="Center" />
                </Grid>
            </Grid>

        </Grid>

        <!-- Persistent status bar: a full-width strip along the bottom of the window with the
             changing status text docked bottom-left like a typical status bar (busy ring,
             detected-source badge, severity-colored message) and the Ln/Col readout on the
             right. Replaces the ISS-013 floating pill, which overlapped the editor's bottom
             buttons at the default 1220×800 launch size. -->
        <Border Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="16,5">
                    <ProgressRing IsActive="{Binding IsBusy}" Width="14" Height="14" VerticalAlignment="Center" />
                    <Border x:Name="DetectedBadge" Visibility="Collapsed" CornerRadius="12" Padding="10,4"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE945;" FontSize="12"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding DetectedSourceText}" FontSize="12"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="StatusMsgText" Text="{Binding StatusText}"
                               VerticalAlignment="Center" FontSize="12" Opacity="0.85"
                               Foreground="{Binding StatusSeverity, Converter={StaticResource StatusSeverityToBrushConverter}}"
                               TextTrimming="CharacterEllipsis" MaxWidth="560" />
                </StackPanel>
                <TextBlock x:Name="CursorPosText" Text="Ln 1, Col 1" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="16,5" FontFamily="Consolas" FontSize="11.5" Opacity="0.7"
                           ToolTipService.ToolTip="Cursor position in the Markdown editor" />
            </Grid>
        </Border>
    </Grid>
</Window>

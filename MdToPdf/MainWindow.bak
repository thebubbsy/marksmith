<Window x:Class="MdToPdf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="using:MdToPdf.Converters">
  <Grid x:Name="RootGrid">
    <Grid.Resources>
      <conv:StatusSeverityConverter x:Key="StatusSeverityConverter" />
      <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="1" Spacing="6">
      <!-- Trial / upgrade banner (shown only when the trial is low or ended) -->
      <InfoBar x:Name="LicenseBanner" Margin="16,0,16,0" IsOpen="False" IsClosable="True">
        <InfoBar.ActionButton>
          <Button Content="Upgrade to Pro" Click="OnUpgradeClick" />
        </InfoBar.ActionButton>
      </InfoBar>
      <!-- Shown once per session when a paste looks like plain text: the browser extension's
                 "Copy as Markdown" button would have kept the formatting. -->
      <InfoBar x:Name="ExtensionHintBar" Margin="16,0,16,0" IsOpen="False" IsClosable="True" Severity="Informational" Title="That paste looks like plain text" Message="Headings, tables and code were probably lost on the way. In your AI chat, use the Marksmith Connector's 'Copy as Markdown' button (it's pulsing there now) to keep the formatting.">
        <InfoBar.ActionButton>
          <Button Content="Get the extension" Click="OnGetExtensionClick" />
        </InfoBar.ActionButton>
      </InfoBar>
    </StackPanel>
    <!-- Custom title bar so Mica shows through behind it; extended via Window.ExtendsContentIntoTitleBar in code-behind -->
    <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/logo.png" Width="26" Height="26" />
        <TextBlock Text="Marksmith" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        <TextBlock Text="·" Opacity="0.4" VerticalAlignment="Center" />
        <TextBlock Text="AI chats → polished documents" Opacity="0.55" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>
    <!-- Left-to-right pipeline: 1 Source -> 2 Style -> 3 Preview & Export -->
    <Grid Grid.Row="2" Padding="16,6,16,16" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="350" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0" RowSpacing="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="History" FontWeight="SemiBold" Style="{StaticResource StepTitleStyle}" />
        <ListView x:Name="HistoryList" Grid.Row="1" MaxHeight="420" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnHistoryItemClick">
          <ListView.ItemTemplate>
            <DataTemplate>
              <StackPanel Padding="0,6" Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
      <Grid Grid.Column="1">
        <WebView2 x:Name="PreviewWebView" Margin="1" />
        <TextBox x:Name="EditorTextBox" Text="{Binding PastedMarkdown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="13" PlaceholderText="Paste or type Markdown here..." VerticalContentAlignment="Top" IsSpellCheckEnabled="False" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" PointerMoved="OnEditorPointerMoved" GotFocus="OnEditorGotFocus" LostFocus="OnEditorLostFocus" SelectionChanged="OnEditorSelectionChanged" Foreground="Transparent" Padding="12" />
        <TextBlock x:Name="EditorOverlayText" Text="{Binding PastedMarkdown}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="13" TextWrapping="Wrap" IsHitTestVisible="False" Padding="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
          <TextBlock.OpacityMask>
            <RadialGradientBrush x:Name="LookingGlassBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.2" RadiusY="0.2">
              <GradientStop Color="#FF000000" Offset="0" />
              <GradientStop Color="#FF000000" Offset="0.5" />
              <GradientStop Color="#00000000" Offset="1" />
            </RadialGradientBrush>
          </TextBlock.OpacityMask>
        </TextBlock>
        <Grid x:Name="PreviewSpinner" Visibility="Collapsed" Background="#14000000">
          <Image x:Name="SpinnerLogo" Source="ms-appx:///Assets/logo.png" Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
              <CompositeTransform x:Name="SpinnerLogoTransform" />
            </Image.RenderTransform>
          </Image>
        </Grid>
      </Grid>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
          <StackPanel Spacing="16">
            <Border x:Name="StyleCard" Grid.Row="1" Style="{StaticResource PipelineCardStyle}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="14" Spacing="14">
                  <!-- Export presets: save the current look, re-apply in one click. -->
                  <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="PresetsCombo" Grid.Column="0" Header="Preset" ItemsSource="{Binding Presets}" DisplayMemberPath="Name" PlaceholderText="Apply a saved preset…" HorizontalAlignment="Stretch" SelectionChanged="OnPresetSelected" />
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnSavePresetClick" ToolTipService.ToolTip="Save current settings as a preset">
                      <FontIcon Glyph="" FontSize="14" />
                    </Button>
                    <Button Grid.Column="2" VerticalAlignment="Bottom" Click="OnDeletePresetClick" ToolTipService.ToolTip="Delete the selected preset">
                      <FontIcon Glyph="" FontSize="14" />
                    </Button>
                  </Grid>
                  <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                  <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Header="Theme" ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding SelectedThemeName, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <Button Grid.Column="1" Content="🎨" Click="OnCreateThemeClick" VerticalAlignment="Bottom" ToolTipService.ToolTip="Create a theme — pick your own colors for every element (starts from the selected theme)" />
                  </Grid>
                  <NumberBox Header="Page width (px)" Value="{Binding ContentWidth, Mode=TwoWay}" SpinButtonPlacementMode="Inline" Minimum="400" Maximum="2400" SmallChange="50" />
                  <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                  <ToggleSwitch Header="Lock to A4 width" IsOn="{Binding A4FixedWidth, Mode=TwoWay}" />
                  <ToggleSwitch Header="Single continuous page (no page breaks)" OnContent="On · PDF only" OffContent="Off" IsOn="{Binding UnlimitedHeight, Mode=TwoWay}" />
                  <TextBlock Text="A PDF-only layout. In DOCX there's no page-less print mode, so Word opens the file in Web Layout view instead — one continuous flow, not meant for printing." Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" TextWrapping="Wrap" />
                  <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                  <TextBlock Text="AI documents" FontWeight="SemiBold" />
                  <ToggleSwitch Header="Normalize AI formatting quirks" IsOn="{Binding NormalizeLlm, Mode=TwoWay}" />
                  <TextBlock Text="Fixes ChatGPT LaTeX + citation pips, Gemini pseudo-headings, Claude tag remnants." Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" />
                  <ToggleSwitch Header="Source attribution strip in export" IsOn="{Binding ShowAttribution, Mode=TwoWay}" />
                  <ToggleSwitch Header="Table of contents" IsOn="{Binding IncludeToc, Mode=TwoWay}" />
                  <ComboBox Header="Diagrams in Word exports" HorizontalAlignment="Stretch" SelectedIndex="{Binding MermaidDocxMode, Mode=TwoWay}">
                    <x:String>Snapshot — picture of the diagram</x:String>
                    <x:String>ShapeForge™ — editable Word shapes</x:String>
                  </ComboBox>
                  <TextBlock Text="ShapeForge rebuilds Mermaid diagrams from Word's own shapes — flowcharts, sequence, class/ER, pie, gantt, mindmap, timeline, quadrant — every box and arrow editable. Anything it can't parse falls back to the snapshot." Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" TextWrapping="Wrap" />
                  <ToggleSwitch Header="Use Smart Connectors (Glued Edges)" IsOn="{Binding SmartConnectors, Mode=TwoWay}" />
                  <TextBlock Text="When enabled, lines stay glued to shapes when dragged in Word." Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" />
                  <ComboBox Header="Large diagrams (won't fit a page)" HorizontalAlignment="Stretch" SelectedIndex="{Binding OversizedDiagramMode, Mode=TwoWay}">
                    <x:String>Ask me each time</x:String>
                    <x:String>Keep exact layout (Web Layout view)</x:String>
                    <x:String>Reflow to fit the page</x:String>
                    <x:String>Multi-page vertical downward (Print Layout)</x:String>
                    <x:String>2x2 Grid poster (Print Layout)</x:String>
                    <x:String>Shrink to fit one page (Print Layout)</x:String>
                  </ComboBox>
                  <TextBlock Text="When a diagram is too big to fit a printed page: keep Mermaid's exact layout (opens in Word's Web Layout, scrolls) or let Marksmith re-wrap it to fit standard pages." Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" TextWrapping="Wrap" />
                  <Expander HorizontalAlignment="Stretch" Margin="0,10,0,0">
                    <Expander.Header>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="" FontSize="14" />
                        <TextBlock Text="Export Branding" />
                        <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center" Visibility="{Binding ShowProBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                          <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="White" />
                        </Border>
                      </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="14">
                      <ToggleSwitch Header="Include Cover Page (Logo, Title, Date)" IsOn="{Binding BrandCoverPage, Mode=TwoWay}" />
                      <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Header="Company Logo (PNG/JPEG)" Text="{Binding BrandLogoPath, Mode=TwoWay}" PlaceholderText="Select logo image..." IsSpellCheckEnabled="False" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnBrowseLogoClick">
                          <FontIcon Glyph="" FontSize="14" />
                        </Button>
                      </Grid>
                      <TextBox Header="Custom Document Font Family" Text="{Binding BrandFontFamily, Mode=TwoWay}" PlaceholderText="e.g. Segoe UI, Inter (leave blank for default)" IsSpellCheckEnabled="False" />
                      <TextBlock Text="Requires Marksmith Pro license to apply to DOCX exports." Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" />
                    </StackPanel>
                  </Expander>
                  <!-- Power-user styling — revealed by Advanced mode (Settings cog). -->
                  <StackPanel x:Name="AdvancedStyleSection" Spacing="14" Visibility="Collapsed">
                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                      <TextBlock Text="Advanced" FontWeight="SemiBold" />
                    </StackPanel>
                    <CheckBox Content="No emoji mode" IsChecked="{Binding NoEmoji, Mode=TwoWay}" />
                    <TextBlock Text="Strips every emoji from the document — whatever the input — in preview, PDF and DOCX." Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" />
                    <ComboBox Header="Em dashes (—)" HorizontalAlignment="Stretch" SelectedIndex="{Binding DashMode, Mode=TwoWay}">
                      <x:String>Keep as-is</x:String>
                      <x:String>Replace with hyphen (-)</x:String>
                      <x:String>Replace with spaced ( - )</x:String>
                      <x:String>Custom…</x:String>
                    </ComboBox>
                    <TextBox PlaceholderText="Custom replacement (used when 'Custom…' is selected)" Text="{Binding DashCustom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSpellCheckEnabled="False" />
                    <TextBlock Text="Swaps AI-style em-dashes throughout preview, PDF and DOCX. Code blocks are left untouched." Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" />
                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <TextBlock Text="Formatting" FontWeight="SemiBold" />
                    <TextBlock Text="Make the formatting yours instead of the model's default — structure, not cleanup." Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" />
                    <NumberBox Header="Heading level shift" Value="{Binding HeadingShift, Mode=TwoWay}" SpinButtonPlacementMode="Inline" Minimum="-5" Maximum="5" SmallChange="1" />
                    <TextBlock Text="Promote (−) or demote (+) every heading, e.g. +1 turns # into ##. Clamped to 1–6." Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" />
                    <ComboBox Header="Bold" HorizontalAlignment="Stretch" SelectedIndex="{Binding BoldMode, Mode=TwoWay}">
                      <x:String>Keep</x:String>
                      <x:String>Remove (plain text)</x:String>
                      <x:String>Convert to italic</x:String>
                    </ComboBox>
                    <ComboBox Header="Italic" HorizontalAlignment="Stretch" SelectedIndex="{Binding ItalicMode, Mode=TwoWay}">
                      <x:String>Keep</x:String>
                      <x:String>Remove (plain text)</x:String>
                    </ComboBox>
                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <TextBlock Text="Branding kit" FontWeight="SemiBold" />
                    <TextBlock Text="Turn a converted chat into a client-ready deliverable — cover page, your logo, your typeface (Word exports)." Style="{StaticResource StepCaptionStyle}" Margin="0,-8,0,0" />
                    <ToggleSwitch Header="Cover page (title, logo, date)" IsOn="{Binding BrandCoverPage, Mode=TwoWay}" />
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Header="Logo (PNG/JPEG)" Text="{Binding BrandLogoPath, Mode=TwoWay}" PlaceholderText="Optional — shown on the cover" IsSpellCheckEnabled="False" />
                      <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnBrowseBrandLogoClick">
                        <FontIcon Glyph="" FontSize="14" />
                      </Button>
                    </Grid>
                    <TextBox Header="Document font" Text="{Binding BrandFontFamily, Mode=TwoWay}" PlaceholderText="Default (Calibri) — e.g. Georgia, Garamond, Segoe UI" IsSpellCheckEnabled="False" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Border>
            <Expander x:Name="AutomationExpander" Grid.Row="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="" FontSize="14" />
                  <TextBlock Text="Automation" />
                </StackPanel>
              </Expander.Header>
              <StackPanel Spacing="10">
                <ToggleSwitch Header="Auto-ingest AI chats from clipboard" OnContent="Watching" OffContent="Off" IsOn="{Binding AutoClipboardIngest, Mode=TwoWay}" />
                <TextBlock Text="Copy a reply in ChatGPT / Gemini / Claude and it lands here, detected and cleaned." Style="{StaticResource StepCaptionStyle}" Margin="0,-6,0,0" />
                <ToggleSwitch Header="Auto-generate PDF from AI-chat ingests" OnContent="On" OffContent="Off" IsOn="{Binding AutoConvertIngests, Mode=TwoWay}" />
                <TextBlock Text="Every chat sent here (clipboard, API, or the extension at end of conversation) is exported to a PDF automatically." Style="{StaticResource StepCaptionStyle}" Margin="0,-6,0,0" />
                <ToggleSwitch Header="Append DOCX ingests to a running document" OnContent="On" OffContent="Off" IsOn="{Binding AppendToRunningDoc, Mode=TwoWay}" />
                <TextBlock Text="When a DOCX is auto-generated, add it as a dated section to one growing .docx instead of a new file — a living compendium of your AI work." Style="{StaticResource StepCaptionStyle}" Margin="0,-6,0,0" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Text="{Binding RunningDocPath, Mode=TwoWay}" PlaceholderText="e.g. C:\Docs\AI-notebook.docx" IsSpellCheckEnabled="False" />
                  <Button Grid.Column="1" Click="OnBrowseRunningDocClick">
                    <FontIcon Glyph="" FontSize="14" />
                  </Button>
                </Grid>
                <ToggleSwitch Header="Watch a folder for Markdown exports" OnContent="Watching" OffContent="Off" IsOn="{Binding WatchFolderEnabled, Mode=TwoWay}" />
                <ToggleSwitch Header="Auto-convert watched files to PDF" OnContent="Hands-free" OffContent="Ingest only" IsOn="{Binding WatchFolderAutoConvert, Mode=TwoWay}" />
                <TextBlock Text="New .md files become PDFs in your output folder automatically, with a toast when done." Style="{StaticResource StepCaptionStyle}" Margin="0,-6,0,0" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Text="{Binding WatchFolder, Mode=TwoWay}" PlaceholderText="e.g. your Downloads folder" IsSpellCheckEnabled="False" />
                  <Button Grid.Column="1" Click="OnBrowseWatchFolderClick">
                    <FontIcon Glyph="" FontSize="14" />
                  </Button>
                </Grid>
                <Button Click="OnBatchConvertClick" HorizontalAlignment="Stretch">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="" FontSize="14" />
                    <TextBlock Text="Batch convert a folder to PDF…" />
                  </StackPanel>
                </Button>
                <TextBlock Text="Every .md file in the folder becomes a themed PDF in your output folder — detection and cleanup applied to each." Style="{StaticResource StepCaptionStyle}" Margin="0,-6,0,0" />
                <ToggleSwitch Header="Local REST API" OnContent="Running" OffContent="Off" IsOn="{Binding ApiEnabled, Mode=TwoWay}" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <NumberBox Grid.Column="0" Header="Port" Value="{Binding ApiPort, Mode=TwoWay}" Minimum="1024" Maximum="65535" />
                  <TextBlock x:Name="ApiUrlText" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,6" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" IsTextSelectionEnabled="True" />
                </Grid>
                <ToggleSwitch Header="Keep running in system tray when closed" OnContent="Tray mode" OffContent="Off" IsOn="{Binding MinimizeToTray, Mode=TwoWay}" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,10,0,0">
          <InfoBar Grid.Row="1" x:Name="ExtensionTip" Severity="Informational" IsOpen="True" IsClosable="True" CloseButtonClick="OnExtensionTipClosed" Title="Work in your AI chat as normal" Message="Install the Marksmith Connector browser extension to send ChatGPT, Gemini and Claude replies straight here — then export a polished PDF whenever you're ready.">
            <InfoBar.ActionButton>
              <HyperlinkButton Content="Get the extension" NavigateUri="https://github.com/thebubbsy/marksmith/tree/main/extension" />
            </InfoBar.ActionButton>
          </InfoBar>
          <Button x:Name="GeneratePdfButton" Grid.Column="0" Height="40" Style="{StaticResource AccentButtonStyle}" Click="OnConvertPdfClick" IsEnabled="{Binding IsNotBusy}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="" FontSize="16" />
              <TextBlock Text="Generate PDF" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Button x:Name="ExportDocxButton" Grid.Column="1" Height="40" Click="OnConvertDocxClick" IsEnabled="{Binding IsNotBusy}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="" FontSize="14" />
              <TextBlock Text="Export DOCX" />
              <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center" Visibility="{Binding ShowProBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="White" />
              </Border>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
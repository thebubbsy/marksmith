<UserControl
    x:Class="MdToPdf.Views.WelcomeTour"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- One feature line: accent glyph + title + caption -->
        <Style x:Key="TourGlyph" TargetType="FontIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Width" Value="26" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="TourHero" TargetType="FontIcon">
            <Setter Property="FontSize" Value="40" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="TourTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style x:Key="TourLead" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <Grid Width="540" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <FlipView x:Name="Pages" Grid.Row="0" Height="340"
                  SelectionChanged="OnPageChanged"
                  Background="Transparent" BorderThickness="0">

            <!-- 1 · Welcome -->
            <FlipViewItem>
                <StackPanel Padding="8,4,8,4">
                    <FontIcon Glyph="&#xE8A5;" Style="{StaticResource TourHero}" />
                    <TextBlock Text="Welcome to Marksmith" Style="{StaticResource TourTitle}" />
                    <TextBlock Style="{StaticResource TourLead}"
                               Text="Turn messy AI-chat replies — ChatGPT, Gemini, Claude, Copilot — into polished, professional documents. Here's a 60-second tour of everything it can do." />
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                        <FontIcon Glyph="&#xE8A1;" Style="{StaticResource TourGlyph}" />
                        <TextBlock TextWrapping="Wrap" Text="A left-to-right pipeline: Source → Style → Preview &amp; Export. Everything updates live." />
                    </StackPanel>
                </StackPanel>
            </FlipViewItem>

            <!-- 2 · Source -->
            <FlipViewItem>
                <StackPanel Padding="8,4,8,4">
                    <FontIcon Glyph="&#xE70F;" Style="{StaticResource TourHero}" />
                    <TextBlock Text="1 · Source" Style="{StaticResource TourTitle}" />
                    <TextBlock Style="{StaticResource TourLead}" Text="Get your content in — however you have it." />
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE77F;" Style="{StaticResource TourGlyph}" />
                            <TextBlock TextWrapping="Wrap" Text="Paste Markdown straight in, or drop / browse a .md file." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8B7;" Style="{StaticResource TourGlyph}" />
                            <TextBlock TextWrapping="Wrap" Text="The file picker finds real .md files across your Downloads, Documents, Desktop and OneDrive — newest first." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8D4;" Style="{StaticResource TourGlyph}" />
                            <TextBlock TextWrapping="Wrap" Text="Marksmith detects which assistant wrote it and cleans the tell-tale quirks — LaTeX delimiters, citation pips, pseudo-headings." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE71B;" Style="{StaticResource TourGlyph}" />
                            <TextBlock TextWrapping="Wrap" Text="The browser extension adds a &quot;Copy as Markdown&quot; button to each chat and sends it here in one click." />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </FlipViewItem>

            <!-- 3 · Style -->
            <FlipViewItem>
                <StackPanel Padding="8,4,8,4">
                    <FontIcon Glyph="&#xE790;" Style="{StaticResource TourHero}" />
                    <TextBlock Text="2 · Style" Style="{StaticResource TourTitle}" />
                    <TextBlock Style="{StaticResource TourLead}" Text="Make the output yours, not the model's default." />
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE2B1;" Style="{StaticResource TourGlyph}" />
                            <TextBlock TextWrapping="Wrap" Text="Ten themes, page width, A4 lock, and a single-continuous-page mode for PDF." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE75C;" Style="{StaticResource TourGlyph}" />
                            <TextBlock TextWrapping="Wrap" Text="Cleanup switches: em-dash handling, strip emoji, and the AI-quirk normalizer — all code-block-safe." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8D2;" Style="{StaticResource TourGlyph}" />
                            <TextBlock TextWrapping="Wrap" Text="Personalize the structure: shift every heading at once, and keep, remove or convert bold / italic. (Turn on Advanced mode in Settings to see these.)" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </FlipViewItem>

            <!-- 4 · Diagrams & math -->
            <FlipViewItem>
                <StackPanel Padding="8,4,8,4">
                    <FontIcon Glyph="&#xE9D9;" Style="{StaticResource TourHero}" />
                    <TextBlock Text="Diagrams &amp; math" Style="{StaticResource TourTitle}" />
                    <TextBlock Style="{StaticResource TourLead}" Text="The features nobody else bothers with." />
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8B1;" Style="{StaticResource TourGlyph}" />
                            <TextBlock TextWrapping="Wrap" Text="Mermaid diagrams become native, editable Word shapes (ShapeForge™) — not a flat picture." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE12B;" Style="{StaticResource TourGlyph}" />
                            <TextBlock TextWrapping="Wrap" Text="Big diagrams can keep Mermaid's exact layout and curves — the Word doc opens in Web Layout so nothing clips." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE943;" Style="{StaticResource TourGlyph}" />
                            <TextBlock TextWrapping="Wrap" Text="LaTeX / KaTeX math becomes real, clickable Word equations (OMML) — editable, not an image." />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </FlipViewItem>

            <!-- 5 · Export -->
            <FlipViewItem>
                <StackPanel Padding="8,4,8,4">
                    <FontIcon Glyph="&#xEDE1;" Style="{StaticResource TourHero}" />
                    <TextBlock Text="3 · Preview &amp; Export" Style="{StaticResource TourTitle}" />
                    <TextBlock Style="{StaticResource TourLead}" Text="See the finished page live, then export." />
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xEA90;" Style="{StaticResource TourGlyph}" />
                            <TextBlock TextWrapping="Wrap" Text="Pixel-perfect PDF, or a proprietary MD-to-Word DOCX with a self-updating table of contents and tables that survive page breaks." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8FD;" Style="{StaticResource TourGlyph}" />
                            <TextBlock TextWrapping="Wrap" Text="Also exports PowerPoint (PPTX) and EPUB." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8D4;" Style="{StaticResource TourGlyph}" />
                            <TextBlock TextWrapping="Wrap" Text="Branding kit: a cover page with your logo and a document-wide font, so a chat lands as a client-ready deliverable." />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </FlipViewItem>

            <!-- 6 · Automate & Pro -->
            <FlipViewItem>
                <StackPanel Padding="8,4,8,4">
                    <FontIcon Glyph="&#xE945;" Style="{StaticResource TourHero}" />
                    <TextBlock Text="Automate &amp; Pro" Style="{StaticResource TourTitle}" />
                    <TextBlock Style="{StaticResource TourLead}" Text="Hands-free conversion, and what Pro unlocks." />
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8B7;" Style="{StaticResource TourGlyph}" />
                            <TextBlock TextWrapping="Wrap" Text="Watch a folder or the clipboard and convert automatically; batch-convert a whole folder to PDF." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE968;" Style="{StaticResource TourGlyph}" />
                            <TextBlock TextWrapping="Wrap" Text="Drive it from scripts via the local REST API." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE734;" Style="{StaticResource TourGlyph}" />
                            <TextBlock TextWrapping="Wrap" Text="Free exports PDF. Marksmith Pro adds Word export, automation and branding — with a 14-day trial." />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </FlipViewItem>

            <!-- 7 · Done -->
            <FlipViewItem>
                <StackPanel Padding="8,4,8,4">
                    <FontIcon Glyph="&#xE73E;" Style="{StaticResource TourHero}" />
                    <TextBlock Text="You're all set" Style="{StaticResource TourTitle}" />
                    <TextBlock Style="{StaticResource TourLead}"
                               Text="Try it now: paste something into Step 1 and hit Generate PDF." />
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE713;" Style="{StaticResource TourGlyph}" />
                            <TextBlock TextWrapping="Wrap" Text="Every option lives in Settings (the gear, top-right)." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE897;" Style="{StaticResource TourGlyph}" />
                            <TextBlock TextWrapping="Wrap" Text="Replay this tour anytime from the tour button next to Settings." />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </FlipViewItem>
        </FlipView>

        <PipsPager x:Name="Pips" Grid.Row="1" HorizontalAlignment="Center"
                   NumberOfPages="7" SelectedPageIndex="{x:Bind Pages.SelectedIndex, Mode=TwoWay}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SkipButton" Grid.Column="0" Content="Skip" Click="OnSkip" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="BackButton" Content="Back" Click="OnBack" Visibility="Collapsed" />
                <Button x:Name="NextButton" Content="Next" Click="OnNext" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

<UserControl
    x:Class="MdToPdf.Views.WelcomeTour"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:MdToPdf.ViewModels">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#107C41" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#0E6E39" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0C5F31" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2EA043" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#2C9740" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#278C3A" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="TourGlyph" TargetType="FontIcon">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="Width" Value="26" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
            <Style x:Key="TourHero" TargetType="FontIcon">
                <Setter Property="FontSize" Value="40" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="TourTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,10,0,2" />
            </Style>
            <Style x:Key="TourLead" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.75" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
            <Style x:Key="TourFeatureText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Width="540" RowSpacing="14" Padding="0,0,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="340">
            <!-- Dynamic Content -->
            <StackPanel DataContext="{x:Bind ViewModel.CurrentPage, Mode=OneWay}" Padding="8,4,8,4">
                <FontIcon Glyph="{Binding HeroGlyph}" Style="{StaticResource TourHero}" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource TourTitle}" />
                <TextBlock Text="{Binding Lead}" Style="{StaticResource TourLead}" />
                
                <StackPanel Spacing="10">
                    <CheckBox IsChecked="{Binding ElementName=RootLayout, Path=ViewModel.LoadSampleRequested, Mode=TwoWay}" MaxWidth="500" HorizontalContentAlignment="Left" Visibility="{Binding IsFinalPage, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock TextWrapping="Wrap" Text="Load a sample document — headings, a table, math, and live diagrams, ready to restyle and export" />
                    </CheckBox>
                    <ItemsControl ItemsSource="{Binding Features}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:TourFeatureViewModel">
                                <Grid ColumnSpacing="12" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource TourGlyph}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource TourFeatureText}" Text="{x:Bind Text}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>

        <PipsPager Grid.Row="1" HorizontalAlignment="Center"
                   NumberOfPages="{x:Bind ViewModel.TotalPages}" 
                   SelectedPageIndex="{x:Bind ViewModel.CurrentIndex, Mode=TwoWay}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Skip" Command="{x:Bind ViewModel.SkipCommand}" MinWidth="88" Visibility="{x:Bind ViewModel.CanSkip, Mode=OneWay}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Back" Command="{x:Bind ViewModel.BackCommand}" Visibility="{x:Bind ViewModel.HasPrevious, Mode=OneWay}" MinWidth="88" />
                <Button Content="{x:Bind ViewModel.NextButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.NextCommand}" Style="{StaticResource AccentButtonStyle}" MinWidth="112" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

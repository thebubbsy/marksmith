<UserControl
    x:Class="MdToPdf.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:MdToPdf.ViewModels">

    <!-- Tabbed so each concern gets its own page and nothing needs to scroll; Plugins in
         particular is expected to grow, so it lives apart from the always-there basics. -->
    <Pivot MinWidth="500" MaxWidth="500" Height="480">

        <!-- ===== General ===== -->
        <PivotItem Header="General">
            <StackPanel Spacing="14" Margin="0,12,0,0">
                <Border Style="{StaticResource PipelineCardStyle}">
                    <Grid Padding="16,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Advanced mode" />
                            <TextBlock Text="Show power-user styling options in the Style panel — cleanup controls and formatting transforms."
                                       Style="{StaticResource StepCaptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind MainViewModel.AdvancedMode, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </PivotItem>

        <!-- ===== License ===== -->
        <PivotItem Header="License">
            <StackPanel Spacing="14" Margin="0,12,0,0">
                <Border Style="{StaticResource PipelineCardStyle}">
                    <StackPanel Padding="16" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE734;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind SettingsVM.EditionStatus, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="MarkSmith Pro unlocks DOCX export (with editable equations), hands-free automation, and removes the footer from your exports."
                                   Style="{StaticResource StepCaptionStyle}" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox PlaceholderText="Paste your license key" Width="290" IsSpellCheckEnabled="False" Text="{x:Bind SettingsVM.LicenseKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Activate" Command="{x:Bind SettingsVM.ActivateLicenseCommand}" IsEnabled="{x:Bind SettingsVM.IsActivating, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind SettingsVM.LicenseStatusMessage, Mode=OneWay}" Style="{StaticResource StepCaptionStyle}"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind SettingsVM.HasLicenseStatus, Mode=OneWay}" />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Command="{x:Bind SettingsVM.BuyProCommand}" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE719;" FontSize="14" />
                                    <TextBlock Text="Buy MarkSmith Pro" />
                                </StackPanel>
                            </Button>
                            <Button Content="Remove license" Command="{x:Bind SettingsVM.DeactivateLicenseCommand}" Visibility="{x:Bind SettingsVM.CanRemoveLicense, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </PivotItem>

        <!-- ===== Plugins ===== -->
        <PivotItem Header="Plugins">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Margin="0,12,10,0">
                    <TextBlock Text="Optional, separately-downloaded capabilities. Nothing here is bundled with MarkSmith — install only what you use."
                               Style="{StaticResource StepCaptionStyle}" TextWrapping="Wrap" />
                    
                    <ItemsControl ItemsSource="{x:Bind SettingsVM.Plugins, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:PluginViewModel">
                                <Border Style="{StaticResource PipelineCardStyle}" Padding="16,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Spacing="3" VerticalAlignment="Center" Grid.Column="0">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Description}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind CodeBlocks}" Opacity="0.55" FontSize="11" Visibility="{x:Bind HasCodeBlocks}" />
                                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="12,0,0,0" Grid.Column="1">
                                            <ProgressRing IsActive="{x:Bind IsInstalling, Mode=OneWay}" Width="18" Height="18" />
                                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="#2EA043" VerticalAlignment="Center" Visibility="{x:Bind ShowTick, Mode=OneWay}" />
                                            <Button Content="Install" Command="{x:Bind InstallCommand}" Visibility="{x:Bind CanInstall, Mode=OneWay}" />
                                            <Button Content="Remove" Command="{x:Bind RemoveCommand}" Visibility="{x:Bind CanRemove, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{x:Bind SettingsVM.PluginWarnings, Mode=OneWay}" Style="{StaticResource StepCaptionStyle}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind SettingsVM.HasPluginWarnings, Mode=OneWay}" />
                    <HyperlinkButton Content="Browse more plugins &amp; write your own"
                                     NavigateUri="https://github.com/thebubbsy/MarkSmith-plugins" Padding="0" />
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- ===== About ===== -->
        <PivotItem Header="About">
            <StackPanel Spacing="14" Margin="0,12,0,0">
                <Border Style="{StaticResource PipelineCardStyle}">
                    <StackPanel Padding="16" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Image Source="ms-appx:///Assets/logo.png" Width="44" Height="44" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="MarkSmith" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="{x:Bind SettingsVM.VersionText}" Style="{StaticResource StepCaptionStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Turn AI chats into polished documents." Opacity="0.8" />

                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button Command="{x:Bind SettingsVM.CheckForUpdatesCommand}" IsEnabled="{x:Bind SettingsVM.IsCheckingForUpdates, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE895;" FontSize="14" />
                                    <TextBlock Text="Check for updates" />
                                </StackPanel>
                            </Button>
                            <ProgressRing IsActive="{x:Bind SettingsVM.IsCheckingForUpdates, Mode=OneWay}" Width="18" Height="18" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind SettingsVM.UpdateStatusMessage, Mode=OneWay}" Style="{StaticResource StepCaptionStyle}"
                                   IsTextSelectionEnabled="True" TextWrapping="Wrap" Visibility="{x:Bind SettingsVM.HasUpdateStatus, Mode=OneWay}" />
                        <HyperlinkButton Content="Download the latest release" NavigateUri="{x:Bind SettingsVM.DownloadUrl, Mode=OneWay}"
                                         Visibility="{x:Bind SettingsVM.HasDownloadUrl, Mode=OneWay}" Padding="0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PipelineCardStyle}">
                    <StackPanel Padding="8,4">
                        <HyperlinkButton Content="GitHub repository" NavigateUri="https://github.com/thebubbsy/MarkSmith" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                        <HyperlinkButton Content="Releases &amp; changelog" NavigateUri="https://github.com/thebubbsy/MarkSmith/releases" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                        <HyperlinkButton Content="Report an issue" NavigateUri="https://github.com/thebubbsy/MarkSmith/issues" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                        <HyperlinkButton Content="License agreement (EULA)" NavigateUri="https://github.com/thebubbsy/MarkSmith/blob/main/LICENSE" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                        <HyperlinkButton Content="Third-party notices" NavigateUri="https://github.com/thebubbsy/MarkSmith/blob/main/THIRD-PARTY-NOTICES.md" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                    </StackPanel>
                </Border>

                <TextBlock Text="© 2026 thebubbsy · All rights reserved · Built with WinUI 3, .NET 8 and WebView2"
                           Style="{StaticResource StepCaptionStyle}" HorizontalAlignment="Center" />
            </StackPanel>
        </PivotItem>
    </Pivot>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Platform-agnostic engine: Markdown parsing, DOCX/PPTX/EPUB/PDF generation, ShapeForge,
         LaTeX->OMML, licensing, governance/DLP, settings. No WinUI/WebView2 types here — the
         WinUI app and the Avalonia app each provide a thin IWebRenderHost adapter and reference
         this project for everything else. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MdToPdf</RootNamespace>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ColorCode.Core" Version="2.0.15" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <!-- Cross-platform image decode/resize/encode, used to downscale oversized local images before
         they're inlined into the preview/export HTML (see MarkdownHtmlService.EmbedLocalImages).
         Avalonia already renders on SkiaSharp, so it's in the app's dependency graph regardless. -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <!-- SVG rasterizer (on top of SkiaSharp): renders a diagram plugin's SVG output to a PNG so it
         can be embedded into DOCX as the raster fallback beside the crisp SVG (see
         DocxExportService's plugin-diagram FencedCodeBlock case). -->
    <PackageReference Include="Svg.Skia" Version="2.0.0.5" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>MdToPdf.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>

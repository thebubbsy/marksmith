<Window
    x:Class="MarkSmith.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:MarkSmith.Services"
    xmlns:conv="using:MarkSmith.Converters"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:localcontrols="using:MarkSmith.Controls">

    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden"
          AllowDrop="True" DragOver="OnWindowDragOver" Drop="OnWindowDrop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control,Menu" Key="T" Invoked="OnToggleDebugModeInvoked" />
            <!-- HIDDEN developer/test command: Ctrl+Shift+Alt+L resets the license to Free (clears
                 any key AND any trial, including the used flag) so the free-vs-pro gates can be
                 exercised end-to-end. Deliberately undocumented in the UI. -->
            <KeyboardAccelerator Modifiers="Control,Shift,Menu" Key="L" Invoked="OnHiddenResetLicenseInvoked" />
            <!-- HIDDEN developer/test command: Ctrl+Shift+Alt+P toggles PRO dev mode — ON writes a
                 dev license key into the license file (full Pro, survives restarts); OFF deletes the
                 license file and drops straight back to Free. -->
            <KeyboardAccelerator Modifiers="Control,Shift,Menu" Key="P" Invoked="OnDevProToggleInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OnOpenFileAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="E" Invoked="OnGeneratePdfAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="D" Invoked="OnExportDocxAcceleratorInvoked" />
            <!-- Instant-export shortcuts (QODER task 8): Ctrl+Shift+E = DOCX, Ctrl+Shift+P = PDF
                 (PPTX moved to Ctrl+Shift+T to free Ctrl+Shift+P), Ctrl+Shift+M = Diagram Studio. -->
            <KeyboardAccelerator Modifiers="Control,Shift" Key="E" Invoked="OnExportDocxAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="P" Invoked="OnGeneratePdfAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="T" Invoked="OnExportPptxAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="M" Invoked="OnMermaidStudioAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="O" Invoked="OnEmailDraftAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="OnCommandPaletteInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnSaveDocumentAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFindAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="H" Invoked="OnReplaceAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="P" Invoked="OnPrintAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="D" Invoked="OnDuplicateLineAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Menu" Key="Up" Invoked="OnMoveLineUpAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Menu" Key="Down" Invoked="OnMoveLineDownAcceleratorInvoked" />
            <KeyboardAccelerator Key="F11" Invoked="OnFocusModeAcceleratorInvoked" />
            <!-- Portal focus-blur toggle (Looking Glass): Ctrl+Alt+X switches an open portal between
                 "focus with blur" (rendered preview behind the aperture blurs) and "focus without
                 blur" (sharp preview). -->
            <KeyboardAccelerator Modifiers="Control,Menu" Key="X" Invoked="OnTogglePortalBlurInvoked" />
            <KeyboardAccelerator Key="F1" Invoked="OnShortcutsCheatsheetInvoked" />
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <conv:StatusSeverityConverter x:Key="StatusSeverityConverter" />
            <conv:StatusSeverityToBrushConverter x:Key="StatusSeverityToBrushConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:BoolToInverseConverter x:Key="BoolToInverseConverter" />
            <conv:ThemeNameToSwatchConverter x:Key="ThemeNameToSwatchConverter" />
            <conv:LevelToIndentConverter x:Key="LevelToIndentConverter" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- Persistent status-bar row along the bottom of the window: the changing status
                 text sits bottom-left like a typical status bar, with the Ln/Col readout on the
                 right. Replaced the ISS-013 floating pill that overlapped the editor's bottom
                 buttons at the default launch size. -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Spacing="6">
            <!-- In-App Auto-Updater Banner -->
            <InfoBar x:Name="UpdateBanner" Margin="16,0,16,0"
                     IsOpen="{Binding IsUpdateAvailable, Mode=OneWay}"
                     IsClosable="True"
                     Title="Marksmith Update"
                     Message="{Binding UpdateStatusText, Mode=OneWay}"
                     Severity="Informational">
                <InfoBar.ActionButton>
                    <Button Content="Update &amp; Relaunch"
                            Command="{Binding DownloadAndApplyUpdateCommand}"
                            Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"
                            Style="{StaticResource AccentButtonStyle}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Relaunch Now" Command="{Binding RelaunchNowCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <ProgressBar Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Value="{Binding UpdateDownloadProgress}" Maximum="100" Margin="0,8,0,4" HorizontalAlignment="Stretch" />
                </InfoBar.Content>
            </InfoBar>

            <!-- Trial / upgrade banner (shown only when the trial is low or ended) -->
            <InfoBar x:Name="LicenseBanner" Margin="16,0,16,0" IsOpen="False" IsClosable="True">
                <InfoBar.ActionButton>
                    <Button x:Name="LicenseActionButton" Style="{ThemeResource AccentButtonStyle}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <!-- Shown once per session when a paste looks like plain text: the browser extension's
                 "Copy as Markdown" button would have kept the formatting. -->
            <localcontrols:ExtensionHintBar x:Name="ExtensionHintBar" Margin="16,0,16,0" />
        </StackPanel>

        <!-- Custom title bar so Mica shows through behind it; extended via Window.ExtendsContentIntoTitleBar in code-behind.
             Issue #6: the row is split — only the branding grid (AppTitleBar) is the drag region
             (SetTitleBar target), so the quick-action buttons in the right half stay clickable. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="AppTitleBar" Grid.Column="0" Padding="16,0,0,0" SizeChanged="OnAppTitleBarSizeChanged">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/logo.png" Width="26" Height="26" />
                    <TextBlock Text="MarkSmith" FontWeight="SemiBold"
                               Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                    <!-- The tagline steps aside (rather than being clipped mid-word against
                         "Export PDF") when the window is too narrow for it; see code-behind. -->
                    <TextBlock x:Name="TitleTaglineDot" Text="·" Opacity="0.4" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleTagline" Text="AI chats &#x2192; polished documents" Opacity="0.55"
                               Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- ISS-008: the tip jar now lives in the ⋯ menu next to Settings (the title-bar button
                     overlapped the system caption buttons at narrow widths). -->
            </Grid>

            <!-- Issue #6: primary quick actions surfaced in the title bar's empty right half.
                 Right margin clears the system caption buttons (min/max/close overlay). -->
            <StackPanel x:Name="TitleBarActions" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center" Margin="0,0,150,0">
                <!-- The command palette's visible entry point: it used to be reachable only by
                     Ctrl+K, which nothing on screen mentioned. The "Search" label steps aside when
                     the title bar is tight (OnAppTitleBarSizeChanged). -->
                <Button x:Name="CommandPaletteButton" Height="30" Padding="8,0,6,0"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="6" Click="OnCommandPaletteClick"
                        AutomationProperties.Name="Command palette"
                        ToolTipService.ToolTip="Search every command, theme and recent file (Ctrl+K)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="12" />
                        <TextBlock x:Name="CommandPaletteLabel" Text="Search commands" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="3" Padding="5,0,5,1">
                            <TextBlock Text="Ctrl+K" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </Button>
                <Border Width="1" Height="16" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />
                <Button Height="30" Padding="8,0" Background="Transparent" BorderThickness="0"
                        Click="OnConvertPdfClick" IsEnabled="{Binding IsNotBusy}"
                        ToolTipService.ToolTip="Export as PDF (.pdf)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE749;" FontSize="12" />
                        <TextBlock Text="Export PDF" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Height="30" Padding="8,0" Background="Transparent" BorderThickness="0"
                        Click="OnConvertDocxClick" IsEnabled="{Binding IsNotBusy}"
                        ToolTipService.ToolTip="Export as Word (.docx)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="12" />
                        <TextBlock Text="Export Word" FontSize="12" />
                        <!-- Same PRO pill as the Branding section; only while the license can't export Word. -->
                        <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="4" Padding="4,0"
                                VerticalAlignment="Center" Visibility="{Binding ShowProBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                </Button>
                <Button Height="30" Padding="8,0" Background="Transparent" BorderThickness="0"
                        Click="OnImportDocumentClick" IsEnabled="{Binding IsNotBusy}"
                        ToolTipService.ToolTip="Import a Word, PDF, HTML or email (.eml, .msg) file as a new Markdown document">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B5;" FontSize="12" />
                        <TextBlock Text="Import" FontSize="12" />
                    </StackPanel>
                </Button>
                <Border Width="1" Height="16" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />
                <Button Height="30" Padding="8,0" Background="Transparent" BorderThickness="0"
                        Click="OnOpenMermaidStudioClick"
                        ToolTipService.ToolTip="Open Diagram Studio (Ctrl+Shift+M)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE943;" FontSize="12" />
                        <TextBlock Text="Diagram Studio" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="SuiteHubButton" Height="30" Padding="8,0" Background="Transparent" BorderThickness="0"
                        Click="OnSuiteHubClick"
                        ToolTipService.ToolTip="Open Suite Hub: the studios, browser extension, AI server and command line in one place">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xECA5;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="Suite Hub" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Button Height="30" Width="34" Padding="0" Background="Transparent" BorderThickness="0"
                        Click="OnSettingsClick"
                        ToolTipService.ToolTip="Settings (Ctrl+,)">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
                <Border Width="1" Height="16" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />
                <!-- Focus mode moved up from the centre pane header (declutter): it's a window-level
                     action, and the title bar stays visible even while the side panels are hidden. -->
                <ToggleButton x:Name="FocusModeToggle" Height="30" Width="34" Padding="0"
                              Background="Transparent" BorderThickness="0"
                              ToolTipService.ToolTip="Focus mode — hide the side panels (F11)"
                              Checked="OnFocusModeToggled" Unchecked="OnFocusModeToggled">
                    <FontIcon Glyph="&#xE740;" FontSize="14" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Left-to-right pipeline: 1 Source -> 2 Style -> 3 Preview & Export -->
        
        <!-- 3-Pane Looking Glass Layout -->
        <Grid x:Name="MainLayoutGrid" Grid.Row="2" Padding="16,6,16,16" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaneCol" Width="320" MinWidth="0" /> <!-- Left: Source/Files (auto-collapses to a 28px hover tab after a document is picked) -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="400" /> <!-- Center: Looking Glass (Editor/Preview) -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightPaneCol" Width="380" MinWidth="290" /> <!-- Right: Style/Export -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE (auto-collapsing drawer): after a document is selected the pane
                 collapses to a slim tab; hovering the tab re-expands it while the mouse is on it,
                 and it tucks away again the moment the pointer leaves. -->
            <Grid Grid.Column="0">
            <Grid x:Name="LeftPane" RowSpacing="10" PointerExited="OnLeftPanePointerExited" PointerEntered="OnLeftPanePointerEntered" LostFocus="OnLeftPaneLostFocus">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                    <Border Style="{StaticResource StepBadgeStyle}">
                        <TextBlock Text="1" Style="{StaticResource StepBadgeTextStyle}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Source" Style="{StaticResource StepTitleStyle}" />
                        <TextBlock Text="Pick a file or paste Markdown" Style="{StaticResource StepCaptionStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- One-time tip: the browser extension lets users send AI chats here in one click. -->
                <localcontrols:ExtensionTip Grid.Row="1" x:Name="ExtensionTip" 
                                            Closed="OnExtensionTipClosed" />

                <Border Grid.Row="2" Style="{StaticResource PipelineCardStyle}"
                        AllowDrop="True" DragOver="OnSourceDragOver" Drop="OnSourceDrop">
                    <ScrollViewer x:Name="SourceScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                    <Grid Padding="14" RowSpacing="12"
                          MinHeight="{Binding ViewportHeight, ElementName=SourceScroll}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <SelectorBar x:Name="SourceSelector" Grid.Row="0" SelectionChanged="OnSourceSelectorChanged">
                            <SelectorBarItem x:Name="FileTab" Text="File">
                                <SelectorBarItem.Icon>
                                    <FontIcon Glyph="&#xE8A5;" />
                                </SelectorBarItem.Icon>
                            </SelectorBarItem>
                            
                        </SelectorBar>

                        <!-- File mode -->
                        <StackPanel x:Name="FilePanel" Grid.Row="1" Spacing="12">
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16,24">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE896;" FontSize="26" Opacity="0.6" HorizontalAlignment="Center" />
                                    <TextBlock Text="Drop a document here" HorizontalAlignment="Center" Opacity="0.75" />
                                    <TextBlock Text="Markdown, Word, PDF, HTML or email (.eml, .msg)" HorizontalAlignment="Center"
                                               Opacity="0.55" TextAlignment="Center" TextWrapping="WrapWholeWords"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="or" HorizontalAlignment="Center" Opacity="0.4"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                    <Button Content="Browse files" Click="OnBrowseFileClick" HorizontalAlignment="Center"
                                            ToolTipService.ToolTip="Open Markdown, or a Word, PDF, HTML or email file as Markdown (Ctrl+O)" />
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="Selected file" Text="{Binding InputFilePath, Mode=TwoWay}"
                                         PlaceholderText="No file selected" IsSpellCheckEnabled="False" />
                                <Button Grid.Column="2" VerticalAlignment="Bottom" Click="OnOpenHistoryClick" Padding="10,4"
                                        AutomationProperties.Name="Version history"
                                        ToolTipService.ToolTip="Version history: every saved version of this file (and of unsaved text), with what changed in each">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE823;" FontSize="14" />
                                        <TextBlock Text="History" FontSize="13" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnTogglePinFileClick"
                                        ToolTipService.ToolTip="Pin/unpin this file to the top of the file list">
                                    <Grid>
                                        <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  Visibility="{Binding IsCurrentFilePinned, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <FontIcon Glyph="&#xE734;" FontSize="14"
                                                  Visibility="{Binding IsCurrentFilePinned, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                    </Grid>
                                </Button>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Recent &amp; found .md files" VerticalAlignment="Bottom"
                                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8" />
                                <HyperlinkButton x:Name="RescanButton" Grid.Column="1" Click="OnRescanMarkdownClick" Padding="4,0"
                                                 ToolTipService.ToolTip="Rescan your PC for recent Markdown files">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                        <TextBlock Text="Rescan" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </HyperlinkButton>
                            </Grid>
                            <ComboBox x:Name="MarkdownFilesCombo" ItemsSource="{Binding MarkdownFiles}"
                                      SelectionChanged="OnMarkdownFileSelected" Margin="0,-8,0,0"
                                      ToolTipService.ToolTip="Recent and discovered Markdown files on this PC"
                                      AutomationProperties.Name="Recent and found Markdown files" PlaceholderText="Pick a Markdown file from your PC…" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="0,2">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Opacity="0.6"
                                                       Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="ScanningLabel" Text="Scanning your files…" Opacity="0.6" Margin="2,-6,0,0"
                                       Style="{StaticResource CaptionTextBlockStyle}" Visibility="Collapsed" />
                        </StackPanel>

                        

                        <!-- Automated ingest: clipboard watcher, watched folder, local REST API -->
                        <Expander x:Name="AutomationExpander" Grid.Row="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE945;" FontSize="14" />
                                    <TextBlock Text="Automation" FontWeight="SemiBold" />
                                    <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="4" Padding="5,1"
                                            VerticalAlignment="Center" Visibility="{Binding ShowProBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </Expander.Header>
                            <!-- Same rhythm as Style & Export: OptionRows under short section labels. It was three
                                 nested boxes of stacked "Header / switch / Watching / caption" blocks, and every
                                 label said PDF while the exports actually follow the default format. -->
                            <StackPanel Spacing="12">
                                <TextBlock Text="{Binding AutomationFormatNote}" Style="{StaticResource StepCaptionStyle}" />

                                <TextBlock Text="AI chats" Style="{StaticResource OptionSectionStyle}" />
                                <localcontrols:OptionRow Header="Watch the clipboard"
                                                         Description="Copy a reply in ChatGPT, Gemini or Claude and it lands here, detected and cleaned.">
                                    <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding AutoClipboardIngest, Mode=TwoWay}" />
                                </localcontrols:OptionRow>
                                <localcontrols:OptionRow Header="Export every ingest"
                                                         Description="Each chat that arrives (clipboard, API or the browser extension) is exported straight away.">
                                    <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding AutoConvertIngests, Mode=TwoWay}" />
                                </localcontrols:OptionRow>
                                <localcontrols:OptionRow Header="Append to a running document"
                                                         Description="When the default format is Word, add each export as a dated section of one growing .docx instead of a new file.">
                                    <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding AppendToRunningDoc, Mode=TwoWay}" />
                                    <localcontrols:OptionRow.Details>
                                        <Grid ColumnSpacing="8" Visibility="{Binding AppendToRunningDoc, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding RunningDocPath, Mode=TwoWay}"
                                                     AutomationProperties.Name="Running document file"
                                                     PlaceholderText="e.g. C:\Docs\AI-notebook.docx" IsSpellCheckEnabled="False" />
                                            <Button Grid.Column="1" VerticalAlignment="Stretch" Click="OnBrowseRunningDocClick"
                                                    ToolTipService.ToolTip="Choose the running .docx document"
                                                    AutomationProperties.Name="Choose the running document">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                            </Button>
                                        </Grid>
                                    </localcontrols:OptionRow.Details>
                                </localcontrols:OptionRow>

                                <TextBlock Text="Folders" Style="{StaticResource OptionSectionStyle}" />
                                <localcontrols:OptionRow Header="Watch a folder"
                                                         Description="New Markdown and text files saved to the folder are picked up as they appear. A file open in the editor is left to you.">
                                    <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding WatchFolderEnabled, Mode=TwoWay}" />
                                    <localcontrols:OptionRow.Details>
                                        <StackPanel Spacing="8">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding WatchFolder, Mode=TwoWay}"
                                                         AutomationProperties.Name="Watched folder"
                                                         PlaceholderText="e.g. your Downloads folder" IsSpellCheckEnabled="False" />
                                                <Button Grid.Column="1" VerticalAlignment="Stretch" Click="OnBrowseWatchFolderClick"
                                                        ToolTipService.ToolTip="Choose the folder to watch"
                                                        AutomationProperties.Name="Choose the folder to watch">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                                </Button>
                                            </Grid>
                                            <!-- ISS-011: one-click presets for the folders local AI agents
                                                 (Gemini CLI, Ollama, Claude Desktop, …) export to. -->
                                            <ComboBox x:Name="WatchFolderPresets" HorizontalAlignment="Stretch"
                                                      PlaceholderText="Quick pick an AI agent folder…"
                                                      AutomationProperties.Name="AI agent folder presets"
                                                      ToolTipService.ToolTip="Pre-configured export folders for local AI agents and CLIs"
                                                      SelectionChanged="OnWatchFolderPresetSelected">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Spacing="1">
                                                            <TextBlock Text="{Binding Name}" />
                                                            <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionTextBlockStyle}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </localcontrols:OptionRow.Details>
                                </localcontrols:OptionRow>
                                <!-- Only meaningful while the folder is being watched. -->
                                <localcontrols:OptionRow Header="Export watched files"
                                                         Description="Hands-free: each new file is exported to your output folder, with a notification when it's done. Off: files are only opened here."
                                                         IsEnabled="{Binding WatchFolderEnabled}">
                                    <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding WatchFolderAutoConvert, Mode=TwoWay}" />
                                </localcontrols:OptionRow>
                                <localcontrols:OptionRow Header="Batch convert"
                                                         Description="Pick a folder: every document inside (Markdown, text, Word, web pages, emails) is cleaned up and exported to your output folder.">
                                    <localcontrols:OptionRow.Details>
                                        <Button Click="OnBatchConvertClick" HorizontalAlignment="Stretch"
                                                ToolTipService.ToolTip="Pick a folder and export every document inside it">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                                <TextBlock Text="Convert a folder…" />
                                            </StackPanel>
                                        </Button>
                                    </localcontrols:OptionRow.Details>
                                </localcontrols:OptionRow>

                                <TextBlock Text="Background" Style="{StaticResource OptionSectionStyle}" />
                                <localcontrols:OptionRow Header="Local REST API"
                                                         Description="For your own scripts and the browser extension. Port and pairing are in Settings ▸ Automation.">
                                    <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding ApiEnabled, Mode=TwoWay}" />
                                    <localcontrols:OptionRow.Details>
                                        <Grid>
                                            <TextBlock Text="{Binding ApiStatusText}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                       Visibility="{Binding ApiStatusIsError, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                            <TextBlock Text="{Binding ApiStatusText}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                       Visibility="{Binding ApiStatusIsError, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                    </localcontrols:OptionRow.Details>
                                </localcontrols:OptionRow>
                                <localcontrols:OptionRow Header="Keep running in the tray"
                                                         Description="Closing the window hides MarkSmith to the notification area, so the watchers and API keep working.">
                                    <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding MinimizeToTray, Mode=TwoWay}" />
                                </localcontrols:OptionRow>
                            </StackPanel>
                        </Expander>
                    </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Drawer tab: only visible while the pane is tucked away. Hovering opens the pane
                 after a short dwell; click, Enter/Space or a screen reader's Invoke open it at once
                 (from the keyboard, focus moves into the pane). A real button so it is reachable
                 without a mouse. -->
            <Button x:Name="LeftDrawerTab" Grid.Column="0" Width="28" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Visibility="Collapsed" Padding="0" CornerRadius="0" Tag="NoHoverPolish"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="OnLeftDrawerTabClick"
                    PointerEntered="OnLeftDrawerTabPointerEntered" PointerExited="OnLeftDrawerTabPointerExited"
                    AutomationProperties.Name="Show the Source panel"
                    ToolTipService.ToolTip="Source — open a file, paste, or switch documents">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    <!-- "Source" written up the tab, like a book spine -->
                    <!-- A Canvas, not a Grid: a Grid clips the unrotated 52 px text to its 16 px slot -->
                    <Canvas Width="16" Height="52" HorizontalAlignment="Center">
                        <TextBlock Text="Source" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Width="52" Height="16" Canvas.Left="-18" Canvas.Top="18" TextAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="90" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>
                </StackPanel>
            </Button>
            </Grid>

            <controls:GridSplitter x:Name="LeftSplitter" AutomationProperties.Name="Resize the Source pane" Grid.Column="1" Width="16" Background="Transparent" ResizeBehavior="BasedOnAlignment" ResizeDirection="Auto"
                                   ToolTipService.ToolTip="Drag to resize the Source pane" />

            <!-- CENTER PANE: LOOKING Glass -->
            
            <Grid Grid.Column="2" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Two columns, not one shared cell: when the side panes leave the centre narrow,
                     the title trims with an ellipsis instead of sliding under the toggles. -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border Style="{StaticResource StepBadgeStyle}">
                            <TextBlock Text="2" Style="{StaticResource StepBadgeTextStyle}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Editor / Preview" Style="{StaticResource StepTitleStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="EditorStepCaption" Text="Write and edit the Markdown" Style="{StaticResource StepCaptionStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    
                    <!-- Decluttered header: Copy HTML / Print moved to the pane's bottom bar, the
                         portal shape + size dials moved to the portal bar (shown while portal mode
                         is on), focus mode moved to the title bar, and the detected-source badge
                         moved to the status bar. Only the portal toggle + view switcher remain, so
                         this row can no longer overflow into the step title on the left at the
                         default 1220×800 launch size. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ToggleButton x:Name="LookingGlassToggle" ToolTipService.ToolTip="Looking Glass portal mode — click the preview to reveal the editable Markdown behind it"
                                      Height="32" Width="32" Padding="0" VerticalAlignment="Center"
                                      Checked="OnLookingGlassToggled" Unchecked="OnLookingGlassToggled">
                            <FontIcon Glyph="&#xE7B3;" FontSize="13" />
                        </ToggleButton>
                        <!-- Preview as email: the preview shows the Outlook draft (header, recipients,
                             email-safe body) instead of the themed page. -->
                        <ToggleButton x:Name="EmailPreviewToggle" Height="32" Width="32" Padding="0" VerticalAlignment="Center"
                                      AutomationProperties.Name="Preview as email"
                                      ToolTipService.ToolTip="Preview as email: see the document exactly as the Outlook draft will show it"
                                      IsChecked="{Binding PreviewAsEmail, Mode=TwoWay}"
                                      Checked="OnEmailPreviewToggled" Unchecked="OnEmailPreviewToggled">
                            <FontIcon Glyph="&#xE715;" FontSize="13" />
                        </ToggleButton>
                        <SelectorBar x:Name="CenterViewSelector" SelectionChanged="OnCenterViewSelectorChanged">
                            <SelectorBarItem x:Name="ViewCodeTab" Text="Code" IsSelected="True"
                                             ToolTipService.ToolTip="Markdown editor only" />
                            <SelectorBarItem x:Name="ViewSplitTab" Text="Split"
                                             ToolTipService.ToolTip="Editor and live preview side by side" />
                            <SelectorBarItem x:Name="ViewPreviewTab" Text="Preview"
                                             ToolTipService.ToolTip="Rendered preview only" />
                        </SelectorBar>
                    </StackPanel>
                </Grid>


                <Grid Grid.Row="2" x:Name="LookingGlassGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SplitLeftCol" Width="*" />
                            <ColumnDefinition x:Name="SplitMidCol" Width="Auto" />
                            <ColumnDefinition x:Name="SplitRightCol" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="PastePanel" Grid.Column="0" RowSpacing="8" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Find & replace bar (Ctrl+F / Ctrl+H): search and replace in the Markdown source.
                                 Ctrl+F opens the find row only; Ctrl+H, or the chevron, adds the replace row. -->
                            <Border x:Name="FindBar" Grid.Row="0" Visibility="Collapsed"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="6,6,8,6"
                                    SizeChanged="OnFindBarSizeChanged">
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="ReplaceExpandToggle" Width="26" Height="30" Padding="0"
                                                  VerticalAlignment="Top" Background="Transparent" BorderThickness="0"
                                                  AutomationProperties.Name="Show replace"
                                                  ToolTipService.ToolTip="Show replace (Ctrl+H)"
                                                  Checked="OnReplaceExpandToggled" Unchecked="OnReplaceExpandToggled">
                                        <FontIcon x:Name="ReplaceExpandGlyph" Glyph="&#xE76C;" FontSize="11" />
                                    </ToggleButton>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="FindTextBox" Grid.Column="0" PlaceholderText="Find in document…"
                                                     AutomationProperties.Name="Find in document"
                                                     Height="30" FontSize="13" KeyDown="OnFindTextBoxKeyDown"
                                                     TextChanged="OnFindTextChanged" />
                                            <TextBlock x:Name="FindCountText" Grid.Column="1" VerticalAlignment="Center"
                                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       MinWidth="64" TextAlignment="Center" />
                                            <ToggleButton x:Name="MatchCaseCheck" Grid.Column="2" Width="32" Height="30" Padding="0"
                                                          AutomationProperties.Name="Match case"
                                                          ToolTipService.ToolTip="Match case"
                                                          Checked="OnMatchCaseChanged" Unchecked="OnMatchCaseChanged">
                                                <TextBlock Text="Aa" FontSize="12" FontWeight="SemiBold" />
                                            </ToggleButton>
                                            <Button x:Name="FindPrevButton" Grid.Column="3" Width="32" Height="30" Padding="0" Click="OnFindPrevClick"
                                                    AutomationProperties.Name="Previous match"
                                                    ToolTipService.ToolTip="Previous match (Shift+Enter)">
                                                <FontIcon Glyph="&#xE70E;" FontSize="12" />
                                            </Button>
                                            <Button x:Name="FindNextButton" Grid.Column="4" Width="32" Height="30" Padding="0" Click="OnFindNextClick"
                                                    AutomationProperties.Name="Next match"
                                                    ToolTipService.ToolTip="Next match (Enter)">
                                                <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                            </Button>
                                            <Button Grid.Column="5" Width="32" Height="30" Padding="0" Click="OnFindCloseClick"
                                                    AutomationProperties.Name="Close find"
                                                    ToolTipService.ToolTip="Close (Esc)">
                                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                                            </Button>
                                        </Grid>
                                        <Grid x:Name="ReplaceRow" ColumnSpacing="6" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ReplaceTextBox" Grid.Column="0" PlaceholderText="Replace with…"
                                                     AutomationProperties.Name="Replace with"
                                                     Height="30" FontSize="13" KeyDown="OnReplaceTextBoxKeyDown" />
                                            <Button x:Name="ReplaceOneButton" Grid.Column="1" Height="30" Padding="12,0" Click="OnReplaceClick"
                                                    ToolTipService.ToolTip="Replace this match and go to the next one (Enter)">
                                                <TextBlock Text="Replace" FontSize="12" />
                                            </Button>
                                            <Button x:Name="ReplaceAllButton" Grid.Column="2" Height="30" Padding="12,0" Click="OnReplaceAllClick"
                                                    ToolTipService.ToolTip="Replace every match (one undo step)">
                                                <TextBlock Text="Replace all" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="LineGutterCol" Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Line-number gutter. Each number is placed at its line's real position in
                                     the editor (GetRectFromCharacterIndex), so a wrapped line takes as much
                                     height as it does in the text and the numbers stay level with it; the
                                     caret's line is drawn at full strength. Only visible lines are drawn. -->
                                <Border x:Name="LineGutter" Grid.Column="0" Visibility="Collapsed"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1,1,0,1" CornerRadius="4,0,0,4"
                                        AutomationProperties.AccessibilityView="Raw">
                                    <Canvas x:Name="LineNumberCanvas" Width="30" SizeChanged="OnLineGutterSizeChanged" />
                                </Border>

                                <!-- No Text binding: the editor shows a view of the document (folded
                                     regions are one line), so MainWindow syncs it by hand and the
                                     view model always holds every line. See SyncDocumentFromEditor. -->
                                <TextBox x:Name="PasteTextBox" Grid.Column="1" MinHeight="180"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         FontFamily="Cascadia Mono, Consolas, monospace" FontSize="13"
                                         PlaceholderText="Paste or type Markdown here…"
                                         VerticalContentAlignment="Top" IsSpellCheckEnabled="False"
                                         AllowDrop="True" DragOver="OnEditorDragOver" Drop="OnEditorDrop"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <!-- Native TextBox undo is in-memory only and dies on restart, so
                                         the app owns a persistent undo stack (MainViewModel.UndoStep).
                                         These accelerators, scoped to the editor, shadow the native
                                         undo (Handled=true), exactly like the Mermaid studio's: Ctrl+Z /
                                         Ctrl+Y / Ctrl+Shift+Z. Other TextBoxes keep their own undo. -->
                                    <TextBox.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoAcceleratorInvoked" />
                                        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="OnRedoAcceleratorInvoked" />
                                        <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" Invoked="OnRedoAcceleratorInvoked" />
                                        <!-- Formatting keys: editor-scoped so Ctrl+B in the find box or a
                                             dialog does nothing. Listed in Core's KeyboardShortcuts (a
                                             test holds this block and that list to each other). -->
                                        <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="OnFormatAcceleratorInvoked" />
                                        <KeyboardAccelerator Key="I" Modifiers="Control" Invoked="OnFormatAcceleratorInvoked" />
                                        <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnFormatAcceleratorInvoked" />
                                        <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnFormatAcceleratorInvoked" />
                                        <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnFormatAcceleratorInvoked" />
                                        <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="OnFormatAcceleratorInvoked" />
                                    </TextBox.KeyboardAccelerators>
                                </TextBox>
                            </Grid>
                            
                            <!-- Two real columns (tools | lint chip) instead of two panels stacked in one
                                 cell: at the default 1220px window the editor is ~400px wide and the
                                 old overlay drew "Wrap", "No issues", "Fold" and the word count on top of
                                 each other. The word count now lives in the status bar beside Ln/Col, and
                                 the lint chip drops its label when the strip is tight (code-behind). -->
                            <Grid Grid.Row="2" x:Name="EditorStrip" ColumnSpacing="8" SizeChanged="OnEditorStripSizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Editor font-size zoom (persisted): A− / A+ buttons plus Ctrl+wheel in the
                                     editor. The % readout is relative to the 13px default. -->
                                <StackPanel x:Name="EditorStripTools" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <!-- Find used to be reachable only by Ctrl+F / Ctrl+H. -->
                                    <Button x:Name="EditorFindButton" Width="28" Height="24" Padding="0" Click="OnEditorFindClick"
                                            AutomationProperties.Name="Find and replace"
                                            ToolTipService.ToolTip="Find (Ctrl+F) · Find and replace (Ctrl+H)">
                                        <FontIcon Glyph="&#xE721;" FontSize="12" />
                                    </Button>
                                    <Border Width="1" Height="14" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />
                                    <Button x:Name="EditorZoomOutButton" ToolTipService.ToolTip="Decrease editor font size (Ctrl+wheel down)" AutomationProperties.Name="Decrease editor font size" Width="28" Height="24" Padding="0" Click="OnEditorZoomOutClick">
                                        <TextBlock Text="A&#x2212;" FontSize="12" />
                                    </Button>
                                    <TextBlock x:Name="EditorZoomText" Text="100%" VerticalAlignment="Center" FontSize="11"
                                               Opacity="0.6" MinWidth="42" TextAlignment="Center"
                                               ToolTipService.ToolTip="Editor font size" />
                                    <Button x:Name="EditorZoomInButton" ToolTipService.ToolTip="Increase editor font size (Ctrl+wheel up)" AutomationProperties.Name="Increase editor font size" Width="28" Height="24" Padding="0" Click="OnEditorZoomInClick">
                                        <TextBlock Text="A+" FontSize="12" />
                                    </Button>
                                    <Border Width="1" Height="14" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />
                                    <ToggleButton x:Name="LineNumbersToggle" ToolTipService.ToolTip="Show line numbers"
                                                  Height="24" Padding="6,0" Checked="OnLineNumbersToggled" Unchecked="OnLineNumbersToggled">
                                        <TextBlock Text="Lines" FontSize="11" />
                                    </ToggleButton>
                                    <Border Width="1" Height="14" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />
                                    <ToggleButton x:Name="WordWrapToggle" ToolTipService.ToolTip="Wrap long lines"
                                                  Height="24" Padding="6,0" Checked="OnWordWrapToggled" Unchecked="OnWordWrapToggled">
                                        <TextBlock Text="Wrap" FontSize="11" />
                                    </ToggleButton>
                                    <Border Width="1" Height="14" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />
                                    <DropDownButton ToolTipService.ToolTip="Fold code blocks and sections" AutomationProperties.Name="Folding" Height="24" Padding="6,0">
                                        <!-- Text-only like Lines / Wrap beside it: the old leading chevron
                                             doubled up with the dropdown's own chevron. -->
                                        <TextBlock x:Name="FoldStatusText" Text="Fold" FontSize="11" VerticalAlignment="Center" />
                                        <DropDownButton.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Fold or unfold at the cursor" Click="OnToggleFoldAtCursorClick">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70D;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Fold all code blocks" Click="OnFoldAllCodeClick">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE943;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem x:Name="FoldMenuUnfoldAll" Text="Unfold everything" Click="OnUnfoldAllClick" IsEnabled="False">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70E;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Markdown lint: live issue count; the flyout lists issues and jumps to them. -->
                                    <Button x:Name="LintButton" Height="24" Padding="6,0"
                                            AutomationProperties.Name="Markdown issues"
                                            ToolTipService.ToolTip="Markdown issues — click to review and jump">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon x:Name="LintIcon" Glyph="&#xE73E;" FontSize="12" />
                                            <TextBlock x:Name="LintCountText" Text="No issues" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout x:Name="LintFlyout" Placement="Top">
                                                <Grid Width="340" RowSpacing="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="Markdown issues" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="LintEmptyText" Grid.Row="1" TextWrapping="Wrap" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Text="Nothing to fix. MarkSmith checks for stray spaces and tabs, images without alt text, headings missing a space after #, long pasted lines and code blocks that never close, as you type." />
                                                    <ListView x:Name="LintList" Grid.Row="1" MaxHeight="300" SelectionMode="None"
                                                              IsItemClickEnabled="True" ItemClick="OnLintItemClick">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,2">
                                                                    <TextBlock Text="{Binding LineLabel}" FontSize="12"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" MinWidth="52" />
                                                                    <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </Grid>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <controls:GridSplitter x:Name="SplitViewSplitter" AutomationProperties.Name="Resize the editor and preview" Grid.Column="1" Width="16" Visibility="Collapsed"
                                               Background="Transparent" ResizeBehavior="BasedOnAlignment" ResizeDirection="Auto"
                                               ToolTipService.ToolTip="Drag to resize the editor / preview split" />
                        <Grid Grid.Column="2" x:Name="PreviewColumn" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Mirrors the editor column's FindBar height so the preview box stays
                                 aligned with the editor when Ctrl+F opens (synced in code-behind). -->
                            <Grid Grid.Row="0" Height="0" x:Name="PreviewFindBarSpacer" />
                            <Border x:Name="PreviewCard" Grid.Row="1" Style="{StaticResource PipelineCardStyle}">
                                <Grid>
                                    <WebView2 x:Name="PreviewWebView" Margin="1" />

                                    <!-- Live-preview loading spinner: the logo, animated in code-behind. Shown on
                                         every refresh with a minimum visible time so quick renders read as a smooth
                                         animation, not a white flash. Two styles, alternating each time (not random):
                                         (0) the logo spinning about its centre, (1) the upright logo tracing a
                                         figure-eight. -->
                                    <Grid x:Name="PreviewSpinner" Visibility="Collapsed"
                                          Background="{ThemeResource LayerFillColorDefaultBrush}" Opacity="0.08">
                                        <Image x:Name="SpinnerLogo" Source="ms-appx:///Assets/logo.png"
                                               Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform>
                                                <CompositeTransform x:Name="SpinnerLogoTransform" />
                                            </Image.RenderTransform>
                                        </Image>
                                    </Grid>
                                </Grid>
                            </Border>
                            <!-- Width ruler + preview zoom now sit in their OWN layout row below the
                                 card — real space, never overlaying the WebView (the old bottom-aligned
                                 overlay is gone, so the preview box and the editor box end on the same
                                 line). -->
                            <Grid Grid.Row="2" x:Name="PreviewWidthContainer" Visibility="Collapsed">
                                <!-- Ruler and zoom in separate columns: when they shared one cell, the centred
                                     "188 px" label ran into the zoom buttons in Split view. -->
                                <Grid Height="24" Margin="2,0,2,2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid ToolTipService.ToolTip="Width of the live preview">
                                        <Rectangle Height="1" VerticalAlignment="Center"
                                                   Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.35" />
                                        <Rectangle Width="1" Height="7" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.55" />
                                        <Rectangle Width="1" Height="7" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.55" />
                                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="4" Padding="8,0"
                                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                                            <TextBlock x:Name="PreviewWidthText" Text="— px" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                    <!-- Preview zoom (persisted): the WebView also honors the browser's native Ctrl+wheel;
                                         the readout stays in sync via a light poll in code-behind. -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <ToggleButton x:Name="PreviewFitToggle" Width="24" Height="22" Padding="0"
                                                      ToolTipService.ToolTip="Fit page width — the page fills the preview and follows it as you resize (zooming turns this off)"
                                                      AutomationProperties.Name="Fit page width"
                                                      Click="OnPreviewFitClick">
                                            <FontIcon Glyph="&#xE9A6;" FontSize="11" />
                                        </ToggleButton>
                                        <Button x:Name="PreviewZoomOutButton" ToolTipService.ToolTip="Zoom preview out" AutomationProperties.Name="Zoom preview out"
                                                Width="24" Height="22" Padding="0" Click="OnPreviewZoomOutClick">
                                            <FontIcon Glyph="&#xE738;" FontSize="11" />
                                        </Button>
                                        <!-- The readout is also the reset: click it for 100%. Borderless so it
                                             still reads as a label; the hover fill shows it's clickable. -->
                                        <Button x:Name="PreviewZoomResetButton" Height="22" MinWidth="44" Padding="4,0"
                                                Background="Transparent" BorderThickness="0"
                                                ToolTipService.ToolTip="Preview zoom. Click for 100%; Ctrl+wheel zooms."
                                                AutomationProperties.Name="Reset preview zoom to 100%"
                                                Click="OnPreviewZoomResetClick">
                                            <TextBlock x:Name="PreviewZoomText" Text="100%" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                                        </Button>
                                        <Button x:Name="PreviewZoomInButton" ToolTipService.ToolTip="Zoom preview in" AutomationProperties.Name="Zoom preview in"
                                                Width="24" Height="22" Padding="0" Click="OnPreviewZoomInClick">
                                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>

                </Grid>

                <!-- Centre pane bottom bar: Copy HTML / Print stay one click away in every mode,
                     the editing clusters show whenever the editor is visible or portal mode turns
                     the preview into an editor, and the portal shape + size dials live on their
                     own row while portal mode is on (visibility managed from code-behind). Hosting
                     the clusters here — instead of inside the editor pane — is what lets portal
                     mode reuse them: the preview shrinks vertically to make room, the same way a
                     writing app's formatting bar claims its strip. -->
                <Grid x:Name="CenterBottomBar" Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ISS-004: portal shape + size — only relevant while portal mode is on, so the
                         dials moved out of the always-visible header down to this portal-only row.
                         Shape: circle spotlight, focus bands, square, or logo cutout; the slider
                         scales the active shape live on every tick. -->
                    <!-- ISS-004: portal shape + size + glass/surround blur controls -->
                    <StackPanel x:Name="PortalControlsRow" Grid.Row="0" Orientation="Horizontal" Spacing="6"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,6"
                                Visibility="Collapsed">
                        <FontIcon Glyph="&#xE7B3;" FontSize="13" VerticalAlignment="Center" Opacity="0.7"
                                  ToolTipService.ToolTip="Looking Glass portal dials" />
                        <ComboBox x:Name="PortalShapeCombo" ToolTipService.ToolTip="Looking Glass shape — circle spotlight, focus band, square, or Marksmith logo cutout"
                                  Width="115" Height="32" VerticalAlignment="Center" SelectionChanged="OnPortalShapeChanged">
                            <ComboBoxItem Content="Circle" Tag="circle" />
                            <ComboBoxItem Content="Focus" Tag="focus1" />
                            <ComboBoxItem Content="Square" Tag="square" />
                            <ComboBoxItem Content="Logo Cutout" Tag="logo" />
                        </ComboBox>
                        <Slider x:Name="PortalRevealSlider" ToolTipService.ToolTip="Looking Glass size — scales the active shape (circle diameter / focus band height)"
                                Width="85" Minimum="0" Maximum="100" StepFrequency="5" SmallChange="5" LargeChange="10"
                                VerticalAlignment="Center" ValueChanged="OnPortalRevealChanged" />

                        <Border Width="1" Height="16" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" VerticalAlignment="Center" />

                        <!-- Glass Blur: blur within the looking glass itself -->
                        <ToggleButton x:Name="PortalInsideBlurToggle" ToolTipService.ToolTip="Glass Blur — turn on/off blur within the looking glass"
                                      IsChecked="{Binding PortalInsideBlur, Mode=TwoWay}"
                                      Click="OnPortalInsideBlurToggled" VerticalAlignment="Center" Height="32" Padding="8,0">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE91F;" FontSize="12" />
                                <TextBlock Text="Glass" FontSize="12" />
                            </StackPanel>
                        </ToggleButton>
                        <Slider x:Name="PortalInsideBlurSlider" ToolTipService.ToolTip="Glass blur intensity — adjust how blurry the looking glass itself is (0-25px)"
                                Width="80" Minimum="0" Maximum="25" StepFrequency="1" SmallChange="1" LargeChange="5"
                                Value="{Binding PortalInsideBlurRadius, Mode=TwoWay}"
                                VerticalAlignment="Center" ValueChanged="OnPortalInsideBlurRadiusChanged" />

                        <Border Width="1" Height="16" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" VerticalAlignment="Center" />

                        <!-- Surround Blur: blur preview area around/behind the portal -->
                        <ToggleButton x:Name="PortalSurroundBlurToggle" ToolTipService.ToolTip="Surround Blur — turn on/off blur of the preview area surrounding the portal (Ctrl+Alt+X)"
                                      IsChecked="{Binding PortalFocusBlur, Mode=TwoWay}"
                                      Click="OnPortalBlurToggled" VerticalAlignment="Center" Height="32" Padding="8,0">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xEF1F;" FontSize="12" />
                                <TextBlock Text="Surround" FontSize="12" />
                            </StackPanel>
                        </ToggleButton>
                        <Slider x:Name="PortalSurroundBlurSlider" ToolTipService.ToolTip="Surround blur intensity — adjust how blurry the area surrounding the portal is (0-25px)"
                                Width="80" Minimum="0" Maximum="25" StepFrequency="1" SmallChange="1" LargeChange="5"
                                Value="{Binding PortalSurroundBlurRadius, Mode=TwoWay}"
                                VerticalAlignment="Center" ValueChanged="OnPortalSurroundBlurRadiusChanged" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" Margin="0,4,0,10">
                        <Button ToolTipService.ToolTip="Copy the rendered HTML to the clipboard" Height="32" Width="32" Padding="0"
                                Click="OnCopyHtmlClick" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                        </Button>
                        <Button ToolTipService.ToolTip="Print the rendered document (Ctrl+P)" Height="32" Width="32" Padding="0"
                                Click="OnPrintClick" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE749;" FontSize="13" />
                        </Button>

                        <!-- Issue #6: the old two rows of 20+ buttons, consolidated into dropdown
                             clusters (every action keeps its original Click handler). The retired
                             "View &amp; Zoom" cluster was redundant: editor font size lives on the
                             A− / A+ strip under the editor, preview zoom on the width ruler under
                             the preview. -->
                        <!-- Expanded layout: when the bottom bar has the room (code mode at normal
                             width, split view, fullscreen), the common editing actions sit as direct
                             icon buttons instead of hiding under the cluster dropdowns. Populated in
                             code-behind so the handlers live in one place. -->
                        <StackPanel x:Name="EditingExpandedPanel" Orientation="Horizontal" Spacing="2"
                                    Visibility="Collapsed" VerticalAlignment="Center">
                            <Border Width="1" Height="16" Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Margin="4,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="EditingClustersPanel" Orientation="Horizontal" Spacing="4">
                            <Border Width="1" Height="16" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                            <DropDownButton AutomationProperties.Name="Text style" ToolTipService.ToolTip="Text style: bold, italic, strikethrough, headings" Height="32" Padding="8,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8DD;" FontSize="14" />
                                    <TextBlock Text="Text style" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Bold" Click="OnBoldClick" KeyboardAcceleratorTextOverride="Ctrl+B">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DD;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Italic" Click="OnItalicClick" KeyboardAcceleratorTextOverride="Ctrl+I">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DB;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Strikethrough" Click="OnStrikethroughClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE0;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Heading 1" Click="OnH1Click" KeyboardAcceleratorTextOverride="Ctrl+1" />
                                        <MenuFlyoutItem Text="Heading 2" Click="OnH2Click" KeyboardAcceleratorTextOverride="Ctrl+2" />
                                        <MenuFlyoutItem Text="Heading 3" Click="OnH3Click" KeyboardAcceleratorTextOverride="Ctrl+3" />
                                        <MenuFlyoutItem Text="Heading 4" Click="OnH4Click" KeyboardAcceleratorTextOverride="Ctrl+4" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <DropDownButton AutomationProperties.Name="Lists" ToolTipService.ToolTip="Lists: bullet, numbered, task list, blockquote" Height="32" Padding="8,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                                    <TextBlock Text="Lists" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Bullet list" Click="OnBulletListClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Numbered list" Click="OnNumberedListClick">
                                            <MenuFlyoutItem.Icon><PathIcon Data="M1,1 h1 v1 h-1 Z M0,2 h2 v1 h-2 Z M1,3 h1 v1 h-1 Z M1,4 h1 v1 h-1 Z M0,5 h3 v1 h-3 Z M0,9 h2 v1 h-2 Z M2,10 h1 v1 h-1 Z M1,11 h1 v1 h-1 Z M0,12 h1 v1 h-1 Z M0,13 h3 v1 h-3 Z M5,3 h11 v1.5 h-11 Z M5,11 h11 v1.5 h-11 Z" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Task list" Click="OnTaskListClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73A;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Blockquote" Click="OnBlockquoteClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9B1;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <DropDownButton x:Name="InsertClusterButton" AutomationProperties.Name="Insert" ToolTipService.ToolTip="Insert: links, images, tables, rich components, diagrams" Height="32" Padding="8,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="Insert" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Link" Click="OnLinkClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Image" Click="OnImageClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Table" Click="OnTableClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80A;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Code block" Click="OnCodeBlockClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE943;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutSubItem Text="Rich components">
                                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE71D;" /></MenuFlyoutSubItem.Icon>
                                            <MenuFlyoutItem Text="Tab group" Click="OnInsertTabsClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C4;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Video embed" Click="OnInsertEmbedClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB41;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Chart" Click="OnInsertChartClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D2;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Data grid" Click="OnInsertDatagridClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF0E2;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Table from a spreadsheet…" Click="OnInsertSpreadsheetClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9F9;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Columns" Click="OnInsertColumnsClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE89A;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Drawing canvas" Click="OnInsertCanvasClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEE56;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Random tile map…" Click="OnInsertWaveFunctionClick" ToolTipService.ToolTip="A procedurally generated map of grass, road, water and wall tiles">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE945;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSubItem Text="Diagrams and studios">
                                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xF003;" /></MenuFlyoutSubItem.Icon>
                                            <MenuFlyoutItem Text="Document Galaxy…" Click="OnOpenMindMapGalaxyClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEC26;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Shape Studio…" Click="OnOpenShapeDesignStudioClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="SmartArt Studio…" Click="OnOpenSmartArtDesignStudioClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Diagram Studio…" Click="OnOpenMermaidStudioClick" KeyboardAcceleratorTextOverride="Ctrl+Shift+M">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE943;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Workflow" Click="OnInsertWorkflowClick" />
                                            <MenuFlyoutItem Text="Timeline" Click="OnInsertTimelineClick" />
                                            <MenuFlyoutItem Text="SmartArt" Click="OnInsertSmartArtClick" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="References" Click="OnInsertReferencesClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE82D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="AI context metadata" Click="OnInsertAiContextClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE99A;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <DropDownButton x:Name="ToolsClusterButton" AutomationProperties.Name="Tools" ToolTipService.ToolTip="Tools: find and replace, change case, sort lines, clean up the document" Height="32" Padding="8,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE90F;" FontSize="14" />
                                    <TextBlock Text="Tools" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Find" Click="OnEditorFindClick" KeyboardAcceleratorTextOverride="Ctrl+F">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Find and replace" Click="OnEditorReplaceClick" KeyboardAcceleratorTextOverride="Ctrl+H">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AB;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="UPPERCASE" Click="OnTransformUpperClick" />
                                        <MenuFlyoutItem Text="lowercase" Click="OnTransformLowerClick" />
                                        <MenuFlyoutItem Text="Title Case" Click="OnTransformTitleClick" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Sort lines A to Z" Click="OnSortLinesAscClick" />
                                        <MenuFlyoutItem Text="Sort lines Z to A" Click="OnSortLinesDescClick" />
                                        <MenuFlyoutItem Text="Remove duplicate lines" Click="OnDedupeLinesClick" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Copy a table to Excel…" Click="OnExportTableClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Clean up document" Click="OnCleanupClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE771;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>


            <controls:GridSplitter x:Name="RightSplitter" AutomationProperties.Name="Resize the Style &amp; Export pane" Grid.Column="3" Width="16" Background="Transparent" ResizeBehavior="BasedOnAlignment" ResizeDirection="Auto"
                                               ToolTipService.ToolTip="Drag to resize the Style &amp; Export pane" />

            <!-- RIGHT PANE -->
            
            <Grid x:Name="RightPane" Grid.Column="4" RowSpacing="10" SizeChanged="OnRightPaneSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource StepBadgeStyle}">
                            <TextBlock Text="3" Style="{StaticResource StepBadgeTextStyle}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Style &amp; Export" Style="{StaticResource StepTitleStyle}" />
                            <TextBlock Text="Finish the document" Style="{StaticResource StepCaptionStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- The old row of four (history / tour / shortcuts / settings) overlapped the
                             step header at narrow widths, so everything lives in one ⋯ menu now — the
                             tip jar too (it used to float in the title bar). The history ListView keeps
                             its rich flyout, re-shown as an attached flyout from the menu item. -->
                        <!-- Document outline (Task 17): H1–H6 flyout; clicking a node scrolls the
                             preview to that heading and, when the editor shows, moves the caret there. Its own Button.Flyout (not an attached flyout)
                             so it doesn't collide with the ⋯ menu's history attached flyout. -->
                        <Button x:Name="OutlineButton" ToolTipService.ToolTip="Document outline (H1–H6)">
                            <FontIcon Glyph="&#xE8A4;" FontSize="14" />
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <Grid RowSpacing="8" Width="340">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Document outline" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TocEmptyText" Grid.Row="1" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="No headings yet. Lines that start with # become the outline, and clicking one takes you there." />
                                        <ListView x:Name="TocList" Grid.Row="1" MaxHeight="420"
                                                  SelectionMode="None" IsItemClickEnabled="True"
                                                  ItemClick="OnTocItemClick">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                                               Margin="{Binding Level, Converter={StaticResource LevelToIndentConverter}}" />
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="MoreMenuButton" ToolTipService.ToolTip="More — history, tour, shortcuts, settings, support">
                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="Version history…" Click="OnOpenHistoryClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE823;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Recent exports" Click="OnExportHistoryMenuClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Take a quick tour" Click="OnTakeTourClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE897;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Keyboard shortcuts" Click="OnShortcutsButtonClick" KeyboardAcceleratorTextOverride="F1">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Settings" Click="OnSettingsClick" KeyboardAcceleratorTextOverride="Ctrl+,">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Buy me a coffee" ToolTipService.ToolTip="Support MarkSmith's development (opens buymeacoffee.com in your browser)" Click="OnBuyCoffeeClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE76E;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <FlyoutBase.AttachedFlyout>
                                <Flyout Placement="Bottom">
                                    <Grid RowSpacing="8" Width="380">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Recent exports" FontWeight="SemiBold" />
                                        <TextBlock x:Name="HistoryEmptyText" Grid.Row="1" TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,4,0,8"
                                                   Text="Nothing exported yet. Files you export appear here; click one to open it." />
                                        <ListView x:Name="HistoryList" Grid.Row="1" MaxHeight="420"
                                                  SelectionMode="None" IsItemClickEnabled="True"
                                                  ItemClick="OnHistoryItemClick">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Padding="0,6" Spacing="2"
                                                                ToolTipService.ToolTip="{Binding OutputPath}">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding OutputPath}" Opacity="0.4" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Flyout>
                            </FlyoutBase.AttachedFlyout>
                        </Button>
                    </StackPanel>
                    <!-- Called out once after the first-run tour, and once more on the third launch
                         (the tip-jar nudge). Title/subtitle are set in code before opening. -->
                    <TeachingTip x:Name="MoreMenuTip" Target="{x:Bind MoreMenuButton}"
                                 PreferredPlacement="BottomLeft" IsLightDismissEnabled="True" />
                </Grid>
<Border x:Name="StyleCard" Grid.Row="1" Style="{StaticResource PipelineCardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel Padding="14" Spacing="12">

                            <!-- ══════════ APPEARANCE ══════════ -->
                                <Expander x:Name="StyleAppearanceExpander" Tag="Appearance" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE790;" FontSize="14" />
                                            <TextBlock Text="Appearance" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="12">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="PresetsCombo" Grid.Column="0" Header="Preset"
                                          ItemsSource="{Binding Presets}" DisplayMemberPath="Name"
                                          PlaceholderText="Apply a saved preset…" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnPresetSelected" />
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnSavePresetClick"
                                        ToolTipService.ToolTip="Save current settings as a preset">
                                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                </Button>
                                <Button Grid.Column="2" VerticalAlignment="Bottom" Click="OnDeletePresetClick"
                                        ToolTipService.ToolTip="Delete the selected preset">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </Grid>

                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Header="Theme" ItemsSource="{Binding ThemeNames}"
                                          SelectedItem="{Binding SelectedThemeName, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3"
                                                           VerticalAlignment="Center"
                                                           Fill="{Binding Converter={StaticResource ThemeNameToSwatchConverter}}" />
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Click="OnToggleThemeFavoriteClick" VerticalAlignment="Bottom"
                                        ToolTipService.ToolTip="Pin/unpin the selected theme to the top of the list">
                                    <Grid>
                                        <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  Visibility="{Binding IsCurrentThemeFavorite, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <FontIcon Glyph="&#xE734;" FontSize="14"
                                                  Visibility="{Binding IsCurrentThemeFavorite, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                    </Grid>
                                </Button>
                                <Button Grid.Column="2" Click="OnCreateThemeClick" Padding="8,5"
                                        VerticalAlignment="Bottom" ToolTipService.ToolTip="Create a theme — pick your own colors for every element (starts from the selected theme)">
                                    <FontIcon Glyph="&#xE790;" FontSize="14" />
                                </Button>
                            </Grid>

                            <localcontrols:OptionRow Header="Light theme influence"
                                                     Description="A light centre panel with the theme's colours on the margins; text colours adjust to stay readable.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding ThemeLightInfluence, Mode=TwoWay}" />
                            </localcontrols:OptionRow>

                                    </StackPanel>
                                </Expander>

                            <!-- ══════════ LAYOUT & PDF ══════════ -->
                                <Expander x:Name="StyleLayoutExpander" Tag="Layout" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8A1;" FontSize="14" />
                                            <TextBlock Text="Layout &amp; PDF" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="12">
                            <localcontrols:OptionRow Header="Lock to A4 width"
                                                     Description="Pins the page to A4 width (794 px), so PDFs come out true A4 and Word uses A4 paper. Off: the width below sets the page, and Word uses Letter.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding A4FixedWidth, Mode=TwoWay}" />
                            </localcontrols:OptionRow>
                            <!-- Width only means something while A4 isn't locking it. -->
                            <localcontrols:OptionRow Header="Page width"
                                                     Description="400–2400 px. Sets the preview and PDF page width while the A4 lock is off."
                                                     IsEnabled="{Binding A4FixedWidth, Converter={StaticResource BoolToInverseConverter}}">
                                <NumberBox Value="{Binding ContentWidth, Mode=TwoWay}" Width="116"
                                           AutomationProperties.Name="Page width in pixels"
                                           SpinButtonPlacementMode="Compact" Minimum="400" Maximum="2400" SmallChange="50" LargeChange="200" />
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Single continuous page"
                                                     Description="PDF only: one long page with no page breaks. Word has no page-less print mode, so a DOCX opens in Web Layout instead.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding UnlimitedHeight, Mode=TwoWay}" />
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Table of contents"
                                                     Description="A linked contents list built from the document's headings, at the top of the preview and every export.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding IncludeToc, Mode=TwoWay}" />
                            </localcontrols:OptionRow>

                                    </StackPanel>
                                </Expander>

                            <!-- ══════════ WORD EXPORT ══════════ -->
                                <Expander x:Name="StyleWordExpander" Tag="Word" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                            <TextBlock Text="Word export" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="12">
                            <localcontrols:OptionRow Header="Page border"
                                                     Description="A decorative frame around every page.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding PageBorder, Mode=TwoWay}" />
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Track changes"
                                                     Description="The document opens with Word's revision tracking on, so every later edit shows.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding TrackChanges, Mode=TwoWay}" />
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Diagrams"
                                                     Description="ShapeForge rebuilds Mermaid diagrams (flowchart, sequence, class/ER, pie, gantt, mind map, timeline, quadrant) from Word's own shapes, every box and arrow editable. Anything it can't parse falls back to a picture.">
                                <localcontrols:OptionRow.Details>
                                    <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="Diagrams in Word exports"
                                              SelectedIndex="{Binding MermaidDocxMode, Mode=TwoWay}">
                                        <x:String>Picture of the diagram</x:String>
                                        <x:String>ShapeForge™ editable shapes</x:String>
                                    </ComboBox>
                                </localcontrols:OptionRow.Details>
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Glued connectors"
                                                     Description="Lines stay attached to their shapes when you drag them in Word.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding SmartConnectors, Mode=TwoWay}" />
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Connector arrowheads"
                                                     Description="Used for connectors whose diagram source doesn't pick one.">
                                <localcontrols:OptionRow.Details>
                                    <!-- Tag is the stored value (DrawingML arrow names); Content is what people read. -->
                                    <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="Connector arrowheads"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding ConnectorArrowhead, Mode=TwoWay}">
                                        <ComboBoxItem Content="Default (from the diagram)" Tag="default" />
                                        <ComboBoxItem Content="Triangle" Tag="triangle" />
                                        <ComboBoxItem Content="Open arrow" Tag="open" />
                                        <ComboBoxItem Content="Diamond" Tag="diamond" />
                                        <ComboBoxItem Content="Oval" Tag="oval" />
                                        <ComboBoxItem Content="Stealth" Tag="stealth" />
                                        <ComboBoxItem Content="None" Tag="none" />
                                    </ComboBox>
                                </localcontrols:OptionRow.Details>
                            </localcontrols:OptionRow>
                            <!-- "Shrink wide diagrams to fit" lived here. DocxExportService forces
                                 OversizedDiagramMode 4 (shrink to one page) on every export by product
                                 decision, so the switch changed nothing; wide diagrams always fit. -->

                                    </StackPanel>
                                </Expander>

                            <!-- ══════════ EMAIL (free on every plan) ══════════ -->
                                <Expander x:Name="StyleEmailExpander" Tag="Email" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE724;" FontSize="14" />
                                            <TextBlock Text="Email" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="12">
                            <TextBlock Text="Export ▸ Email draft (Ctrl+Shift+O) opens the document as a new Outlook message. Every email feature is free."
                                       Style="{StaticResource StepCaptionStyle}" TextWrapping="Wrap" />
                            <localcontrols:OptionRow Header="To"
                                                     Description="Filled in on every draft. Separate addresses with ; or ,">
                                <localcontrols:OptionRow.Details>
                                    <StackPanel Spacing="6">
                                        <TextBox Text="{Binding EmailTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="name@company.com; team@company.com"
                                                 AutomationProperties.Name="Default To recipients" />
                                        <Grid ColumnSpacing="6" Visibility="{Binding HasEmailToProblem, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding EmailToProblem}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </localcontrols:OptionRow.Details>
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Cc">
                                <localcontrols:OptionRow.Details>
                                    <StackPanel Spacing="6">
                                        <TextBox Text="{Binding EmailCc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Optional"
                                                 AutomationProperties.Name="Default Cc recipients" />
                                        <Grid ColumnSpacing="6" Visibility="{Binding HasEmailCcProblem, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding EmailCcProblem}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </localcontrols:OptionRow.Details>
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Subject"
                                                     Description="{}{title} is the document's opening heading; {source} its file name; {date} today.">
                                <localcontrols:OptionRow.Details>
                                    <StackPanel Spacing="6">
                                        <TextBox Text="{Binding EmailSubjectTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{}{title}"
                                                 AutomationProperties.Name="Email subject template" />
                                        <TextBlock Text="{Binding EmailSubjectPreview}" TextWrapping="Wrap" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" MaxLines="2"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </localcontrols:OptionRow.Details>
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Keep the title in the message"
                                                     Description="The opening heading becomes the subject. Turn this on to repeat it as a heading at the top of the message too.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding EmailRepeatTitleInBody, Mode=TwoWay}" />
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Attach a PDF copy"
                                                     Description="The same document as a PDF, for readers who want to print or file it.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding EmailAttachPdf, Mode=TwoWay}" />
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Attach a Word copy"
                                                     Description="An editable .docx of the document. Attaching Word files is a Pro feature; on the free plan the email still goes, without the copy.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding EmailAttachDocx, Mode=TwoWay}" />
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Draft format"
                                                     Description="{Binding EmailFormatDescription}">
                                <ComboBox MinWidth="140" SelectedValuePath="Tag"
                                          AutomationProperties.Name="Email draft format"
                                          SelectedValue="{Binding EmailFormat, Mode=TwoWay}">
                                    <ComboBoxItem Content="Automatic" Tag="auto" />
                                    <ComboBoxItem Content="Email (.eml)" Tag="eml" />
                                    <ComboBoxItem Content="Outlook (.msg)" Tag="msg" />
                                </ComboBox>
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Saved drafts"
                                                     Description="Each email draft is kept in MarkSmith's outbox for 7 days, then deleted.">
                                <Button Content="Clear now" Command="{Binding ClearEmailOutboxCommand}"
                                        ToolTipService.ToolTip="Delete every email draft MarkSmith has saved" />
                            </localcontrols:OptionRow>
                                    </StackPanel>
                                </Expander>

                            <!-- ══════════ DIAGRAMS ══════════ -->
                                <Expander x:Name="StyleDiagramsExpander" Tag="Diagrams" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xF003;" FontSize="14" />
                                            <TextBlock Text="Diagrams" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="12">
                            <localcontrols:OptionRow Header="Render Mermaid diagrams"
                                                     Description="Off: Mermaid code blocks stay as plain code in the preview and every export.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding MermaidEnabled, Mode=TwoWay}" />
                            </localcontrols:OptionRow>
                            <!-- Collapsed as well as closed: a closed InfoBar still took the panel's
                                 spacing plus its own margin, leaving a gap under the caption. -->
                            <InfoBar IsOpen="{Binding HasMermaidDiagram}"
                                     Visibility="{Binding HasMermaidDiagram, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Severity="{Binding DiagramHintSeverity, Converter={StaticResource StatusSeverityConverter}}"
                                     Message="{Binding DiagramHintText}"
                                     IsClosable="False">
                                <InfoBar.ActionButton>
                                    <Button Click="OnOpenMermaidStudioClick" ToolTipService.ToolTip="Open Diagram Studio (Ctrl+Shift+M)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE943;" FontSize="14" />
                                        <TextBlock Text="Diagram Studio" />
                                    </StackPanel>
                                </Button>
                                </InfoBar.ActionButton>
                            </InfoBar>

                                    </StackPanel>
                                </Expander>

                            <!-- ══════════ CONTENT & CLEANUP ══════════ -->
                                <Expander x:Name="StyleContentExpander" Tag="Content" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8D2;" FontSize="14" />
                                            <TextBlock Text="Content &amp; cleanup" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="12">
                            <localcontrols:OptionRow Header="Fix AI formatting quirks"
                                                     Description="ChatGPT's LaTeX and citation pips, Gemini's pseudo-headings, Claude's leftover tags.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding NormalizeLlm, Mode=TwoWay}" />
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Custom cleanup rules"
                                                     Description="Strip your pet-peeve AI phrases (e.g. 'In conclusion', 'delve'). Applied after the fixes above, while they're on. Type \n for a line break; regex rules can use $1 captures.">
                                <localcontrols:OptionRow.Details>
                                <StackPanel Spacing="8">
                            <!-- The rules only run inside the AI-quirks pass. Say so instead of leaving
                                 the user to wonder why a rule does nothing. -->
                            <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="4" Padding="8,6"
                                    Visibility="{Binding NormalizationRulesPaused, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE769;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <TextBlock Grid.Column="1" Text="Paused: turn on Fix AI formatting quirks to run these rules."
                                               TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Border>
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="6"
                                    Visibility="{Binding HasNormalizationRules, Converter={StaticResource BoolToVisibilityConverter}}">
                                <!-- No inner scroller: rows now carry a status line, and a 140 px nested
                                     scroll hid most of them inside a pane that already scrolls. -->
                                    <StackPanel Spacing="4">
                                        <ItemsControl ItemsSource="{Binding NormalizationRules}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Spacing="2" Margin="0,0,0,4">
                                                    <Grid services:HoverPolish.ApplyOnLoad="True" ColumnSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- FindText/ReplaceText show line breaks and tabs as \n and \t: these boxes
                                                             are single-line, so a real break showed as nothing. -->
                                                        <TextBox Text="{Binding FindText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 PlaceholderText="Find" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                                                                 AutomationProperties.Name="Find"
                                                                 ToolTipService.ToolTip="Text to find, any case. \n is a line break, \t a tab." />
                                                        <TextBox Grid.Column="1" Text="{Binding ReplaceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 PlaceholderText="Replace" ToolTipService.ToolTip="Leave blank to strip the match. \n is a line break."
                                                                 AutomationProperties.Name="Replace with"
                                                                 FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />
                                                        <!-- A ".*" toggle, as in VS Code's find box. It was a bare CheckBox, whose
                                                             default MinWidth of 120 left a dead gap and squeezed Find/Replace until
                                                             their text and placeholders clipped. -->
                                                        <ToggleButton Grid.Column="2" IsChecked="{Binding IsRegex, Mode=TwoWay}" Content=".*"
                                                                      FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" Padding="7,4" MinWidth="0"
                                                                      VerticalAlignment="Stretch"
                                                                      ToolTipService.ToolTip="Treat Find as a regular expression"
                                                                      AutomationProperties.Name="Treat Find as a regular expression" />
                                                        <Button Grid.Column="3" Padding="6,4" VerticalAlignment="Stretch"
                                                                ToolTipService.ToolTip="Remove this rule"
                                                                AutomationProperties.Name="Remove this rule"
                                                                Command="{Binding ElementName=RootGrid, Path=DataContext.RemoveNormalizationRuleCommand}"
                                                                CommandParameter="{Binding}">
                                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                        </Button>
                                                    </Grid>
                                                    <!-- Checked as you type (bad pattern) and after each preview pass (matches). -->
                                                    <Grid ColumnSpacing="5" Margin="2,0,0,0"
                                                                Visibility="{Binding HasPatternError, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE783;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding PatternError}" FontSize="11" TextWrapping="Wrap"
                                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Status}" FontSize="11" Margin="2,0,0,0"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                            </Border>
                            <Button FontSize="12" Padding="10,4"
                                    Command="{Binding AddNormalizationRuleCommand}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Add rule" />
                                </StackPanel>
                            </Button>
                                </StackPanel>
                                </localcontrols:OptionRow.Details>
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Source attribution"
                                                     Description="A strip at the top naming the AI the text came from and how many fixes were applied. Only shown when the source is recognised.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding ShowAttribution, Mode=TwoWay}" />
                            </localcontrols:OptionRow>

                                    </StackPanel>
                                </Expander>

                            <!-- ══════════ FORMATTING & TEXT ══════════ -->
                                <Expander x:Name="StyleFormattingExpander" Tag="Formatting" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE943;" FontSize="14" />
                                            <TextBlock Text="Formatting &amp; text" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="12">
                                        <localcontrols:OptionRow Header="No emoji"
                                                                 Description="Strips every emoji, whatever the input, from the preview and every export.">
                                            <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding NoEmoji, Mode=TwoWay}" />
                                        </localcontrols:OptionRow>

                                        <localcontrols:OptionRow Header="Em dashes (—)"
                                                                 Description="Swap AI-style em dashes everywhere except code blocks.">
                                            <localcontrols:OptionRow.Details>
                                                <StackPanel Spacing="8">
                                                    <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="Em dashes"
                                                              SelectedIndex="{Binding DashMode, Mode=TwoWay}">
                                                        <x:String>Keep as-is</x:String>
                                                        <x:String>Replace with hyphen (-)</x:String>
                                                        <x:String>Replace with spaced ( - )</x:String>
                                                        <x:String>Custom…</x:String>
                                                    </ComboBox>
                                                    <TextBox PlaceholderText="Replace each em dash with…" AutomationProperties.Name="Custom em dash replacement"
                                                             Text="{Binding DashCustom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding IsDashCustom, Converter={StaticResource BoolToVisibilityConverter}}"
                                                             IsSpellCheckEnabled="False" />
                                                </StackPanel>
                                            </localcontrols:OptionRow.Details>
                                        </localcontrols:OptionRow>

                                        <localcontrols:OptionRow Header="Heading level shift"
                                                                 Description="Promote (−) or demote (+) every heading: +1 turns # into ##. Levels stay within 1–6.">
                                            <NumberBox Value="{Binding HeadingShift, Mode=TwoWay}" Width="96"
                                                       AutomationProperties.Name="Heading level shift"
                                                       SpinButtonPlacementMode="Compact" Minimum="-5" Maximum="5" SmallChange="1" />
                                        </localcontrols:OptionRow>

                                        <localcontrols:OptionRow Header="Bold text">
                                            <ComboBox Width="150" AutomationProperties.Name="Bold text"
                                                      SelectedIndex="{Binding BoldMode, Mode=TwoWay}">
                                                <x:String>Keep</x:String>
                                                <x:String>Plain text</x:String>
                                                <x:String>Make italic</x:String>
                                            </ComboBox>
                                        </localcontrols:OptionRow>
                                        <localcontrols:OptionRow Header="Italic text">
                                            <ComboBox Width="150" AutomationProperties.Name="Italic text"
                                                      SelectedIndex="{Binding ItalicMode, Mode=TwoWay}">
                                                <x:String>Keep</x:String>
                                                <x:String>Plain text</x:String>
                                            </ComboBox>
                                        </localcontrols:OptionRow>
                                    </StackPanel>
                                </Expander>

                            <!-- ══════════ BRANDING (PRO) ══════════ -->
                                <Expander x:Name="ExportBrandingExpander" Tag="Branding" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8D4;" FontSize="14" />
                                        <TextBlock Text="Branding" FontWeight="SemiBold" />
                                        <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="4" Padding="5,1"
                                                VerticalAlignment="Center" Visibility="{Binding ShowProBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Turn a converted chat into a client-ready deliverable: a cover page, your logo and your typeface."
                                               Style="{StaticResource StepCaptionStyle}" TextWrapping="Wrap" />
                                    <localcontrols:OptionRow Header="Cover page"
                                                             Description="A Word title page with the document's title, your logo and today's date.">
                                        <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding BrandCoverPage, Mode=TwoWay}" />
                                    </localcontrols:OptionRow>
                                    <localcontrols:OptionRow Header="Company logo"
                                                             Description="PNG or JPEG, placed on the Word cover page and used as an e-book's cover.">
                                        <localcontrols:OptionRow.Details>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding BrandLogoPath, Mode=TwoWay}" AutomationProperties.Name="Company logo file"
                                                         PlaceholderText="No logo chosen" IsSpellCheckEnabled="False" />
                                                <Button Grid.Column="1" VerticalAlignment="Stretch" Click="OnBrowseLogoClick"
                                                        ToolTipService.ToolTip="Choose a logo image (PNG/JPEG)"
                                                        AutomationProperties.Name="Choose a logo image">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </localcontrols:OptionRow.Details>
                                    </localcontrols:OptionRow>
                                    <localcontrols:OptionRow Header="Document font"
                                                             Description="Any installed typeface, used for the body in the preview and every export. Blank: the fallback font from Settings.">
                                        <localcontrols:OptionRow.Details>
                                            <TextBox Text="{Binding BrandFontFamily, Mode=TwoWay}" AutomationProperties.Name="Document font family"
                                                     PlaceholderText="e.g. Inter, Georgia" IsSpellCheckEnabled="False" />
                                        </localcontrols:OptionRow.Details>
                                    </localcontrols:OptionRow>
                                    <localcontrols:OptionRow Header="Embedded font file"
                                                             Description="A .ttf or .otf that isn't installed on this PC, embedded so the document looks the same anywhere.">
                                        <localcontrols:OptionRow.Details>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding CustomFontPath, Mode=TwoWay}" AutomationProperties.Name="Embedded font file"
                                                         PlaceholderText="No font file chosen" IsSpellCheckEnabled="False" />
                                                <Button Grid.Column="1" VerticalAlignment="Stretch" Click="OnBrowseFontClick"
                                                        ToolTipService.ToolTip="Choose a .ttf or .otf font file"
                                                        AutomationProperties.Name="Choose a font file">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </localcontrols:OptionRow.Details>
                                    </localcontrols:OptionRow>
                                    <localcontrols:OptionRow Header="Author"
                                                             Description="Written into the file's properties as its author, in Word, PDF and PowerPoint.">
                                        <localcontrols:OptionRow.Details>
                                            <TextBox Text="{Binding AuthorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Author name"
                                                     PlaceholderText="Your name or company" IsSpellCheckEnabled="False" />
                                        </localcontrols:OptionRow.Details>
                                    </localcontrols:OptionRow>
                                </StackPanel>
                                </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

<Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding OutputFolder, Mode=TwoWay}"
                             PlaceholderText="Output folder (defaults to next to the input file)"
                             IsSpellCheckEnabled="False" ToolTipService.ToolTip="Output folder" />

                    <Button Grid.Column="1" VerticalAlignment="Stretch" Click="OnBrowseFolderClick"
                            ToolTipService.ToolTip="Choose output folder">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    </Button>

                    <Button Grid.Column="2" VerticalAlignment="Stretch" Click="OnOpenOutputClick"
                            IsEnabled="{Binding HasOutput}" ToolTipService.ToolTip="Open last output"
                            AutomationProperties.Name="Open output">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                            <!-- Hidden when the pane is narrow (code-behind) so the folder path keeps room. -->
                            <TextBlock x:Name="OpenOutputLabel" Text="Open output" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- The primary export fills the row; Cancel and the busy ring only take space while
                     an export is actually running (a permanently greyed-out Cancel used to sit here
                     and was clipped off the edge whenever the pane was narrow). -->
                <Grid Grid.Row="3">
                    <!-- Margins, not ColumnSpacing: spacing would still be reserved beside the
                         collapsed Cancel / ring and leave the button short of the row above. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- ISS-016: export actions collapsed into a single SplitButton so the toolbar
                         no longer overflows the window at narrow widths / in Split View. -->
                    <!-- ISS-019: the primary click runs the main export for the current license:
                         Word for Pro and trial users, PDF on the free plan (a free user's biggest
                         button used to open a paywall). UpdateExportButtonForLicense swaps the
                         label, icon and tooltip, and tags the Pro items in the flyout. -->
                    <SplitButton x:Name="ExportSplitButton" Grid.Column="0" Height="40" HorizontalAlignment="Stretch"
                                 AutomationProperties.Name="Generate Word document"
                                 Click="OnPrimaryExportClick" IsEnabled="{Binding IsNotBusy}"
                                 ToolTipService.ToolTip="Generate a Word document — use the chevron for other formats">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="PrimaryExportIcon" Glyph="&#xE74E;" FontSize="16" />
                            <TextBlock x:Name="PrimaryExportText" Text="Generate Word (.docx)" FontWeight="SemiBold" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem x:Name="ExportWordItem" Text="Export as Word (.docx)" Click="OnConvertDocxClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="ExportPdfItem" Text="Export as PDF (.pdf)" Click="OnConvertPdfClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE749;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="ExportPptxItem" Text="Export as PowerPoint (.pptx)" Click="OnConvertPptxClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Export as EPUB (.epub)" Click="OnExportEpubClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE82D;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="ExportGoogleDocsItem" Text="Export to Google Docs (native)" Click="OnExportGoogleDocsClick"
                                                ToolTipService.ToolTip="Creates a real Google Doc (headings, tables, images) — connect your Google account in Settings → Google first">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE753;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Export as web page (.html)" Click="OnExportHtmlClick"
                                                ToolTipService.ToolTip="A self-contained HTML file of the rendered document, styled with the current theme">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE12B;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Export as Markdown (.md)" Click="OnExportMarkdownClick"
                                                ToolTipService.ToolTip="Save the recovered/cleaned source as a Markdown file — the counterpart to importing a .docx">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C3;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <!-- Email is free on every plan (FeatureId.EmailDraft). -->
                                <MenuFlyoutItem Text="Email draft (opens in Outlook)" Click="OnEmailDraftClick"
                                                KeyboardAcceleratorTextOverride="Ctrl+Shift+O"
                                                AutomationProperties.Name="Email draft"
                                                ToolTipService.ToolTip="Opens the document as a new email in Outlook (or your default mail app), ready to address and send. The title becomes the subject; tables, code and diagrams come through. Free on every plan.">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE724;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Save as email (.eml)" Click="OnSaveEmailClick"
                                                ToolTipService.ToolTip="Saves an .eml draft beside your other exports. Every mail app opens it; Outlook opens it as a message you can send.">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE715;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Save as Outlook message (.msg)" Click="OnSaveOutlookMessageClick"
                                                ToolTipService.ToolTip="Saves an Outlook .msg draft beside your other exports, for people who file or share mail as .msg. Double-click it to open it in Outlook as a message you can send.">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C3;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Copy as email" Click="OnCopyAsEmailClick"
                                                AutomationProperties.Name="Copy as email"
                                                ToolTipService.ToolTip="Copies the document as an email body, pictures and diagrams included, to paste into a message you already have open: a reply, Gmail, Outlook on the web. Free on every plan.">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="ExportAllItem" Text="Export all licensed formats" Click="OnExportAllClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71D;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <Button Grid.Column="1" Height="40" Content="Cancel" Margin="8,0,0,0"
                            Command="{Binding CancelConversionCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTipService.ToolTip="Cancel the export in progress" />

                    <ProgressRing Grid.Column="2" IsActive="{Binding IsBusy}" Width="22" Height="22" Margin="8,0,0,0"
                                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                  VerticalAlignment="Center" />
                </Grid>
            </Grid>

        </Grid>

        <!-- Persistent status bar: a full-width strip along the bottom of the window with the
             changing status text docked bottom-left like a typical status bar (busy ring,
             detected-source badge, severity-colored message) and the Ln/Col readout on the
             right. Replaces the ISS-013 floating pill, which overlapped the editor's bottom
             buttons at the default 1220×800 launch size. -->
        <Border Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="16,5">
                    <ProgressRing IsActive="{Binding IsBusy}" Width="14" Height="14" VerticalAlignment="Center" />
                    <Border x:Name="DetectedBadge" Visibility="Collapsed" CornerRadius="12" Padding="10,4"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE945;" FontSize="12"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding DetectedSourceText}" FontSize="12"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="StatusMsgText" Text="{Binding StatusText}"
                               VerticalAlignment="Center" FontSize="12" Opacity="0.85"
                               Foreground="{Binding StatusSeverity, Converter={StaticResource StatusSeverityToBrushConverter}}"
                               TextTrimming="CharacterEllipsis" MaxWidth="560"
                               ToolTipService.ToolTip="{Binding StatusText}" />
                    <!-- Shown only while the status line is announcing a finished export (the
                         Windows toast is easy to miss, or switched off entirely). -->
                    <StackPanel x:Name="StatusOutputLinks" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                Visibility="{Binding HasStatusOutput, Converter={StaticResource BoolToVisibilityConverter}}">
                        <HyperlinkButton Click="OnStatusOpenOutputClick" Padding="6,1" FontSize="12"
                                         ToolTipService.ToolTip="Open the exported file"
                                         AutomationProperties.Name="Open exported file">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE8E5;" FontSize="11" />
                                <TextBlock Text="Open" />
                            </StackPanel>
                        </HyperlinkButton>
                        <HyperlinkButton Click="OnStatusShowOutputFolderClick" Padding="6,1" FontSize="12"
                                         ToolTipService.ToolTip="Show the exported file in File Explorer"
                                         AutomationProperties.Name="Show exported file in folder">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE838;" FontSize="11" />
                                <TextBlock Text="Show in folder" />
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="16,5">
                    <TextBlock Text="{Binding WordCountText}" VerticalAlignment="Center" FontSize="11.5" Opacity="0.7"
                               ToolTipService.ToolTip="{Binding DocumentStatsDetail}" />
                    <Border Width="1" Height="12" Background="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="CursorPosText" Text="Ln 1, Col 1" VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="11.5" Opacity="0.7"
                               ToolTipService.ToolTip="Cursor position in the Markdown editor" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- Dedicated background WebView2 host for headless exports and diagram harvesting — keeps background compiles from ever flashing or resetting the live preview pane. -->
        <WebView2 x:Name="ExportWebView" Visibility="Collapsed" Width="0" Height="0" />
    </Grid>
</Window>

                                        <MenuFlyoutItem Text="Bibliography / References" Click="OnInsertReferencesClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE82D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="AI Context metadata" Click="OnInsertAiContextClick">

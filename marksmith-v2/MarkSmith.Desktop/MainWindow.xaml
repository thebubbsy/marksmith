                                            <MenuFlyoutItem Text="Native Chart" Click="OnInsertChartClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D2;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Data Grid" Click="OnInsertDatagridClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF0E2;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="From Spreadsheet…" Click="OnInsertSpreadsheetClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9F9;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Table to Excel…" Click="OnExportTableClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Multi-column Section" Click="OnInsertColumnsClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE89A;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Drawing Canvas" Click="OnInsertCanvasClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEE56;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Wave Function Collapse…" Click="OnInsertWaveFunctionClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE945;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSubItem Text="Diagram &amp; Galaxy">
                                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xF003;" /></MenuFlyoutSubItem.Icon>
                                            <MenuFlyoutItem Text="Document Galaxy &amp; Knowledge Graph…" Click="OnOpenMindMapGalaxyClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEC26;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Shape Studio…" Click="OnOpenShapeDesignStudioClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="SmartArt Design Studio…" Click="OnOpenSmartArtDesignStudioClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Visual Diagram Studio…" Click="OnOpenMermaidStudioClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE943;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Workflow / Flowchart" Click="OnInsertWorkflowClick" />
                                            <MenuFlyoutItem Text="Timeline" Click="OnInsertTimelineClick" />
                                            <MenuFlyoutItem Text="SmartArt" Click="OnInsertSmartArtClick" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutItem Text="Version History…" Click="OnOpenHistoryClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE823;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                </Grid>
            </Grid>


            <controls:GridSplitter x:Name="RightSplitter" AutomationProperties.Name="Resize the Style &amp; Export pane" Grid.Column="3" Width="16" Background="Transparent" ResizeBehavior="BasedOnAlignment" ResizeDirection="Auto"
                                               ToolTipService.ToolTip="Drag to resize the Style &amp; Export pane" />

            <!-- RIGHT PANE -->
            
            <Grid x:Name="RightPane" Grid.Column="4" RowSpacing="10" SizeChanged="OnRightPaneSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource StepBadgeStyle}">
                            <TextBlock Text="3" Style="{StaticResource StepBadgeTextStyle}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Style &amp; Export" Style="{StaticResource StepTitleStyle}" />
                            <TextBlock Text="Finish the document" Style="{StaticResource StepCaptionStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- The old row of four (history / tour / shortcuts / settings) overlapped the
                             step header at narrow widths, so everything lives in one ⋯ menu now — the
                             tip jar too (it used to float in the title bar). The history ListView keeps
                             its rich flyout, re-shown as an attached flyout from the menu item. -->
                        <!-- Document outline (Task 17): H1–H6 flyout; clicking a node scrolls the
                             preview to that heading. Its own Button.Flyout (not an attached flyout)
                             so it doesn't collide with the ⋯ menu's history attached flyout. -->
                        <Button x:Name="OutlineButton" ToolTipService.ToolTip="Document outline (H1–H6)">
                            <FontIcon Glyph="&#xE8A4;" FontSize="14" />
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <Grid RowSpacing="8" Width="340">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Document outline" FontWeight="SemiBold" />
                                        <ListView x:Name="TocList" Grid.Row="1" MaxHeight="420"
                                                  SelectionMode="None" IsItemClickEnabled="True"
                                                  ItemClick="OnTocItemClick">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                                               Margin="{Binding Level, Converter={StaticResource LevelToIndentConverter}}" />
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="MoreMenuButton" ToolTipService.ToolTip="More — history, tour, shortcuts, settings, support">
                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="Version history…" Click="OnOpenHistoryClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE823;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Recent exports" Click="OnExportHistoryMenuClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Take a quick tour" Click="OnTakeTourClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE897;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Keyboard shortcuts" Click="OnShortcutsButtonClick" KeyboardAcceleratorTextOverride="F1">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Settings" Click="OnSettingsClick" KeyboardAcceleratorTextOverride="Ctrl+,">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Buy me a coffee" ToolTipService.ToolTip="Support MarkSmith's development (opens buymeacoffee.com in your browser)" Click="OnBuyCoffeeClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE76E;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <FlyoutBase.AttachedFlyout>
                                <Flyout Placement="Bottom">
                                    <Grid RowSpacing="8" Width="380">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Recent exports" FontWeight="SemiBold" />
                                        <TextBlock x:Name="HistoryEmptyText" Grid.Row="1" TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,4,0,8"
                                                   Text="Nothing exported yet. Files you export appear here; click one to open it." />
                                        <ListView x:Name="HistoryList" Grid.Row="1" MaxHeight="420"
                                                  SelectionMode="None" IsItemClickEnabled="True"
                                                  ItemClick="OnHistoryItemClick">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Padding="0,6" Spacing="2"
                                                                ToolTipService.ToolTip="{Binding OutputPath}">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding OutputPath}" Opacity="0.4" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Flyout>
                            </FlyoutBase.AttachedFlyout>
                        </Button>
                    </StackPanel>
                    <!-- Called out once after the first-run tour, and once more on the third launch
                         (the tip-jar nudge). Title/subtitle are set in code before opening. -->
                    <TeachingTip x:Name="MoreMenuTip" Target="{x:Bind MoreMenuButton}"
                                 PreferredPlacement="BottomLeft" IsLightDismissEnabled="True" />
                </Grid>
<Border x:Name="StyleCard" Grid.Row="1" Style="{StaticResource PipelineCardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel Padding="14" Spacing="12">

                            <!-- ══════════ APPEARANCE ══════════ -->
                                <Expander x:Name="StyleAppearanceExpander" Tag="Appearance" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE790;" FontSize="14" />
                                            <TextBlock Text="Appearance" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="12">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="PresetsCombo" Grid.Column="0" Header="Preset"
                                          ItemsSource="{Binding Presets}" DisplayMemberPath="Name"
                                          PlaceholderText="Apply a saved preset…" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnPresetSelected" />
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnSavePresetClick"
                                        ToolTipService.ToolTip="Save current settings as a preset">
                                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                </Button>
                                <Button Grid.Column="2" VerticalAlignment="Bottom" Click="OnDeletePresetClick"
                                        ToolTipService.ToolTip="Delete the selected preset">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </Grid>

                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Header="Theme" ItemsSource="{Binding ThemeNames}"
                                          SelectedItem="{Binding SelectedThemeName, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3"
                                                           VerticalAlignment="Center"
                                                           Fill="{Binding Converter={StaticResource ThemeNameToSwatchConverter}}" />
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Click="OnToggleThemeFavoriteClick" VerticalAlignment="Bottom"
                                        ToolTipService.ToolTip="Pin/unpin the selected theme to the top of the list">
                                    <Grid>
                                        <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  Visibility="{Binding IsCurrentThemeFavorite, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <FontIcon Glyph="&#xE734;" FontSize="14"
                                                  Visibility="{Binding IsCurrentThemeFavorite, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                    </Grid>
                                </Button>
                                <Button Grid.Column="2" Click="OnCreateThemeClick" Padding="8,5"
                                        VerticalAlignment="Bottom" ToolTipService.ToolTip="Create a theme — pick your own colors for every element (starts from the selected theme)">
                                    <FontIcon Glyph="&#xE790;" FontSize="14" />
                                </Button>
                            </Grid>

                            <localcontrols:OptionRow Header="Light theme influence"
                                                     Description="A light centre panel with the theme's colours on the margins; text colours adjust to stay readable.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding ThemeLightInfluence, Mode=TwoWay}" />
                            </localcontrols:OptionRow>

                                    </StackPanel>
                                </Expander>

                            <!-- ══════════ LAYOUT & PDF ══════════ -->
                                <Expander x:Name="StyleLayoutExpander" Tag="Layout" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8A1;" FontSize="14" />
                                            <TextBlock Text="Layout &amp; PDF" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="12">
                            <localcontrols:OptionRow Header="Lock to A4 width"
                                                     Description="Pins the page to A4 width (794 px), so PDFs come out true A4 and Word uses A4 paper. Off: the width below sets the page, and Word uses Letter.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding A4FixedWidth, Mode=TwoWay}" />
                            </localcontrols:OptionRow>
                            <!-- Width only means something while A4 isn't locking it. -->
                            <localcontrols:OptionRow Header="Page width"
                                                     Description="400–2400 px. Sets the preview and PDF page width while the A4 lock is off."
                                                     IsEnabled="{Binding A4FixedWidth, Converter={StaticResource BoolToInverseConverter}}">
                                <NumberBox Value="{Binding ContentWidth, Mode=TwoWay}" Width="116"
                                           AutomationProperties.Name="Page width in pixels"
                                           SpinButtonPlacementMode="Compact" Minimum="400" Maximum="2400" SmallChange="50" LargeChange="200" />
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Single continuous page"
                                                     Description="PDF only: one long page with no page breaks. Word has no page-less print mode, so a DOCX opens in Web Layout instead.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding UnlimitedHeight, Mode=TwoWay}" />
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Table of contents"
                                                     Description="A linked contents list built from the document's headings, at the top of the preview and every export.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding IncludeToc, Mode=TwoWay}" />
                            </localcontrols:OptionRow>

                                    </StackPanel>
                                </Expander>

                            <!-- ══════════ WORD EXPORT ══════════ -->
                                <Expander x:Name="StyleWordExpander" Tag="Word" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                            <TextBlock Text="Word export" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="12">
                            <localcontrols:OptionRow Header="Page border"
                                                     Description="A decorative frame around every page.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding PageBorder, Mode=TwoWay}" />
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Track changes"
                                                     Description="The document opens with Word's revision tracking on, so every later edit shows.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding TrackChanges, Mode=TwoWay}" />
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Diagrams"
                                                     Description="ShapeForge rebuilds Mermaid diagrams (flowchart, sequence, class/ER, pie, gantt, mind map, timeline, quadrant) from Word's own shapes, every box and arrow editable. Anything it can't parse falls back to a picture.">
                                <localcontrols:OptionRow.Details>
                                    <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="Diagrams in Word exports"
                                              SelectedIndex="{Binding MermaidDocxMode, Mode=TwoWay}">
                                        <x:String>Picture of the diagram</x:String>
                                        <x:String>ShapeForge™ editable shapes</x:String>
                                    </ComboBox>
                                </localcontrols:OptionRow.Details>
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Glued connectors"
                                                     Description="Lines stay attached to their shapes when you drag them in Word.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding SmartConnectors, Mode=TwoWay}" />
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Connector arrowheads"
                                                     Description="Used for connectors whose diagram source doesn't pick one.">
                                <localcontrols:OptionRow.Details>
                                    <!-- Tag is the stored value (DrawingML arrow names); Content is what people read. -->
                                    <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="Connector arrowheads"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding ConnectorArrowhead, Mode=TwoWay}">
                                        <ComboBoxItem Content="Default (from the diagram)" Tag="default" />
                                        <ComboBoxItem Content="Triangle" Tag="triangle" />
                                        <ComboBoxItem Content="Open arrow" Tag="open" />
                                        <ComboBoxItem Content="Diamond" Tag="diamond" />
                                        <ComboBoxItem Content="Oval" Tag="oval" />
                                        <ComboBoxItem Content="Stealth" Tag="stealth" />
                                        <ComboBoxItem Content="None" Tag="none" />
                                    </ComboBox>
                                </localcontrols:OptionRow.Details>
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Shrink wide diagrams to fit"
                                                     Description="Scale diagrams wider than the page down to fit inside its margins.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}"
                                              IsOn="{Binding OversizedDiagramMode, Mode=TwoWay, Converter={StaticResource OversizedDiagramModeConverter}}" />
                            </localcontrols:OptionRow>

                                    </StackPanel>
                                </Expander>

                            <!-- ══════════ DIAGRAMS ══════════ -->
                                <Expander x:Name="StyleDiagramsExpander" Tag="Diagrams" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xF003;" FontSize="14" />
                                            <TextBlock Text="Diagrams" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="12">
                            <localcontrols:OptionRow Header="Render Mermaid diagrams"
                                                     Description="Off: Mermaid code blocks stay as plain code in the preview and every export.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding MermaidEnabled, Mode=TwoWay}" />
                            </localcontrols:OptionRow>
                            <!-- Collapsed as well as closed: a closed InfoBar still took the panel's
                                 spacing plus its own margin, leaving a gap under the caption. -->
                            <InfoBar IsOpen="{Binding HasMermaidDiagram}"
                                     Visibility="{Binding HasMermaidDiagram, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Severity="{Binding DiagramHintSeverity, Converter={StaticResource StatusSeverityConverter}}"
                                     Message="{Binding DiagramHintText}"
                                     IsClosable="False">
                                <InfoBar.ActionButton>
                                    <Button Click="OnOpenMermaidStudioClick" ToolTipService.ToolTip="Open the visual Mermaid Diagram Studio (Ctrl+Shift+M)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE943;" FontSize="14" />
                                        <TextBlock Text="Diagram Studio" />
                                    </StackPanel>
                                </Button>
                                </InfoBar.ActionButton>
                            </InfoBar>

                                    </StackPanel>
                                </Expander>

                            <!-- ══════════ CONTENT & CLEANUP ══════════ -->
                                <Expander x:Name="StyleContentExpander" Tag="Content" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8D2;" FontSize="14" />
                                            <TextBlock Text="Content &amp; cleanup" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="12">
                            <localcontrols:OptionRow Header="Fix AI formatting quirks"
                                                     Description="ChatGPT's LaTeX and citation pips, Gemini's pseudo-headings, Claude's leftover tags.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding NormalizeLlm, Mode=TwoWay}" />
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Custom cleanup rules"
                                                     Description="Strip your pet-peeve AI phrases (e.g. 'In conclusion', 'delve'). Applied after the fixes above, while they're on. Type \n for a line break; regex rules can use $1 captures.">
                                <localcontrols:OptionRow.Details>
                                <StackPanel Spacing="8">
                            <!-- The rules only run inside the AI-quirks pass. Say so instead of leaving
                                 the user to wonder why a rule does nothing. -->
                            <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="4" Padding="8,6"
                                    Visibility="{Binding NormalizationRulesPaused, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE769;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <TextBlock Grid.Column="1" Text="Paused: turn on Fix AI formatting quirks to run these rules."
                                               TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Border>
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="6"
                                    Visibility="{Binding HasNormalizationRules, Converter={StaticResource BoolToVisibilityConverter}}">
                                <!-- No inner scroller: rows now carry a status line, and a 140 px nested
                                     scroll hid most of them inside a pane that already scrolls. -->
                                    <StackPanel Spacing="4">
                                        <ItemsControl ItemsSource="{Binding NormalizationRules}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Spacing="2" Margin="0,0,0,4">
                                                    <Grid services:HoverPolish.ApplyOnLoad="True" ColumnSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- FindText/ReplaceText show line breaks and tabs as \n and \t: these boxes
                                                             are single-line, so a real break showed as nothing. -->
                                                        <TextBox Text="{Binding FindText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 PlaceholderText="Find" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                                                                 AutomationProperties.Name="Find"
                                                                 ToolTipService.ToolTip="Text to find, any case. \n is a line break, \t a tab." />
                                                        <TextBox Grid.Column="1" Text="{Binding ReplaceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 PlaceholderText="Replace" ToolTipService.ToolTip="Leave blank to strip the match. \n is a line break."
                                                                 AutomationProperties.Name="Replace with"
                                                                 FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />
                                                        <!-- A ".*" toggle, as in VS Code's find box. It was a bare CheckBox, whose
                                                             default MinWidth of 120 left a dead gap and squeezed Find/Replace until
                                                             their text and placeholders clipped. -->
                                                        <ToggleButton Grid.Column="2" IsChecked="{Binding IsRegex, Mode=TwoWay}" Content=".*"
                                                                      FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" Padding="7,4" MinWidth="0"
                                                                      VerticalAlignment="Stretch"
                                                                      ToolTipService.ToolTip="Treat Find as a regular expression"
                                                                      AutomationProperties.Name="Treat Find as a regular expression" />
                                                        <Button Grid.Column="3" Padding="6,4" VerticalAlignment="Stretch"
                                                                ToolTipService.ToolTip="Remove this rule"
                                                                AutomationProperties.Name="Remove this rule"
                                                                Command="{Binding ElementName=RootGrid, Path=DataContext.RemoveNormalizationRuleCommand}"
                                                                CommandParameter="{Binding}">
                                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                        </Button>
                                                    </Grid>
                                                    <!-- Checked as you type (bad pattern) and after each preview pass (matches). -->
                                                    <Grid ColumnSpacing="5" Margin="2,0,0,0"
                                                                Visibility="{Binding HasPatternError, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE783;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding PatternError}" FontSize="11" TextWrapping="Wrap"
                                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Status}" FontSize="11" Margin="2,0,0,0"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                            </Border>
                            <Button FontSize="12" Padding="10,4"
                                    Command="{Binding AddNormalizationRuleCommand}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Add rule" />
                                </StackPanel>
                            </Button>
                                </StackPanel>
                                </localcontrols:OptionRow.Details>
                            </localcontrols:OptionRow>
                            <localcontrols:OptionRow Header="Source attribution"
                                                     Description="A strip at the top naming the AI the text came from and how many fixes were applied. Only shown when the source is recognised.">
                                <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding ShowAttribution, Mode=TwoWay}" />
                            </localcontrols:OptionRow>

                                    </StackPanel>
                                </Expander>

                            <!-- ══════════ FORMATTING & TEXT ══════════ -->
                                <Expander x:Name="StyleFormattingExpander" Tag="Formatting" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE943;" FontSize="14" />
                                            <TextBlock Text="Formatting &amp; text" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="12">
                                        <localcontrols:OptionRow Header="No emoji"
                                                                 Description="Strips every emoji, whatever the input, from the preview and every export.">
                                            <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding NoEmoji, Mode=TwoWay}" />
                                        </localcontrols:OptionRow>

                                        <localcontrols:OptionRow Header="Em dashes (—)"
                                                                 Description="Swap AI-style em dashes everywhere except code blocks.">
                                            <localcontrols:OptionRow.Details>
                                                <StackPanel Spacing="8">
                                                    <ComboBox HorizontalAlignment="Stretch" AutomationProperties.Name="Em dashes"
                                                              SelectedIndex="{Binding DashMode, Mode=TwoWay}">
                                                        <x:String>Keep as-is</x:String>
                                                        <x:String>Replace with hyphen (-)</x:String>
                                                        <x:String>Replace with spaced ( - )</x:String>
                                                        <x:String>Custom…</x:String>
                                                    </ComboBox>
                                                    <TextBox PlaceholderText="Replace each em dash with…" AutomationProperties.Name="Custom em dash replacement"
                                                             Text="{Binding DashCustom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding IsDashCustom, Converter={StaticResource BoolToVisibilityConverter}}"
                                                             IsSpellCheckEnabled="False" />
                                                </StackPanel>
                                            </localcontrols:OptionRow.Details>
                                        </localcontrols:OptionRow>

                                        <localcontrols:OptionRow Header="Heading level shift"
                                                                 Description="Promote (−) or demote (+) every heading: +1 turns # into ##. Levels stay within 1–6.">
                                            <NumberBox Value="{Binding HeadingShift, Mode=TwoWay}" Width="96"
                                                       AutomationProperties.Name="Heading level shift"
                                                       SpinButtonPlacementMode="Compact" Minimum="-5" Maximum="5" SmallChange="1" />
                                        </localcontrols:OptionRow>

                                        <localcontrols:OptionRow Header="Bold text">
                                            <ComboBox Width="150" AutomationProperties.Name="Bold text"
                                                      SelectedIndex="{Binding BoldMode, Mode=TwoWay}">
                                                <x:String>Keep</x:String>
                                                <x:String>Plain text</x:String>
                                                <x:String>Make italic</x:String>
                                            </ComboBox>
                                        </localcontrols:OptionRow>
                                        <localcontrols:OptionRow Header="Italic text">
                                            <ComboBox Width="150" AutomationProperties.Name="Italic text"
                                                      SelectedIndex="{Binding ItalicMode, Mode=TwoWay}">
                                                <x:String>Keep</x:String>
                                                <x:String>Plain text</x:String>
                                            </ComboBox>
                                        </localcontrols:OptionRow>
                                    </StackPanel>
                                </Expander>

                            <!-- ══════════ BRANDING (PRO) ══════════ -->
                                <Expander x:Name="ExportBrandingExpander" Tag="Branding" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8D4;" FontSize="14" />
                                        <TextBlock Text="Branding" FontWeight="SemiBold" />
                                        <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="4" Padding="5,1"
                                                VerticalAlignment="Center" Visibility="{Binding ShowProBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Turn a converted chat into a client-ready deliverable: a cover page, your logo and your typeface."
                                               Style="{StaticResource StepCaptionStyle}" TextWrapping="Wrap" />
                                    <localcontrols:OptionRow Header="Cover page"
                                                             Description="A Word title page with the document's title, your logo and today's date.">
                                        <ToggleSwitch Style="{StaticResource PanelToggleStyle}" IsOn="{Binding BrandCoverPage, Mode=TwoWay}" />
                                    </localcontrols:OptionRow>
                                    <localcontrols:OptionRow Header="Company logo"
                                                             Description="PNG or JPEG, placed on the Word cover page and used as an e-book's cover.">
                                        <localcontrols:OptionRow.Details>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding BrandLogoPath, Mode=TwoWay}" AutomationProperties.Name="Company logo file"
                                                         PlaceholderText="No logo chosen" IsSpellCheckEnabled="False" />
                                                <Button Grid.Column="1" VerticalAlignment="Stretch" Click="OnBrowseLogoClick"
                                                        ToolTipService.ToolTip="Choose a logo image (PNG/JPEG)"
                                                        AutomationProperties.Name="Choose a logo image">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </localcontrols:OptionRow.Details>
                                    </localcontrols:OptionRow>
                                    <localcontrols:OptionRow Header="Document font"
                                                             Description="Any installed typeface, used for the body in the preview and every export. Blank: the fallback font from Settings.">
                                        <localcontrols:OptionRow.Details>
                                            <TextBox Text="{Binding BrandFontFamily, Mode=TwoWay}" AutomationProperties.Name="Document font family"
                                                     PlaceholderText="e.g. Inter, Georgia" IsSpellCheckEnabled="False" />
                                        </localcontrols:OptionRow.Details>
                                    </localcontrols:OptionRow>
                                    <localcontrols:OptionRow Header="Embedded font file"
                                                             Description="A .ttf or .otf that isn't installed on this PC, embedded so the document looks the same anywhere.">
                                        <localcontrols:OptionRow.Details>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding CustomFontPath, Mode=TwoWay}" AutomationProperties.Name="Embedded font file"
                                                         PlaceholderText="No font file chosen" IsSpellCheckEnabled="False" />
                                                <Button Grid.Column="1" VerticalAlignment="Stretch" Click="OnBrowseFontClick"
                                                        ToolTipService.ToolTip="Choose a .ttf or .otf font file"
                                                        AutomationProperties.Name="Choose a font file">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </localcontrols:OptionRow.Details>
                                    </localcontrols:OptionRow>
                                    <localcontrols:OptionRow Header="Author"
                                                             Description="Written into the file's properties as its author, in Word, PDF and PowerPoint.">
                                        <localcontrols:OptionRow.Details>
                                            <TextBox Text="{Binding AuthorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Author name"
                                                     PlaceholderText="Your name or company" IsSpellCheckEnabled="False" />
                                        </localcontrols:OptionRow.Details>
                                    </localcontrols:OptionRow>
                                </StackPanel>
                                </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

<Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding OutputFolder, Mode=TwoWay}"
                             PlaceholderText="Output folder (defaults to next to the input file)"
                             IsSpellCheckEnabled="False" ToolTipService.ToolTip="Output folder" />

                    <Button Grid.Column="1" VerticalAlignment="Stretch" Click="OnBrowseFolderClick"
                            ToolTipService.ToolTip="Choose output folder">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    </Button>

                    <Button Grid.Column="2" VerticalAlignment="Stretch" Click="OnOpenOutputClick"
                            IsEnabled="{Binding HasOutput}" ToolTipService.ToolTip="Open last output"
                            AutomationProperties.Name="Open output">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                            <!-- Hidden when the pane is narrow (code-behind) so the folder path keeps room. -->
                            <TextBlock x:Name="OpenOutputLabel" Text="Open output" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- The primary export fills the row; Cancel and the busy ring only take space while
                     an export is actually running (a permanently greyed-out Cancel used to sit here
                     and was clipped off the edge whenever the pane was narrow). -->
                <Grid Grid.Row="3">
                    <!-- Margins, not ColumnSpacing: spacing would still be reserved beside the
                         collapsed Cancel / ring and leave the button short of the row above. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- ISS-016: export actions collapsed into a single SplitButton so the toolbar
                         no longer overflows the window at narrow widths / in Split View. -->
                    <!-- ISS-019: Word (.docx) is the default export — the primary click generates
                         a .docx; PDF and the rest live in the chevron flyout. -->
                    <SplitButton x:Name="ExportSplitButton" Grid.Column="0" Height="40" HorizontalAlignment="Stretch"
                                 AutomationProperties.Name="Generate Word document"
                                 Click="OnPrimaryExportClick" IsEnabled="{Binding IsNotBusy}"
                                 ToolTipService.ToolTip="Generate a Word document — use the chevron for other formats">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="16" />
                            <TextBlock Text="Generate Word (.docx)" FontWeight="SemiBold" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Export as Word (.docx)" Click="OnConvertDocxClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Export as PDF (.pdf)" Click="OnConvertPdfClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE749;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Export as PowerPoint (.pptx)" Click="OnConvertPptxClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Export as EPUB (.epub)" Click="OnExportEpubClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE82D;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Export to Google Docs (native)" Click="OnExportGoogleDocsClick"
                                                ToolTipService.ToolTip="Creates a real Google Doc (headings, tables, images) — connect your Google account in Settings → Google first">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE753;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Export as web page (.html)" Click="OnExportHtmlClick"
                                                ToolTipService.ToolTip="A self-contained HTML file of the rendered document, styled with the current theme">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE12B;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Export as Markdown (.md)" Click="OnExportMarkdownClick"
                                                ToolTipService.ToolTip="Save the recovered/cleaned source as a Markdown file — the counterpart to importing a .docx">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C3;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Export all licensed formats" Click="OnExportAllClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71D;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <Button Grid.Column="1" Height="40" Content="Cancel" Margin="8,0,0,0"
                            Command="{Binding CancelConversionCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTipService.ToolTip="Cancel the export in progress" />

                    <ProgressRing Grid.Column="2" IsActive="{Binding IsBusy}" Width="22" Height="22" Margin="8,0,0,0"
                                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                  VerticalAlignment="Center" />
                </Grid>
            </Grid>

        </Grid>

        <!-- Persistent status bar: a full-width strip along the bottom of the window with the
             changing status text docked bottom-left like a typical status bar (busy ring,
             detected-source badge, severity-colored message) and the Ln/Col readout on the
             right. Replaces the ISS-013 floating pill, which overlapped the editor's bottom
             buttons at the default 1220×800 launch size. -->
        <Border Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="16,5">
                    <ProgressRing IsActive="{Binding IsBusy}" Width="14" Height="14" VerticalAlignment="Center" />
                    <Border x:Name="DetectedBadge" Visibility="Collapsed" CornerRadius="12" Padding="10,4"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE945;" FontSize="12"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding DetectedSourceText}" FontSize="12"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="StatusMsgText" Text="{Binding StatusText}"
                               VerticalAlignment="Center" FontSize="12" Opacity="0.85"
                               Foreground="{Binding StatusSeverity, Converter={StaticResource StatusSeverityToBrushConverter}}"
                               TextTrimming="CharacterEllipsis" MaxWidth="560"
                               ToolTipService.ToolTip="{Binding StatusText}" />
                    <!-- Shown only while the status line is announcing a finished export (the
                         Windows toast is easy to miss, or switched off entirely). -->
                    <StackPanel x:Name="StatusOutputLinks" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                Visibility="{Binding HasStatusOutput, Converter={StaticResource BoolToVisibilityConverter}}">
                        <HyperlinkButton Click="OnStatusOpenOutputClick" Padding="6,1" FontSize="12"
                                         ToolTipService.ToolTip="Open the exported file"
                                         AutomationProperties.Name="Open exported file">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE8E5;" FontSize="11" />
                                <TextBlock Text="Open" />
                            </StackPanel>
                        </HyperlinkButton>
                        <HyperlinkButton Click="OnStatusShowOutputFolderClick" Padding="6,1" FontSize="12"
                                         ToolTipService.ToolTip="Show the exported file in File Explorer"
                                         AutomationProperties.Name="Show exported file in folder">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE838;" FontSize="11" />
                                <TextBlock Text="Show in folder" />
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="16,5">
                    <TextBlock Text="{Binding WordCountText}" VerticalAlignment="Center" FontSize="11.5" Opacity="0.7"
                               ToolTipService.ToolTip="{Binding DocumentStatsDetail}" />
                    <Border Width="1" Height="12" Background="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="CursorPosText" Text="Ln 1, Col 1" VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="11.5" Opacity="0.7"
                               ToolTipService.ToolTip="Cursor position in the Markdown editor" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- Dedicated background WebView2 host for headless exports and diagram harvesting — keeps background compiles from ever flashing or resetting the live preview pane. -->
        <WebView2 x:Name="ExportWebView" Visibility="Collapsed" Width="0" Height="0" />
    </Grid>
</Window>

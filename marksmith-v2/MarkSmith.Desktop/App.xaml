<Application
    x:Class="MarkSmith.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- MarkSmith's brand accent — the electric blue of the logo's spark — instead of the
                 machine's Windows accent. A grey or near-black system accent made every primary
                 button (Next, Export, Start trial), step badge and selection look disabled. Every
                 Accent* brush, AccentButtonStyle and the focus/selection visuals derive from this
                 ramp, in both themes (light uses Dark1, dark uses Light2, per the Fluent rules). -->
            <Color x:Key="SystemAccentColor">#1A8CFF</Color>
            <Color x:Key="SystemAccentColorLight1">#47A3FF</Color>
            <Color x:Key="SystemAccentColorLight2">#7ABDFF</Color>
            <Color x:Key="SystemAccentColorLight3">#B0D8FF</Color>
            <Color x:Key="SystemAccentColorDark1">#0068C9</Color>
            <Color x:Key="SystemAccentColorDark2">#00519E</Color>
            <Color x:Key="SystemAccentColorDark3">#003B73</Color>

            <!-- Pipeline column card -->
            <Style x:Key="PipelineCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <!-- Zebra (checker) alternate for adjacent cards — each button+description group reads as
                 its own band (grey / dark-grey), adapting to light & dark themes automatically. -->
            <Style x:Key="PipelineCardZebraStyle" TargetType="Border" BasedOn="{StaticResource PipelineCardStyle}">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            </Style>

            <!-- Numbered step badge -->
            <Style x:Key="StepBadgeStyle" TargetType="Border">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="StepBadgeTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="StepTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="StepCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Opacity" Value="0.6" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Toggle inside a Settings row or a side-panel OptionRow. Stock ToggleSwitch has
                 MinWidth 154, which parked the switch mid-row with a dead gap after "Off"; a fixed
                 width, right-aligned, puts every track at the same x and stops the knob shifting
                 between On and Off. -->
            <Style x:Key="OptionToggleStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="84" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="0,-2,0,-2" />
            </Style>

            <!-- The side panels' version: the bare switch, no On/Off text. The panels are ~300px
                 wide, and the 84px text column wrapped every description to four lines; the
                 track's own fill already says on or off. -->
            <Style x:Key="PanelToggleStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="0,-2,-10,-2" />
            </Style>

            <!-- Section label inside a side-panel expander (e.g. Automation's "Folder watcher"). -->
            <Style x:Key="OptionSectionStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,6,0,-4" />
            </Style>

            <!-- Chevron between pipeline stages -->
            <Style x:Key="FlowChevronStyle" TargetType="FontIcon">
                <Setter Property="Glyph" Value="&#xE76C;" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Opacity" Value="0.35" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

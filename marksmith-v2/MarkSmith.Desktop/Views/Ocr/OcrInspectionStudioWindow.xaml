<Window
    x:Class="MarkSmith.Views.Ocr.OcrInspectionStudioWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OCR Inspection Studio — MarkSmith">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- Row 0: Custom Window TitleBar -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Status & Call-To-Action Ribbon -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Main 3-Pane Inspection Studio Stage -->
            <RowDefinition Height="*" />
            <!-- Row 3: Footer Status & Metrics Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Window Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="14,0"
              Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: App Icon & Studio Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/logo.png" Width="22" Height="22" VerticalAlignment="Center" />
                <TextBlock Text="OCR Inspection Studio" FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                <Border x:Name="EngineBadgeBorder" CornerRadius="4" Padding="6,1,6,2"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="EngineBadgeText" Text="MarkSmith OCR" FontSize="11"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                </Border>
            </StackPanel>

            <!-- Center: Interactive Page Flicking Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="PrevPageButton" Click="OnPrevPageClick"
                        Padding="8,4" CornerRadius="4"
                        ToolTipService.ToolTip="Previous Page (Left Arrow or Page Up)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE76B;" FontSize="10" />
                        <TextBlock Text="Previous Page" FontSize="11.5" />
                    </StackPanel>
                </Button>

                <Border x:Name="PageIndicatorBorder" CornerRadius="4" Padding="10,3"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="PageIndicatorText" Text="Page 1 of 1" FontSize="11.5" FontWeight="SemiBold"
                               FontFamily="Consolas" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Border>

                <Button x:Name="NextPageButton" Click="OnNextPageClick"
                        Padding="8,4" CornerRadius="4"
                        ToolTipService.ToolTip="Next Page (Right Arrow or Page Down)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="Next Page" FontSize="11.5" />
                        <FontIcon Glyph="&#xE76C;" FontSize="10" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Right: Session Telemetry Counters -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,140,0">
                <Border CornerRadius="4" Padding="8,3" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="Elements:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="HeaderElementsCountText" Text="0" FontSize="11" FontWeight="Bold" FontFamily="Consolas" />
                    </StackPanel>
                </Border>
                <Border CornerRadius="4" Padding="8,3" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="Reclassified:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="HeaderReclassifiedCountText" Text="0" FontSize="11" FontWeight="Bold"
                                   FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Row 1: Action Ribbon & Call-to-Action Bar -->
        <Border Grid.Row="1" Padding="18,10,18,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <!-- Status Banner & Subtitle -->
                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="StatusBannerIcon" Glyph="&#xE73E;" FontSize="14"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusBannerText"
                                   Text="Scan In Progress — Decomposing layout geometry and recognizing elements…"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="StatusSubtext"
                               Text="Flick through pages to inspect detected elements. Click any element to reclassify it between Picture, Mosaic, Diagram, Table, Key-Value, or Text. Hit 'Import into MarkSmith' to apply."
                               FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Prominent Call-To-Action (CTA) Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="DiscardButton" Click="OnDiscardClick"
                            Padding="12,7" CornerRadius="6"
                            ToolTipService.ToolTip="Close studio without importing changes into the application (Esc)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                            <TextBlock Text="Cancel &amp; Discard" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ImportCtaButton" Click="OnImportCtaClick"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="18,7" CornerRadius="6"
                            FontWeight="SemiBold"
                            ToolTipService.ToolTip="Finalize import and open assembled Markdown in the main editor (Ctrl+Enter)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE898;" FontSize="13" />
                            <TextBlock Text="Import into MarkSmith" FontSize="12.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: 3-Pane Inspection Studio Stage -->
        <Grid Grid.Row="2" Padding="14,12" ColumnDefinitions="460,340,*" ColumnSpacing="12">
            <!-- Left Pane: Document Page Canvas & Element Bounding Boxes -->
            <Border Grid.Column="0" CornerRadius="8" Padding="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                    <!-- Pane Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="PAGE CANVAS &amp; BOUNDING BOXES" FontSize="11" FontWeight="SemiBold"
                                       CharacterSpacing="30" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="CanvasMetricsText" Grid.Column="1" Text="0 × 0 px"
                                   FontSize="10.5" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <!-- Page Viewport Well -->
                    <Border Grid.Row="1" CornerRadius="6" Padding="4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid x:Name="PageViewportGrid" SizeChanged="OnPageViewportSizeChanged"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Border x:Name="PageSheetBorder"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    CornerRadius="4" Background="#FFFFFF"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid x:Name="PageSheetGrid" Width="380" Height="520">
                                    <!-- Real Page Image -->
                                    <Image x:Name="DocumentImage" Stretch="Fill" />

                                    <!-- Interactive Element Frames Canvas -->
                                    <Canvas x:Name="ElementsCanvas" Width="380" Height="520" />

                                    <!-- Sweeping Scan Laser Beam Canvas -->
                                    <Canvas x:Name="LaserCanvas" Width="380" Height="520" IsHitTestVisible="False">
                                        <Border x:Name="LaserBeam" Height="3" Width="380"
                                                Visibility="Collapsed" CornerRadius="1.5"
                                                Background="#D91A8CFF">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="LaserTransform" Y="0" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Canvas>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Live Word Ticker HUD -->
                    <Border Grid.Row="2" CornerRadius="6" Padding="8,5"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Text="OCR STREAM" FontSize="10" FontWeight="Bold" FontFamily="Consolas"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="WordStreamText" Grid.Column="1" Text="Ready"
                                       FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="WordCountBadgeText" Grid.Column="2" Text="0 words"
                                       FontSize="10.5" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Middle Pane: Element Hierarchy & Reclassification Inspector -->
            <Border Grid.Column="1" CornerRadius="8" Padding="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                    <!-- Pane Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="ELEMENT INSPECTOR" FontSize="11" FontWeight="SemiBold"
                                       CharacterSpacing="30" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="SelectedElementBadgeText" Grid.Column="1" Text="Click box to edit"
                                   FontSize="10.5" FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Grid>

                    <!-- Scrollable Element Cards List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ElementCardsPanel" Spacing="6" Padding="0,2,4,8" />
                    </ScrollViewer>

                    <!-- Selected Element Action Box -->
                    <Border Grid.Row="2" CornerRadius="6" Padding="10,8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="QUICK RECLASSIFY SELECTED" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <ComboBox x:Name="QuickReclassifyComboBox"
                                          SelectionChanged="OnQuickReclassifySelectionChanged"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="🖼 Picture" Tag="Picture" />
                                    <ComboBoxItem Content="✨ Mosaic / Shape" Tag="ShapeMosaic" />
                                    <ComboBoxItem Content="📐 Diagram" Tag="Diagram" />
                                    <ComboBoxItem Content="📊 Table" Tag="Table" />
                                    <ComboBoxItem Content="🔑 Key-Value" Tag="KeyValue" />
                                    <ComboBoxItem Content="📌 Heading" Tag="Heading" />
                                    <ComboBoxItem Content="📑 List" Tag="List" />
                                    <ComboBoxItem Content="📝 Text Block" Tag="Paragraph" />
                                </ComboBox>
                                <Button x:Name="ResetElementButton" Grid.Column="1" Click="OnResetElementClick"
                                        Padding="8,5" ToolTipService.ToolTip="Reset to original engine interpretation">
                                    <FontIcon Glyph="&#xE7A7;" FontSize="11" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Pane: Live Markdown Preview -->
            <Border Grid.Column="2" CornerRadius="8" Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <!-- Pane Header & View Toggle -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="LIVE MARKDOWN PREVIEW" FontSize="11" FontWeight="SemiBold"
                                       CharacterSpacing="30" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- Toggle between Current Page and Full Document view -->
                        <ComboBox x:Name="MarkdownScopeComboBox" Grid.Column="1"
                                  SelectionChanged="OnMarkdownScopeChanged" SelectedIndex="0"
                                  Padding="10,4" FontSize="11.5">
                            <ComboBoxItem Content="Current Page Markdown" />
                            <ComboBoxItem Content="Full Document Markdown" />
                        </ComboBox>
                    </Grid>

                    <!-- Markdown Source Viewer -->
                    <Border Grid.Row="1" CornerRadius="6" Padding="10"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox x:Name="MarkdownPreviewTextBox"
                                     IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="12"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     Background="Transparent" BorderThickness="0" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 3: Footer Status & Progress Bar -->
        <Grid Grid.Row="3" Padding="16,8,16,10" RowDefinitions="Auto,Auto" RowSpacing="5"
              Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <TextBlock x:Name="FooterStatusText"
                           Text="OCR Studio active — Ready to finalize document import into MarkSmith."
                           FontSize="11.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="SessionMetricsText" Grid.Column="1"
                           Text="1 Page · 0 Elements · 0 Words"
                           FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <ProgressBar x:Name="StageProgressBar" Grid.Row="1"
                         Minimum="0" Maximum="100" Value="100" Height="3" CornerRadius="1.5"
                         Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
        </Grid>
    </Grid>
</Window>

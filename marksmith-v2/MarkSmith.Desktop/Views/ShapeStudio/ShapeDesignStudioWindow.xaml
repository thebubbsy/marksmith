                        <!-- Grid Snap & Colour scheme controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button x:Name="GridSnapButton" Style="{StaticResource ToolIconButton}" Padding="8,4"
                                    Click="OnGridSnapButtonClick"
                                    DoubleTapped="OnGridSnapButtonDoubleTapped"
                                    RightTapped="OnGridSnapButtonRightTapped"
                                    AutomationProperties.Name="Canvas grid snap"
                                    ToolTipService.ToolTip="Canvas grid and magnetic snap (Off, 10px, 20px · Double-click to cycle, Right-click for presets)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE80A;" FontSize="13" />
                                    <TextBlock x:Name="GridSnapLabel" Text="Snap · Off" FontSize="11.5" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="GridSnapFlyout">
                                        <MenuFlyoutItem Text="Grid snap: Off" Click="OnGridSnapOffClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Grid snap: 10px (Fine)" Click="OnGridSnap10Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80A;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Grid snap: 20px (Standard)" Click="OnGridSnap20Click">

<Window
    x:Class="MarkSmith.Views.ShapeStudio.ShapeDesignStudioWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:MarkSmith.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:MarkSmith.Converters"
    mc:Ignorable="d"
    Title="Shape Studio — MarkSmith">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <conv:ShapeGeometryConverter x:Key="ShapeGeom" />
            <conv:FillBrushConverter x:Key="FillBrushConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVis" />
            <conv:InsetsToThicknessConverter x:Key="InsetsToMargin" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:PresetDisplayNameConverter x:Key="PresetName" />
            <conv:UprightLabelAngleConverter x:Key="UprightLabel" />
            <Style x:Key="InspectorLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="InspectorAxis" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="PaneCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <!-- Square icon buttons in the canvas toolbar: one size, one padding, so the row reads
                 as a single control strip instead of a run of differently sized chips. -->
            <Style x:Key="ToolIconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar + window commands -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="56" Padding="16,0" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE790;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Shape Studio" FontWeight="SemiBold" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Diagrams built from native Word shapes — still editable in Word, never flattened to a picture"
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="ClearCanvasButton" Click="OnClearClick" IsEnabled="{Binding HasShapes}"
                        RightTapped="OnClearCanvasButtonRightTapped"
                        ToolTipService.ToolTip="Remove every shape from the canvas (Ctrl+Z brings them back, Right-click for options)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE894;" FontSize="14" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>
                <DropDownButton x:Name="ExportDropDownButton" AutomationProperties.Name="Export"
                                RightTapped="OnExportDropDownButtonRightTapped"
                                ToolTipService.ToolTip="Save the diagram as a Word file, or move it in and out as Markdown (Right-click for options)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ExportMenu" Placement="BottomEdgeAlignedRight" Opening="OnExportMenuOpening">
                            <MenuFlyoutItem x:Name="ExportDocxItem" Text="Word document (.docx)…" Click="OnExportDocxClick">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ExportDotxItem" Text="Word template (.dotx)…" Click="OnExportDotxClick">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F1;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="CopyMarkdownItem" Text="Copy as Markdown" KeyboardAcceleratorTextOverride="Ctrl+Shift+C" Click="OnCopyMarkdownClick">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Load Markdown from clipboard" KeyboardAcceleratorTextOverride="Ctrl+V" Click="OnLoadMarkdownClick">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="InsertIntoDocumentButton" Command="{Binding InsertIntoDocumentCommand}" Style="{ThemeResource AccentButtonStyle}"
                        RightTapped="OnInsertIntoDocumentButtonRightTapped"
                        AutomationProperties.Name="Insert into document"
                        ToolTipService.ToolTip="Insert this diagram into the open document (Ctrl+Enter, Right-click for options)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                        <TextBlock Text="Insert into document" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" ColumnSpacing="10" Padding="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Presets | Shapes | Picture. One section at a time, each with the full pane
                 height — the old single scroll put the shape palette and the picture tracer below
                 the fold, so most people never found them. -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <SelectorBar x:Name="LeftTabs" Margin="6,4,6,0" SelectionChanged="OnLeftTabsChanged"
                                 RightTapped="OnLeftTabsRightTapped"
                                 ToolTipService.ToolTip="Switch between Presets, Shapes, and Picture (Right-click for options)">
                        <SelectorBarItem x:Name="PresetsTab" Text="Presets" IsSelected="True">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xF0E2;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="ShapesTab" Text="Shapes">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE790;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="PictureTab" Text="Picture">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xEB9F;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>

                    <!-- Presets -->
                    <Grid x:Name="PresetsPanel" Grid.Row="1" Padding="12,8,12,12" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="One click builds a finished diagram you can then edit shape by shape." Style="{StaticResource PaneCaption}" />
                        <ComboBox Grid.Row="1" x:Name="PresetCategoryCombo" AutomationProperties.Name="Preset category" ItemsSource="{Binding PresetCategories}"
                                  SelectedItem="{Binding SelectedPresetCategory, Mode=TwoWay}" HorizontalAlignment="Stretch"
                                  KeyDown="OnPresetCategoryComboKeyDown"
                                  DoubleTapped="OnPresetCategoryComboDoubleTapped"
                                  RightTapped="OnPresetCategoryComboRightTapped"
                                  ToolTipService.ToolTip="Preset categories (Enter to browse, Esc to reset, Double-click to cycle, Right-click for options)" />
                        <ListView Grid.Row="2" x:Name="PresetList" ItemsSource="{Binding FilteredPresets}" SelectionMode="None"
                                  IsItemClickEnabled="True" ItemClick="OnPresetItemClick" Margin="-12,0,-12,0" Padding="4,0"
                                  RightTapped="OnPresetListRightTapped"
                                  ToolTipService.ToolTip="Diagram presets (Right-click for options)"
                                  AutomationProperties.Name="Diagram presets">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnSpacing="12" AutomationProperties.Name="{Binding Name}"
                                          ToolTipService.ToolTip="{Binding Description}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- A live miniature of the diagram in the current colour scheme
                                             (filled in code-behind), so the list can be scanned by
                                             eye instead of by name: every preset in a category used
                                             to share one icon. -->
                                        <Border Width="64" Height="46" CornerRadius="6" VerticalAlignment="Center" Padding="5"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <Viewbox Stretch="Uniform">
                                                <Canvas Loaded="OnPresetThumbLoaded" Unloaded="OnPresetThumbUnloaded"
                                                        DataContextChanged="OnPresetThumbDataContextChanged" />
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Shapes -->
                    <ScrollViewer x:Name="ShapesPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="12,8,12,12" Spacing="8">
                            <TextBlock Text="Pick a shape, then click the canvas to drop it — or drag to draw it at the size you want." Style="{StaticResource PaneCaption}" />
                            <GridView x:Name="PaletteGrid" ItemsSource="{Binding PaletteItems}" SelectionMode="Single"
                                      SelectedItem="{Binding ArmedTool, Mode=TwoWay}" Margin="-4,0"
                                      SizeChanged="OnPaletteGridSizeChanged"
                                      DoubleTapped="OnPaletteGridDoubleTapped"
                                      RightTapped="OnPaletteGridRightTapped"
                                      ToolTipService.ToolTip="Shapes to draw · Click to arm shape, Double-click to place, Right-click for options"
                                      AutomationProperties.Name="Shapes to draw">
                                <!-- Tiles share the row evenly (OnPaletteGridSizeChanged). Fixed 84 px tiles fitted
                                     two to a row and left a third of the pane empty. -->
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" ItemHeight="82" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Height="74" Spacing="5" Padding="2,8,2,4"
                                                    AutomationProperties.Name="{Binding Converter={StaticResource PresetName}}"
                                                    ToolTipService.ToolTip="{Binding Converter={StaticResource PresetName}}">
                                            <Path Width="26" Height="22" Stretch="Uniform" HorizontalAlignment="Center"
                                                  Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                  Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.5"
                                                  Data="{Binding Converter={StaticResource ShapeGeom}}" />
                                            <TextBlock Text="{Binding Converter={StaticResource PresetName}}" FontSize="11" TextAlignment="Center" LineHeight="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Picture → vector -->
                    <ScrollViewer x:Name="PicturePanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="12,8,12,12" Spacing="12">
                            <TextBlock Text="Turn a photo or logo into Word shapes and traced line art. Set either density to 0 to skip that layer." Style="{StaticResource PaneCaption}" />

                            <!-- Image card -->
                            <Border x:Name="ImageCardBorder" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10"
                                    RightTapped="OnImageCardRightTapped"
                                    ToolTipService.ToolTip="Image to vectorize · Right-click for options">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="56" Height="56" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Grid>
                                            <FontIcon Glyph="&#xEB9F;" FontSize="20" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                            <Image x:Name="FuseThumb" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock x:Name="FuseImageLabel" Text="No image chosen" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Button x:Name="PickImageButton" Content="Choose image…" Click="OnPickImageClick" Padding="10,4"
                                                RightTapped="OnImageCardRightTapped"
                                                ToolTipService.ToolTip="Choose image file · Right-click for options" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="FuseImagePathBox" PlaceholderText="…or paste an image path here"
                                                     AutomationProperties.Name="Image file path"
                                                     DoubleTapped="OnFuseImagePathBoxDoubleTapped"
                                                     RightTapped="OnFuseImagePathBoxRightTapped"
                                                     ToolTipService.ToolTip="Image file path · Double-click to select all, Right-click for options" />
                                            <Button Grid.Column="1" Content="Use" Click="OnUseImagePathClick" Padding="10,4"
                                                    ToolTipService.ToolTip="Use the pasted path (handy when the file dialog hangs on a cloud folder)" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Shape mosaic layer -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Shape mosaic" Style="{StaticResource SectionHeader}" />
                                <Grid>
                                    <TextBlock Text="Density" Style="{StaticResource InspectorLabel}" />
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               Text="{Binding ElementName=FuseMosaicDensity, Path=Value}" />
                                </Grid>
                                <Slider AutomationProperties.Name="Mosaic density" x:Name="FuseMosaicDensity" Minimum="0" Maximum="120" Value="96" SmallChange="1" LargeChange="5"
                                        DoubleTapped="OnFuseMosaicDensityDoubleTapped"
                                        RightTapped="OnFuseMosaicDensityRightTapped"
                                        ToolTipService.ToolTip="Shape mosaic density (0..120) · Double-click for default 96, Right-click for presets" />
                                <Grid>
                                    <TextBlock Text="Tile spacing" Style="{StaticResource InspectorLabel}" />
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               Text="{Binding ElementName=FuseMosaicPadding, Path=Value}" />
                                </Grid>
                                <Slider AutomationProperties.Name="Tile spacing" x:Name="FuseMosaicPadding" Minimum="-20" Maximum="20" Value="-6" SmallChange="1" LargeChange="5" StepFrequency="1"
                                        DoubleTapped="OnFuseMosaicPaddingDoubleTapped"
                                        RightTapped="OnFuseMosaicPaddingRightTapped"
                                        ToolTipService.ToolTip="Padding around each tile (-20..+20) · Double-click for default -6, Right-click for presets" />
                                <CheckBox x:Name="CompAdaptive" Content="Smart tiles — pick each shape from the picture" MinWidth="0"
                                          Checked="OnCompAdaptiveChanged" Unchecked="OnCompAdaptiveChanged"
                                          ToolTipService.ToolTip="Flat areas become discs, edges become directional shapes, busy texture becomes hexagons. Overrides the tile-shape boxes below." />
                                <TextBlock Text="Tile shapes" Style="{StaticResource InspectorLabel}" />
                                <Grid ColumnSpacing="4" RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <CheckBox x:Name="CompRoundRect" Grid.Row="0" Grid.Column="0" Content="Rounded rect" IsChecked="True" MinWidth="0" IsEnabled="False" />
                                    <CheckBox x:Name="CompRect" Grid.Row="0" Grid.Column="1" Content="Rectangle" MinWidth="0" IsEnabled="False" />
                                    <CheckBox x:Name="CompEllipse" Grid.Row="1" Grid.Column="0" Content="Ellipse" IsChecked="True" MinWidth="0" IsEnabled="False" />
                                    <CheckBox x:Name="CompChevron" Grid.Row="1" Grid.Column="1" Content="Chevron" MinWidth="0" IsEnabled="False" />
                                    <CheckBox x:Name="CompDiamond" Grid.Row="2" Grid.Column="0" Content="Diamond" MinWidth="0" IsEnabled="False" />
                                    <CheckBox x:Name="CompHexagon" Grid.Row="2" Grid.Column="1" Content="Hexagon" MinWidth="0" IsEnabled="False" />
                                    <CheckBox x:Name="CompTriangle" Grid.Row="3" Grid.Column="0" Content="Triangle" MinWidth="0" IsEnabled="False" />
                                    <CheckBox x:Name="CompCloud" Grid.Row="3" Grid.Column="1" Content="Cloud" MinWidth="0" IsEnabled="False" />
                                </Grid>
                            </StackPanel>

                            <!-- Line-art layer -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Traced line art" Style="{StaticResource SectionHeader}" />
                                <Grid>
                                    <TextBlock Text="Density" Style="{StaticResource InspectorLabel}" />
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               Text="{Binding ElementName=FuseLineDensity, Path=Value}" />
                                </Grid>
                                <Slider AutomationProperties.Name="Line density" x:Name="FuseLineDensity" Minimum="0" Maximum="1200" Value="120" SmallChange="10" LargeChange="50" StepFrequency="10"
                                        DoubleTapped="OnFuseLineDensityDoubleTapped"
                                        RightTapped="OnFuseLineDensityRightTapped"
                                        ToolTipService.ToolTip="Traced line density (0..1200) · Double-click for default 120, Right-click for presets" />
                                <ComboBox x:Name="FuseModePicker" Header="Line style" HorizontalAlignment="Stretch" SelectedIndex="0"
                                          AutomationProperties.Name="Line style">
                                    <ComboBoxItem Content="Cross-hatch — etching" Tag="CrossHatch" />
                                    <ComboBoxItem Content="Topographic waves — flowing contours" Tag="TopographicWaves" />
                                    <ComboBoxItem Content="Calligraphic — 30° chisel strokes" Tag="Calligraphic" />
                                    <ComboBoxItem Content="Edges — outlines only" Tag="Edges" />
                                    <ComboBoxItem Content="Engraved — fine hatching" Tag="Engraved" />
                                    <ComboBoxItem Content="Scanlines — horizontal strokes" Tag="Scanlines" />
                                    <ComboBoxItem Content="Silhouette — solid shapes" Tag="Silhouette" />
                                </ComboBox>
                                <Grid ColumnSpacing="12" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="0">
                                        <Grid>
                                            <TextBlock Text="Detail" Style="{StaticResource InspectorLabel}" />
                                            <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding ElementName=FuseEdgeSensitivity, Path=Value}" />
                                        </Grid>
                                        <Slider x:Name="FuseEdgeSensitivity" Minimum="5" Maximum="80" Value="30" AutomationProperties.Name="Detail threshold"
                                                DoubleTapped="OnFuseEdgeSensitivityDoubleTapped"
                                                RightTapped="OnFuseEdgeSensitivityRightTapped"
                                                ToolTipService.ToolTip="Detail threshold (5..80) · Double-click for default 30, Right-click for presets" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="0">
                                        <Grid>
                                            <TextBlock Text="Stroke (pt)" Style="{StaticResource InspectorLabel}" />
                                            <TextBlock x:Name="StrokeWidthReadout" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="1.5" />
                                        </Grid>
                                        <Slider x:Name="FuseStrokeWidth" Minimum="0.5" Maximum="5.0" Value="1.5" StepFrequency="0.1" AutomationProperties.Name="Stroke width"
                                                ValueChanged="OnStrokeWidthChanged"
                                                DoubleTapped="OnFuseStrokeWidthDoubleTapped"
                                                RightTapped="OnFuseStrokeWidthRightTapped"
                                                ToolTipService.ToolTip="Thickness of traced ink strokes (0.5..5.0 pt) · Double-click for default 1.5 pt, Right-click for presets" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="FuseMonochrome" Content="Dark ink only (ignore the picture's colours)" IsChecked="True" MinWidth="0" />
                            </StackPanel>

                            <Button x:Name="ConvertButton" Click="OnFuseImageClick" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,8"
                                    IsEnabled="{Binding HasImage}" AutomationProperties.Name="Convert picture to shapes"
                                    RightTapped="OnConvertButtonRightTapped"
                                    ToolTipService.ToolTip="Replace the canvas with the converted picture (Ctrl+Z restores it, Right-click for options)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE945;" FontSize="14" />
                                    <TextBlock Text="Convert picture to shapes" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- CENTER: toolbar + canvas -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="8,6" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="8,8,0,0"
                          SizeChanged="OnToolbarSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="ToolStrip" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                    Background="Transparent" IsHitTestVisible="True"
                                    RightTapped="OnToolStripRightTapped"
                                    ToolTipService.ToolTip="Canvas tools (Right-click for options)">
                            <Button Style="{StaticResource ToolIconButton}" Command="{Binding UndoCommand}" AutomationProperties.Name="Undo" RightTapped="OnToolStripRightTapped" ToolTipService.ToolTip="Undo (Ctrl+Z, Right-click for options)">
                                <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource ToolIconButton}" Command="{Binding RedoCommand}" AutomationProperties.Name="Redo" RightTapped="OnToolStripRightTapped" ToolTipService.ToolTip="Redo (Ctrl+Y, Right-click for options)">
                                <FontIcon Glyph="&#xE7A6;" FontSize="14" />
                            </Button>
                            <AppBarSeparator Margin="0" Padding="0" />
                            <Button x:Name="AlignLeftButton" Style="{StaticResource ToolIconButton}" Command="{Binding AlignLeftCommand}" AutomationProperties.Name="Align left" RightTapped="OnAlignButtonRightTapped" DoubleTapped="OnAlignLeftDoubleTapped" ToolTipService.ToolTip="Align left edges — select two or more shapes (Ctrl+click · Double-click to align &amp; distribute · Right-click for alignment menu)"><PathIcon Width="14" Height="14" Data="M0.75,0.75 h1.12 v10.5 h-1.12 Z M3,2.62 h7.5 v2.25 h-7.5 Z M3,7.12 h4.5 v2.25 h-4.5 Z" /></Button>
                            <Button x:Name="AlignCenterButton" Style="{StaticResource ToolIconButton}" Command="{Binding AlignCenterCommand}" AutomationProperties.Name="Align centre" RightTapped="OnAlignButtonRightTapped" DoubleTapped="OnAlignCenterDoubleTapped" ToolTipService.ToolTip="Align centres — select two or more shapes (Ctrl+click · Double-click to align &amp; distribute · Right-click for alignment menu)"><PathIcon Width="14" Height="14" Data="M5.44,0.75 h1.12 v10.5 h-1.12 Z M1.5,2.62 h9 v2.25 h-9 Z M3,7.12 h6 v2.25 h-6 Z" /></Button>
                            <Button x:Name="AlignRightButton" Style="{StaticResource ToolIconButton}" Command="{Binding AlignRightCommand}" AutomationProperties.Name="Align right" RightTapped="OnAlignButtonRightTapped" DoubleTapped="OnAlignRightDoubleTapped" ToolTipService.ToolTip="Align right edges — select two or more shapes (Ctrl+click · Double-click to align &amp; distribute · Right-click for alignment menu)"><PathIcon Width="14" Height="14" Data="M10.12,0.75 h1.12 v10.5 h-1.12 Z M1.5,2.62 h7.5 v2.25 h-7.5 Z M4.5,7.12 h4.5 v2.25 h-4.5 Z" /></Button>
                            <Button x:Name="AlignTopButton" Style="{StaticResource ToolIconButton}" Command="{Binding AlignTopCommand}" AutomationProperties.Name="Align top" RightTapped="OnAlignButtonRightTapped" DoubleTapped="OnAlignTopDoubleTapped" ToolTipService.ToolTip="Align top edges — select two or more shapes (Ctrl+click · Double-click to align &amp; distribute · Right-click for alignment menu)"><PathIcon Width="14" Height="14" Data="M0.75,0.75 h10.5 v1.12 h-10.5 Z M2.62,3 h2.25 v7.5 h-2.25 Z M7.12,3 h2.25 v4.5 h-2.25 Z" /></Button>
                            <Button x:Name="AlignMiddleButton" Style="{StaticResource ToolIconButton}" Command="{Binding AlignMiddleCommand}" AutomationProperties.Name="Align middle" RightTapped="OnAlignButtonRightTapped" DoubleTapped="OnAlignMiddleDoubleTapped" ToolTipService.ToolTip="Align middles — select two or more shapes (Ctrl+click · Double-click to align &amp; distribute · Right-click for alignment menu)"><PathIcon Width="14" Height="14" Data="M0.75,5.44 h10.5 v1.12 h-10.5 Z M2.62,1.5 h2.25 v9 h-2.25 Z M7.12,3 h2.25 v6 h-2.25 Z" /></Button>
                            <Button x:Name="AlignBottomButton" Style="{StaticResource ToolIconButton}" Command="{Binding AlignBottomCommand}" AutomationProperties.Name="Align bottom" RightTapped="OnAlignButtonRightTapped" DoubleTapped="OnAlignBottomDoubleTapped" ToolTipService.ToolTip="Align bottom edges — select two or more shapes (Ctrl+click · Double-click to align &amp; distribute · Right-click for alignment menu)"><PathIcon Width="14" Height="14" Data="M0.75,10.12 h10.5 v1.12 h-10.5 Z M2.62,1.5 h2.25 v7.5 h-2.25 Z M7.12,4.5 h2.25 v4.5 h-2.25 Z" /></Button>
                            <AppBarSeparator Margin="0" Padding="0" />
                            <Button x:Name="DistributeHorizontalButton" Style="{StaticResource ToolIconButton}" Command="{Binding DistributeHorizontalCommand}" AutomationProperties.Name="Distribute horizontally" RightTapped="OnAlignButtonRightTapped" DoubleTapped="OnDistributeHorizontalDoubleTapped" ToolTipService.ToolTip="Space evenly left to right — select three or more shapes (Double-click to distribute and center vertically · Right-click for alignment menu)"><PathIcon Width="14" Height="14" Data="M0.75,0.75 h1.12 v10.5 h-1.12 Z M10.12,0.75 h1.12 v10.5 h-1.12 Z M4.88,3 h2.25 v6 h-2.25 Z" /></Button>
                            <Button x:Name="DistributeVerticalButton" Style="{StaticResource ToolIconButton}" Command="{Binding DistributeVerticalCommand}" AutomationProperties.Name="Distribute vertically" RightTapped="OnAlignButtonRightTapped" DoubleTapped="OnDistributeVerticalDoubleTapped" ToolTipService.ToolTip="Space evenly top to bottom — select three or more shapes (Double-click to distribute and center horizontally · Right-click for alignment menu)"><PathIcon Width="14" Height="14" Data="M0.75,0.75 h10.5 v1.12 h-10.5 Z M0.75,10.12 h10.5 v1.12 h-10.5 Z M3,4.88 h6 v2.25 h-6 Z" /></Button>
                            <AppBarSeparator Margin="0" Padding="0" />
                            <Button Style="{StaticResource ToolIconButton}" Command="{Binding BringToFrontCommand}" AutomationProperties.Name="Bring to front" RightTapped="OnToolStripRightTapped" ToolTipService.ToolTip="Bring to front (Ctrl+Shift+], Right-click for options)">
                                <FontIcon Glyph="&#xE74A;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource ToolIconButton}" Command="{Binding SendToBackCommand}" AutomationProperties.Name="Send to back" RightTapped="OnToolStripRightTapped" ToolTipService.ToolTip="Send to back (Ctrl+Shift+[, Right-click for options)">
                                <FontIcon Glyph="&#xE74B;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource ToolIconButton}" Command="{Binding RotateCounterClockwiseCommand}" AutomationProperties.Name="Rotate 90 degrees left"
                                    RightTapped="OnRotateButtonRightTapped" DoubleTapped="OnRotateCounterClockwiseDoubleTapped"
                                    ToolTipService.ToolTip="Rotate 90° counter-clockwise (Alt+Shift+Left, Double-click to turn, Right-click for angle presets)">
                                <FontIcon Glyph="&#xE7A7;" FontSize="14" RenderTransformOrigin="0.5,0.5" />

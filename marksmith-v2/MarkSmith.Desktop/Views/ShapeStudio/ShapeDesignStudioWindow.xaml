                                        </ToggleMenuFlyoutItem>
                                        <ToggleMenuFlyoutItem x:Name="ToggleSnapToCenterItem" Text="Snap to canvas center guidelines" Click="OnToggleSnapToCenterClick" IsChecked="True">
                                            <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE81E;" /></ToggleMenuFlyoutItem.Icon>
                                        </ToggleMenuFlyoutItem>
                                        <ToggleMenuFlyoutItem x:Name="ToggleSnapToShapesItem" Text="Snap to adjacent shape guidelines" Click="OnToggleSnapToShapesClick" IsChecked="True">
                                            <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE740;" /></ToggleMenuFlyoutItem.Icon>
                                        </ToggleMenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="CenterCanvasButton" Style="{StaticResource ToolIconButton}" Padding="8,4"
                                    Click="OnCenterCanvasButtonClick"
                                    DoubleTapped="OnCenterCanvasButtonDoubleTapped"
                                    RightTapped="OnCenterCanvasButtonRightTapped"
                                    AutomationProperties.Name="Center diagram on canvas"
                                    ToolTipService.ToolTip="Center diagram on canvas (Click to center, Double-click for top-left margin, Right-click for options)">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE898;" FontSize="13" />
                                    <TextBlock Text="Center" FontSize="11.5" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="CenterCanvasFlyout">
                                        <MenuFlyoutItem Text="Center horizontally and vertically" Click="OnCenterBothClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE898;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Center horizontally only" Click="OnCenterHorizontallyClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81E;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Center vertically only" Click="OnCenterVerticallyClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF003;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Reset to top-left margin (60, 60)" Click="OnResetTopLeftClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="DistributeCanvasButton" Style="{StaticResource ToolIconButton}" Padding="8,4"
                                    Click="OnDistributeCanvasButtonClick"
                                    DoubleTapped="OnDistributeCanvasButtonDoubleTapped"
                                    RightTapped="OnDistributeCanvasButtonRightTapped"
                                    AutomationProperties.Name="Distribute shapes on canvas"
                                    ToolTipService.ToolTip="Distribute shapes evenly (Click for horizontal, Double-click for vertical, Right-click for options)">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8D3;" FontSize="13" />
                                    <TextBlock Text="Distribute" FontSize="11.5" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="DistributeCanvasFlyout">
                                        <MenuFlyoutItem Text="Distribute horizontally (equal spacing)" Click="OnDistributeHorizontallyClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D3;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Distribute vertically (equal spacing)" Click="OnDistributeVerticallyClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D4;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Auto-tidy diagram grid (Flow layout)" Click="OnAutoTidyGridClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF0E2;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <!-- Selection Geometry & Bounds HUD Pill -->
                            <Border x:Name="SelectionBoundsPill" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="7,3" VerticalAlignment="Center"
                                    Tapped="OnSelectionBoundsPillTapped"
                                    DoubleTapped="OnSelectionBoundsPillDoubleTapped"
                                    RightTapped="OnSelectionBoundsPillRightTapped"
                                    ToolTipService.ToolTip="Selection geometry &amp; bounds · Click to center, double-click to square, right-click for options">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE740;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="SelectionBoundsText" Text="Shapes: 0 · Canvas 2200×1800" FontSize="11"
                                               FontFamily="Cascadia Mono, Consolas, monospace" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border.ContextFlyout>
                                    <MenuFlyout x:Name="SelectionBoundsFlyout">
                                        <MenuFlyoutItem Text="Center selection on canvas" Click="OnSelectionCenterCanvasClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81E;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Make square (equal width &amp; height)" Click="OnSelectionMakeSquareClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF003;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Reset rotation (0°)" Click="OnSelectionResetRotationClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Copy bounds geometry" Click="OnSelectionCopyBoundsClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Bring forward (Ctrl+])" Click="OnSelectionBringForwardClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74A;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Send backward (Ctrl+[)" Click="OnSelectionSendBackwardClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74B;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Bring to front (Ctrl+Shift+])" Click="OnSelectionBringToFrontClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE898;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Send to back (Ctrl+Shift+[)" Click="OnSelectionSendToBackClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Distribute horizontally (equal spacing)" Click="OnSelectionDistributeHorizontallyClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D3;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Distribute vertically (equal spacing)" Click="OnSelectionDistributeVerticallyClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D4;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Fit inside canvas (clamp with 40px padding)" Click="OnSelectionFitInsideCanvasClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73F;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="SelectionSnapToGridItem" Text="Snap selection to 10px grid" Click="OnSelectionSnapToGridClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80A;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="SelectionStandardizeRatioItem" Text="Standardize aspect ratio (16:9 widescreen)" Click="OnSelectionStandardizeRatioClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="SelectionCycleRotationItem" Text="Cycle rotation (0° / 90° / 180° / 270°)" Click="OnSelectionCycleRotationClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7AD;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="SelectionToggleCornerStyleItem" Text="Toggle corner style (Sharp / Rounded)" Click="OnSelectionToggleCornerStyleClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="SelectionCycleStrokeDashItem" Text="Cycle stroke dash (Solid / Dashed / Dotted)" Click="OnSelectionCycleStrokeDashClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B2;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="SelectionCycleOpacityItem" Text="Cycle shape opacity (100% / 75% / 50% / 25%)" Click="OnSelectionCycleOpacityClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="SelectionCycleShadowBlurItem" Text="Cycle shadow blur (0px / 4px / 8px / 16px)" Click="OnSelectionCycleShadowBlurClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="SelectionCycleCornerRadiusItem" Text="Cycle corner radius (0px / 4px / 8px / 16px)" Click="OnSelectionCycleCornerRadiusClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                            </Border>
                            <DropDownButton x:Name="PaletteButton" Padding="8,4" AutomationProperties.Name="Colour scheme"
                                            RightTapped="OnPaletteButtonRightTapped"
                                            ToolTipService.ToolTip="Colour scheme for presets and new shapes (Right-click for options)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <StackPanel x:Name="PaletteButtonSwatches" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PaletteNameText" Text="{Binding SelectedPaletteName}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                <DropDownButton.Flyout>
                                    <Flyout x:Name="PaletteFlyout" Placement="BottomEdgeAlignedRight">
                                        <StackPanel Spacing="8" Width="240">
                                            <TextBlock Text="Colour scheme" Style="{StaticResource SectionHeader}" />
                                            <TextBlock Text="Recolours the canvas now, and every preset you add after." Style="{StaticResource PaneCaption}" />
                                            <ListView x:Name="PaletteList" SelectionMode="Single" Margin="-12,0" SelectionChanged="OnPaletteListSelectionChanged" AutomationProperties.Name="Colour schemes">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Padding="0,6" Spacing="6" AutomationProperties.Name="{Binding Name}">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" />
                                                            <ItemsControl ItemsSource="{Binding Swatches}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Width="26" Height="12" CornerRadius="3" Background="{Binding}" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </Grid>

                    <!-- dense trace preview -->
                    <StackPanel Grid.Row="1" Visibility="{Binding IsDense, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Padding="20">
                        <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Image x:Name="DensePreview" Stretch="Uniform" MaxWidth="1300" MaxHeight="820" />
                        </Border>
                        <TextBlock Text="Line-art preview — every stroke exports as its own native Word line." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" MaxWidth="760" />
                    </StackPanel>

                    <!-- editable canvas -->
                    <ScrollViewer x:Name="CanvasScroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Enabled"
                                  MinZoomFactor="0.2" MaxZoomFactor="4" ViewChanged="OnCanvasViewChanged"
                                  IsTabStop="True" UseSystemFocusVisuals="False" AutomationProperties.Name="Canvas"
                                  Visibility="{Binding IsDense, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <Grid Width="2200" Height="1800">
                            <Canvas x:Name="MainCanvas" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                    PointerPressed="OnCanvasPointerPressed" PointerMoved="OnCanvasPointerMoved"
                                    PointerReleased="OnCanvasPointerReleased" PointerCaptureLost="OnCanvasPointerCaptureLost"
                                    DoubleTapped="OnCanvasDoubleTapped"
                                    RightTapped="OnCanvasRightTapped">
                                <Canvas x:Name="GridOverlayCanvas" IsHitTestVisible="False" Visibility="Collapsed" />
                                <ItemsControl ItemsSource="{Binding Shapes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="{Binding Width}" Height="{Binding Height}"
                                                  Background="Transparent"
                                                  RenderTransformOrigin="0.5,0.5"
                                                  PointerPressed="OnShapePointerPressed"
                                                  PointerMoved="OnShapePointerMoved"
                                                  PointerReleased="OnShapePointerReleased"
                                                  PointerEntered="OnShapePointerEntered"
                                                  PointerExited="OnShapePointerExited"
                                                  DoubleTapped="OnShapeDoubleTapped">
                                                <!-- Rotate about the shape's own centre FIRST, then move it into place.
                                                     The old translate-then-rotate order spun every rotated shape about
                                                     its untranslated centre, so the Funnel preset (180°) and any shape
                                                     given a rotation in the inspector flew off the canvas. -->
                                                <Grid.RenderTransform>
                                                    <TransformGroup>
                                                        <RotateTransform Angle="{Binding Rotation}" />
                                                        <TranslateTransform X="{Binding X}" Y="{Binding Y}" />
                                                    </TransformGroup>
                                                </Grid.RenderTransform>
                                                <Path Stretch="Fill"
                                                      StrokeThickness="1.5"
                                                      Loaded="OnShapeLoaded"
                                                      DataContextChanged="OnShapeDataContextChanged" />
                                                <!-- Text on top of the shape -->
                                                <TextBlock Text="{Binding Text}"
                                                           Foreground="{Binding TextForegroundHex, Converter={StaticResource FillBrushConverter}}"
                                                           FontSize="{Binding LabelFontSize}" FontWeight="SemiBold" TextAlignment="Center"
                                                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           MaxWidth="{Binding Width}" MaxHeight="{Binding Height}"
                                                           Margin="{Binding LabelInsets, Converter={StaticResource InsetsToMargin}}"
                                                           Padding="1.5,0.5" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"
                                                           Visibility="{Binding Text, Converter={StaticResource EmptyToVis}}">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="{Binding Rotation, Converter={StaticResource UprightLabel}}" />
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- live outline while dragging out a new shape -->
                                <Rectangle x:Name="DrawGhost" Visibility="Collapsed" StrokeThickness="1.5" StrokeDashArray="4,3"
                                           Stroke="{ThemeResource AccentFillColorDefaultBrush}" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" RadiusX="2" RadiusY="2" />
                                <!-- rubber-band selection: drag on empty canvas (Ctrl/Shift adds) -->
                                <Rectangle x:Name="MarqueeRect" Visibility="Collapsed" StrokeThickness="1" IsHitTestVisible="False"
                                           Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
                                <!-- selection frame with eight resize handles (built in code) for one unrotated shape -->
                                <Canvas x:Name="SelectionAdorner" Visibility="Collapsed">
                                    <Rectangle x:Name="SelectionFrame" IsHitTestVisible="False" StrokeThickness="1"
                                               Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Canvas>
                                <!-- multi-selection bounding frame and dimensions badge for 2+ shapes -->
                                <Canvas x:Name="MultiSelectionAdorner" Visibility="Collapsed">
                                    <Rectangle x:Name="MultiSelectionFrame" IsHitTestVisible="False" StrokeThickness="1"
                                               StrokeDashArray="4,2" Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <Line x:Name="MultiRotateStem" IsHitTestVisible="False" StrokeThickness="1"
                                          StrokeDashArray="2,2" Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <Ellipse x:Name="MultiRotateHandle" Width="10" Height="10"
                                             Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                             Stroke="{ThemeResource SurfaceStrokeColorDefaultBrush}" StrokeThickness="1"
                                             ToolTipService.ToolTip="Rotate group · Drag to rotate around center (Shift: 15° snap), Scroll to nudge, Double-click to reset, Right-click for presets" />
                                    <Border x:Name="MultiSelectionBadge"
                                            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="6,2"
                                            DoubleTapped="OnMultiSelectionBadgeDoubleTapped"
                                            RightTapped="OnMultiSelectionBadgeRightTapped"
                                            ToolTipService.ToolTip="Selection group · Double-click to auto-align &amp; distribute, Right-click for group options">
                                        <TextBlock x:Name="MultiSelectionBadgeText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <Border x:Name="MultiAlignRibbon"
                                            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="4,2" Visibility="Collapsed"
                                            IsHitTestVisible="True"
                                            ToolTipService.ToolTip="Selection align &amp; distribute ribbon · Click icons to arrange shapes">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button x:Name="MultiAlignLeftBtn" Width="26" Height="26" Padding="0"
                                                    Style="{StaticResource DefaultButtonStyle}" Background="Transparent" BorderThickness="0"
                                                    Click="OnMultiAlignLeftClick"
                                                    ToolTipService.ToolTip="Align left edges (Alt+Shift+L)">
                                                <FontIcon Glyph="&#xE8E4;" FontSize="11" />
                                            </Button>
                                            <Button x:Name="MultiAlignCenterBtn" Width="26" Height="26" Padding="0"
                                                    Style="{StaticResource DefaultButtonStyle}" Background="Transparent" BorderThickness="0"
                                                    Click="OnMultiAlignCenterClick"
                                                    ToolTipService.ToolTip="Align horizontal center (Alt+Shift+C)">
                                                <FontIcon Glyph="&#xE8E3;" FontSize="11" />
                                            </Button>
                                            <Button x:Name="MultiAlignRightBtn" Width="26" Height="26" Padding="0"
                                                    Style="{StaticResource DefaultButtonStyle}" Background="Transparent" BorderThickness="0"
                                                    Click="OnMultiAlignRightClick"
                                                    ToolTipService.ToolTip="Align right edges (Alt+Shift+R)">
                                                <FontIcon Glyph="&#xE8E2;" FontSize="11" />
                                            </Button>
                                            <Border Width="1" Height="14" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,0" />
                                            <Button x:Name="MultiAlignTopBtn" Width="26" Height="26" Padding="0"
                                                    Style="{StaticResource DefaultButtonStyle}" Background="Transparent" BorderThickness="0"
                                                    Click="OnMultiAlignTopClick"
                                                    ToolTipService.ToolTip="Align top edges (Alt+Shift+T)">
                                                <FontIcon Glyph="&#xE74A;" FontSize="11" />
                                            </Button>
                                            <Button x:Name="MultiAlignMiddleBtn" Width="26" Height="26" Padding="0"
                                                    Style="{StaticResource DefaultButtonStyle}" Background="Transparent" BorderThickness="0"
                                                    Click="OnMultiAlignMiddleClick"
                                                    ToolTipService.ToolTip="Align vertical middle (Alt+Shift+M)">
                                                <FontIcon Glyph="&#xE8E3;" FontSize="11" />
                                            </Button>
                                            <Button x:Name="MultiAlignBottomBtn" Width="26" Height="26" Padding="0"
                                                    Style="{StaticResource DefaultButtonStyle}" Background="Transparent" BorderThickness="0"
                                                    Click="OnMultiAlignBottomClick"
                                                    ToolTipService.ToolTip="Align bottom edges (Alt+Shift+B)">
                                                <FontIcon Glyph="&#xE74B;" FontSize="11" />
                                            </Button>
                                            <Border Width="1" Height="14" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,0" />
                                            <Button x:Name="MultiDistributeHBtn" Width="26" Height="26" Padding="0"
                                                    Style="{StaticResource DefaultButtonStyle}" Background="Transparent" BorderThickness="0"
                                                    Click="OnMultiDistributeHClick"
                                                    ToolTipService.ToolTip="Distribute horizontally with equal spacing (3+ shapes)">
                                                <FontIcon Glyph="&#xE8D3;" FontSize="11" />
                                            </Button>
                                            <Button x:Name="MultiDistributeVBtn" Width="26" Height="26" Padding="0"
                                                    Style="{StaticResource DefaultButtonStyle}" Background="Transparent" BorderThickness="0"
                                                    Click="OnMultiDistributeVClick"
                                                    ToolTipService.ToolTip="Distribute vertically with equal spacing (3+ shapes)">
                                                <FontIcon Glyph="&#xE8D4;" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <Canvas x:Name="DistributionSpacingBadgesCanvas" IsHitTestVisible="True" />
                                </Canvas>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>

                    <!-- empty state -->
                    <StackPanel x:Name="CanvasEmptyStatePanel" Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" IsHitTestVisible="True"
                                Background="Transparent"
                                DoubleTapped="OnCanvasEmptyStateDoubleTapped"
                                RightTapped="OnCanvasEmptyStateRightTapped"
                                ToolTipService.ToolTip="Canvas is empty · Double-click to place starter shape, Right-click for options"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="440">
                        <FontIcon Glyph="&#xE790;" FontSize="40" Foreground="{ThemeResource TextFillColorDisabledBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Start with a preset or a shape" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Presets build a whole diagram — pyramids, org charts, cycles, roadmaps. Shapes let you draw your own, and Picture turns an image into editable Word shapes."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>

                    <!-- placement hint -->
                    <Border Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="14,6" CornerRadius="14"
                            Background="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False"
                            Visibility="{Binding IsPlacing, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding PlacementHint}" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: inspector + shapes list -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="InspectorPanel" Padding="12,12,12,4" Spacing="12">
                        <TextBlock Text="Inspector" Style="{StaticResource SectionHeader}" FontSize="14" />
                        <!-- Empty state -->
                        <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="8" Padding="16,22"
                                Visibility="{Binding SelectedShape, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8B0;" FontSize="26" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding InspectorEmptyTitle}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding InspectorEmptyHint}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <InfoBar IsOpen="{Binding IsMultiSelect}" IsClosable="False" Severity="Informational" Padding="0"
                                 Message="Editing the last shape you clicked. Align, duplicate and delete act on the whole selection." />

                        <!-- Property editors -->
                        <Grid ColumnSpacing="10" RowSpacing="10" Visibility="{Binding HasSelectedShape, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Type" Style="{StaticResource InspectorLabel}" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                <ComboBox AutomationProperties.Name="Shape type" HorizontalAlignment="Stretch"
                                          SelectedItem="{Binding SelectedShape.Prst, Mode=TwoWay}" ItemsSource="{Binding PaletteItems}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                                      Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                                      Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.2"
                                                      Data="{Binding Converter={StaticResource ShapeGeom}}" />
                                                <TextBlock Text="{Binding Converter={StaticResource PresetName}}" VerticalAlignment="Center"
                                                           FontSize="13" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Border x:Name="QuickMorphRibbon" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="6,4">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="Morph" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <Button x:Name="MorphRectBtn" Style="{StaticResource SubtleButtonStyle}" Padding="6,2" Height="24"
                                                    Click="OnMorphRectClick" ToolTipService.ToolTip="Convert to Rectangle (rect)">
                                                <FontIcon Glyph="&#xE7C3;" FontSize="11" />
                                            </Button>
                                            <Button x:Name="MorphRoundRectBtn" Style="{StaticResource SubtleButtonStyle}" Padding="6,2" Height="24"
                                                    Click="OnMorphRoundRectClick" ToolTipService.ToolTip="Convert to Rounded Rectangle (roundrect)">
                                                <FontIcon Glyph="&#xE944;" FontSize="11" />
                                            </Button>
                                            <Button x:Name="MorphEllipseBtn" Style="{StaticResource SubtleButtonStyle}" Padding="6,2" Height="24"
                                                    Click="OnMorphEllipseClick" ToolTipService.ToolTip="Convert to Ellipse (ellipse)">
                                                <FontIcon Glyph="&#xEA3B;" FontSize="11" />
                                            </Button>
                                            <Button x:Name="MorphDiamondBtn" Style="{StaticResource SubtleButtonStyle}" Padding="6,2" Height="24"
                                                    Click="OnMorphDiamondClick" ToolTipService.ToolTip="Convert to Decision Diamond (diamond)">
                                                <FontIcon Glyph="&#xE734;" FontSize="11" />
                                            </Button>
                                            <Button x:Name="MorphHexagonBtn" Style="{StaticResource SubtleButtonStyle}" Padding="6,2" Height="24"
                                                    Click="OnMorphHexagonClick" ToolTipService.ToolTip="Convert to Hexagon (hexagon)">
                                                <FontIcon Glyph="&#xE8B9;" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                        <Button Grid.Column="2" x:Name="CornerRadiusToggleBtn" Style="{StaticResource SubtleButtonStyle}" Padding="6,2" Height="24"
                                                Click="OnCornerRadiusToggleClick" ToolTipService.ToolTip="Toggle between Sharp (0px) and Rounded corners (roundrect)">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <FontIcon Glyph="&#xEB9F;" FontSize="10" />
                                                <TextBlock x:Name="CornerRadiusText" Text="Round" FontSize="10.5" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border x:Name="LayerRibbon" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="6,4">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="Layer" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                                            <Button x:Name="InspectorBringToFrontBtn" Style="{StaticResource SubtleButtonStyle}" Padding="6,2" Height="24"
                                                    Click="OnInspectorBringToFrontClick" ToolTipService.ToolTip="Bring to front (Ctrl+Shift+])">
                                                <FontIcon Glyph="&#xE74A;" FontSize="11" />
                                            </Button>
                                            <Button x:Name="InspectorBringForwardBtn" Style="{StaticResource SubtleButtonStyle}" Padding="6,2" Height="24"
                                                    Click="OnInspectorBringForwardClick" ToolTipService.ToolTip="Bring forward (Ctrl+])">
                                                <FontIcon Glyph="&#xE70E;" FontSize="11" />
                                            </Button>
                                            <Button x:Name="InspectorSendBackwardBtn" Style="{StaticResource SubtleButtonStyle}" Padding="6,2" Height="24"
                                                    Click="OnInspectorSendBackwardClick" ToolTipService.ToolTip="Send backward (Ctrl+[)">
                                                <FontIcon Glyph="&#xE70D;" FontSize="11" />
                                            </Button>
                                            <Button x:Name="InspectorSendToBackBtn" Style="{StaticResource SubtleButtonStyle}" Padding="6,2" Height="24"
                                                    Click="OnInspectorSendToBackClick" ToolTipService.ToolTip="Send to back (Ctrl+Shift+[)">
                                                <FontIcon Glyph="&#xE74B;" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock x:Name="InspectorLayerPositionText" Text="Layer 1 of 1" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border x:Name="TransformRibbon" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="6,4">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="Flip" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                                            <Button x:Name="InspectorFlipHBtn" Style="{StaticResource SubtleButtonStyle}" Padding="6,2" Height="24"
                                                    Click="OnInspectorFlipHClick" ToolTipService.ToolTip="Flip shape horizontally (Mirror)">
                                                <FontIcon Glyph="&#xE8E2;" FontSize="11" />
                                            </Button>
                                            <Button x:Name="InspectorFlipVBtn" Style="{StaticResource SubtleButtonStyle}" Padding="6,2" Height="24"
                                                    Click="OnInspectorFlipVClick" ToolTipService.ToolTip="Flip shape vertically (Mirror)">
                                                <FontIcon Glyph="&#xE8E1;" FontSize="11" />
                                            </Button>
                                            <Button x:Name="InspectorRotateCwBtn" Style="{StaticResource SubtleButtonStyle}" Padding="6,2" Height="24"
                                                    Click="OnInspectorRotateCwClick" ToolTipService.ToolTip="Rotate 90° clockwise (Alt+Shift+Right)">
                                                <FontIcon Glyph="&#xE7AD;" FontSize="11" />
                                            </Button>
                                            <Button x:Name="InspectorRotateCcwBtn" Style="{StaticResource SubtleButtonStyle}" Padding="6,2" Height="24"
                                                    Click="OnInspectorRotateCcwClick" ToolTipService.ToolTip="Rotate 90° counter-clockwise (Alt+Shift+Left)">
                                                <FontIcon Glyph="&#xE7A7;" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                        <Button Grid.Column="2" x:Name="InspectorSquareAspectBtn" Style="{StaticResource SubtleButtonStyle}" Padding="6,2" Height="24"
                                                Click="OnInspectorSquareAspectClick" ToolTipService.ToolTip="Make square 1:1 aspect ratio">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <FontIcon Glyph="&#xE739;" FontSize="10" />
                                                <TextBlock Text="1:1" FontSize="10.5" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Position" Style="{StaticResource InspectorLabel}" />
                            <!-- Visible X/Y (W/H) captions: the placeholders vanished as soon as the boxes held
                                 numbers, leaving two unexplained values side by side. -->
                            <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="X" Style="{StaticResource InspectorAxis}" />
                                <NumberBox x:Name="PositionXNumberBox" Grid.Column="1" AutomationProperties.Name="X position" ToolTipService.ToolTip="X — distance from the left edge in px (Double-click to select all, Right-click for options)" Minimum="0"
                                           Value="{Binding SelectedShape.X, Mode=TwoWay}" SmallChange="1" LargeChange="10"
                                           DoubleTapped="OnNumberBoxDoubleTapped" RightTapped="OnPositionNumberBoxRightTapped" />
                                <TextBlock Grid.Column="2" Text="Y" Style="{StaticResource InspectorAxis}" Margin="4,0,0,0" />
                                <NumberBox x:Name="PositionYNumberBox" Grid.Column="3" AutomationProperties.Name="Y position" ToolTipService.ToolTip="Y — distance from the top edge in px (Double-click to select all, Right-click for options)" Minimum="0"
                                           Value="{Binding SelectedShape.Y, Mode=TwoWay}" SmallChange="1" LargeChange="10"
                                           DoubleTapped="OnNumberBoxDoubleTapped" RightTapped="OnPositionNumberBoxRightTapped" />
                            </Grid>

                            <TextBlock Grid.Row="2" Text="Size" Style="{StaticResource InspectorLabel}" />
                            <!-- Visible X/Y (W/H) captions: the placeholders vanished as soon as the boxes held
                                 numbers, leaving two unexplained values side by side. -->
                            <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="W" Style="{StaticResource InspectorAxis}" />
                                <NumberBox x:Name="SizeWidthNumberBox" Grid.Column="1" AutomationProperties.Name="Width" ToolTipService.ToolTip="Width in px (Double-click to select all, Right-click for size presets)" Minimum="4"
                                           Value="{Binding SelectedShape.Width, Mode=TwoWay}" SmallChange="1" LargeChange="10"
                                           DoubleTapped="OnNumberBoxDoubleTapped" RightTapped="OnSizeNumberBoxRightTapped" />
                                <TextBlock Grid.Column="2" Text="H" Style="{StaticResource InspectorAxis}" Margin="4,0,0,0" />
                                <NumberBox x:Name="SizeHeightNumberBox" Grid.Column="3" AutomationProperties.Name="Height" ToolTipService.ToolTip="Height in px (Double-click to select all, Right-click for size presets)" Minimum="4"
                                           Value="{Binding SelectedShape.Height, Mode=TwoWay}" SmallChange="1" LargeChange="10"
                                           DoubleTapped="OnNumberBoxDoubleTapped" RightTapped="OnSizeNumberBoxRightTapped" />
                            </Grid>

                            <TextBlock Grid.Row="3" Text="{Binding SelectedShape.ColourLabel}" Style="{StaticResource InspectorLabel}" />
                            <Grid Grid.Row="3" Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="FillSwatchButton" Width="32" Height="32" Padding="3"
                                        AutomationProperties.Name="{Binding SelectedShape.ColourPickerLabel, FallbackValue='Pick fill colour'}"
                                        RightTapped="OnFillSwatchButtonRightTapped"
                                        ToolTipService.ToolTip="{Binding SelectedShape.ColourPickerLabel, FallbackValue='Pick fill colour (Right-click for quick palette &amp; copy)'}">
                                    <Border Width="24" Height="24" CornerRadius="4"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                            Background="{Binding SelectedShape.Fill, Converter={StaticResource FillBrushConverter}}" />
                                    <Button.Flyout>
                                        <Flyout x:Name="FillFlyout" Opening="OnFillFlyoutOpening">
                                            <StackPanel Spacing="10" MinWidth="260">
                                                <Grid>
                                                    <TextBlock x:Name="FillFlyoutTitle" Text="Fill colour" FontSize="12" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock x:Name="FillFlyoutHexText" Text="#0078D4" FontSize="11.5" FontFamily="Consolas"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Scheme &amp; quick swatches" FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <StackPanel x:Name="FillFlyoutSwatches" Orientation="Horizontal" Spacing="6" />
                                                </StackPanel>
                                                <StackPanel x:Name="RecentColorsContainer" Spacing="4">
                                                    <Grid>
                                                        <TextBlock Text="Recent colours" FontSize="11"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                        <HyperlinkButton x:Name="ClearRecentColorsBtn" Content="Clear" FontSize="10.5" Padding="4,0"
                                                                         HorizontalAlignment="Right" Click="OnClearRecentColorsClick"
                                                                         ToolTipService.ToolTip="Clear recent colour swatches" />
                                                    </Grid>
                                                    <StackPanel x:Name="RecentColorsSwatches" Orientation="Horizontal" Spacing="6" />
                                                </StackPanel>
                                                <ColorPicker x:Name="FillPicker" ColorSpectrumShape="Ring" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                             IsColorSliderVisible="True" IsColorChannelTextInputVisible="False" IsHexInputVisible="True"
                                                             ColorChanged="OnFillPickerColorChanged" />
                                                <Button Content="Use this colour" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnFillPickerApply"
                                                        AutomationProperties.Name="Use this colour" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBox x:Name="FillHexBox" Grid.Column="1"
                                         AutomationProperties.Name="{Binding SelectedShape.ColourHexLabel, FallbackValue='Fill colour'}"
                                         PlaceholderText="RRGGBB" FontFamily="Consolas" CharacterCasing="Upper"
                                         RightTapped="OnFillHexBoxRightTapped"
                                         ToolTipService.ToolTip="{Binding SelectedShape.ColourHexToolTip, FallbackValue='Fill colour as a 6-digit hex value (Right-click for options)'}"
                                         KeyDown="OnFillHexBoxKeyDown" LostFocus="OnFillHexBoxLostFocus"
                                         Text="{Binding SelectedShape.Fill, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" />
                            </Grid>

                            <!-- Lines only: connectors kept whatever weight their preset gave them. -->
                            <TextBlock Grid.Row="4" Text="Weight" Style="{StaticResource InspectorLabel}"
                                       Visibility="{Binding SelectedShape.IsLine, Converter={StaticResource BoolToVis}}" />
                            <Grid Grid.Row="4" Grid.Column="1" ColumnSpacing="6"
                                  Visibility="{Binding SelectedShape.IsLine, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="StrokeWeightNumberBox" AutomationProperties.Name="Line weight in points"
                                           ToolTipService.ToolTip="Line weight in points (Double-click to select all, Right-click for weight presets)"
                                           Minimum="0.25" Maximum="24" SmallChange="0.5" LargeChange="2" SpinButtonPlacementMode="Inline"
                                           Value="{Binding SelectedShape.StrokeWidthPt, Mode=TwoWay}"
                                           DoubleTapped="OnStrokeWeightDoubleTapped"
                                           RightTapped="OnStrokeWeightRightTapped" />
                                <TextBlock Grid.Column="1" Text="pt" Style="{StaticResource InspectorAxis}" />
                            </Grid>

                            <TextBlock Grid.Row="5" Text="Rotation" Style="{StaticResource InspectorLabel}" />
                            <Grid Grid.Row="5" Grid.Column="1" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="RotationSlider" Minimum="-180" Maximum="180" StepFrequency="1" AutomationProperties.Name="Rotation" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Rotation angle (−180° to 180° · Alt+Left / Alt+Right steps by 15° · Double-click for 0°, Right-click for presets)"
                                        Value="{Binding SelectedShape.Rotation, Mode=TwoWay}"
                                        DoubleTapped="OnRotationSliderDoubleTapped"
                                        RightTapped="OnRotationSliderRightTapped" />
                                <TextBlock x:Name="RotationDegreeText" Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           IsHitTestVisible="True"
                                           DoubleTapped="OnRotationSliderDoubleTapped"
                                           RightTapped="OnRotationSliderRightTapped"
                                           ToolTipService.ToolTip="Rotation readout (Double-click for 0°, Right-click for angle presets)">
                                    <Run Text="{Binding SelectedShape.Rotation}" /><Run Text="°" />
                                </TextBlock>
                                <Button x:Name="ResetRotationButton" Grid.Column="2" Content="0°" Padding="6,2" FontSize="11"
                                        Command="{Binding ResetRotationCommand}"
                                        DoubleTapped="OnResetRotationButtonDoubleTapped"
                                        RightTapped="OnResetRotationButtonRightTapped"
                                        ToolTipService.ToolTip="Reset rotation to 0° (Double-click for 0°, Right-click for angle presets)"
                                        AutomationProperties.Name="Reset rotation to 0 degrees" />
                            </Grid>

                            <TextBlock Grid.Row="6" Text="Label" Style="{StaticResource InspectorLabel}" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <TextBox x:Name="LabelTextBox" Grid.Row="6" Grid.Column="1" AutomationProperties.Name="Text label" PlaceholderText="Text shown on the shape"
                                     ToolTipService.ToolTip="Text shown on the shape (F2 · Double-click to select all, Right-click for text options, Esc to return to canvas)"
                                     Text="{Binding SelectedShape.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     DoubleTapped="OnLabelTextBoxDoubleTapped"
                                     RightTapped="OnLabelTextBoxRightTapped"
                                     KeyDown="OnLabelTextBoxKeyDown"
                                     AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>

                    <!-- Shapes on canvas: fills the rest of the pane -->
                    <Grid Grid.Row="1" Margin="12,8,12,12" Padding="10,10,10,4" RowSpacing="4" CornerRadius="8" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Shapes on canvas" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding LineStats}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Row="1" Style="{StaticResource PaneCaption}" FontSize="11.5">
                            <Run Text="{Binding ShapesListHint}" />
                            <Run Text="{Binding ShapesListCapNote}" />
                        </TextBlock>
                        <ListView Grid.Row="2" x:Name="ShapesList" ItemsSource="{Binding ListedShapes}" SelectedItem="{Binding SelectedShape, Mode=TwoWay}"
                                  Margin="-10,4,-10,0" AutomationProperties.Name="Shapes on canvas"
                                  KeyDown="OnShapesListKeyDown">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,6" ColumnSpacing="10" Background="Transparent" RightTapped="OnShapesListItemRightTapped" AutomationProperties.Name="{Binding ListTitle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Width="18" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                              Fill="{Binding Fill, Converter={StaticResource FillBrushConverter}}"
                                              Stroke="{Binding Fill, Converter={StaticResource FillBrushConverter}}" StrokeThickness="1"
                                              Data="{Binding Prst, Converter={StaticResource ShapeGeom}}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ListTitle}" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ListSubtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding ListSubtitle, Converter={StaticResource EmptyToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status -->
        <Grid Grid.Row="2" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" Padding="14,7" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="16"
              RightTapped="OnStatusBarRightTapped" DoubleTapped="OnStatusBarDoubleTapped"
              ToolTipService.ToolTip="Shape Studio status (Double-click to copy, Right-click for options)">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusBarText" Text="{Binding StatusMessage}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       RightTapped="OnStatusBarRightTapped" DoubleTapped="OnStatusBarDoubleTapped" />
            <TextBlock x:Name="SelectionSummaryText" Grid.Column="1" Text="{Binding SelectionSummary}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"
                       IsHitTestVisible="True"
                       DoubleTapped="OnSelectionSummaryDoubleTapped"
                       RightTapped="OnSelectionSummaryRightTapped"
                       ToolTipService.ToolTip="Selection summary · Double-click to copy summary, right-click for shape selection actions" />
            <!-- Zoom: Ctrl+scroll and pinch always worked but nothing showed the level or offered
                 a way back. Presets now open fitted to the canvas. -->
            <DropDownButton x:Name="ZoomButton" Grid.Column="2" Padding="8,0" Height="24" MinWidth="70" FontSize="12"
                            Margin="0,-4" AutomationProperties.Name="Zoom"
                            ToolTipService.ToolTip="Zoom — Ctrl+scroll to zoom, Ctrl+0 to fit, double-click for 100%, right-click for preset stops"
                            DoubleTapped="OnZoomButtonDoubleTapped"
                            RightTapped="OnZoomButtonRightTapped">
                <TextBlock x:Name="ZoomText" Text="100%" FontSize="12" />
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedRight">
                        <MenuFlyoutItem Text="Fit diagram" Click="OnZoomFitClick" KeyboardAcceleratorTextOverride="Ctrl+0">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9A6;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Actual size (100%)" Click="OnZoomActualClick" KeyboardAcceleratorTextOverride="Ctrl+1">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71E;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Zoom in" Click="OnZoomInClick" KeyboardAcceleratorTextOverride="Ctrl+=">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A3;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Zoom out" Click="OnZoomOutClick" KeyboardAcceleratorTextOverride="Ctrl+−">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71F;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem Text="Preset zoom levels">
                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE71E;" /></MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem Text="50%" Click="OnZoom50Click" />
                            <MenuFlyoutItem Text="75%" Click="OnZoom75Click" />
                            <MenuFlyoutItem Text="100%" Click="OnZoom100Click" />
                            <MenuFlyoutItem Text="150%" Click="OnZoom150Click" />
                            <MenuFlyoutItem Text="200%" Click="OnZoom200Click" />
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>
    </Grid>
</Window>

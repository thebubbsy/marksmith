<Window
    x:Class="MarkSmith.Views.ShapeStudio.ShapeDesignStudioWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:MarkSmith.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:MarkSmith.Converters"
    mc:Ignorable="d"
    Title="Shape Studio — MarkSmith">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <conv:ShapeGeometryConverter x:Key="ShapeGeom" />
            <conv:FillBrushConverter x:Key="FillBrushConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVis" />
            <conv:InsetsToThicknessConverter x:Key="InsetsToMargin" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:PresetDisplayNameConverter x:Key="PresetName" />
            <conv:UprightLabelAngleConverter x:Key="UprightLabel" />
            <Style x:Key="InspectorLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="PaneCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <!-- Square icon buttons in the canvas toolbar: one size, one padding, so the row reads
                 as a single control strip instead of a run of differently sized chips. -->
            <Style x:Key="ToolIconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar + window commands -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="56" Padding="16,0" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE790;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Shape Studio" FontWeight="SemiBold" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Diagrams built from native Word shapes — still editable in Word, never flattened to a picture"
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="OnClearClick" IsEnabled="{Binding HasShapes}"
                        ToolTipService.ToolTip="Remove every shape from the canvas (Ctrl+Z brings them back)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE894;" FontSize="14" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>
                <DropDownButton AutomationProperties.Name="Export" ToolTipService.ToolTip="Save the diagram as a Word file, or move it in and out as Markdown">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ExportMenu" Placement="BottomEdgeAlignedRight" Opening="OnExportMenuOpening">
                            <MenuFlyoutItem x:Name="ExportDocxItem" Text="Word document (.docx)…" Click="OnExportDocxClick">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ExportDotxItem" Text="Word template (.dotx)…" Click="OnExportDotxClick">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F1;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="CopyMarkdownItem" Text="Copy as Markdown" Click="OnCopyMarkdownClick">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Load Markdown from clipboard" Click="OnLoadMarkdownClick">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Command="{Binding InsertIntoDocumentCommand}" Style="{ThemeResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Insert this diagram into the open document — it previews live and exports as editable Word shapes">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                        <TextBlock Text="Insert into document" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" ColumnSpacing="10" Padding="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Presets | Shapes | Picture. One section at a time, each with the full pane
                 height — the old single scroll put the shape palette and the picture tracer below
                 the fold, so most people never found them. -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <SelectorBar x:Name="LeftTabs" Margin="6,4,6,0" SelectionChanged="OnLeftTabsChanged">
                        <SelectorBarItem x:Name="PresetsTab" Text="Presets" IsSelected="True">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xF0E2;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="ShapesTab" Text="Shapes">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE790;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="PictureTab" Text="Picture">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xEB9F;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>

                    <!-- Presets -->
                    <Grid x:Name="PresetsPanel" Grid.Row="1" Padding="12,8,12,12" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="One click builds a finished diagram you can then edit shape by shape." Style="{StaticResource PaneCaption}" />
                        <ComboBox Grid.Row="1" AutomationProperties.Name="Preset category" ItemsSource="{Binding PresetCategories}"
                                  SelectedItem="{Binding SelectedPresetCategory, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        <ListView Grid.Row="2" x:Name="PresetList" ItemsSource="{Binding FilteredPresets}" SelectionMode="None"
                                  IsItemClickEnabled="True" ItemClick="OnPresetItemClick" Margin="-12,0,-12,0" Padding="4,0"
                                  AutomationProperties.Name="Diagram presets">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnSpacing="12" AutomationProperties.Name="{Binding Name}"
                                          ToolTipService.ToolTip="{Binding Description}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- A live miniature of the diagram in the current colour scheme
                                             (filled in code-behind), so the list can be scanned by
                                             eye instead of by name: every preset in a category used
                                             to share one icon. -->
                                        <Border Width="64" Height="46" CornerRadius="6" VerticalAlignment="Center" Padding="5"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <Viewbox Stretch="Uniform">
                                                <Canvas Loaded="OnPresetThumbLoaded" Unloaded="OnPresetThumbUnloaded"
                                                        DataContextChanged="OnPresetThumbDataContextChanged" />
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Shapes -->
                    <ScrollViewer x:Name="ShapesPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="12,8,12,12" Spacing="8">
                            <TextBlock Text="Pick a shape, then click the canvas to drop it — or drag to draw it at the size you want." Style="{StaticResource PaneCaption}" />
                            <GridView x:Name="PaletteGrid" ItemsSource="{Binding PaletteItems}" SelectionMode="Single"
                                      SelectedItem="{Binding ArmedTool, Mode=TwoWay}" Margin="-4,0"
                                      AutomationProperties.Name="Shapes to draw">
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="84" Height="74" Spacing="5" Padding="2,8,2,4"
                                                    AutomationProperties.Name="{Binding Converter={StaticResource PresetName}}"
                                                    ToolTipService.ToolTip="{Binding Converter={StaticResource PresetName}}">
                                            <Path Width="26" Height="22" Stretch="Uniform" HorizontalAlignment="Center"
                                                  Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                  Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.5"
                                                  Data="{Binding Converter={StaticResource ShapeGeom}}" />
                                            <TextBlock Text="{Binding Converter={StaticResource PresetName}}" FontSize="11" TextAlignment="Center" LineHeight="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Picture → vector -->
                    <ScrollViewer x:Name="PicturePanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="12,8,12,12" Spacing="12">
                            <TextBlock Text="Turn a photo or logo into Word shapes and traced line art. Set either density to 0 to skip that layer." Style="{StaticResource PaneCaption}" />

                            <!-- Image card -->
                            <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="10">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="56" Height="56" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Grid>
                                            <FontIcon Glyph="&#xEB9F;" FontSize="20" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                            <Image x:Name="FuseThumb" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock x:Name="FuseImageLabel" Text="No image chosen" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Button x:Name="PickImageButton" Content="Choose image…" Click="OnPickImageClick" Padding="10,4" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Shape mosaic layer -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Shape mosaic" Style="{StaticResource SectionHeader}" />
                                <Grid>
                                    <TextBlock Text="Density" Style="{StaticResource InspectorLabel}" />
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               Text="{Binding ElementName=FuseMosaicDensity, Path=Value}" />
                                </Grid>
                                <Slider AutomationProperties.Name="Mosaic density" x:Name="FuseMosaicDensity" Minimum="0" Maximum="120" Value="32" SmallChange="1" LargeChange="5" />
                                <TextBlock Text="Tile shapes" Style="{StaticResource InspectorLabel}" />
                                <Grid ColumnSpacing="4" RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <CheckBox x:Name="CompRoundRect" Grid.Row="0" Grid.Column="0" Content="Rounded rect" IsChecked="True" MinWidth="0" />
                                    <CheckBox x:Name="CompRect" Grid.Row="0" Grid.Column="1" Content="Rectangle" MinWidth="0" />
                                    <CheckBox x:Name="CompEllipse" Grid.Row="1" Grid.Column="0" Content="Ellipse" IsChecked="True" MinWidth="0" />
                                    <CheckBox x:Name="CompChevron" Grid.Row="1" Grid.Column="1" Content="Chevron" MinWidth="0" />
                                    <CheckBox x:Name="CompDiamond" Grid.Row="2" Grid.Column="0" Content="Diamond" MinWidth="0" />
                                    <CheckBox x:Name="CompHexagon" Grid.Row="2" Grid.Column="1" Content="Hexagon" MinWidth="0" />
                                    <CheckBox x:Name="CompTriangle" Grid.Row="3" Grid.Column="0" Content="Triangle" MinWidth="0" />
                                    <CheckBox x:Name="CompCloud" Grid.Row="3" Grid.Column="1" Content="Cloud" MinWidth="0" />
                                </Grid>
                            </StackPanel>

                            <!-- Line-art layer -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Traced line art" Style="{StaticResource SectionHeader}" />
                                <Grid>
                                    <TextBlock Text="Density" Style="{StaticResource InspectorLabel}" />
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               Text="{Binding ElementName=FuseLineDensity, Path=Value}" />
                                </Grid>
                                <Slider AutomationProperties.Name="Line density" x:Name="FuseLineDensity" Minimum="0" Maximum="1200" Value="300" SmallChange="10" LargeChange="50" StepFrequency="10" />
                                <ComboBox x:Name="FuseModePicker" Header="Line style" HorizontalAlignment="Stretch" SelectedIndex="0"
                                          AutomationProperties.Name="Line style">
                                    <ComboBoxItem Content="Cross-hatch — etching" Tag="CrossHatch" />
                                    <ComboBoxItem Content="Topographic waves — flowing contours" Tag="TopographicWaves" />
                                    <ComboBoxItem Content="Calligraphic — 30° chisel strokes" Tag="Calligraphic" />
                                    <ComboBoxItem Content="Edges — outlines only" Tag="Edges" />
                                    <ComboBoxItem Content="Engraved — fine hatching" Tag="Engraved" />
                                    <ComboBoxItem Content="Scanlines — horizontal strokes" Tag="Scanlines" />
                                    <ComboBoxItem Content="Silhouette — solid shapes" Tag="Silhouette" />
                                </ComboBox>
                                <Grid ColumnSpacing="12" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="0">
                                        <Grid>
                                            <TextBlock Text="Detail" Style="{StaticResource InspectorLabel}" />
                                            <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding ElementName=FuseEdgeSensitivity, Path=Value}" />
                                        </Grid>
                                        <Slider x:Name="FuseEdgeSensitivity" Minimum="5" Maximum="80" Value="30" AutomationProperties.Name="Detail threshold"
                                                ToolTipService.ToolTip="Lower values pick up finer texture and subtle detail" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="0">
                                        <Grid>
                                            <TextBlock Text="Stroke (pt)" Style="{StaticResource InspectorLabel}" />
                                            <TextBlock x:Name="StrokeWidthReadout" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="1.5" />
                                        </Grid>
                                        <Slider x:Name="FuseStrokeWidth" Minimum="0.5" Maximum="5.0" Value="1.5" StepFrequency="0.1" AutomationProperties.Name="Stroke width"
                                                ValueChanged="OnStrokeWidthChanged" ToolTipService.ToolTip="Thickness of the traced ink strokes" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="FuseMonochrome" Content="Dark ink only (ignore the picture's colours)" IsChecked="True" MinWidth="0" />
                            </StackPanel>

                            <Button x:Name="ConvertButton" Click="OnFuseImageClick" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,8"
                                    IsEnabled="{Binding HasImage}" AutomationProperties.Name="Convert picture to shapes"
                                    ToolTipService.ToolTip="Replace the canvas with the converted picture (Ctrl+Z restores it)">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE945;" FontSize="14" />
                                    <TextBlock Text="Convert picture to shapes" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- CENTER: toolbar + canvas -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="8,6" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="8,8,0,0"
                          SizeChanged="OnToolbarSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="ToolStrip" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Style="{StaticResource ToolIconButton}" Command="{Binding UndoCommand}" AutomationProperties.Name="Undo" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                                <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource ToolIconButton}" Command="{Binding RedoCommand}" AutomationProperties.Name="Redo" ToolTipService.ToolTip="Redo (Ctrl+Y)">
                                <FontIcon Glyph="&#xE7A6;" FontSize="14" />
                            </Button>
                            <AppBarSeparator Margin="0" Padding="0" />
                            <Button Style="{StaticResource ToolIconButton}" Command="{Binding AlignLeftCommand}" AutomationProperties.Name="Align left" ToolTipService.ToolTip="Align left edges — select two or more shapes (Ctrl+click)"><PathIcon Width="14" Height="14" Data="M0.75,0.75 h1.12 v10.5 h-1.12 Z M3,2.62 h7.5 v2.25 h-7.5 Z M3,7.12 h4.5 v2.25 h-4.5 Z" /></Button>
                            <Button Style="{StaticResource ToolIconButton}" Command="{Binding AlignCenterCommand}" AutomationProperties.Name="Align centre" ToolTipService.ToolTip="Align centres — select two or more shapes (Ctrl+click)"><PathIcon Width="14" Height="14" Data="M5.44,0.75 h1.12 v10.5 h-1.12 Z M1.5,2.62 h9 v2.25 h-9 Z M3,7.12 h6 v2.25 h-6 Z" /></Button>
                            <Button Style="{StaticResource ToolIconButton}" Command="{Binding AlignRightCommand}" AutomationProperties.Name="Align right" ToolTipService.ToolTip="Align right edges — select two or more shapes (Ctrl+click)"><PathIcon Width="14" Height="14" Data="M10.12,0.75 h1.12 v10.5 h-1.12 Z M1.5,2.62 h7.5 v2.25 h-7.5 Z M4.5,7.12 h4.5 v2.25 h-4.5 Z" /></Button>
                            <Button Style="{StaticResource ToolIconButton}" Command="{Binding AlignTopCommand}" AutomationProperties.Name="Align top" ToolTipService.ToolTip="Align top edges — select two or more shapes (Ctrl+click)"><PathIcon Width="14" Height="14" Data="M0.75,0.75 h10.5 v1.12 h-10.5 Z M2.62,3 h2.25 v7.5 h-2.25 Z M7.12,3 h2.25 v4.5 h-2.25 Z" /></Button>
                            <Button Style="{StaticResource ToolIconButton}" Command="{Binding AlignMiddleCommand}" AutomationProperties.Name="Align middle" ToolTipService.ToolTip="Align middles — select two or more shapes (Ctrl+click)"><PathIcon Width="14" Height="14" Data="M0.75,5.44 h10.5 v1.12 h-10.5 Z M2.62,1.5 h2.25 v9 h-2.25 Z M7.12,3 h2.25 v6 h-2.25 Z" /></Button>
                            <Button Style="{StaticResource ToolIconButton}" Command="{Binding AlignBottomCommand}" AutomationProperties.Name="Align bottom" ToolTipService.ToolTip="Align bottom edges — select two or more shapes (Ctrl+click)"><PathIcon Width="14" Height="14" Data="M0.75,10.12 h10.5 v1.12 h-10.5 Z M2.62,1.5 h2.25 v7.5 h-2.25 Z M7.12,4.5 h2.25 v4.5 h-2.25 Z" /></Button>
                            <AppBarSeparator Margin="0" Padding="0" />
                            <Button Style="{StaticResource ToolIconButton}" Command="{Binding DistributeHorizontalCommand}" AutomationProperties.Name="Distribute horizontally" ToolTipService.ToolTip="Space evenly left to right — select three or more shapes"><PathIcon Width="14" Height="14" Data="M0.75,0.75 h1.12 v10.5 h-1.12 Z M10.12,0.75 h1.12 v10.5 h-1.12 Z M4.88,3 h2.25 v6 h-2.25 Z" /></Button>
                            <Button Style="{StaticResource ToolIconButton}" Command="{Binding DistributeVerticalCommand}" AutomationProperties.Name="Distribute vertically" ToolTipService.ToolTip="Space evenly top to bottom — select three or more shapes"><PathIcon Width="14" Height="14" Data="M0.75,0.75 h10.5 v1.12 h-10.5 Z M0.75,10.12 h10.5 v1.12 h-10.5 Z M3,4.88 h6 v2.25 h-6 Z" /></Button>
                            <AppBarSeparator Margin="0" Padding="0" />
                            <Button Style="{StaticResource ToolIconButton}" Command="{Binding DuplicateSelectedCommand}" AutomationProperties.Name="Duplicate" ToolTipService.ToolTip="Duplicate the selection (Ctrl+D)">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource ToolIconButton}" Command="{Binding RemoveSelectedCommand}" AutomationProperties.Name="Delete" ToolTipService.ToolTip="Delete the selection (Del)">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>

                        <!-- Colour scheme: picking one recolours the canvas at once (and every preset
                             after it). Swatches show the colours instead of a bare name + "Apply". -->
                        <DropDownButton x:Name="PaletteButton" Grid.Column="1" Padding="8,4" AutomationProperties.Name="Colour scheme"
                                        ToolTipService.ToolTip="Colour scheme for presets and new shapes">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <StackPanel x:Name="PaletteButtonSwatches" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
                                <TextBlock x:Name="PaletteNameText" Text="{Binding SelectedPaletteName}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <Flyout x:Name="PaletteFlyout" Placement="BottomEdgeAlignedRight">
                                    <StackPanel Spacing="8" Width="240">
                                        <TextBlock Text="Colour scheme" Style="{StaticResource SectionHeader}" />
                                        <TextBlock Text="Recolours the canvas now, and every preset you add after." Style="{StaticResource PaneCaption}" />
                                        <ListView x:Name="PaletteList" SelectionMode="Single" Margin="-12,0" SelectionChanged="OnPaletteListSelectionChanged" AutomationProperties.Name="Colour schemes">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Padding="0,6" Spacing="6" AutomationProperties.Name="{Binding Name}">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" />
                                                        <ItemsControl ItemsSource="{Binding Swatches}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="26" Height="12" CornerRadius="3" Background="{Binding}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <!-- dense trace preview -->
                    <StackPanel Grid.Row="1" Visibility="{Binding IsDense, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Padding="20">
                        <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Image x:Name="DensePreview" Stretch="Uniform" MaxWidth="1300" MaxHeight="820" />
                        </Border>
                        <TextBlock Text="Line-art preview — every stroke exports as its own native Word line." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" MaxWidth="760" />
                    </StackPanel>

                    <!-- editable canvas -->
                    <ScrollViewer x:Name="CanvasScroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Enabled"
                                  MinZoomFactor="0.2" MaxZoomFactor="4" ViewChanged="OnCanvasViewChanged"
                                  IsTabStop="True" UseSystemFocusVisuals="False" AutomationProperties.Name="Canvas"
                                  Visibility="{Binding IsDense, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <Grid Width="2200" Height="1800">
                            <Canvas x:Name="MainCanvas" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                    PointerPressed="OnCanvasPointerPressed" PointerMoved="OnCanvasPointerMoved"
                                    PointerReleased="OnCanvasPointerReleased" PointerCaptureLost="OnCanvasPointerCaptureLost">
                                <ItemsControl ItemsSource="{Binding Shapes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="{Binding Width}" Height="{Binding Height}"
                                                  Background="Transparent"
                                                  RenderTransformOrigin="0.5,0.5"
                                                  PointerPressed="OnShapePointerPressed"
                                                  PointerMoved="OnShapePointerMoved"
                                                  PointerReleased="OnShapePointerReleased"
                                                  PointerEntered="OnShapePointerEntered"
                                                  PointerExited="OnShapePointerExited">
                                                <!-- Rotate about the shape's own centre FIRST, then move it into place.
                                                     The old translate-then-rotate order spun every rotated shape about
                                                     its untranslated centre, so the Funnel preset (180°) and any shape
                                                     given a rotation in the inspector flew off the canvas. -->
                                                <Grid.RenderTransform>
                                                    <TransformGroup>
                                                        <RotateTransform Angle="{Binding Rotation}" />
                                                        <TranslateTransform X="{Binding X}" Y="{Binding Y}" />
                                                    </TransformGroup>
                                                </Grid.RenderTransform>
                                                <Path Stretch="Fill"
                                                      StrokeThickness="1.5"
                                                      Loaded="OnShapeLoaded"
                                                      DataContextChanged="OnShapeDataContextChanged" />
                                                <!-- Text on top of the shape -->
                                                <TextBlock Text="{Binding Text}"
                                                           Foreground="{Binding TextForegroundHex, Converter={StaticResource FillBrushConverter}}"
                                                           FontSize="{Binding LabelFontSize}" FontWeight="SemiBold" TextAlignment="Center"
                                                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           MaxWidth="{Binding Width}" MaxHeight="{Binding Height}"
                                                           Margin="{Binding LabelInsets, Converter={StaticResource InsetsToMargin}}"
                                                           Padding="1.5,0.5" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"
                                                           Visibility="{Binding Text, Converter={StaticResource EmptyToVis}}">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="{Binding Rotation, Converter={StaticResource UprightLabel}}" />
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- live outline while dragging out a new shape -->
                                <Rectangle x:Name="DrawGhost" Visibility="Collapsed" StrokeThickness="1.5" StrokeDashArray="4,3"
                                           Stroke="{ThemeResource AccentFillColorDefaultBrush}" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" RadiusX="2" RadiusY="2" />
                                <!-- rubber-band selection: drag on empty canvas (Ctrl/Shift adds) -->
                                <Rectangle x:Name="MarqueeRect" Visibility="Collapsed" StrokeThickness="1" IsHitTestVisible="False"
                                           Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
                                <!-- selection frame with eight resize handles (built in code) for one unrotated shape -->
                                <Canvas x:Name="SelectionAdorner" Visibility="Collapsed">
                                    <Rectangle x:Name="SelectionFrame" IsHitTestVisible="False" StrokeThickness="1"
                                               Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Canvas>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>

                    <!-- empty state -->
                    <StackPanel Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="440">
                        <FontIcon Glyph="&#xE790;" FontSize="40" Foreground="{ThemeResource TextFillColorDisabledBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Start with a preset or a shape" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Presets build a whole diagram — pyramids, org charts, cycles, roadmaps. Shapes let you draw your own, and Picture turns an image into editable Word shapes."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>

                    <!-- placement hint -->
                    <Border Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="14,6" CornerRadius="14"
                            Background="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False"
                            Visibility="{Binding IsPlacing, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding PlacementHint}" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: inspector + shapes list -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="InspectorPanel" Padding="12,12,12,4" Spacing="12">
                        <TextBlock Text="Inspector" Style="{StaticResource SectionHeader}" FontSize="14" />
                        <!-- Empty state -->
                        <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="8" Padding="16,22"
                                Visibility="{Binding SelectedShape, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8B0;" FontSize="26" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding InspectorEmptyTitle}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding InspectorEmptyHint}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <InfoBar IsOpen="{Binding IsMultiSelect}" IsClosable="False" Severity="Informational" Padding="0"
                                 Message="Editing the last shape you clicked. Align, duplicate and delete act on the whole selection." />

                        <!-- Property editors -->
                        <Grid ColumnSpacing="10" RowSpacing="10" Visibility="{Binding HasSelectedShape, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Type" Style="{StaticResource InspectorLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" AutomationProperties.Name="Shape type" HorizontalAlignment="Stretch"
                                      SelectedItem="{Binding SelectedShape.Prst, Mode=TwoWay}" ItemsSource="{Binding PaletteItems}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                                  Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Data="{Binding Converter={StaticResource ShapeGeom}}" />
                                            <TextBlock Text="{Binding Converter={StaticResource PresetName}}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="Position" Style="{StaticResource InspectorLabel}" />
                            <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox AutomationProperties.Name="X position" PlaceholderText="X" ToolTipService.ToolTip="X — distance from the left edge (px)" Minimum="0"
                                           Value="{Binding SelectedShape.X, Mode=TwoWay}" SmallChange="1" LargeChange="10" />
                                <NumberBox Grid.Column="1" AutomationProperties.Name="Y position" PlaceholderText="Y" ToolTipService.ToolTip="Y — distance from the top edge (px)" Minimum="0"
                                           Value="{Binding SelectedShape.Y, Mode=TwoWay}" SmallChange="1" LargeChange="10" />
                            </Grid>

                            <TextBlock Grid.Row="2" Text="Size" Style="{StaticResource InspectorLabel}" />
                            <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox AutomationProperties.Name="Width" PlaceholderText="W" ToolTipService.ToolTip="Width (px)" Minimum="4"
                                           Value="{Binding SelectedShape.Width, Mode=TwoWay}" SmallChange="1" LargeChange="10" />
                                <NumberBox Grid.Column="1" AutomationProperties.Name="Height" PlaceholderText="H" ToolTipService.ToolTip="Height (px)" Minimum="4"
                                           Value="{Binding SelectedShape.Height, Mode=TwoWay}" SmallChange="1" LargeChange="10" />
                            </Grid>

                            <TextBlock Grid.Row="3" Text="Fill" Style="{StaticResource InspectorLabel}" />
                            <Grid Grid.Row="3" Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="FillSwatchButton" Width="32" Height="32" Padding="3" AutomationProperties.Name="Pick fill colour"
                                        ToolTipService.ToolTip="Pick a fill colour">
                                    <Border Width="24" Height="24" CornerRadius="4"
                                            Background="{Binding SelectedShape.Fill, Converter={StaticResource FillBrushConverter}}" />
                                    <Button.Flyout>
                                        <Flyout x:Name="FillFlyout" Opening="OnFillFlyoutOpening">
                                            <StackPanel Spacing="10">
                                                <ColorPicker x:Name="FillPicker" ColorSpectrumShape="Ring" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                             IsColorSliderVisible="True" IsColorChannelTextInputVisible="False" IsHexInputVisible="True" />
                                                <Button Content="Use this colour" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Right" Click="OnFillPickerApply" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBox Grid.Column="1" AutomationProperties.Name="Fill colour" PlaceholderText="RRGGBB" FontFamily="Consolas"
                                         ToolTipService.ToolTip="Fill colour as a 6-digit hex value"
                                         Text="{Binding SelectedShape.Fill, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" />
                            </Grid>

                            <TextBlock Grid.Row="4" Text="Rotation" Style="{StaticResource InspectorLabel}" />
                            <Grid Grid.Row="4" Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="-180" Maximum="180" StepFrequency="1" AutomationProperties.Name="Rotation" VerticalAlignment="Center"
                                        Value="{Binding SelectedShape.Rotation, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{Binding SelectedShape.Rotation}" /><Run Text="°" />
                                </TextBlock>
                            </Grid>

                            <TextBlock Grid.Row="5" Text="Label" Style="{StaticResource InspectorLabel}" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <TextBox Grid.Row="5" Grid.Column="1" AutomationProperties.Name="Text label" PlaceholderText="Text shown on the shape"
                                     Text="{Binding SelectedShape.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>

                    <!-- Shapes on canvas: fills the rest of the pane -->
                    <Grid Grid.Row="1" Margin="12,8,12,12" Padding="10,10,10,4" RowSpacing="4" CornerRadius="8" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Shapes on canvas" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding LineStats}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding ShapesListHint}" Style="{StaticResource PaneCaption}" FontSize="11.5" />
                        <ListView Grid.Row="2" x:Name="ShapesList" ItemsSource="{Binding Shapes}" SelectedItem="{Binding SelectedShape, Mode=TwoWay}"
                                  Margin="-10,4,-10,0" AutomationProperties.Name="Shapes on canvas">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,6" ColumnSpacing="10" AutomationProperties.Name="{Binding ListTitle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Width="18" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                              Fill="{Binding Fill, Converter={StaticResource FillBrushConverter}}"
                                              Stroke="{Binding Fill, Converter={StaticResource FillBrushConverter}}" StrokeThickness="1"
                                              Data="{Binding Prst, Converter={StaticResource ShapeGeom}}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ListTitle}" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ListSubtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding ListSubtitle, Converter={StaticResource EmptyToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status -->
        <Grid Grid.Row="2" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" Padding="14,7" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding SelectionSummary}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
            <!-- Zoom: Ctrl+scroll and pinch always worked but nothing showed the level or offered
                 a way back. Presets now open fitted to the canvas. -->
            <DropDownButton x:Name="ZoomButton" Grid.Column="2" Padding="8,0" Height="24" MinWidth="70" FontSize="12"
                            Margin="0,-4" AutomationProperties.Name="Zoom"
                            ToolTipService.ToolTip="Zoom — Ctrl+scroll to zoom, Ctrl+0 to fit the diagram">
                <TextBlock x:Name="ZoomText" Text="100%" FontSize="12" />
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedRight">
                        <MenuFlyoutItem Text="Fit diagram" Click="OnZoomFitClick" KeyboardAcceleratorTextOverride="Ctrl+0">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9A6;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Actual size" Click="OnZoomActualClick" KeyboardAcceleratorTextOverride="Ctrl+1" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Zoom in" Click="OnZoomInClick" KeyboardAcceleratorTextOverride="Ctrl+=">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A3;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Zoom out" Click="OnZoomOutClick" KeyboardAcceleratorTextOverride="Ctrl+−">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71F;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>
    </Grid>
</Window>

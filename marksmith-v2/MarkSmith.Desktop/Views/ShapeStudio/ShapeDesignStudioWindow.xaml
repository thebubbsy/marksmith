<Window
    x:Class="MarkSmith.Views.ShapeStudio.ShapeDesignStudioWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:MarkSmith.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:MarkSmith.Converters"
    mc:Ignorable="d"
    Title="MLShape &amp; SmartArt Vector Studio">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <conv:ShapeGeometryConverter x:Key="ShapeGeom" />
            <conv:FillBrushConverter x:Key="FillBrushConverter" />
            <conv:DashConverter x:Key="DashConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVis" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:PresetDisplayNameConverter x:Key="PresetName" />
            <conv:UprightLabelAngleConverter x:Key="UprightLabel" />
            <Style x:Key="InspectorLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Command bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="56" Padding="16,0" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE790;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="MLShape &amp; SmartArt Vector Studio" FontWeight="Bold" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Native DrawingML vector diagrams &amp; line art — Word cannot strip or corrupt them" FontSize="11" Opacity="0.65" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="100% Native Word Vector" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Insert into document" Command="{Binding InsertIntoDocumentCommand}" Style="{ThemeResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Insert this vector diagram into the active document — renders in preview and exports as native editable Word shapes." />
                <Button Content="Export .docx" Command="{Binding ExportDocxCommand}" ToolTipService.ToolTip="Export as standalone Word Document" />
                <Button Content="Export .dotx" Command="{Binding ExportDotxCommand}" ToolTipService.ToolTip="Export as Word Template" />
                <Button Content="Clear" Click="OnClearClick" ToolTipService.ToolTip="Remove every shape from the canvas" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" ColumnSpacing="10" Padding="12,10,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: SmartArt Templates + Palette + Tools -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">

                        <!-- 1. SMARTART & DIAGRAM TEMPLATES & PRESETS (40+ PROFESSIONAL LAYOUTS) -->
                        <Expander Header="Diagram presets (40+)" IsExpanded="True">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Filter by category to explore 40+ native Word vector layouts." FontSize="11" Opacity="0.7" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                
                                <ComboBox AutomationProperties.Name="Preset category" ItemsSource="{Binding PresetCategories}" SelectedItem="{Binding SelectedPresetCategory, Mode=TwoWay}" HorizontalAlignment="Stretch" />

                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredPresets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button services:HoverPolish.ApplyOnLoad="True" Click="OnPresetItemClick" Tag="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,5" Margin="0,2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="{Binding Glyph}" FontSize="14" Width="18" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                            <TextBlock Text="{Binding Description}" FontSize="9.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Text="Quick Favorites:" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                                <Grid ColumnSpacing="4" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Button Grid.Row="0" Grid.Column="0" Command="{Binding GeneratePyramidTemplateCommand}" HorizontalAlignment="Stretch" Padding="4,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Width="12" Height="12" Data="M6,0 L12,11 L0,11 Z" />
                                            <TextBlock Text="Pyramid" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="0" Grid.Column="1" Command="{Binding GenerateOrgChartTemplateCommand}" HorizontalAlignment="Stretch" Padding="4,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xF003;" FontSize="12" />
                                            <TextBlock Text="Org Chart" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="0" Command="{Binding GenerateSwotMatrixTemplateCommand}" HorizontalAlignment="Stretch" Padding="4,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8A9;" FontSize="12" />
                                            <TextBlock Text="SWOT 2x2" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="1" Command="{Binding GenerateCycleTemplateCommand}" HorizontalAlignment="Stretch" Padding="4,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE895;" FontSize="12" />
                                            <TextBlock Text="Cycle" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="2" Grid.Column="0" Command="{Binding GenerateTimelineTemplateCommand}" HorizontalAlignment="Stretch" Padding="4,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE787;" FontSize="12" />
                                            <TextBlock Text="Roadmap" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="2" Grid.Column="1" Command="{Binding GenerateVennTemplateCommand}" HorizontalAlignment="Stretch" Padding="4,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xEA3A;" FontSize="12" />
                                            <TextBlock Text="Venn" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="3" Grid.Column="0" Command="{Binding GeneratePillarsTemplateCommand}" HorizontalAlignment="Stretch" Padding="4,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Width="12" Height="12" Data="M6,0 L12,3 L12,4 L0,4 L0,3 Z M1,5 h2 v5 h-2 Z M5,5 h2 v5 h-2 Z M9,5 h2 v5 h-2 Z M0,11 h12 v1 h-12 Z" />
                                            <TextBlock Text="Pillars" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="3" Grid.Column="1" Command="{Binding GenerateFunnelTemplateCommand}" HorizontalAlignment="Stretch" Padding="4,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE71C;" FontSize="12" />
                                            <TextBlock Text="Funnel" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- 2. COLOR THEMES & PALETTES -->
                        <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="6" Padding="8">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE790;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Color Theme" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" AutomationProperties.Name="Color theme" ItemsSource="{Binding PaletteNames}" SelectedItem="{Binding SelectedPaletteName, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Content="Apply" Command="{Binding ApplyPaletteThemeCommand}" ToolTipService.ToolTip="Recolor all shapes with selected palette" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. DRAW WITH SHAPES -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Shape Primitives" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Click a shape to place on canvas, or drag to draw." FontSize="11" Opacity="0.7" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding PaletteItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><VariableSizedWrapGrid MaximumRowsOrColumns="2" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button services:HoverPolish.ApplyOnLoad="True" Margin="2" Padding="8,5" Click="OnPaletteItemClick" Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path Width="16" Height="16" Stretch="Uniform" Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                                      Data="{Binding Converter={StaticResource ShapeGeom}}" />
                                                <TextBlock Text="{Binding Converter={StaticResource PresetName}}" FontSize="11" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 4. PICTURE TO VECTOR STUDIO (HYBRID FUSION) -->
                        <Expander Header="Picture to Vector" IsExpanded="True">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Transform images into native Word vector shapes and crisp traced line art. Set either density to 0 for single-layer output."
                                           FontSize="11" Opacity="0.7" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                
                                <!-- Image Picker -->
                                <Button Content="Choose image…" Click="OnPickImageClick" HorizontalAlignment="Left" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="56" Height="56" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6"
                                            Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                                        <Image x:Name="FuseThumb" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock x:Name="FuseImageLabel" Text="No image selected" FontSize="11" Opacity="0.7"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- SECTION 1: SHAPES CONFIGURATION -->
                                <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xF0E2;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="Base Shape Mosaic" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        
                                        <StackPanel Spacing="2">
                                            <Grid>
                                                <TextBlock Text="Shape Density (0 to disable):" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
                                                <TextBlock Text="{Binding ElementName=FuseMosaicDensity, Path=Value}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider AutomationProperties.Name="Mosaic density" x:Name="FuseMosaicDensity" Minimum="0" Maximum="120" Value="32" SmallChange="1" LargeChange="5" />
                                        </StackPanel>

                                        <TextBlock Text="Tile primitives:" FontSize="10.5" Opacity="0.7" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Grid ColumnSpacing="4" RowSpacing="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <CheckBox x:Name="CompRoundRect" Grid.Row="0" Grid.Column="0" Content="RoundRect" IsChecked="True" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <CheckBox x:Name="CompRect" Grid.Row="0" Grid.Column="1" Content="Rect" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <CheckBox x:Name="CompEllipse" Grid.Row="1" Grid.Column="0" Content="Ellipse" IsChecked="True" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <CheckBox x:Name="CompChevron" Grid.Row="1" Grid.Column="1" Content="Chevron" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <CheckBox x:Name="CompDiamond" Grid.Row="2" Grid.Column="0" Content="Diamond" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <CheckBox x:Name="CompHexagon" Grid.Row="2" Grid.Column="1" Content="Hexagon" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <CheckBox x:Name="CompTriangle" Grid.Row="3" Grid.Column="0" Content="Triangle" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <CheckBox x:Name="CompCloud" Grid.Row="3" Grid.Column="1" Content="Cloud" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- SECTION 2: LINE ART & CONTOUR CONFIGURATION -->
                                <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE76D;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="Traced Line Art &amp; Contours" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>

                                        <StackPanel Spacing="2">
                                            <Grid>
                                                <TextBlock Text="Line Density (0 to disable):" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
                                                <TextBlock Text="{Binding ElementName=FuseLineDensity, Path=Value}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider AutomationProperties.Name="Line density" x:Name="FuseLineDensity" Minimum="0" Maximum="1200" Value="300" SmallChange="10" LargeChange="50" />
                                        </StackPanel>

                                        <TextBlock Text="Linework style:" FontSize="10.5" Opacity="0.7" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <StackPanel Spacing="2">
                                            <RadioButton x:Name="FuseModeCrossHatch" Content="Cross-Hatch (etching)" IsChecked="True" GroupName="FuseTraceMode" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="11" />
                                            <RadioButton x:Name="FuseModeTopographic" Content="Topographic Waves (flow)" GroupName="FuseTraceMode" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="11" />
                                            <RadioButton x:Name="FuseModeCalligraphic" Content="Calligraphic (30° chisel)" GroupName="FuseTraceMode" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="11" />
                                            <RadioButton x:Name="FuseModeEdges" Content="Edges (contours)" GroupName="FuseTraceMode" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="11" />
                                            <RadioButton x:Name="FuseModeEngraved" Content="Engraved (hatching)" GroupName="FuseTraceMode" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="11" />
                                            <RadioButton x:Name="FuseModeScanlines" Content="Scanlines (strokes)" GroupName="FuseTraceMode" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="11" />
                                            <RadioButton x:Name="FuseModeSilhouette" Content="Silhouette (solid)" GroupName="FuseTraceMode" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="11" />
                                        </StackPanel>

                                        <!-- Finer Detail Controls -->
                                        <Grid ColumnSpacing="6" Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" Spacing="1">
                                                <TextBlock Text="Detail Threshold:" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Slider x:Name="FuseEdgeSensitivity" Minimum="5" Maximum="80" Value="30" ToolTipService.ToolTip="Lower = captures finer micro-textures and subtle details" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="Stroke Width (pt):" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Slider x:Name="FuseStrokeWidth" Minimum="0.5" Maximum="5.0" Value="1.5" StepFrequency="0.1" ToolTipService.ToolTip="Thickness of traced vector ink strokes" />
                                            </StackPanel>
                                        </Grid>

                                        <CheckBox x:Name="FuseMonochrome" Content="Monochrome dark ink" IsChecked="True" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- SINGLE GO BUTTON -->
                                <Button Click="OnFuseImageClick" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,8"
                                        AutomationProperties.Name="Convert image to DrawingML vectors">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE945;" FontSize="13" />
                                        <TextBlock Text="Convert image to DrawingML vectors" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <!-- Markdown Utilities -->
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <Button Content="Copy Markdown" Click="OnCopyMarkdownClick" FontSize="11" Padding="8,4" />
                                    <Button Content="Load Markdown" Click="OnLoadMarkdownClick" FontSize="11" Padding="8,4" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CENTER: canvas + toolbar -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Canvas Toolbar: Alignment, Spacing, Duplication -->
                    <Grid Grid.Row="0" Padding="10,6" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Align:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <Button Command="{Binding AlignLeftCommand}" ToolTipService.ToolTip="Align Left" Padding="6,4"><PathIcon Width="12" Height="12" Data="M0.75,0.75 h1.12 v10.5 h-1.12 Z M3,2.62 h7.5 v2.25 h-7.5 Z M3,7.12 h4.5 v2.25 h-4.5 Z" /></Button>
                            <Button Command="{Binding AlignCenterCommand}" ToolTipService.ToolTip="Align Center" Padding="6,4"><PathIcon Width="12" Height="12" Data="M5.44,0.75 h1.12 v10.5 h-1.12 Z M1.5,2.62 h9 v2.25 h-9 Z M3,7.12 h6 v2.25 h-6 Z" /></Button>
                            <Button Command="{Binding AlignRightCommand}" ToolTipService.ToolTip="Align Right" Padding="6,4"><PathIcon Width="12" Height="12" Data="M10.12,0.75 h1.12 v10.5 h-1.12 Z M1.5,2.62 h7.5 v2.25 h-7.5 Z M4.5,7.12 h4.5 v2.25 h-4.5 Z" /></Button>
                            <Button Command="{Binding AlignTopCommand}" ToolTipService.ToolTip="Align Top" Padding="6,4"><PathIcon Width="12" Height="12" Data="M0.75,0.75 h10.5 v1.12 h-10.5 Z M2.62,3 h2.25 v7.5 h-2.25 Z M7.12,3 h2.25 v4.5 h-2.25 Z" /></Button>
                            <Button Command="{Binding AlignMiddleCommand}" ToolTipService.ToolTip="Align Middle" Padding="6,4"><PathIcon Width="12" Height="12" Data="M0.75,5.44 h10.5 v1.12 h-10.5 Z M2.62,1.5 h2.25 v9 h-2.25 Z M7.12,3 h2.25 v6 h-2.25 Z" /></Button>
                            <Button Command="{Binding AlignBottomCommand}" ToolTipService.ToolTip="Align Bottom" Padding="6,4"><PathIcon Width="12" Height="12" Data="M0.75,10.12 h10.5 v1.12 h-10.5 Z M2.62,1.5 h2.25 v7.5 h-2.25 Z M7.12,4.5 h2.25 v4.5 h-2.25 Z" /></Button>
                            <AppBarSeparator Margin="2,0" />
                            <Button Command="{Binding DistributeHorizontalCommand}" ToolTipService.ToolTip="Distribute Horizontally" Padding="6,4"><PathIcon Width="12" Height="12" Data="M0.75,0.75 h1.12 v10.5 h-1.12 Z M10.12,0.75 h1.12 v10.5 h-1.12 Z M4.88,3 h2.25 v6 h-2.25 Z" /></Button>
                            <Button Command="{Binding DistributeVerticalCommand}" ToolTipService.ToolTip="Distribute Vertically" Padding="6,4"><PathIcon Width="12" Height="12" Data="M0.75,0.75 h10.5 v1.12 h-10.5 Z M0.75,10.12 h10.5 v1.12 h-10.5 Z M3,4.88 h6 v2.25 h-6 Z" /></Button>
                            <AppBarSeparator Margin="2,0" />
                            <Button Command="{Binding DuplicateSelectedCommand}" ToolTipService.ToolTip="Duplicate selected shape (Ctrl+D)" Padding="6,4">
                                <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE8C8;" FontSize="12" /><TextBlock Text="Duplicate" FontSize="11" /></StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Tool:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveTool, Converter={StaticResource PresetName}}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- dense trace preview -->
                    <StackPanel Grid.Row="1" Visibility="{Binding IsDense, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Padding="20">
                        <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Image x:Name="DensePreview" Stretch="Uniform" MaxWidth="1300" MaxHeight="820" />
                        </Border>
                        <TextBlock Text="Dense line-art preview — every line is individually selectable and exports as a native Word line." FontSize="11" Opacity="0.65" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" MaxWidth="760" />
                    </StackPanel>

                    <!-- editable canvas -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Enabled"
                                  Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}">
                        <Grid Width="2200" Height="1800">
                            <Canvas x:Name="MainCanvas" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                    PointerPressed="OnCanvasPointerPressed">
                                <ItemsControl ItemsSource="{Binding Shapes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="{Binding Width}" Height="{Binding Height}"
                                                  Background="Transparent"
                                                  RenderTransformOrigin="0.5,0.5"
                                                  PointerPressed="OnShapePointerPressed"
                                                  PointerMoved="OnShapePointerMoved"
                                                  PointerReleased="OnShapePointerReleased">
                                                <!-- Rotate about the shape's own centre FIRST, then move it into place.
                                                     The old translate-then-rotate order spun every rotated shape about
                                                     its untranslated centre, so the Funnel preset (180°) and any shape
                                                     given a rotation in the inspector flew off the canvas. -->
                                                <Grid.RenderTransform>
                                                    <TransformGroup>
                                                        <RotateTransform Angle="{Binding Rotation}" />
                                                        <TranslateTransform X="{Binding X}" Y="{Binding Y}" />
                                                    </TransformGroup>
                                                </Grid.RenderTransform>
                                                <Path Stretch="Fill"
                                                      Data="{Binding Prst, Converter={StaticResource ShapeGeom}}"
                                                      Fill="{Binding Fill, Converter={StaticResource FillBrushConverter}}"
                                                      Stroke="{Binding Fill, Converter={StaticResource FillBrushConverter}}"
                                                      StrokeThickness="1.5"
                                                      StrokeDashArray="{Binding IsSelected, Converter={StaticResource DashConverter}}"
                                                      Loaded="OnShapeLoaded"
                                                      DataContextChanged="OnShapeDataContextChanged" />
                                                <!-- Text on top of the shape -->
                                                <TextBlock Text="{Binding Text}"
                                                           Foreground="{Binding TextForegroundHex, Converter={StaticResource FillBrushConverter}}"
                                                           FontSize="11" FontWeight="SemiBold" TextAlignment="Center"
                                                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           MaxWidth="{Binding Width}" MaxHeight="{Binding Height}"
                                                           Padding="6,4" RenderTransformOrigin="0.5,0.5"
                                                           Visibility="{Binding Text, Converter={StaticResource EmptyToVis}}">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="{Binding Rotation, Converter={StaticResource UprightLabel}}" />
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>

                    <!-- empty hint -->
                    <StackPanel Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="520">
                        <FontIcon Glyph="&#xE790;" FontSize="40" Foreground="{ThemeResource TextFillColorDisabledBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="SmartArt &amp; Vector Shape Studio" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Pick a SmartArt Preset on the left (Pyramid, Org Chart, SWOT, Cycle, Roadmap) or compose pictures into shape mosaics. Every shape is 100% native vector in Word."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT: inspector + shapes list -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Shape Inspector" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <!-- Empty state: the property editors used to sit there blank (empty Type
                             combo, empty boxes) whenever nothing was selected. Now a short card says
                             why and what to do; the editors only appear with a selection. -->
                        <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="8" Padding="16,22"
                                Visibility="{Binding SelectedShape, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8B0;" FontSize="26" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding InspectorEmptyTitle}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding InspectorEmptyHint}" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Property editors: one label column so every row lines up; number boxes
                             validate and commit on Enter / focus loss instead of silently dropping
                             half-typed text; the fill shows a live swatch beside its hex. -->
                        <Grid ColumnSpacing="10" RowSpacing="10" Visibility="{Binding HasSelectedShape, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Type" Style="{StaticResource InspectorLabel}" />
                            <ComboBox Grid.Row="0" Grid.Column="1" AutomationProperties.Name="Shape type" HorizontalAlignment="Stretch"
                                      SelectedItem="{Binding SelectedShape.Prst, Mode=TwoWay}" ItemsSource="{Binding PaletteItems}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                                  Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Data="{Binding Converter={StaticResource ShapeGeom}}" />
                                            <TextBlock Text="{Binding Converter={StaticResource PresetName}}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="Position" Style="{StaticResource InspectorLabel}" />
                            <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox AutomationProperties.Name="X position" PlaceholderText="X" ToolTipService.ToolTip="X position (px)"
                                           Value="{Binding SelectedShape.X, Mode=TwoWay}" SmallChange="1" LargeChange="10" />
                                <NumberBox Grid.Column="1" AutomationProperties.Name="Y position" PlaceholderText="Y" ToolTipService.ToolTip="Y position (px)"
                                           Value="{Binding SelectedShape.Y, Mode=TwoWay}" SmallChange="1" LargeChange="10" />
                            </Grid>

                            <TextBlock Grid.Row="2" Text="Size" Style="{StaticResource InspectorLabel}" />
                            <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox AutomationProperties.Name="Width" PlaceholderText="W" ToolTipService.ToolTip="Width (px)" Minimum="0"
                                           Value="{Binding SelectedShape.Width, Mode=TwoWay}" SmallChange="1" LargeChange="10" />
                                <NumberBox Grid.Column="1" AutomationProperties.Name="Height" PlaceholderText="H" ToolTipService.ToolTip="Height (px)" Minimum="0"
                                           Value="{Binding SelectedShape.Height, Mode=TwoWay}" SmallChange="1" LargeChange="10" />
                            </Grid>

                            <TextBlock Grid.Row="3" Text="Fill" Style="{StaticResource InspectorLabel}" />
                            <Grid Grid.Row="3" Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="6" VerticalAlignment="Center"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        Background="{Binding SelectedShape.Fill, Converter={StaticResource FillBrushConverter}}" />
                                <TextBox Grid.Column="1" AutomationProperties.Name="Fill color" PlaceholderText="RRGGBB" FontFamily="Consolas"
                                         ToolTipService.ToolTip="Fill colour as a 6-digit hex value"
                                         Text="{Binding SelectedShape.Fill, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" />
                            </Grid>

                            <TextBlock Grid.Row="4" Text="Rotation" Style="{StaticResource InspectorLabel}" />
                            <Grid Grid.Row="4" Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="-180" Maximum="180" StepFrequency="1" AutomationProperties.Name="Rotation" VerticalAlignment="Center"
                                        Value="{Binding SelectedShape.Rotation, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{Binding SelectedShape.Rotation}" /><Run Text="°" />
                                </TextBlock>
                            </Grid>

                            <TextBlock Grid.Row="5" Text="Label" Style="{StaticResource InspectorLabel}" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <TextBox Grid.Row="5" Grid.Column="1" AutomationProperties.Name="Text label" PlaceholderText="Text shown on the shape"
                                     Text="{Binding SelectedShape.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" />

                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding DuplicateSelectedCommand}" ToolTipService.ToolTip="Duplicate selected shape (Ctrl+D)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                        <TextBlock Text="Duplicate" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RemoveSelectedCommand}" ToolTipService.ToolTip="Delete selected shape (Del)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <TextBlock Text="Delete" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="8" Padding="10">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Shapes on Canvas" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding LineStats}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding ShapesListHint}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                <ListView MaxHeight="400" ItemsSource="{Binding Shapes}" SelectedItem="{Binding SelectedShape, Mode=TwoWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="2,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform" Fill="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,8,0"
                                                      Data="{Binding Prst, Converter={StaticResource ShapeGeom}}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Text}" FontSize="10" Opacity="0.7" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Width="12" Height="12" CornerRadius="2"
                                                        Background="{Binding Fill, Converter={StaticResource FillBrushConverter}}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="2" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" Padding="14,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>
    </Grid>
</Window>

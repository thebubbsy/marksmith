<Window
    x:Class="MarkSmith.Views.ShapeStudio.ShapeDesignStudioWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:MarkSmith.Converters"
    mc:Ignorable="d"
    Title="MLShape Design Studio">

    <Grid x:Name="RootGrid" Background="#1B1B1F">
        <Grid.Resources>
            <conv:ShapeGeometryConverter x:Key="ShapeGeom" />
            <conv:FillBrushConverter x:Key="FillBrushConverter" />
            <conv:DashConverter x:Key="DashConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Command bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="52" Padding="16,0" Background="#232329">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE790;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="MLShape Design Studio" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Foreground="White" />
                <Border Background="#0078D4" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="Native DrawingML Shapes" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Export .docx" Click="OnExportDocxClick" Style="{ThemeResource AccentButtonStyle}" />
                <Button Content="Clear" Click="OnClearClick" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" ColumnSpacing="10" Padding="12,10,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: palette -->
            <Border Grid.Column="0" Background="#232329" BorderBrush="#33333B" BorderThickness="1" CornerRadius="8" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Shape Palette" FontWeight="SemiBold" FontSize="14" Foreground="White" />
                            <TextBlock Text="Select a shape, then click the canvas to place it." FontSize="11" Opacity="0.7" Foreground="White" TextWrapping="Wrap" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding PaletteItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><VariableSizedWrapGrid MaximumRowsOrColumns="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="2" Padding="10,6" Click="OnPaletteItemClick" Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Width="18" Height="18" Stretch="Uniform" Fill="#777777"
                                                  Data="{Binding Converter={StaticResource ShapeGeom}}" />
                                            <TextBlock Text="{Binding}" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="#1E1E24" CornerRadius="8" Padding="10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Image → Shapes" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                <TextBlock Text="Rebuild a picture on this canvas from shapes." FontSize="11" Opacity="0.7" Foreground="White" TextWrapping="Wrap" />
                                <Button Content="Choose image..." Click="OnPickImageClick" HorizontalAlignment="Left" />
                                <TextBlock x:Name="ComposeImageLabel" Text="No image selected" FontSize="11" Opacity="0.7" Foreground="White" TextWrapping="Wrap" />
                                <TextBlock Text="Density:" FontSize="11" Foreground="White" />
                                <Slider x:Name="ComposeDensity" Minimum="24" Maximum="1024" Value="120" StepFrequency="16" />
                                <TextBlock Text="Compose with (pick one or many):" FontSize="11" Foreground="White" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <CheckBox x:Name="CompEllipse" Content="Ellipse" IsChecked="True" Foreground="White" />
                                    <CheckBox x:Name="CompRoundRect" Content="RoundRect" IsChecked="True" Foreground="White" />
                                    <CheckBox x:Name="CompRect" Content="Rect" Foreground="White" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <CheckBox x:Name="CompChevron" Content="Chevron" Foreground="White" />
                                    <CheckBox x:Name="CompDiamond" Content="Diamond" Foreground="White" />
                                    <CheckBox x:Name="CompHexagon" Content="Hexagon" Foreground="White" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <CheckBox x:Name="CompTriangle" Content="Triangle" Foreground="White" />
                                    <CheckBox x:Name="CompParallelogram" Content="Parallelogram" Foreground="White" />
                                    <CheckBox x:Name="CompLine" Content="Line" Foreground="White" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <CheckBox x:Name="CompArc" Content="Arc" Foreground="White" />
                                    <CheckBox x:Name="CompCloud" Content="Cloud" Foreground="White" />
                                    <CheckBox x:Name="CompHeart" Content="Heart" Foreground="White" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <CheckBox x:Name="CompMoon" Content="Moon" Foreground="White" />
                                    <CheckBox x:Name="CompCircularArrow" Content="CircArrow" Foreground="White" />
                                    <CheckBox x:Name="CompSmiley" Content="Smiley" Foreground="White" />
                                </StackPanel>
                                <TextBlock Text="Line alone = full image as scanline strokes" FontSize="10" Opacity="0.6" Foreground="White" TextWrapping="Wrap" />
                                <Button Content="Compose onto canvas" Click="OnComposeImageClick" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CENTER: free canvas -->
            <Border Grid.Column="1" Background="#18181C" BorderBrush="#33333B" BorderThickness="1" CornerRadius="8" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="10,8" Background="#1F1F25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Canvas — click to place, drag to move, select then edit" FontWeight="SemiBold" FontSize="12"
                                   Foreground="White" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Active:" FontSize="12" Foreground="#888888" />
                            <TextBlock Text="{Binding ActiveTool}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Enabled">
                        <Grid Width="2200" Height="1800">
                            <Canvas x:Name="MainCanvas" Background="#141417"
                                    PointerPressed="OnCanvasPointerPressed">
                                <ItemsControl ItemsSource="{Binding Shapes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="{Binding Width}" Height="{Binding Height}"
                                                  RenderTransformOrigin="0.5,0.5"
                                                  PointerPressed="OnShapePointerPressed"
                                                  PointerMoved="OnShapePointerMoved"
                                                  PointerReleased="OnShapePointerReleased">
                                                <Grid.RenderTransform>
                                                    <RotateTransform Angle="{Binding Rotation}" />
                                                </Grid.RenderTransform>
                                                <Path Stretch="Fill"
                                                      Fill="{Binding Fill, Converter={StaticResource FillBrushConverter}}"
                                                      Data="{Binding Prst, Converter={StaticResource ShapeGeom}}"
                                                      Stroke="#FFFFFF" StrokeThickness="1.5"
                                                      StrokeDashArray="{Binding IsSelected, Converter={StaticResource DashConverter}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT: inspector + list -->
            <Border Grid.Column="2" Background="#232329" BorderBrush="#33333B" BorderThickness="1" CornerRadius="8" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Inspector" FontWeight="SemiBold" FontSize="14" Foreground="White" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="(select a shape on the canvas)" FontSize="11" Opacity="0.6" Foreground="White"
                                       Visibility="{Binding SelectedShape, Converter={StaticResource NullToVisibilityConverter}}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Type:" FontSize="12" Foreground="White" VerticalAlignment="Center" Width="40" />
                                <ComboBox SelectedItem="{Binding SelectedShape.Prst, Mode=TwoWay}" ItemsSource="{Binding PaletteItems}" Width="150" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="X:" FontSize="12" Foreground="White" VerticalAlignment="Center" Width="40" />
                                <TextBox Text="{Binding SelectedShape.X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                <TextBlock Text="Y:" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                                <TextBox Text="{Binding SelectedShape.Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="W:" FontSize="12" Foreground="White" VerticalAlignment="Center" Width="40" />
                                <TextBox Text="{Binding SelectedShape.Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                <TextBlock Text="H:" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                                <TextBox Text="{Binding SelectedShape.Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Fill:" FontSize="12" Foreground="White" VerticalAlignment="Center" Width="40" />
                                <TextBox Text="{Binding SelectedShape.Fill, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Rot:" FontSize="12" Foreground="White" VerticalAlignment="Center" Width="40" />
                                <Slider Minimum="-180" Maximum="180" Value="{Binding SelectedShape.Rotation, Mode=TwoWay}" Width="180" />
                            </StackPanel>
                            <Button Content="Delete shape" Click="OnDeleteShapeClick" HorizontalAlignment="Left" />
                        </StackPanel>

                        <Border Background="#1E1E24" CornerRadius="8" Padding="10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Shapes on canvas" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                <ListView MaxHeight="280" ItemsSource="{Binding Shapes}" SelectedItem="{Binding SelectedShape, Mode=TwoWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Path Width="14" Height="14" Stretch="Uniform" Fill="#CCCCCC"
                                                      Data="{Binding Prst, Converter={StaticResource ShapeGeom}}" />
                                                <TextBlock Text="{Binding Prst}" FontSize="12" Foreground="White" />
                                                <TextBlock Text="{Binding Fill}" FontSize="10" Opacity="0.6" Foreground="White" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="2" Background="#232329" Padding="14,8" BorderBrush="#33333B" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#CCCCCC" />
        </Border>
    </Grid>
</Window>

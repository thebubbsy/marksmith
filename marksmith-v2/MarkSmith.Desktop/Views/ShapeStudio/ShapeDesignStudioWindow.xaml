<Window
    x:Class="MarkSmith.Views.ShapeStudio.ShapeDesignStudioWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:MarkSmith.Converters"
    mc:Ignorable="d"
    Title="MLShape Design Studio">

    <Grid x:Name="RootGrid" Background="#1B1B1F">
        <Grid.Resources>
            <conv:ShapeGeometryConverter x:Key="ShapeGeom" />
            <conv:FillBrushConverter x:Key="FillBrushConverter" />
            <conv:DashConverter x:Key="DashConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVis" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Command bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="56" Padding="16,0" Background="#232329">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE790;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="MLShape Design Studio" FontWeight="Bold" FontSize="16" Foreground="White" />
                    <TextBlock Text="trace any picture into editable Word line art" FontSize="11" Opacity="0.65" Foreground="White" />
                </StackPanel>
                <Border Background="#0078D4" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="Native DrawingML Line Items" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Export .dotx" Click="OnExportDotxClick" Style="{ThemeResource AccentButtonStyle}" />
                <Button Content="Export .docx" Click="OnExportDocxClick" />
                <Button Content="Clear" Click="OnClearClick" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" ColumnSpacing="10" Padding="12,10,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: trace workflow + shape palette -->
            <Border Grid.Column="0" Background="#232329" BorderBrush="#33333B" BorderThickness="1" CornerRadius="8" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">

                        <!-- TRACE HERO -->
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Picture → Line Art" FontWeight="SemiBold" FontSize="14" Foreground="White" />
                                <TextBlock Text="Pick an image, choose how fine, and trace it into dense non-overlapping line items." FontSize="11" Opacity="0.7" Foreground="White" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="1 · Choose an image" FontSize="11" FontWeight="SemiBold" Foreground="#BBBBBB" />
                                <Button Content="Choose image from Explorer…" Click="OnPickImageClick" HorizontalAlignment="Left" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="72" Height="72" Background="#141417" BorderBrush="#33333B" BorderThickness="1" CornerRadius="6"
                                            Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                                        <Image x:Name="TraceThumb" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock x:Name="TraceImageLabel" Text="No image selected" FontSize="11" Opacity="0.7"
                                               Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="2 · Line density" FontSize="11" FontWeight="SemiBold" Foreground="#BBBBBB" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TraceDensity}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="rows" FontSize="11" Opacity="0.6" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                                <Slider Minimum="0" Maximum="100" Value="{Binding TraceDensityLog, Mode=TwoWay}" />
                                <TextBlock Text="log scale 16 → 16,384 scanlines — crank it up until it looks like the image" FontSize="10" Opacity="0.55" Foreground="White" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="3 · Style" FontSize="11" FontWeight="SemiBold" Foreground="#BBBBBB" />
                                <RadioButton x:Name="ModeEngraved" Content="Engraved (hatch shading)" GroupName="TraceMode" Checked="OnTraceModeChecked" Foreground="White" FontSize="12" />
                                <RadioButton x:Name="ModeEdges" Content="Edges (contour lines)" GroupName="TraceMode" Checked="OnTraceModeChecked" Foreground="White" FontSize="12" />
                                <RadioButton x:Name="ModeSilhouette" Content="Silhouette (solid shape)" GroupName="TraceMode" Checked="OnTraceModeChecked" Foreground="White" FontSize="12" />
                                <RadioButton x:Name="ModeScanlines" Content="Scanlines (thick strokes)" GroupName="TraceMode" Checked="OnTraceModeChecked" Foreground="White" FontSize="12" />
                                <CheckBox Content="Monochrome ink (color = sampled from image)" IsChecked="{Binding TraceMonochrome, Mode=TwoWay}" Foreground="White" FontSize="12" />
                            </StackPanel>

                            <Button Content="Trace onto canvas" Click="OnTraceClick" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                            <TextBlock Text="{Binding LineStats}" FontSize="12" FontWeight="SemiBold" Foreground="#7FD1A0" TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Copy as Markdown" Click="OnCopyMarkdownClick" />
                                <Button Content="Load from Markdown" Click="OnLoadMarkdownClick" />
                            </StackPanel>
                            <TextBlock Text="Paste the :::shapes block into the editor — the preview shows the SVG, export writes native Word lines." FontSize="10" Opacity="0.55" Foreground="White" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- DRAW (classic palette + shape mosaic) -->
                        <Expander Header="Draw with shapes" IsExpanded="False">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Shape Palette" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                    <TextBlock Text="Select a shape, then click the canvas to place it." FontSize="11" Opacity="0.7" Foreground="White" TextWrapping="Wrap" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding PaletteItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><VariableSizedWrapGrid MaximumRowsOrColumns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="2" Padding="10,6" Click="OnPaletteItemClick" Tag="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Path Width="18" Height="18" Stretch="Uniform" Fill="#777777"
                                                          Data="{Binding Converter={StaticResource ShapeGeom}}" />
                                                    <TextBlock Text="{Binding}" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Classic: picture made of shapes" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                    <TextBlock Text="Rebuild a picture from the chosen preset shapes (coarse mosaic)." FontSize="11" Opacity="0.7" Foreground="White" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ComposeImageLabel" Text="No image selected" FontSize="11" Opacity="0.7" Foreground="White" TextWrapping="Wrap" />
                                    <TextBlock Text="Density:" FontSize="11" Foreground="White" />
                                    <Slider x:Name="ComposeDensity" Minimum="24" Maximum="1024" Value="120" StepFrequency="16" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <CheckBox x:Name="CompEllipse" Content="Ellipse" Foreground="White" />
                                        <CheckBox x:Name="CompRoundRect" Content="RoundRect" Foreground="White" />
                                        <CheckBox x:Name="CompRect" Content="Rect" Foreground="White" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <CheckBox x:Name="CompChevron" Content="Chevron" Foreground="White" />
                                        <CheckBox x:Name="CompDiamond" Content="Diamond" Foreground="White" />
                                        <CheckBox x:Name="CompHexagon" Content="Hexagon" Foreground="White" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <CheckBox x:Name="CompTriangle" Content="Triangle" Foreground="White" />
                                        <CheckBox x:Name="CompParallelogram" Content="Parallelogram" Foreground="White" />
                                        <CheckBox x:Name="CompLine" Content="Line" Foreground="White" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <CheckBox x:Name="CompArc" Content="Arc" Foreground="White" />
                                        <CheckBox x:Name="CompCloud" Content="Cloud" Foreground="White" />
                                        <CheckBox x:Name="CompHeart" Content="Heart" Foreground="White" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <CheckBox x:Name="CompMoon" Content="Moon" Foreground="White" />
                                        <CheckBox x:Name="CompCircularArrow" Content="CircArrow" Foreground="White" />
                                        <CheckBox x:Name="CompSmiley" Content="Smiley" Foreground="White" />
                                    </StackPanel>
                                    <TextBlock Text="Line alone = full image as scanline strokes" FontSize="10" Opacity="0.6" Foreground="White" TextWrapping="Wrap" />
                                    <CheckBox x:Name="CompSketch" Content="Sketch mode — wavy curved strokes" Foreground="White" />
                                    <Button Content="Compose onto canvas" Click="OnComposeImageClick" HorizontalAlignment="Left" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CENTER: canvas -->
            <Border Grid.Column="1" Background="#18181C" BorderBrush="#33333B" BorderThickness="1" CornerRadius="8" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="10,8" Background="#1F1F25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Canvas" FontWeight="SemiBold" FontSize="12"
                                   Foreground="White" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Active:" FontSize="12" Foreground="#888888" />
                            <TextBlock Text="{Binding ActiveTool}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- dense trace preview: one raster image, looks exactly like the picture -->
                    <StackPanel Grid.Row="1" Visibility="{Binding IsDense, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Padding="20">
                        <Border Background="#141417" BorderBrush="#33333B" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Image x:Name="DensePreview" Stretch="Uniform" MaxWidth="1300" MaxHeight="820" />
                        </Border>
                        <TextBlock Text="Dense line-art preview — every line is individually selectable in the Lines list and exports as a native Word line." FontSize="11" Opacity="0.65" Foreground="White" TextWrapping="Wrap" HorizontalAlignment="Center" MaxWidth="760" />
                    </StackPanel>

                    <!-- editable canvas -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Enabled"
                                  Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}">
                        <Grid Width="2200" Height="1800">
                            <Canvas x:Name="MainCanvas" Background="#141417"
                                    PointerPressed="OnCanvasPointerPressed">
                                <ItemsControl ItemsSource="{Binding Shapes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="{Binding Width}" Height="{Binding Height}"
                                                  Background="Transparent"
                                                  RenderTransformOrigin="0.5,0.5"
                                                  PointerPressed="OnShapePointerPressed"
                                                  PointerMoved="OnShapePointerMoved"
                                                  PointerReleased="OnShapePointerReleased">
                                                <Grid.RenderTransform>
                                                    <RotateTransform Angle="{Binding Rotation}" />
                                                </Grid.RenderTransform>
                                                <Path Stretch="Fill"
                                                      Stroke="#FFFFFF" StrokeThickness="1.5"
                                                      StrokeDashArray="{Binding IsSelected, Converter={StaticResource DashConverter}}"
                                                      Loaded="OnShapeLoaded" />
                                                <!-- Font on top of the shape: colour is the CONTRAST
                                                     RULE result (guarded against THIS shape's fill). -->
                                                <TextBlock Text="{Binding Text}"
                                                           Foreground="{Binding TextForegroundHex, Converter={StaticResource FillBrushConverter}}"
                                                           FontSize="11" FontWeight="SemiBold" TextAlignment="Center"
                                                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           MaxWidth="{Binding Width}" MaxHeight="{Binding Height}"
                                                           Visibility="{Binding Text, Converter={StaticResource EmptyToVis}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>

                    <!-- empty hint -->
                    <StackPanel Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="520">
                        <FontIcon Glyph="&#xE790;" FontSize="40" Foreground="#555555" HorizontalAlignment="Center" />
                        <TextBlock Text="Trace a picture into Word line art" FontSize="18" FontWeight="SemiBold" Foreground="#BBBBBB" HorizontalAlignment="Center" />
                        <TextBlock Text="1 · Choose an image on the left   2 · set the line density   3 · Trace onto canvas — every line stays individually editable and exports to .docx / .dotx as native Word lines."
                                   FontSize="12" Foreground="#888888" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT: inspector + lines list -->
            <Border Grid.Column="2" Background="#232329" BorderBrush="#33333B" BorderThickness="1" CornerRadius="8" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Inspector" FontWeight="SemiBold" FontSize="14" Foreground="White" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="(select a shape or line)" FontSize="11" Opacity="0.6" Foreground="White"
                                       Visibility="{Binding SelectedShape, Converter={StaticResource NullToVisibilityConverter}}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Type:" FontSize="12" Foreground="White" VerticalAlignment="Center" Width="40" />
                                <ComboBox SelectedItem="{Binding SelectedShape.Prst, Mode=TwoWay}" ItemsSource="{Binding PaletteItems}" Width="150" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="X:" FontSize="12" Foreground="White" VerticalAlignment="Center" Width="40" />
                                <TextBox Text="{Binding SelectedShape.X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                <TextBlock Text="Y:" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                                <TextBox Text="{Binding SelectedShape.Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="W:" FontSize="12" Foreground="White" VerticalAlignment="Center" Width="40" />
                                <TextBox Text="{Binding SelectedShape.Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                <TextBlock Text="H:" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                                <TextBox Text="{Binding SelectedShape.Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Fill:" FontSize="12" Foreground="White" VerticalAlignment="Center" Width="40" />
                                <TextBox Text="{Binding SelectedShape.Fill, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Label:" FontSize="12" Foreground="White" VerticalAlignment="Center" Width="40" />
                                <TextBox Text="{Binding SelectedShape.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                                <TextBlock Text="auto-contrasts vs fill" FontSize="10" Opacity="0.6" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Rot:" FontSize="12" Foreground="White" VerticalAlignment="Center" Width="40" />
                                <Slider Minimum="-180" Maximum="180" Value="{Binding SelectedShape.Rotation, Mode=TwoWay}" Width="180" />
                            </StackPanel>
                            <Button Content="Delete selected" Click="OnDeleteShapeClick" HorizontalAlignment="Left" />
                        </StackPanel>

                        <Border Background="#1E1E24" CornerRadius="8" Padding="10">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Lines / shapes on canvas" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                    <TextBlock Text="{Binding LineStats}" FontSize="11" Foreground="#888888" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Click any line to select it — tweak or delete it individually." FontSize="10" Opacity="0.6" Foreground="White" TextWrapping="Wrap" />
                                <ListView MaxHeight="400" ItemsSource="{Binding Shapes}" SelectedItem="{Binding SelectedShape, Mode=TwoWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Path Width="14" Height="14" Stretch="Uniform" Fill="#CCCCCC"
                                                      Data="{Binding Prst, Converter={StaticResource ShapeGeom}}" />
                                                <TextBlock Text="{Binding Prst}" FontSize="12" Foreground="White" />
                                                <TextBlock Text="{Binding Fill}" FontSize="10" Opacity="0.6" Foreground="White" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="2" Background="#232329" Padding="14,8" BorderBrush="#33333B" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#CCCCCC" />
        </Border>
    </Grid>
</Window>

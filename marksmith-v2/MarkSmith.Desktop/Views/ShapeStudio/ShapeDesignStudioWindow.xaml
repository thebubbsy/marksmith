                            <Button Style="{StaticResource ToolIconButton}" Command="{Binding RotateClockwiseCommand}" AutomationProperties.Name="Rotate 90 degrees right"
                                    RightTapped="OnRotateButtonRightTapped" DoubleTapped="OnRotateClockwiseDoubleTapped"

<Window
    x:Class="MarkSmith.Views.SmartArt.SmartArtDesignerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:smartart="using:MarkSmith.Views.SmartArt"
    mc:Ignorable="d"
    Title="MarkSmith SmartArt Designer Studio">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Application Title Bar -->
        <Grid Grid.Row="0" Height="48" x:Name="AppTitleBar" Padding="16,0" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE81E;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="SmartArt Designer Studio" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="v2.0 Ecosystem" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,150,0">
                <Button Content="Render Exactly as Word Would" Click="OnRenderFidelityClick" Style="{ThemeResource AccentButtonStyle}" />
                <Button Content="Export .docx" Click="OnExportDocxClick" />
                <Button Content="Export .glox" Click="OnExportGloxClick" />
                <Button Content="Import .glox..." Click="OnImportGloxClick" />
            </StackPanel>
        </Grid>

        <!-- Body: left panels | canvas | preview -->
        <Grid Grid.Row="1" ColumnSpacing="12" Padding="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: stacked panels (no tabs) -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">

                    <!-- Shape Palette -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Shape Palette" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Drag a shape onto the canvas." FontSize="11" Opacity="0.6" />
                            <smartart:SmartArtPaletteControl />
                        </StackPanel>
                    </Border>

                    <!-- Layout Gallery -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Layout Gallery" FontWeight="SemiBold" FontSize="13" />
                            <TextBox PlaceholderText="Search layouts..." MaxHeight="32"
                                     Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox SelectedIndex="{Binding SelectedCategoryIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" MaxHeight="34">
                                <ComboBoxItem Content="All Categories" />
                                <ComboBoxItem Content="Hierarchy" />
                                <ComboBoxItem Content="Process" />
                                <ComboBoxItem Content="Cycle" />
                                <ComboBoxItem Content="Matrix" />
                                <ComboBoxItem Content="Pyramid" />
                                <ComboBoxItem Content="Venn" />
                                <ComboBoxItem Content="Picture List" />
                            </ComboBox>
                            <ListView MaxHeight="210" ItemsSource="{Binding AvailableLayouts}" SelectedItem="{Binding SelectedLayout, Mode=TwoWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="2,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="{Binding Alias}" FontSize="10" Opacity="0.6" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{ThemeResource SystemControlBackgroundAccentBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="9" Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- Markdown Data -->
                    <Expander HorizontalAlignment="Stretch" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Text="Markdown Data" FontWeight="SemiBold" FontSize="12" />
                        </Expander.Header>
                        <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"
                                 Text="{Binding MarkdownText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="12"
                                 PlaceholderText="- Executive Board&#x0a;  - CEO&#x0a;  - CTO" />
                    </Expander>

                    <!-- Layout JSON -->
                    <Expander HorizontalAlignment="Stretch" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Text="Layout JSON" FontWeight="SemiBold" FontSize="12" />
                        </Expander.Header>
                        <StackPanel Spacing="8">
                            <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"
                                     Text="{Binding JsonDefinitionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" FontSize="12"
                                     PlaceholderText="{}{ 'Title': 'My Custom Layout' }" />
                            <Button Content="Compile JSON → .glox (desktop)" Click="OnCompileGloxClick" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <controls:GridSplitter Grid.Column="1" Width="8" Background="Transparent" />

            <!-- CENTER: visual canvas -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Visual Canvas — drag to move, double-click to edit text"
                               FontWeight="SemiBold" FontSize="12" Margin="2,0,0,6" Opacity="0.8" />
                    <smartart:SmartArtCanvasControl Grid.Row="1" />
                </Grid>
            </Border>

            <controls:GridSplitter Grid.Column="3" Width="8" Background="Transparent" />

            <!-- RIGHT: live preview -->
            <Border Grid.Column="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="12" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Real-Time Canvas Preview" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <CheckBox Grid.Column="1" x:Name="WordFidelityToggle" Content="Render Exactly as Word Would" Click="OnWordFidelityToggleClick" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Grid>

                    <WebView2 x:Name="PreviewWebView" Grid.Row="1" Margin="0" />
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" Padding="16,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>

<UserControl
    x:Class="MarkSmith.Views.SmartArt.SmartArtCanvasControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:MarkSmith.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />

        <DataTemplate x:Key="NodeTemplate">
            <Border Width="{Binding Width}" Height="{Binding Height}"
                    Background="{Binding Color}"
                    BorderBrush="#FFFFFF" BorderThickness="2"
                    CornerRadius="8" Padding="8"
                    PointerPressed="OnNodePointerPressed"
                    PointerMoved="OnNodePointerMoved"
                    PointerReleased="OnNodePointerReleased"
                    DoubleTapped="OnNodeDoubleTapped">

                <Grid>
                    <TextBlock Text="{Binding Text}"
                               Foreground="White" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsEditingText, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert, FallbackValue=Visible}" />

                    <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12" FontWeight="Bold" Foreground="Black"
                             HorizontalAlignment="Stretch" VerticalAlignment="Center"
                             LostFocus="OnNodeTextLostFocus"
                             KeyDown="OnNodeTextKeyDown"
                             Visibility="{Binding IsEditingText, Converter={StaticResource BoolToVisConverter}, FallbackValue=Collapsed}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ConnectorTemplate">
            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                  Stroke="{Binding Color}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#121216"
          AllowDrop="True"
          DragOver="OnCanvasDragOver"
          Drop="OnCanvasDrop"
          PointerPressed="OnCanvasPointerPressed"
          PointerMoved="OnCanvasPointerMoved"
          PointerReleased="OnCanvasPointerReleased">

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Enabled">
            <Canvas x:Name="MainCanvas" Width="2000" Height="2000" Background="Transparent">

                <!-- Connector lines (drawn beneath the nodes) -->
                <ItemsControl ItemsSource="{Binding Connectors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="2000" Height="2000" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="0" />
                            <Setter Property="Canvas.Top" Value="0" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <StaticResource ResourceKey="ConnectorTemplate" />
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Top-level nodes -->
                <ItemsControl ItemsSource="{Binding CanvasNodes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="2000" Height="2000" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.ItemTemplate>
                        <StaticResource ResourceKey="NodeTemplate" />
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Child nodes (auto-laid out under their parents) -->
                <ItemsControl ItemsSource="{Binding ChildCanvasNodes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="2000" Height="2000" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.ItemTemplate>
                        <StaticResource ResourceKey="NodeTemplate" />
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </ScrollViewer>
    </Grid>
</UserControl>

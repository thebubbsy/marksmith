<UserControl
    x:Class="MdToPdf.Views.SmartArt.SmartArtPaletteControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" Padding="12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search Header -->
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Shape Palette" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBox x:Name="SearchTextBox"
                     PlaceholderText="Search shapes &amp; primitives..."
                     TextChanged="OnSearchTextChanged"
                     FontSize="12" />
        </StackPanel>

        <!-- Category Selector -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="6" Padding="0,2">
                <ToggleButton x:Name="CatAll" Content="All" IsChecked="True" Click="OnCategoryPillClick" Padding="10,4" CornerRadius="12" FontSize="11" />
                <ToggleButton x:Name="CatBasic" Content="Basic" Click="OnCategoryPillClick" Padding="10,4" CornerRadius="12" FontSize="11" />
                <ToggleButton x:Name="CatSmartArt" Content="SmartArt" Click="OnCategoryPillClick" Padding="10,4" CornerRadius="12" FontSize="11" />
                <ToggleButton x:Name="CatSpecial" Content="Special" Click="OnCategoryPillClick" Padding="10,4" CornerRadius="12" FontSize="11" />
            </StackPanel>
        </ScrollViewer>

        <!-- Palette Items List with Drag-and-Drop enabled -->
        <ListView x:Name="PaletteListView"
                  Grid.Row="2"
                  ItemsSource="{Binding PaletteItems}"
                  SelectionMode="None"
                  CanDragItems="True"
                  DragItemsStarting="OnPaletteDragItemsStarting">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,3"
                            ToolTipService.ToolTip="{Binding Tooltip}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="4" Background="{Binding Color}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE81E;" FontSize="14" Foreground="White" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>

<UserControl
    x:Class="MarkSmith.Views.SuiteHubView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer x:Name="HubScroller" VerticalScrollBarVisibility="Auto" MaxHeight="620" MinWidth="460">
        <StackPanel Spacing="16" Margin="4,8,16,12">

            <!-- Suite Platform Header -->
            <Border x:Name="HeaderCardBorder"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="18,14">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="ms-appx:///Assets/logo.png" Width="44" Height="44"
                           VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- The dialog title already says Suite Hub; this card is about the app itself. -->
                            <TextBlock Text="MarkSmith" FontSize="16" FontWeight="SemiBold" />
                            <Border x:Name="VersionBadge" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,1" VerticalAlignment="Center"
                                    Tapped="OnVersionInfoTapped" RightTapped="OnVersionInfoRightTapped" ToolTipService.ToolTip="Click to copy version details (Ctrl+C, Right-click for options)" AutomationProperties.Name="MarkSmith Version badge">
                                <TextBlock x:Name="VersionText" Text="Version 3.0.0" FontSize="10.5" Opacity="0.8" />
                            </Border>
                            <Border x:Name="LicenseBadge" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,1" VerticalAlignment="Center"
                                    Tapped="OnVersionInfoTapped" RightTapped="OnVersionInfoRightTapped" ToolTipService.ToolTip="Click to copy plan and license details (Ctrl+C, Right-click for options)">
                                <TextBlock x:Name="LicenseText" Text="Free plan" FontSize="10.5" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                            </Border>
                            <Border x:Name="HealthStatusBadge" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,1" VerticalAlignment="Center"
                                    Tapped="OnHealthStatusTapped" RightTapped="OnHealthStatusRightTapped" ToolTipService.ToolTip="System status: Desktop Engine Ready · Click to copy diagnostic summary" AutomationProperties.Name="Suite health status">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="HealthStatusText" Text="Engine Ready" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <!-- Wraps rather than clipping: this sits between a fixed-width icon and the
                             Config Folder button, so the space it gets depends on the dialog width. -->
                        <TextBlock Text="Everything that works with MarkSmith: the drawing studios, your AI assistant, the browser extension, the command line and the web companion."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBox x:Name="HubSearchBox" Width="170" VerticalAlignment="Center"
                                 PlaceholderText="Filter suite (Ctrl+F)…"
                                 CornerRadius="6" FontSize="11.5"
                                 TextChanged="OnHubSearchBoxTextChanged" KeyDown="OnHubSearchBoxKeyDown"
                                 ToolTipService.ToolTip="Filter suite components &amp; templates · Esc clears" />
                        <Button x:Name="ShortcutsHelpButton" Click="OnShortcutsHelpClick" Padding="10,6"
                                ToolTipService.ToolTip="MarkSmith keyboard shortcuts &amp; cheat sheet (? or F1)"
                                AutomationProperties.Name="Keyboard shortcuts (? or F1)">
                            <Button.Flyout>
                                <Flyout x:Name="ShortcutsFlyout" Placement="BottomEdgeAlignedRight">
                                    <StackPanel Width="360" Spacing="10" Padding="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Keyboard Shortcuts Cheat Sheet" FontWeight="SemiBold" FontSize="13" />
                                            <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                                <TextBlock Text="MarkSmith v3" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Speed up your editing, studios, and navigation with these global shortcuts:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="10,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Hub &amp; Launching (Press 1–6)" FontWeight="SemiBold" FontSize="11.5" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="1" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" Width="40" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="Open Drawing Studios (Mermaid, Shapes, SmartArt)" FontSize="11" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="2" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" Width="40" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="Copy AI Assistant / MCP Config" FontSize="11" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="3" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" Width="40" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="Open Browser Extension Folder" FontSize="11" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="4" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" Width="40" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="Copy CLI Command" FontSize="11" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="5" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" Width="40" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="Launch Web Companion" FontSize="11" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="6" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" Width="40" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="Open Document Galaxy" FontSize="11" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="10,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Editor &amp; Navigation" FontWeight="SemiBold" FontSize="11.5" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="Ctrl+K" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" Width="75" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="Command Palette (Actions, Recents)" FontSize="11" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="Ctrl+G" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" Width="75" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="Go to Line dialog" FontSize="11" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="F7 / Shift+F7" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" Width="75" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="Next / Previous Diff Hunk in History" FontSize="11" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="Alt+R" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" Width="75" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="MindMap Radial Fan-Out layout" FontSize="11" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="Space" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" Width="75" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="Fold / Unfold MindMap branch" FontSize="11" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="Alt+E" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" Width="75" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="Auto-route shape connector around obstacles" FontSize="11" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE765;" FontSize="12" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Text="Shortcuts" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenConfigFolderButton" Click="OnOpenConfigFolderClick" Padding="10,6"
                                RightTapped="OnOpenConfigFolderRightTapped"
                                ToolTipService.ToolTip="Open the folder where MarkSmith keeps your settings, version history and templates (Ctrl+O · Right-click for options)"
                                AutomationProperties.Name="Open settings folder (Ctrl+O)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="12" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Text="Settings folder" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Recent Documents Quick Strip -->
            <Border x:Name="RecentDocsStrip" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,8"
                    RightTapped="OnRecentDocsStripRightTapped"
                    DoubleTapped="OnRecentDocsStripDoubleTapped">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Recent Documents" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <AutoSuggestBox x:Name="RecentSearchBox" Grid.Column="1" QueryIcon="Find"
                                    PlaceholderText="Filter recent…" Width="120" Height="28" FontSize="11"
                                    TextChanged="OnRecentSearchBoxTextChanged"
                                    AutomationProperties.Name="Filter recent documents" />
                    <StackPanel x:Name="RecentFilesPanel" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
                    <TextBlock x:Name="NoRecentDocsText" Grid.Column="2" Text="No recent documents yet — start writing in MarkSmith"
                               FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontStyle="Italic"
                               VerticalAlignment="Center" Visibility="Collapsed" />
                    <Border x:Name="RecentDocsCountPill" Grid.Column="2" HorizontalAlignment="Right"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="6,2" VerticalAlignment="Center" Margin="0,0,6,0"
                            Tapped="OnRecentDocsCountPillTapped"
                            DoubleTapped="OnRecentDocsCountPillDoubleTapped"
                            RightTapped="OnRecentDocsCountPillRightTapped"
                            ToolTipService.ToolTip="Recent documents count · Tap to copy summary, double-click to clear filter, right-click for options">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE81C;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="RecentDocsCountText" Text="0 docs" FontSize="11" FontFamily="Cascadia Mono, Consolas, monospace" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="RecentDocsActionBtn" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="0"
                                Click="OnRecentDocsActionBtnClick"
                                ToolTipService.ToolTip="Recent documents options (Open file, Browse folder, Clear history · Right-click for options)"
                                AutomationProperties.Name="Recent documents actions">
                            <FontIcon Glyph="&#xE712;" FontSize="11" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="RecentDocsFlyout">
                                    <MenuFlyoutItem Text="Browse for Markdown file… (Ctrl+O)" Click="OnBrowseFileToOpenClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Open MarkSmith Documents folder" Click="OnOpenDocumentsFolderClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Filter Markdown documents (.md)" Click="OnFilterMarkdownRecentClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Copy all recent document paths" Click="OnCopyAllRecentPathsClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Copy recent file names only" Click="OnCopyRecentFileNamesOnlyClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Copy parent folders only" Click="OnCopyRecentParentFoldersClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyRecentAsMarkdownListItem" Text="Copy as Markdown links (- [name](path))" Click="OnCopyRecentAsMarkdownListClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyRecentLibrarySummaryItem" Text="Copy document library summary" Click="OnCopyRecentLibrarySummaryClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8EC;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyRecentExtensionBreakdownItem" Text="Copy file type breakdown (.md, .txt...)" Click="OnCopyRecentExtensionBreakdownClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyRecentDriveDistributionItem" Text="Copy storage drive breakdown (C:, D:...)" Click="OnCopyRecentDriveDistributionClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8EA;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyRecentAgeDistributionItem" Text="Copy document age breakdown (Today, This week...)" Click="OnCopyRecentAgeDistributionClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE823;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyRecentPathLengthItem" Text="Copy path length &amp; MAX_PATH safety audit" Click="OnCopyRecentPathLengthClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9F9;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyRecentSizeDistributionItem" Text="Copy disk footprint &amp; file size audit" Click="OnCopyRecentSizeDistributionClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8EA;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyRecentDirectorySpreadItem" Text="Copy directory spread &amp; folder dispersion audit" Click="OnCopyRecentDirectorySpreadClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyRecentNamingPatternsItem" Text="Copy file naming patterns &amp; casing audit" Click="OnCopyRecentNamingPatternsClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyRecentMissingAuditItem" Text="Copy missing &amp; moved file paths audit" Click="OnCopyRecentMissingAuditClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7BA;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyRecentSortedCatalogItem" Text="Copy sorted &amp; folder-grouped recent catalog (A–Z)" Click="OnCopyRecentSortedCatalogClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8CB;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyRecentWorkspaceClustersItem" Text="Copy project workspace clusters" Click="OnCopyRecentWorkspaceClustersClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyRecentDuplicatesAuditItem" Text="Copy duplicate &amp; versioned files audit" Click="OnCopyRecentDuplicatesAuditClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyRecentHealthScorecardItem" Text="Copy library health &amp; portability scorecard" Click="OnCopyRecentHealthScorecardClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyRecentStalenessScorecardItem" Text="Copy library staleness &amp; recency tiers" Click="OnCopyRecentStalenessScorecardClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE823;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyRecentVolumeDistributionItem" Text="Copy storage volume &amp; drive partition distribution" Click="OnCopyRecentVolumeDistributionClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyRecentAccessHeatmapItem" Text="Copy access frequency heatmap &amp; revisit cadence" Click="OnCopyRecentAccessHeatmapClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE809;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyRecentDormancyAlertsItem" Text="Copy library dormancy risk &amp; revival alerts" Click="OnCopyRecentDormancyAlertsClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7BA;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyRecentClusterDormancyItem" Text="Copy workspace cluster dormancy &amp; stagnation audit" Click="OnCopyRecentClusterDormancyClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyRecentClusterVelocityItem" Text="Copy workspace cluster activity velocity index" Click="OnCopyRecentClusterVelocityClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="FilterByActiveClusterItem" Text="Filter recent documents by top active cluster" Click="OnFilterByActiveClusterClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71C;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyFormatClusterMatrixItem" Text="Copy file format cluster matrix &amp; diversity index" Click="OnCopyFormatClusterMatrixClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE809;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyCompanionFormatCoverageItem" Text="Copy companion export format coverage &amp; uncompiled audit" Click="OnCopyCompanionFormatCoverageClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyDocumentStalenessItem" Text="Copy document aging, staleness &amp; velocity audit" Click="OnCopyDocumentStalenessClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE823;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyWorkspaceStorageFootprintItem" Text="Copy workspace storage footprint &amp; size audit" Click="OnCopyWorkspaceStorageFootprintClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C8;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyDocumentNamingConventionsItem" Text="Copy document naming convention &amp; casing audit" Click="OnCopyDocumentNamingConventionsClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyPathLengthAuditItem" Text="Copy path length &amp; MAX_PATH (260 char) safety audit" Click="OnCopyPathLengthAuditClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyExtensionDiversityItem" Text="Copy file extension diversity &amp; format distribution audit" Click="OnCopyExtensionDiversityClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C3;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyDeadLinksAuditItem" Text="Copy dead link &amp; orphan asset cross-reference audit" Click="OnCopyDeadLinksAuditClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8BD;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyAssetCompressionAdvisorItem" Text="Copy workspace asset compression &amp; format modernization advisor" Click="OnCopyAssetCompressionAdvisorClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyAssetDpiSvgAdvisorItem" Text="Copy High-DPI display &amp; SVG vector optimization advisor" Click="OnCopyAssetDpiSvgAdvisorClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyWorkspaceTypographyAdvisorItem" Text="Copy workspace typography &amp; font fallback advisor" Click="OnCopyWorkspaceTypographyAdvisorClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyWorkspaceFileSizeDistributionAdvisorItem" Text="Copy workspace file size distribution &amp; storage bloat advisor" Click="OnCopyWorkspaceFileSizeDistributionAdvisorClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyWorkspaceAssetDeduplicationAdvisorItem" Text="Copy workspace asset redundancy &amp; hash deduplication advisor" Click="OnCopyWorkspaceAssetDeduplicationAdvisorClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyWorkspaceHeadingAdvisorItem" Text="Copy workspace markdown header depth uniformity &amp; slug advisor" Click="OnCopyWorkspaceHeadingAdvisorClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyWorkspaceCodeFenceAdvisorItem" Text="Copy workspace code fence language &amp; highlighter coverage advisor" Click="OnCopyWorkspaceCodeFenceAdvisorClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyWorkspaceMediaLinksAdvisorItem" Text="Copy workspace media link integrity &amp; missing asset advisor" Click="OnCopyWorkspaceMediaLinksAdvisorClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyWorkspaceCrossDocAnchorsAdvisorItem" Text="Copy workspace cross-document anchor link &amp; heading slug advisor" Click="OnCopyWorkspaceCrossDocAnchorsAdvisorClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyWorkspaceTableFormattingAdvisorItem" Text="Copy workspace table formatting &amp; column integrity advisor" Click="OnCopyWorkspaceTableFormattingAdvisorClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF158;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyWorkspaceFileSizeAdvisorItem" Text="Copy workspace file size distribution &amp; storage bloat advisor" Click="OnCopyWorkspaceFileSizeAdvisorClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B9;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyWorkspaceDocumentGraphAdvisorItem" Text="Copy workspace document linking graph, hubs &amp; orphan advisor" Click="OnCopyWorkspaceDocumentGraphAdvisorClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyWorkspaceMediaAssetAdvisorItem" Text="Copy workspace media asset integrity &amp; broken image advisor" Click="OnCopyWorkspaceMediaAssetAdvisorClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyWorkspaceMediaAccessibilityAdvisorItem" Text="Copy workspace media alt-text accessibility &amp; WCAG caption advisor" Click="OnCopyWorkspaceMediaAccessibilityAdvisorClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyWorkspaceCodeFenceLanguageAdvisorItem" Text="Copy workspace code fence language tag completeness &amp; syntax highlighting advisor" Click="OnCopyWorkspaceCodeFenceLanguageAdvisorClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE943;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

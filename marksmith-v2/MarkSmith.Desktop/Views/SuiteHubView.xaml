<UserControl
    x:Class="MarkSmith.Views.SuiteHubView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620" MinWidth="680">
        <StackPanel Spacing="16" Margin="4,8,16,12">

            <!-- Suite Platform Header -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="18,14">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="ms-appx:///Assets/logo.png" Width="44" Height="44"
                           VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Suite Hub" FontSize="16" FontWeight="SemiBold" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionText" Text="v3.0.0 · x64" FontSize="10.5" Opacity="0.8" />
                            </Border>
                            <Border x:Name="LicenseBadge" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock x:Name="LicenseText" Text="Pro Entitled" FontSize="10.5" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <!-- Wraps rather than clipping: this sits between a fixed-width icon and the
                             Config Folder button, so the space it gets depends on the dialog width. -->
                        <TextBlock Text="Unified ecosystem for authoring, compiling, AI tool-calling, and document visualization."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="2" Click="OnOpenConfigFolderClick" VerticalAlignment="Center" Padding="10,6"
                            ToolTipService.ToolTip="Open the shared configuration directory">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                            <TextBlock Text="Config Folder" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 2-Column Grid of Suite Components -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- CARD 1: Core Desktop Engine -->
                <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <!-- Rows: header / description / actions. The actions row is pinned to the bottom so
                         buttons line up across a row of cards whose descriptions wrap differently. -->
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7F4;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Desktop Engine" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1">
                                <TextBlock Text="Active" FontSize="10" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Native WinUI 3 editor, Looking Glass live preview, SAX streaming OpenXML O(1) compiler, OMML math, and CriticMarkup."
                                   FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                            <Button Click="OnOpenMermaidStudioClick" Padding="8,4" FontSize="11" ToolTipService.ToolTip="Open Diagram Studio (Ctrl+Shift+M)">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE943;" FontSize="11" />
                                    <TextBlock Text="Diagram Studio" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnOpenShapeStudioClick" Padding="8,4" FontSize="11" ToolTipService.ToolTip="Open Shape Studio">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE790;" FontSize="11" />
                                    <TextBlock Text="Shape Studio" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 2: AI & MCP Server -->
                <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE945;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="AI &amp; MCP Server" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1">
                                <TextBlock Text="Any MCP client" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="marksmith-mcp stdio server exposing 10 document tools, 3-block cycle governance, and lossless OpenXML patching."
                                   FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                            <Button Padding="8,4" FontSize="11" ToolTipService.ToolTip="Copy a ready-made MCP server entry for your client">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                    <TextBlock Text="Copy MCP Config" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="9" Margin="2,1,0,0" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Claude Desktop (claude_desktop_config.json)" Click="OnCopyClaudeConfigClick" />
                                        <MenuFlyoutItem Text="Gemini / Antigravity / Cursor (.mcp.json)" Click="OnCopyGeminiConfigClick" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Click="OnCopyMcpPathClick" Padding="8,4" FontSize="11">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE756;" FontSize="11" />
                                    <TextBlock Text="Copy Server Path" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 3: Browser Companion Extension -->
                <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE774;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Browser Companion" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <Border x:Name="ApiBadge" HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1">
                                <TextBlock x:Name="ApiStatusText" Text="API off" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Chrome &amp; Edge extension for 1-click capture from ChatGPT, Claude, Gemini, and Copilot straight into MarkSmith."
                                   FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                            <Button Click="OnCopyApiUrlClick" Padding="8,4" FontSize="11" ToolTipService.ToolTip="Copy the local REST API address">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE71B;" FontSize="11" />
                                    <TextBlock Text="Copy API URL" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnOpenExtensionDocsClick" Padding="8,4" FontSize="11" ToolTipService.ToolTip="How to install and connect the browser extension">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE897;" FontSize="11" />
                                    <TextBlock Text="Extension Guide" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 4: Command Line Interface -->
                <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE756;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="CLI Toolchain" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1">
                                <TextBlock x:Name="CliStatusText" Text="CLI" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Single-binary headless compiler, batch file watcher, high-res image snapshot rasterizer (render-image), and vector tracer."
                                   FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                            <Button Click="OnCopyCliCommandClick" Padding="8,4" FontSize="11" ToolTipService.ToolTip="Copy an example CLI command">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE756;" FontSize="11" />
                                    <TextBlock Text="Copy CLI Syntax" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CopyCliPathButton" Click="OnCopyCliPathClick" Padding="8,4" FontSize="11" ToolTipService.ToolTip="Copy the full path of marksmith.exe">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                    <TextBlock Text="Copy Path" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 5: Express Web Companion -->
                <Border Grid.Row="2" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE968;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Express Web Companion" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1">
                                <TextBlock Text="Port 5000" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Zero-dependency loopback web interface and conversion service for local network and lightweight browser workflows."
                                   FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                            <Button Click="OnLaunchExpressClick" Padding="8,4" FontSize="11" ToolTipService.ToolTip="Start MarkSmith Express if needed and open it in your browser">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE774;" FontSize="11" />
                                    <TextBlock Text="Open in Browser" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 6: Document Galaxy -->
                <Border Grid.Row="2" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEC26;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Document Galaxy" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1">
                                <TextBlock Text="Visual graph" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Interconnected document vault library with radial, tree, and force layouts, relationship inference, and time machine history."
                                   FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                            <Button Click="OnOpenGalaxyClick" Padding="8,4" FontSize="11" ToolTipService.ToolTip="Open the Document Galaxy window">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xEC26;" FontSize="11" />
                                    <TextBlock Text="Launch Galaxy" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Status Banner Toast / Feedback -->
            <StackPanel x:Name="NotificationRow" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                        Margin="0,2,0,0" Opacity="0" MinHeight="20">
                <FontIcon x:Name="NotificationIcon" Glyph="&#xE73E;" FontSize="13"
                          Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="NotificationText" Text="" FontSize="12" TextWrapping="Wrap" MaxWidth="600"
                           VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>

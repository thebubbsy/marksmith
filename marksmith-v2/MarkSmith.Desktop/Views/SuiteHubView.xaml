<UserControl
    x:Class="MarkSmith.Views.SuiteHubView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620" MinWidth="680">
        <StackPanel Spacing="16" Margin="4,8,16,12">

            <!-- Suite Platform Header -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="18,14">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="ms-appx:///Assets/logo.png" Width="44" Height="44"
                           VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- The dialog title already says Suite Hub; this card is about the app itself. -->
                            <TextBlock Text="MarkSmith" FontSize="16" FontWeight="SemiBold" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionText" Text="Version 3.0.0" FontSize="10.5" Opacity="0.8" />
                            </Border>
                            <Border x:Name="LicenseBadge" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock x:Name="LicenseText" Text="Free plan" FontSize="10.5" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <!-- Wraps rather than clipping: this sits between a fixed-width icon and the
                             Config Folder button, so the space it gets depends on the dialog width. -->
                        <TextBlock Text="Everything that works with MarkSmith: the drawing studios, your AI assistant, the browser extension, the command line and the web companion."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="2" Click="OnOpenConfigFolderClick" VerticalAlignment="Center" Padding="10,6"
                            ToolTipService.ToolTip="Open the folder where MarkSmith keeps your settings, version history and templates">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                            <TextBlock Text="Settings folder" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 2-Column Grid of Suite Components -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- CARD 1: Core Desktop Engine -->
                <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <!-- Rows: header / description / actions. The actions row is pinned to the bottom so
                         buttons line up across a row of cards whose descriptions wrap differently. -->
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEB3C;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Drawing studios" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1">
                                <TextBlock Text="Built in" FontSize="10" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Draw flowcharts, sequence and state diagrams, or Word-ready shapes, then drop them straight into your document."
                                   FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                            <Button Click="OnOpenMermaidStudioClick" Padding="8,4" FontSize="11" ToolTipService.ToolTip="Open Diagram Studio (Ctrl+Shift+M)">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xEF90;" FontSize="11" />
                                    <TextBlock Text="Diagram Studio" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnOpenShapeStudioClick" Padding="8,4" FontSize="11" ToolTipService.ToolTip="Open Shape Studio">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE790;" FontSize="11" />
                                    <TextBlock Text="Shape Studio" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 2: AI & MCP Server -->
                <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE99A;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="AI assistants" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1">
                                <TextBlock Text="MCP" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Let Claude, Cursor, Gemini or any MCP app read, write and export your documents. Copy the setup for your app and paste it into its settings."
                                   FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                            <Button Padding="8,4" FontSize="11" ToolTipService.ToolTip="Copy a ready-made MarkSmith entry for your AI app's settings">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                    <TextBlock Text="Copy setup" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="9" Margin="2,1,0,0" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="For Claude Desktop" Click="OnCopyClaudeConfigClick"
                                                        ToolTipService.ToolTip="Paste into claude_desktop_config.json">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE99A;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="For Cursor, Gemini and other apps" Click="OnCopyGeminiConfigClick"
                                                        ToolTipService.ToolTip="Paste into the app's .mcp.json">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE943;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Click="OnCopyMcpPathClick" Padding="8,4" FontSize="11"
                                    ToolTipService.ToolTip="Copy the full path of the MarkSmith MCP server, for apps that ask for a command">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE756;" FontSize="11" />
                                    <TextBlock Text="Copy server path" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 3: Browser Companion Extension -->
                <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE774;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Browser extension" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <Border x:Name="ApiBadge" HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1">
                                <TextBlock x:Name="ApiStatusText" Text="Not connected" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Send any ChatGPT, Claude, Gemini or Copilot answer to MarkSmith in one click, from Chrome or Edge."
                                   FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                            <!-- Shown while the connection is off: "API off" used to be a dead end that
                                 didn't say where to go. One click turns it on (same setting as
                                 Settings > Automation > Local API). -->
                            <Button x:Name="TurnOnApiButton" Click="OnTurnOnApiClick" Padding="8,4" FontSize="11"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="Let the browser extension reach MarkSmith on this PC (Settings › Automation › Local API)">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE7E8;" FontSize="11" />
                                    <TextBlock Text="Turn on" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CopyApiUrlButton" Click="OnCopyApiUrlClick" Padding="8,4" FontSize="11"
                                    ToolTipService.ToolTip="Copy the address the extension connects to, if it asks for one">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE71B;" FontSize="11" />
                                    <TextBlock Text="Copy address" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnOpenExtensionDocsClick" Padding="8,4" FontSize="11" ToolTipService.ToolTip="Set up the extension in Edge or Chrome: about a minute, once">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xEA86;" FontSize="11" />
                                    <TextBlock Text="Get the extension" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 4: Command Line Interface -->
                <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE756;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Command line" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1">
                                <TextBlock x:Name="CliStatusText" Text="CLI" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Convert a file or a whole folder from PowerShell or a script, with the same styles and output as the app."
                                   FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                            <Button Padding="8,4" FontSize="11" ToolTipService.ToolTip="Copy a ready-to-edit command">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE756;" FontSize="11" />
                                    <TextBlock Text="Copy a command" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="9" Margin="2,1,0,0" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Convert a file to Word" Tag="file" Click="OnCopyCliCommandClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Convert every file in a folder" Tag="batch" Click="OnCopyCliCommandClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Check the installation" Tag="doctor" Click="OnCopyCliCommandClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D5;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="CopyCliPathButton" Click="OnCopyCliPathClick" Padding="8,4" FontSize="11" ToolTipService.ToolTip="Copy the full path of marksmith.exe">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                    <TextBlock Text="Copy path" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 5: Express Web Companion -->
                <Border Grid.Row="2" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEB41;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Web companion" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1">
                                <TextBlock Text="localhost:5000" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Use MarkSmith from a browser tab on this PC: paste Markdown, pick a style and download the document."
                                   FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                            <Button Click="OnLaunchExpressClick" Padding="8,4" FontSize="11" ToolTipService.ToolTip="Start MarkSmith Express if needed and open it in your browser">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE774;" FontSize="11" />
                                    <TextBlock Text="Open in browser" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 6: Document Galaxy -->
                <Border Grid.Row="2" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEC26;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Document Galaxy" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1">
                                <TextBlock Text="Library map" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="See your documents as a map: which ones link to each other, how they are grouped and what changed over time."
                                   FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                            <Button Click="OnOpenGalaxyClick" Padding="8,4" FontSize="11" ToolTipService.ToolTip="Open the Document Galaxy window">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xEC26;" FontSize="11" />
                                    <TextBlock Text="Open Galaxy" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- The result of the last action (copied, connected, couldn't open). An InfoBar rather
                 than the old hand-faded text row: after its first message that row never drew
                 again inside the dialog, so every "Copied…" was invisible. -->
            <InfoBar x:Name="Notification" IsOpen="False" IsClosable="True" Margin="0,0,0,0"
                     AutomationProperties.LiveSetting="Polite" />

        </StackPanel>
    </ScrollViewer>
</UserControl>

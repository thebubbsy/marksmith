                        <StackPanel x:Name="StarterTemplatesPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button x:Name="TemplateMeetingNotesBtn" Style="{StaticResource DefaultButtonStyle}" Padding="10,4"
                                    Click="OnTemplateMeetingNotesClick" ToolTipService.ToolTip="Create a structured meeting minutes document with agenda and action items"
                                    Tag="meeting notes agenda minutes action items">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE77B;" FontSize="11" />
                                    <TextBlock Text="Meeting Notes" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TemplateTechSpecBtn" Style="{StaticResource DefaultButtonStyle}" Padding="10,4"

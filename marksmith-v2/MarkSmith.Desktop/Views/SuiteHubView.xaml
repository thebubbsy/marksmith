                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xF003;" FontSize="11" />
                                    <TextBlock Text="SmartArt Showcase" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TemplateMindMapBtn" Style="{StaticResource DefaultButtonStyle}" Padding="10,4"
                                    Click="OnTemplateMindMapClick" ToolTipService.ToolTip="Create a knowledge base document with mindmap mermaid outline"
                                    Tag="mindmap note knowledge base mermaid outline brain diagram visual">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEC26;" FontSize="11" />
                                    <TextBlock Text="MindMap Note" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TemplateAdrBtn" Style="{StaticResource DefaultButtonStyle}" Padding="10,4"

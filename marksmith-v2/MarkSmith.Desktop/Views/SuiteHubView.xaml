                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="CopyMcpPathButton" Click="OnCopyMcpPathClick" Padding="8,4" FontSize="11"
                                    RightTapped="OnCard2ButtonRightTapped"
                                    ToolTipService.ToolTip="Copy the full path of the MarkSmith MCP server, for apps that ask for a command"
                                    AutomationProperties.Name="Copy MCP server path">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE756;" FontSize="11" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="Copy server path" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 3: Browser Companion Extension -->
                <Border x:Name="Card3Border" Grid.Row="1" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE774;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Text="Browser extension" FontWeight="SemiBold" FontSize="13" AutomationProperties.HeadingLevel="Level2" />
                            </StackPanel>
                            <Border x:Name="ApiBadge" HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1">
                                <TextBlock x:Name="ApiStatusText" Text="Not connected" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"
                                           AutomationProperties.Name="Status: Not connected" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Send any ChatGPT, Claude, Gemini or Copilot answer to MarkSmith in one click, from Chrome or Edge."
                                   FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                            <!-- Shown while the connection is off: "API off" used to be a dead end that
                                 didn't say where to go. One click turns it on (same setting as
                                 Settings > Automation > Local API). -->
                            <Button x:Name="TurnOnApiButton" Click="OnTurnOnApiClick" Padding="8,4" FontSize="11"
                                    RightTapped="OnCard3ButtonRightTapped"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="Let the browser extension reach MarkSmith on this PC (Settings › Automation › Local API, Ctrl+3)"
                                    AutomationProperties.Name="Turn on local API connection (Ctrl+3)">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE7E8;" FontSize="11" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="Turn on" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CopyApiUrlButton" Click="OnCopyApiUrlClick" Padding="8,4" FontSize="11"
                                    RightTapped="OnCard3ButtonRightTapped"
                                    ToolTipService.ToolTip="Copy the address the extension connects to, if it asks for one (Ctrl+3)"
                                    AutomationProperties.Name="Copy local API address (Ctrl+3)">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE71B;" FontSize="11" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="Copy address" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="GetExtensionButton" Click="OnOpenExtensionDocsClick" Padding="8,4" FontSize="11"
                                    RightTapped="OnCard3ButtonRightTapped"
                                    ToolTipService.ToolTip="Set up the extension in Edge or Chrome: about a minute, once"
                                    AutomationProperties.Name="Get the extension">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xEA86;" FontSize="11" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="Get the extension" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 4: Command Line Interface -->
                <Border x:Name="Card4Border" Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE756;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Text="Command line" FontWeight="SemiBold" FontSize="13" AutomationProperties.HeadingLevel="Level2" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1">
                                <TextBlock x:Name="CliStatusText" Text="CLI" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"
                                           AutomationProperties.Name="Status: CLI" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Convert a file or a whole folder from PowerShell or a script, with the same styles and output as the app."
                                   FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="Card4CopyCommandButton" Padding="8,4" FontSize="11"
                                    RightTapped="OnCard4ButtonRightTapped"
                                    ToolTipService.ToolTip="Copy a ready-to-edit command (Ctrl+4)"
                                    AutomationProperties.Name="Copy a CLI command (Ctrl+4)">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE756;" FontSize="11" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="Copy a command" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="9" Margin="2,1,0,0" AutomationProperties.AccessibilityView="Raw" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Convert a file to Word" Tag="file" Click="OnCopyCliCommandClick"
                                                        ToolTipService.ToolTip="Copy command to convert a single Markdown file to Word (.docx)">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Convert every file in a folder" Tag="batch" Click="OnCopyCliCommandClick"
                                                        ToolTipService.ToolTip="Copy command to batch convert all Markdown files in a folder">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Check the installation" Tag="doctor" Click="OnCopyCliCommandClick"
                                                        ToolTipService.ToolTip="Copy command to inspect marksmith dependencies, fonts, and engines">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D5;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="CopyCliPathButton" Click="OnCopyCliPathClick" Padding="8,4" FontSize="11"
                                    RightTapped="OnCard4ButtonRightTapped"
                                    ToolTipService.ToolTip="Copy the full path of marksmith.exe (Ctrl+Shift+C)"
                                    AutomationProperties.Name="Copy MarkSmith CLI path (Ctrl+Shift+C)">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="Copy path" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 5: Express Web Companion -->
                <Border x:Name="Card5Border" Grid.Row="2" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEB41;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Text="Web companion" FontWeight="SemiBold" FontSize="13" AutomationProperties.HeadingLevel="Level2" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1">
                                <TextBlock Text="localhost:5000" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           AutomationProperties.Name="Address: localhost:5000" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Use MarkSmith from a browser tab on this PC: paste Markdown, pick a style and download the document."
                                   FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="Card5ExpressButton" Click="OnLaunchExpressClick" Padding="8,4" FontSize="11"
                                    RightTapped="OnCard5ButtonRightTapped"
                                    ToolTipService.ToolTip="Start MarkSmith Express if needed and open it in your browser (Ctrl+5)"
                                    AutomationProperties.Name="Open Express web companion in browser (Ctrl+5)">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE774;" FontSize="11" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="Open in browser" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CopyExpressUrlButton" Click="OnCopyExpressUrlClick" Padding="8,4" FontSize="11"
                                    RightTapped="OnCard5ButtonRightTapped"
                                    ToolTipService.ToolTip="Copy the web companion address (http://localhost:5000)"
                                    AutomationProperties.Name="Copy Express web companion address">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE71B;" FontSize="11" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="Copy address" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 6: Document Galaxy -->
                <Border x:Name="Card6Border" Grid.Row="2" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEC26;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Text="Document Galaxy" FontWeight="SemiBold" FontSize="13" AutomationProperties.HeadingLevel="Level2" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1">
                                <TextBlock Text="Library map" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           AutomationProperties.Name="Category: Library map" />
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="See your documents as a map: which ones link to each other, how they are grouped and what changed over time."
                                   FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="Card6GalaxyButton" Click="OnOpenGalaxyClick" Padding="8,4" FontSize="11"
                                    RightTapped="OnCard6ButtonRightTapped"
                                    ToolTipService.ToolTip="Open the Document Galaxy window (Ctrl+6)"
                                    AutomationProperties.Name="Open Document Galaxy (Ctrl+6)">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xEC26;" FontSize="11" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="Open Galaxy" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- The result of the last action (copied, connected, couldn't open). An InfoBar rather
                 than the old hand-faded text row: after its first message that row never drew
                 again inside the dialog, so every "Copied…" was invisible. -->
            <InfoBar x:Name="Notification" IsOpen="False" IsClosable="True" Margin="0,0,0,0"
                     AutomationProperties.LiveSetting="Polite" />

            <!-- Suite Hub Status & Environment Diagnostics Strip -->
            <Border x:Name="HubFooterStrip" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Margin="0,4,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="MarkSmith Desktop Environment" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                        <TextBlock Text="· All engines healthy" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Uptime & Temporary Cache Footprint Pill -->
                    <Border x:Name="UptimeStoragePill" Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="5" Padding="6,2" VerticalAlignment="Center"
                            Tapped="OnUptimeStoragePillTapped" RightTapped="OnUptimeStoragePillRightTapped"
                            ToolTipService.ToolTip="Desktop engine uptime &amp; cache · Tap to prune MarkSmith temp cache, right-click to copy diagnostics">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE823;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="UptimeStorageText" Text="Uptime: 0m · Cache: OK" FontSize="10.5" FontFamily="Cascadia Mono, Consolas, monospace" />
                        </StackPanel>
                    </Border>
                    <!-- Memory Usage Pill -->
                    <Border x:Name="MemoryUsagePill" Grid.Column="3" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="5" Padding="6,2" VerticalAlignment="Center"
                            Tapped="OnMemoryUsagePillTapped" RightTapped="OnMemoryUsagePillRightTapped"
                            ToolTipService.ToolTip="Managed process memory · Tap to optimize &amp; garbage collect, right-click to copy metrics">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE950;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="MemoryUsageText" Text="Memory: ~45 MB" FontSize="10.5" FontFamily="Cascadia Mono, Consolas, monospace" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

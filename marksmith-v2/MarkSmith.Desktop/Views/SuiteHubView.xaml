                                    <FontIcon Glyph="&#xE943;" FontSize="11" />
                                    <TextBlock Text="Technical Spec" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TemplateSmartArtBtn" Style="{StaticResource DefaultButtonStyle}" Padding="10,4"
                                    Click="OnTemplateSmartArtClick" ToolTipService.ToolTip="Create a SmartArt showcase document with ready-to-edit layout blocks"

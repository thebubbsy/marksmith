<UserControl
    x:Class="MarkSmith.Views.WelcomeTour"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
        <!-- One feature line: accent glyph + title + caption -->
        <Style x:Key="TourGlyph" TargetType="FontIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Width" Value="26" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="TourHero" TargetType="FontIcon">
            <Setter Property="FontSize" Value="40" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <!-- Plain setters, not BasedOn a system text style — see the FlipView note below for why
             this file trusts nothing that can't be proven to parse detached. -->
        <Style x:Key="TourTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style x:Key="TourLead" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <!-- The body text of a feature row. It sits in the * column of a 2-column Grid (see
             FeatureRow below), which is the ONLY layout that actually wraps it: a horizontal
             StackPanel hands its children unbounded width, so TextWrapping never fires and long
             lines clip off the card. This was a real bug — every feature line ran off the edge. -->
        <!-- Welcome-slide pipeline cards: a real Button (keyboard, focus visual, hover/press
             states and the app-wide HoverPolish lift for free) dressed as a card. -->
        <Style x:Key="TourStepCard" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="12,12,12,12" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="TourStepCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="TourFeatureText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Right padding keeps the content (and the right-aligned Next button) clear of the hosting
         ContentDialog's overlay scrollbar, which draws at the dialog's right edge when a short
         window forces the content to scroll. Without it the scrollbar thumb sits on top of the
         Next button and reads as a stray white sliver. -->
    <Grid Width="540" RowSpacing="14" Padding="0,0,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- NOT a FlipView: Application.LoadComponent on a detached UserControl containing a
             FlipView throws XamlParseException in WASDK 1.6 (bisected live — a FlipView-only
             skeleton fails, the identical skeleton without it parses). Pages are stacked panels
             visibility-switched from code-behind; Back/Next/pips still navigate. -->
        <Grid x:Name="PagesHost" Grid.Row="0">

            <!-- 1 · Welcome -->
            <StackPanel x:Name="Page0" Padding="8,4,8,4">
                <Image Source="ms-appx:///Assets/logo.png" Width="44" Height="44" HorizontalAlignment="Left"
                       AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="Welcome to MarkSmith" Style="{StaticResource TourTitle}" />
                <TextBlock Style="{StaticResource TourLead}"
                           Text="Turn messy AI-chat replies — ChatGPT, Gemini, Claude, Copilot — into polished, professional documents. Here's a 60-second tour of everything it can do." />
                <!-- The pipeline the rest of the tour walks through, as three cards. Each one
                     jumps straight to its page, so the welcome slide is a map, not a wall of
                     empty space under one line of text. -->
                <Grid ColumnSpacing="6" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Tag="1" Click="OnStepCard" Style="{StaticResource TourStepCard}"
                            AutomationProperties.Name="Source — go to step 1"
                            ToolTipService.ToolTip="Jump to step 1 · Source">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE70F;" Style="{StaticResource TourGlyph}" HorizontalAlignment="Left" />
                            <TextBlock Text="1 · Source" FontWeight="SemiBold" />
                            <TextBlock Text="Paste, drop or pick a file" Style="{StaticResource TourStepCaption}" />
                        </StackPanel>
                    </Button>
                    <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" Opacity="0.45" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Tag="2" Click="OnStepCard" Style="{StaticResource TourStepCard}"
                            AutomationProperties.Name="Style — go to step 2"
                            ToolTipService.ToolTip="Jump to step 2 · Style">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE790;" Style="{StaticResource TourGlyph}" HorizontalAlignment="Left" />
                            <TextBlock Text="2 · Style" FontWeight="SemiBold" />
                            <TextBlock Text="Themes, cleanup, structure" Style="{StaticResource TourStepCaption}" />
                        </StackPanel>
                    </Button>
                    <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="12" Opacity="0.45" VerticalAlignment="Center" />
                    <Button Grid.Column="4" Tag="3" Click="OnStepCard" Style="{StaticResource TourStepCard}"
                            AutomationProperties.Name="Preview and Export — go to step 3"
                            ToolTipService.ToolTip="Jump to step 3 · Preview &amp; Export">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xEDE1;" Style="{StaticResource TourGlyph}" HorizontalAlignment="Left" />
                            <TextBlock Text="3 · Preview &amp; Export" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="PDF, Word, slides, EPUB, email" Style="{StaticResource TourStepCaption}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Margin="0,14,0,0" Style="{StaticResource TourStepCaption}"
                           Text="Everything updates live as you go. Use Next, the dots, or the arrow keys to move around." />
            </StackPanel>

            <!-- 2 · Source -->
            <StackPanel x:Name="Page1" Padding="8,4,8,4" Visibility="Collapsed">
                <FontIcon Glyph="&#xE70F;" Style="{StaticResource TourHero}" />
                <TextBlock Text="1 · Source" Style="{StaticResource TourTitle}" />
                <TextBlock Style="{StaticResource TourLead}" Text="Get your content in — however you have it." />
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE77F;" Style="{StaticResource TourGlyph}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TourFeatureText}" Text="Paste Markdown straight in, or drop / browse a file: Markdown, or a Word, PDF, HTML or Outlook email (.eml, .msg) file, which opens as clean Markdown." />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" Style="{StaticResource TourGlyph}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TourFeatureText}" Text="The file picker finds real .md files across your Downloads, Documents, Desktop and OneDrive — newest first." />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE99A;" Style="{StaticResource TourGlyph}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TourFeatureText}" Text="MarkSmith detects which assistant wrote it and cleans the tell-tale quirks — LaTeX delimiters, citation pips, pseudo-headings." />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE71B;" Style="{StaticResource TourGlyph}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TourFeatureText}" Text="The browser extension adds Copy as Markdown and Email buttons under each AI reply and sends it here in one click. Set it up from the card at the top of the Source panel." />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- 3 · Style -->
            <StackPanel x:Name="Page2" Padding="8,4,8,4" Visibility="Collapsed">
                <FontIcon Glyph="&#xE790;" Style="{StaticResource TourHero}" />
                <TextBlock Text="2 · Style" Style="{StaticResource TourTitle}" />
                <TextBlock Style="{StaticResource TourLead}" Text="Make the output yours, not the model's default." />
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE771;" Style="{StaticResource TourGlyph}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TourFeatureText}" Text="Ten themes — or build your own with the palette editor — plus page width, A4 lock, and a single-continuous-page mode for PDF." />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEA99;" Style="{StaticResource TourGlyph}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TourFeatureText}" Text="Cleanup switches: em-dash handling, strip emoji, and the AI-quirk normalizer — all code-block-safe." />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8D2;" Style="{StaticResource TourGlyph}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TourFeatureText}" Text="Personalize the structure: shift every heading at once, and keep, remove or convert bold / italic. (Style &amp; Export ▸ Formatting &amp; text.)" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- 4 · Diagrams & math -->
            <StackPanel x:Name="Page3" Padding="8,4,8,4" Visibility="Collapsed">
                <FontIcon Glyph="&#xF003;" Style="{StaticResource TourHero}" />
                <TextBlock Text="Diagrams &amp; math" Style="{StaticResource TourTitle}" />
                <TextBlock Style="{StaticResource TourLead}" Text="The features nobody else bothers with." />
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEA86;" Style="{StaticResource TourGlyph}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TourFeatureText}" Text="Six diagram engines from one code fence each: Mermaid ships built in; PlantUML, Graphviz, D2, Typst and Vega-Lite install as one-click plugins (Settings ▸ Plugins) and render offline." />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEB3C;" Style="{StaticResource TourGlyph}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TourFeatureText}" Text="Every diagram engine becomes native, editable Word shapes (ShapeForge™) — not a flat picture. Big ones keep their exact layout via Web Layout." />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8EF;" Style="{StaticResource TourGlyph}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TourFeatureText}" Text="LaTeX / KaTeX math becomes real, clickable Word equations (OMML) — editable, not an image." />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- 5 · Export -->
            <StackPanel x:Name="Page4" Padding="8,4,8,4" Visibility="Collapsed">
                <FontIcon Glyph="&#xEDE1;" Style="{StaticResource TourHero}" />
                <TextBlock Text="3 · Preview &amp; Export" Style="{StaticResource TourTitle}" />
                <TextBlock Style="{StaticResource TourLead}" Text="See the finished page live, then export." />
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEA90;" Style="{StaticResource TourGlyph}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TourFeatureText}" Text="Pixel-perfect PDF, or a real Word document with a self-updating table of contents and tables that survive page breaks." />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE786;" Style="{StaticResource TourGlyph}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TourFeatureText}" Text="Also exports PowerPoint (PPTX) and EPUB, and opens any document as a ready-to-send Outlook email (Ctrl+Shift+O)." />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEB9F;" Style="{StaticResource TourGlyph}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TourFeatureText}" Text="Branding kit: a cover page with your logo and a document-wide font, so a chat lands as a client-ready deliverable." />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- 6 · Automate & Pro -->
            <StackPanel x:Name="Page5" Padding="8,4,8,4" Visibility="Collapsed">
                <FontIcon Glyph="&#xE945;" Style="{StaticResource TourHero}" />
                <TextBlock Text="Automate &amp; Pro" Style="{StaticResource TourTitle}" />
                <TextBlock Style="{StaticResource TourLead}" Text="Hands-free conversion, and what Pro unlocks." />
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" Style="{StaticResource TourGlyph}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TourFeatureText}" Text="Watch a folder or the clipboard and convert automatically, or batch-convert a whole folder. (Source ▸ Automation.)" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE943;" Style="{StaticResource TourGlyph}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TourFeatureText}" Text="Drive it from scripts and other apps through the local REST API on this PC. (Settings ▸ Automation.)" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE734;" Style="{StaticResource TourGlyph}" />
                        <!-- Set from ProGate in code-behind, so the tour can't drift from the plan (it once
                             listed branding as Pro; branding is free). -->
                        <TextBlock x:Name="PlanText" Grid.Column="1" Style="{StaticResource TourFeatureText}" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- 7 · Done. Two clear starts instead of a checkbox under "Get started": either card
                 finishes the tour. The sample opens in Split view so the result is on screen. -->
            <StackPanel x:Name="Page6" Padding="8,4,8,4" Visibility="Collapsed">
                <FontIcon Glyph="&#xE73E;" Style="{StaticResource TourHero}" />
                <TextBlock Text="You're all set" Style="{StaticResource TourTitle}" />
                <TextBlock Style="{StaticResource TourLead}" Text="How would you like to start?" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- The recommended start: accent border in every state. -->
                    <Button x:Name="SampleCard" Click="OnSampleCard" Style="{StaticResource TourStepCard}" BorderThickness="2"
                            AutomationProperties.Name="Open the sample document"
                            ToolTipService.ToolTip="Open the sample beside its live preview">
                        <Button.Resources>
                            <ResourceDictionary>
                                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                            </ResourceDictionary>
                        </Button.Resources>
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE8A5;" Style="{StaticResource TourGlyph}" HorizontalAlignment="Left" />
                            <TextBlock Text="Open the sample" FontWeight="SemiBold" />
                            <TextBlock x:Name="SampleCaption" Style="{StaticResource TourStepCaption}"
                                       Text="A short report with a table, math and live diagrams, shown beside its preview. Restyle it and export." />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" x:Name="BlankCard" Click="OnBlankCard" Style="{StaticResource TourStepCard}"
                            AutomationProperties.Name="Start with my own document"
                            ToolTipService.ToolTip="Close the tour and start in the editor">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE70F;" Style="{StaticResource TourGlyph}" HorizontalAlignment="Left" />
                            <TextBlock Text="Start with my own" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource TourStepCaption}"
                                       Text="Paste a reply from your AI chat, or drop a file on the Source panel." />
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid ColumnSpacing="12" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE897;" Style="{StaticResource TourGlyph}" FontSize="14" Width="20" />
                    <TextBlock Grid.Column="1" Style="{StaticResource TourStepCaption}"
                               Text="Replay this tour any time: the ⋯ menu at the top right of Style &amp; Export ▸ Take a quick tour." />
                </Grid>
            </StackPanel>
        </Grid>

        <PipsPager x:Name="Pips" Grid.Row="1" HorizontalAlignment="Center"
                   NumberOfPages="7" MaxVisiblePips="7" SelectedIndexChanged="OnPipSelected" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SkipButton" Grid.Column="0" Content="Skip" Click="OnSkip" MinWidth="88"
                    ToolTipService.ToolTip="Skip the tour — reopen it anytime from the ⋯ menu" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="BackButton" Content="Back" Click="OnBack" Visibility="Collapsed" MinWidth="88"
                        ToolTipService.ToolTip="Previous step" />
                <Button x:Name="NextButton" Content="Next" Click="OnNext" Style="{StaticResource AccentButtonStyle}" MinWidth="112"
                        ToolTipService.ToolTip="Next step" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>


<Window
    x:Class="MarkSmith.Views.History.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:MarkSmith.Services"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:conv="using:MarkSmith.Converters"
    Title="Version History — MarkSmith">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:DiffKindVisibilityConverter x:Key="DiffIs" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ Header Bar ═══ (also the window's title bar: drag it, double-click to maximise;
             TitleBarInsets keeps the buttons clear of minimise/maximise/close) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="20,12,20,12"
              MinHeight="60">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand & Current File -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Width="36" Height="36" CornerRadius="8">
                        <FontIcon Glyph="&#xE81C;" FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="1">
                        <TextBlock Text="Version History" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="FileNameTextBlock" Text="{Binding FileName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="320"
                                   RightTapped="OnFileNameRightTapped" DoubleTapped="OnFileNameDoubleTapped"
                                   ToolTipService.ToolTip="Current document · Right-click for path options · Double-click to copy path" />
                    </StackPanel>
                </StackPanel>

                <!-- Search Input with Live Match Indicator -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox AutomationProperties.Name="Search versions" x:Name="SearchBox" Grid.Column="0"
                             Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Search labels, kinds, days… (Ctrl+F)" MaxWidth="280" MinWidth="160"
                             HorizontalAlignment="Stretch" IsSpellCheckEnabled="False" KeyDown="OnSearchBoxKeyDown"
                             DoubleTapped="OnSearchBoxDoubleTapped"
                             RightTapped="OnSearchBoxRightTapped"
                             CornerRadius="6" VerticalAlignment="Center"
                             ToolTipService.ToolTip="Filter the timeline by label, kind (Auto-Save, Checkpoint, Export · PDF…), weekday or time · Right-click for options" />
                    <Border x:Name="TimelineSearchMatchPill" Grid.Column="1" Margin="6,0,0,0"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center"
                            Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVis}}"
                            ToolTipService.ToolTip="Search match count · Click to clear filter">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="TimelineSearchMatchText" Text="{Binding SearchMatchText}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Button x:Name="TimelineClearSearchBtn" Width="18" Height="18" Padding="0"
                                    Style="{StaticResource DefaultButtonStyle}" Background="Transparent" BorderThickness="0"
                                    Click="OnTimelineClearSearchClick" ToolTipService.ToolTip="Clear search filter (Esc)">
                                <FontIcon Glyph="&#xE711;" FontSize="9" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Filter Starred & Version Kind -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ToggleButton x:Name="StarredFilterToggle" IsChecked="{Binding IsStarredOnlyFilter, Mode=TwoWay}"
                                   Padding="10,6" CornerRadius="6" VerticalAlignment="Center"
                                   RightTapped="OnStarredFilterToggleRightTapped"
                                   ToolTipService.ToolTip="Show starred versions only (Right-click for options)"
                                   AutomationProperties.Name="Show starred versions only">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE734;" FontSize="13" />
                            <TextBlock Text="Starred" FontSize="12" />
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="KindFilterButton" Padding="10,6" CornerRadius="6" VerticalAlignment="Center"
                            Click="OnKindFilterButtonClick" RightTapped="OnKindFilterButtonRightTapped"
                            ToolTipService.ToolTip="Filter timeline by version kind (Checkpoints, Auto-Saves, Exports)"
                            AutomationProperties.Name="Filter by version kind">
                        <Button.Flyout>
                            <MenuFlyout x:Name="KindFilterFlyout">
                                <MenuFlyoutItem Text="All Versions" Click="OnKindFilterAllClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Checkpoints only" Click="OnKindFilterCheckpointsClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Auto-Saves only" Click="OnKindFilterAutoSavesClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE823;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Exports only" Click="OnKindFilterExportsClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71C;" FontSize="12" />
                            <TextBlock x:Name="KindFilterLabel" Text="All Kinds" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Take Checkpoint. Stays enabled even when the selected document isn't open, so
                     its tooltip can still explain why (disabled controls show no tooltip). -->
                <Button x:Name="TakeCheckpointButton" Grid.Column="3" Click="OnTakeSnapshotClick" Padding="12,6" CornerRadius="6"
                        VerticalAlignment="Center" ToolTipService.ToolTip="{Binding CheckpointTooltip}"
                        DoubleTapped="OnTakeCheckpointButtonDoubleTapped"
                        RightTapped="OnTakeCheckpointButtonRightTapped"
                        AutomationProperties.Name="Take checkpoint">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="13" />
                        <TextBlock Text="Take Checkpoint" FontSize="12" FontWeight="Medium" />
                    </StackPanel>
                </Button>

                <!-- Restore Hero Action -->
                <Button x:Name="RestoreButton" Grid.Column="4" Click="OnRestoreClick" Padding="16,6" CornerRadius="6"
                        Style="{ThemeResource AccentButtonStyle}" IsEnabled="{Binding HasSelection}"
                        FontWeight="SemiBold" VerticalAlignment="Center"
                        DoubleTapped="OnRestoreButtonDoubleTapped"
                        RightTapped="OnRestoreButtonRightTapped"
                        AutomationProperties.Name="Restore to editor"
                        ToolTipService.ToolTip="Put the selected version's text back in the editor (Ctrl+Enter · Double-click to restore, Right-click for options)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7A7;" FontSize="13" />
                        <TextBlock Text="Restore to Editor" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- Confirmations and errors (checkpoint saved, restore done, delete failed…). -->
        <InfoBar x:Name="NoticeBar" Grid.Row="1" Margin="20,12,20,0" IsOpen="False" IsClosable="True"
                 Closed="OnNoticeClosed" />

        <!-- ═══ 3-Pane Body ═══ -->
        <Grid Grid.Row="2" Margin="20,16,20,16" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- ═══ Pane 1: Documents ═══ -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="DocumentsHeaderBorder" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                            IsHitTestVisible="True"
                            DoubleTapped="OnDocumentsHeaderDoubleTapped"
                            RightTapped="OnDocumentsHeaderRightTapped"
                            ToolTipService.ToolTip="Documents header · Double-click to refresh file list, right-click for options">
                        <TextBlock Text="DOCUMENTS" FontSize="11" FontWeight="Bold" CharacterSpacing="60"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Border>

                    <ProgressRing Grid.Row="1" IsActive="{Binding IsLoading}" Width="28" Height="28"
                                  VerticalAlignment="Top" Margin="0,32,0,0"
                                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Grid.Row="1" Spacing="8" Margin="18,28,18,0" VerticalAlignment="Top"
                                Visibility="{Binding ShowNoFiles, Converter={StaticResource BoolToVis}}">
                        <FontIcon Glyph="&#xE81C;" FontSize="28" HorizontalAlignment="Left"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No history yet" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="MarkSmith keeps a version whenever you open, edit or export a document. They will appear here." />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="8" Margin="18,28,18,0" VerticalAlignment="Top"
                                Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}">
                        <FontIcon Glyph="&#xE783;" FontSize="24" HorizontalAlignment="Left"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                        <Button Content="Try again" Command="{Binding LoadCommand}" Padding="12,5" />
                    </StackPanel>

                    <ScrollViewer x:Name="FilesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Files}" Margin="0,3,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- A real Button (not a tappable Border) so rows get the hover tint, keyboard
                                         focus and Enter/Space. Tag opts out of the scale lift: zooming a whole
                                         list row reads as jitter; the tint is the hover cue here. -->
                                    <Button Tag="NoHoverPolish" Click="OnFileClick" ContextRequested="OnFileContextRequested"
                                            Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                            BorderThickness="0" CornerRadius="6" Padding="0" Margin="6,2,6,2"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            ToolTipService.ToolTip="{Binding Detail}"
                                            AutomationProperties.Name="{Binding FileName}">
                                      <Grid>
                                        <!-- Selection: an accent wash and a pill, in theme resources so they
                                             follow a theme switch (a brush resolved in code did not), and
                                             inside the content so hovering a selected row keeps it marked. -->
                                        <Border CornerRadius="6" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.16"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                        <Border Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                        <Grid RowSpacing="3" Margin="12,8,10,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Row="0" Grid.Column="0" Glyph="&#xE8A5;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <!-- The name gets the whole row: with the version count beside it,
                                                 "Quarterly report.md" was cut to "Quarterly report…." in a
                                                 240 px pane. The count sits on the date line instead. -->
                                            <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastModifiedLabel}" VerticalAlignment="Center"
                                                       FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Row="1" Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="10"
                                                    Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VersionCountLabel}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                      </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ═══ Pane 2: Timeline ═══ -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="TimelineHeaderBorder" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                            IsHitTestVisible="True"
                            DoubleTapped="OnTimelineHeaderDoubleTapped"
                            RightTapped="OnTimelineHeaderRightTapped"
                            ToolTipService.ToolTip="Timeline header · Double-click to scroll to latest version, right-click for options">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TIMELINE" FontSize="11" FontWeight="Bold" CharacterSpacing="60"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedHeader}" FontSize="11" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Border x:Name="TimelineJumpPill" Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="5" Padding="2" VerticalAlignment="Center" Margin="4,0,0,0"
                                    ToolTipService.ToolTip="Timeline quick jump (▲ Latest · ▼ First)">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button x:Name="JumpLatestButton" Style="{StaticResource SubtleButtonStyle}" Width="22" Height="22" Padding="0"
                                            Click="OnTimelineJumpLatestClick" ToolTipService.ToolTip="Jump to latest version (Home)"
                                            AutomationProperties.Name="Jump to latest version">
                                        <FontIcon Glyph="&#xE70E;" FontSize="9" />
                                    </Button>
                                    <Button x:Name="JumpOldestButton" Style="{StaticResource SubtleButtonStyle}" Width="22" Height="22" Padding="0"
                                            Click="OnTimelineJumpOldestClick" ToolTipService.ToolTip="Jump to first / oldest version (End)"
                                            AutomationProperties.Name="Jump to oldest version">
                                        <FontIcon Glyph="&#xE70D;" FontSize="9" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border x:Name="TimelineFilterStatusPill" Grid.Column="3"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="5" Padding="4,2" VerticalAlignment="Center" Margin="4,0,0,0"
                                    IsHitTestVisible="True"
                                    Tapped="OnTimelineFilterStatusPillTapped"
                                    DoubleTapped="OnTimelineFilterStatusPillDoubleTapped"
                                    RightTapped="OnTimelineFilterStatusPillRightTapped"
                                    ToolTipService.ToolTip="Timeline filter mode · Click to filter by version type, double-click to clear all filters, right-click for options">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE71C;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TimelineFilterStatusText" Text="All" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Border.ContextFlyout>
                                    <MenuFlyout x:Name="TimelineFilterFlyout">
                                        <MenuFlyoutItem Text="All Versions" Click="OnFilterAllVersionsClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Starred Versions Only" Click="OnFilterStarredOnlyClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE735;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Checkpoints / Snapshots Only" Click="OnFilterCheckpointsClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Exports Only" Click="OnFilterExportsClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Auto-Saves Only" Click="OnFilterAutoSavesClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Clear All Filters" Click="OnFilterClearAllClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                            </Border>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="TimelineScroll"
                                  RightTapped="OnTimelineBackgroundRightTapped">
                        <StackPanel Padding="10,6,10,12" Spacing="8">
                            <TextBlock Text="Pick a document on the left to see its versions."
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{Binding ShowNoFiles, Converter={StaticResource BoolToVis}}"
                                       Margin="8,16" />
                            <TextBlock Text="No versions of this document yet. Edit or export it to start its history."
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{Binding ShowNoVersions, Converter={StaticResource BoolToVis}}"
                                       Margin="8,16" />
                            <StackPanel Spacing="10" Margin="8,16" Visibility="{Binding ShowNoMatches, Converter={StaticResource BoolToVis}}">
                                <TextBlock x:Name="NoMatchesTextBlock" Text="{Binding NoMatchesText}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           AutomationProperties.LiveSetting="Polite" />
                                <Button x:Name="ClearFiltersButton" Content="Clear filters" Command="{Binding ClearFiltersCommand}" Padding="12,5"
                                        RightTapped="OnClearFiltersButtonRightTapped"
                                        ToolTipService.ToolTip="Reset search query and starred filter (Right-click for options)" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Bands}"
                                          Visibility="{Binding ShowTimeline, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="4" Margin="0,4,0,8">
                                            <!-- Time Band Header -->
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="40"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="8,4,0,2" />
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Tag="NoHoverPolish" Click="OnVersionClick" ContextRequested="OnVersionContextRequested"
                                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                                                                Padding="0" Margin="2,2,2,4"
                                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                VerticalContentAlignment="Stretch"
                                                                AutomationProperties.Name="{Binding AutomationName}">
                                                          <Grid>
                                                            <Border CornerRadius="7" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.16"
                                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                                            <Border Width="3" Height="22" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                                            <Grid RowSpacing="4" Margin="12,8,4,8">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <FontIcon Grid.Row="0" Grid.Column="0" Glyph="{Binding SourceGlyph}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding TimestampLabel}" FontSize="13" FontWeight="SemiBold"
                                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                                    <TextBlock Text="{Binding SourceLabel}" FontSize="11"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </StackPanel>

                                                                <!-- Delta Badge -->
                                                                <Border Grid.Row="0" Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                        CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                        ToolTipService.ToolTip="{Binding DeltaTooltip}"
                                                                        IsHitTestVisible="True"
                                                                        DoubleTapped="OnVersionDeltaBadgeDoubleTapped"
                                                                        RightTapped="OnVersionDeltaBadgeRightTapped"
                                                                        Visibility="{Binding HasDelta, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{Binding DeltaBadge}" FontSize="10" FontFamily="Cascadia Mono, Consolas, monospace"
                                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                                </Border>

                                                                <!-- Star Button -->
                                                                <Button Grid.Row="0" Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="6"
                                                                        services:HoverPolish.ApplyOnLoad="True" VerticalAlignment="Center"
                                                                        Click="OnStarClick"
                                                                        RightTapped="OnStarButtonRightTapped"
                                                                        ToolTipService.ToolTip="{Binding StarTooltip}"
                                                                        AutomationProperties.Name="{Binding StarTooltip}">
                                                                    <Grid>
                                                                        <FontIcon Glyph="&#xE734;" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                                  Visibility="{Binding IsStarred, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                                                        <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                                  Visibility="{Binding IsStarred, Converter={StaticResource BoolToVis}}" />
                                                                    </Grid>
                                                                </Button>

                                                                <!-- More actions (also on right-click / Shift+F10 anywhere on the row) -->
                                                                <Button Grid.Row="0" Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="6"
                                                                        services:HoverPolish.ApplyOnLoad="True" VerticalAlignment="Center"
                                                                        Click="OnVersionMoreClick" ToolTipService.ToolTip="More: rename, star, copy, restore, delete"
                                                                        AutomationProperties.Name="More actions for this version">
                                                                    <FontIcon Glyph="&#xE712;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </Button>

                                                                <!-- Custom Label -->
                                                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Snippet}"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"
                                                                           TextTrimming="CharacterEllipsis" MaxLines="1" Margin="0,2,0,0"
                                                                           Visibility="{Binding HasSnippet, Converter={StaticResource BoolToVis}}" />
                                                            </Grid>
                                                          </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ═══ Pane 3: Changes & Preview ═══ -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Inspector Toolbar -->
                    <Border Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Mode Selector -->
                            <!-- One segmented control: three loose bordered buttons read as three
                                  separate actions, not one choice of view. -->
                            <Border Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <StackPanel.Resources>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                                            <Setter Property="Padding" Value="10,3,10,4" />
                                            <Setter Property="CornerRadius" Value="4" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                                        </Style>
                                    </StackPanel.Resources>
                                    <ToggleButton x:Name="UnifiedToggle" Content="Unified" IsChecked="True"
                                                  Click="OnUnifiedToggleClick"
                                                  RightTapped="OnDiffModeToggleRightTapped"
                                                  AutomationProperties.Name="Unified diff view"
                                                  ToolTipService.ToolTip="Changes inline: removed lines, then the lines that replaced them (Ctrl+1)" />
                                    <ToggleButton x:Name="SplitToggle" Content="Side by side"
                                                  Click="OnSplitToggleClick"
                                                  RightTapped="OnDiffModeToggleRightTapped"
                                                  AutomationProperties.Name="Side by side diff view"
                                                  ToolTipService.ToolTip="The version before on the left, this version on the right (Ctrl+2)" />
                                    <ToggleButton x:Name="PreviewToggle" Content="Preview"
                                                  Click="OnPreviewToggleClick"
                                                  RightTapped="OnDiffModeToggleRightTapped"
                                                  AutomationProperties.Name="Rendered document preview"
                                                  ToolTipService.ToolTip="This version rendered as a document (Ctrl+3)" />
                                </StackPanel>
                            </Border>

                            <!-- Diff Summary Info -->
                            <StackPanel x:Name="DiffSummaryPanel" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                        IsHitTestVisible="True"
                                        DoubleTapped="OnDiffSummaryDoubleTapped"
                                        RightTapped="OnDiffSummaryRightTapped"
                                        ToolTipService.ToolTip="Version summary · Double-click to copy title, right-click for options">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="DiffTitleText" Text="{Binding DiffTitle}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <Border x:Name="CommitShaCopyPill" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"
                                            Tapped="OnCommitShaCopyPillTapped"
                                            ToolTipService.ToolTip="Click to copy full commit version SHA (Ctrl+C)">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="CommitShaText" Text="{Binding Selected.Id}" FontSize="10" FontFamily="Cascadia Mono, Consolas, monospace" MaxWidth="90" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding DiffHeader}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Change Stepper Navigation Pill & Context Filter -->
                            <Border x:Name="DiffChangeStepperPill" Grid.Column="2"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="2" VerticalAlignment="Center"
                                    Visibility="{Binding HasDiffStats, Converter={StaticResource BoolToVis}}">
                                <Border.ContextFlyout>
                                    <MenuFlyout x:Name="DiffContextFlyout" Opening="OnDiffContextFlyoutOpening">
                                        <MenuFlyoutItem Text="Changes only (0 context lines)" Click="OnDiffContextChangesOnlyClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Compact (1 context line)" Click="OnDiffContextCompactClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Standard (3 context lines)" Click="OnDiffContextStandardClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Full document (All lines)" Click="OnDiffContextFullClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button x:Name="PrevChangeButton" Click="OnPrevChangeButtonClick" Style="{StaticResource SubtleButtonStyle}"
                                            Width="24" Height="24" Padding="0"
                                            ToolTipService.ToolTip="Previous change hunk (Shift+F7)" AutomationProperties.Name="Previous change">
                                        <FontIcon Glyph="&#xE70E;" FontSize="10" />
                                    </Button>
                                    <TextBlock x:Name="ChangeStepperLabel" Text="Hunks: 0" FontSize="11" VerticalAlignment="Center" Margin="4,0"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               IsHitTestVisible="True"
                                               Tapped="OnChangeStepperLabelTapped"
                                               DoubleTapped="OnChangeStepperLabelDoubleTapped"
                                               RightTapped="OnChangeStepperLabelRightTapped"
                                               ToolTipService.ToolTip="Change hunk index · Click to step to next hunk (F7) · Double-click to jump to first · Right-click for diff context" />
                                    <Button x:Name="NextChangeButton" Click="OnNextChangeButtonClick" Style="{StaticResource SubtleButtonStyle}"
                                            Width="24" Height="24" Padding="0"
                                            ToolTipService.ToolTip="Next change hunk (F7)" AutomationProperties.Name="Next change">
                                        <FontIcon Glyph="&#xE70D;" FontSize="10" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Diff Line Search & Match Stepper Pill -->
                            <Border x:Name="DiffSearchPill" Grid.Column="3"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="4,2" VerticalAlignment="Center"
                                    Visibility="{Binding HasDiffStats, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE721;" FontSize="11" Margin="4,0,2,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox x:Name="DiffSearchBox" Width="105" Height="26" Padding="4,2" FontSize="11"
                                             PlaceholderText="Find in diff..." BorderThickness="0" Background="Transparent"
                                             TextChanged="OnDiffSearchBoxTextChanged" KeyDown="OnDiffSearchBoxKeyDown" />
                                    <TextBlock x:Name="DiffMatchCountLabel" Text="" FontSize="10.5" VerticalAlignment="Center" Margin="2,0"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Button x:Name="DiffPrevMatchButton" Click="OnDiffPrevMatchClick" Style="{StaticResource SubtleButtonStyle}"
                                            Width="22" Height="22" Padding="0" ToolTipService.ToolTip="Previous match (Shift+F3)"
                                            AutomationProperties.Name="Previous search match">
                                        <FontIcon Glyph="&#xE70E;" FontSize="9" />
                                    </Button>
                                    <Button x:Name="DiffNextMatchButton" Click="OnDiffNextMatchClick" Style="{StaticResource SubtleButtonStyle}"
                                            Width="22" Height="22" Padding="0" ToolTipService.ToolTip="Next match (F3 or Enter)"
                                            AutomationProperties.Name="Next search match">
                                        <FontIcon Glyph="&#xE70D;" FontSize="9" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Delta Meter -->
                            <Border x:Name="DeltaMeterBorder" Grid.Column="4" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center"
                                    IsHitTestVisible="True"
                                    DoubleTapped="OnDeltaMeterDoubleTapped"
                                    RightTapped="OnDeltaMeterRightTapped"
                                    ToolTipService.ToolTip="Lines added and removed compared with the version before · Double-click to copy stats, right-click for options"
                                    Visibility="{Binding HasDiffStats, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock x:Name="DiffStatsText" Text="{Binding DiffStats}" FontSize="11" FontFamily="Cascadia Mono, Consolas, monospace"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <!-- Visual Diff Proportion Bar -->
                                    <Grid x:Name="DiffVisualStatBar" Width="36" Height="5" CornerRadius="2.5" Background="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="DiffAddedCol" Width="*" />
                                            <ColumnDefinition x:Name="DiffRemovedCol" Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle x:Name="DiffAddedRect" Grid.Column="0" Fill="{ThemeResource SystemFillColorSuccessBrush}" RadiusX="1.5" RadiusY="1.5" />
                                        <Rectangle x:Name="DiffRemovedRect" Grid.Column="1" Fill="{ThemeResource SystemFillColorCriticalBrush}" RadiusX="1.5" RadiusY="1.5" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Word Delta Meter Pill -->
                            <Border x:Name="DiffWordDeltaPill" Grid.Column="5" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center"
                                    IsHitTestVisible="True"
                                    Tapped="OnDiffWordDeltaPillTapped"
                                    DoubleTapped="OnDiffWordDeltaPillDoubleTapped"
                                    RightTapped="OnDiffWordDeltaPillRightTapped"
                                    ToolTipService.ToolTip="Prose &amp; code word delta (+added / -removed words) · Click to copy word stats, right-click for options"
                                    Visibility="{Binding HasDiffStats, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8C1;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DiffWordDeltaText" Text="+0 / -0 words" FontSize="11" FontFamily="Cascadia Mono, Consolas, monospace"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Copy Action Button -->
                            <Button x:Name="CopyToolbarButton" Grid.Column="6" Click="OnCopyToolbarButtonClick"
                                    DoubleTapped="OnCopyToolbarButtonDoubleTapped"
                                    VerticalAlignment="Center" Padding="8,4" CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    ToolTipService.ToolTip="Copy diff patch (Ctrl+Shift+C · Double-click to copy, Right-click for options)"
                                    AutomationProperties.Name="Copy diff patch (Ctrl+Shift+C)"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                <Button.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Copy diff patch" Click="OnCopyDiffPatchContextClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE943;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Copy version Markdown" Click="OnCopyMarkdownContextClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Copy added lines (+)" Click="OnCopyAddedLinesContextClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Copy removed lines (-)" Click="OnCopyRemovedLinesContextClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE738;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Copy unchanged context lines (=)" Click="OnCopyUnchangedLinesContextClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8BD;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.ContextFlyout>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="CopyToolbarIcon" Glyph="&#xE943;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="CopyToolbarText" Text="Copy diff" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <!-- Diff Line Soft-Wrap Toggle Button -->
                            <Button x:Name="DiffWrapButton" Grid.Column="7" Click="OnDiffWrapButtonClick"
                                    VerticalAlignment="Center" Padding="8,4" CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    ToolTipService.ToolTip="Toggle diff text soft-wrapping (Wrap: Off/On)"
                                    AutomationProperties.Name="Toggle diff text soft-wrap"
                                    Visibility="{Binding HasDiffStats, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8D2;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="DiffWrapLabel" Text="Wrap: Off" FontSize="11.5" />
                                </StackPanel>
                            </Button>

                            <!-- Diff Line Number Jump Button -->
                            <Button x:Name="DiffLineJumpButton" Grid.Column="8" Click="OnDiffLineJumpButtonClick"
                                    VerticalAlignment="Center" Padding="8,4" CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    ToolTipService.ToolTip="Jump to document line in diff (Ctrl+G)"
                                    AutomationProperties.Name="Jump to document line in diff"
                                    Visibility="{Binding HasDiffStats, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Go to Line" FontSize="11.5" />
                                </StackPanel>
                            </Button>

                            <!-- Diff Ignore Whitespace Toggle Button -->
                            <Button x:Name="DiffIgnoreWhitespaceButton" Grid.Column="9" Click="OnDiffIgnoreWhitespaceButtonClick"
                                    VerticalAlignment="Center" Padding="8,4" CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    ToolTipService.ToolTip="Ignore whitespace-only changes in diff (Ignore WS: Off/On)"
                                    AutomationProperties.Name="Toggle ignore whitespace in diff"
                                    Visibility="{Binding HasDiffStats, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="DiffIgnoreWhitespaceLabel" Text="Ignore WS: Off" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Nothing selected yet -->
                    <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"
                                Visibility="{Binding ShowDiffPlaceholder, Converter={StaticResource BoolToVis}}">
                        <FontIcon Glyph="&#xE81C;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Select a version on the timeline to see what changed in it." TextWrapping="Wrap"
                                   TextAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Identical to the version before -->
                    <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340"
                                Visibility="{Binding ShowNoChanges, Converter={StaticResource BoolToVis}}">
                        <FontIcon Glyph="&#xE73E;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Same text as the version before" FontWeight="SemiBold" TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="It was recorded by an export or a reopen with no edits in between. Switch to Preview to see the document." />
                    </StackPanel>

                    <!-- 1. Unified diff. ItemsRepeater virtualises, so the first version of a
                         5,000-line document no longer builds 5,000 rows of controls up front. -->
                    <ScrollViewer x:Name="UnifiedScroll" Grid.Row="1" Padding="0,4,0,8"
                                  RightTapped="OnDiffAreaRightTapped"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                                  Visibility="{Binding ShowUnifiedRows, Converter={StaticResource BoolToVis}}">
                        <ItemsRepeater x:Name="UnifiedDiffRepeater" ItemsSource="{Binding UnifiedDiffRows}"
                                       ElementPrepared="OnUnifiedDiffRepeaterElementPrepared">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent">
                                        <!-- Tints are ThemeResource layers, not a converted brush: rows are recycled with the
                                             same data, so a converter's brush never followed a light/dark switch. -->
                                        <Grid Visibility="{Binding IsLine, Converter={StaticResource BoolToVis}}">
                                            <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                    Visibility="{Binding Kind, Converter={StaticResource DiffIs}, ConverterParameter=Removed}" />
                                            <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                    Visibility="{Binding Kind, Converter={StaticResource DiffIs}, ConverterParameter=Added}" />
                                            <Border Padding="6,1">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding OldNumberLabel}" FontSize="12" FontFamily="Cascadia Mono, Consolas, monospace"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="1" Text="{Binding NewNumberLabel}" FontSize="12" FontFamily="Cascadia Mono, Consolas, monospace"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="2" Text="{Binding Prefix}" FontSize="12" FontFamily="Cascadia Mono, Consolas, monospace"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Bold" />
                                                <TextBlock Grid.Column="3" Text="{Binding Text}" FontSize="12" FontFamily="Cascadia Mono, Consolas, monospace"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="NoWrap" />
                                            </Grid>
                                        </Border>
                                        </Grid>
                                        <Border Visibility="{Binding IsGap, Converter={StaticResource BoolToVis}}" Margin="0,4" Padding="14,3"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{Binding Text}" FontSize="11" FontStyle="Italic"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>

                    <!-- 2. Side-by-side diff. Lines wrap instead of scrolling sideways: two
                         half-width columns that each need a horizontal scrollbar are unreadable. -->
                    <ScrollViewer x:Name="SplitScroll" Grid.Row="1" Padding="0,4,0,8"
                                  RightTapped="OnDiffAreaRightTapped"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding ShowSplitRows, Converter={StaticResource BoolToVis}}">
                        <ItemsRepeater x:Name="SplitDiffRepeater" ItemsSource="{Binding DiffRows}"
                                       ElementPrepared="OnSplitDiffRepeaterElementPrepared">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent">
                                        <Grid Visibility="{Binding IsLine, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                    Visibility="{Binding Left.Kind, Converter={StaticResource DiffIs}, ConverterParameter=Removed}" />
                                            <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                    Visibility="{Binding Left.Kind, Converter={StaticResource DiffIs}, ConverterParameter=Added}" />
                                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="4,1"
                                                    Background="Transparent">
                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="38" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Left.NumberLabel}" FontSize="12" FontFamily="Cascadia Mono, Consolas, monospace"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Left.Text}" FontSize="12" FontFamily="Cascadia Mono, Consolas, monospace"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                            <Border Grid.Column="1" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                    Visibility="{Binding Right.Kind, Converter={StaticResource DiffIs}, ConverterParameter=Removed}" />
                                            <Border Grid.Column="1" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                    Visibility="{Binding Right.Kind, Converter={StaticResource DiffIs}, ConverterParameter=Added}" />
                                            <Border Grid.Column="1" Padding="4,1"
                                                    Background="Transparent">
                                                <Grid ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="38" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Right.NumberLabel}" FontSize="12" FontFamily="Cascadia Mono, Consolas, monospace"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Right.Text}" FontSize="12" FontFamily="Cascadia Mono, Consolas, monospace"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <Border Visibility="{Binding IsGap, Converter={StaticResource BoolToVis}}" Margin="0,4" Padding="14,3"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{Binding GapText}" FontSize="11" FontStyle="Italic"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>

                    <!-- 3. Rendered preview -->
                    <Border Grid.Row="1" Visibility="{Binding ShowPreviewPane, Converter={StaticResource BoolToVis}}">
                        <controls:WebView2 x:Name="PreviewWeb" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

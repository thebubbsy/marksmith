<Window
    x:Class="MarkSmith.Views.MindMap.MindMapGalaxyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:MarkSmith.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:MarkSmith.Converters"
    xmlns:ui="using:MarkSmith.Controls"
    xmlns:vm="using:MarkSmith.ViewModels.MindMap"
    mc:Ignorable="d"
    Title="Document Galaxy — MarkSmith">

    <Grid x:Name="RootGrid" Background="#12131C">
        <Grid.Resources>
            <conv:FillBrushConverter x:Key="FillBrushConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

            <!-- Inspector section titles: sentence case, the same weight as Shape Studio's, instead
                 of the letter-spaced capitals ("DOCUMENT VAULT TOPOLOGY") this panel used to shout. -->
            <Style x:Key="InspectorHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="InspectorCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <!-- One shape for every text-and-icon command in the toolbar row. -->
            <Style x:Key="GalaxyToolButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="MinHeight" Value="32" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP HEADER: row 0 is the window's (extended) title bar — title on the left, search and
             zoom on the right, kept clear of the caption buttons by TitleBarInsets. Row 1 is the
             action toolbar on its own line: squeezed into the middle of row 0 it overflowed under
             the subtitle and behind the search box at ordinary window widths. -->
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="14,0,14,8">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="AppTitleBar" Grid.Row="0" MinHeight="48" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: title, unsaved marker and what the window is for -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEC26;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <StackPanel Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <!-- A button, not a hit-testable TextBlock: the title bar treats plain text as a drag
                                     handle (so its right-click showed the window's system menu), and the keyboard
                                     could not reach the title's copy / save / fit menu at all. -->
                                <Button x:Name="MapTitleButton" MinHeight="0" MinWidth="0" Padding="4,1" Margin="-4,0,0,0"
                                        VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                        Click="OnMapTitleButtonClick"
                                        RightTapped="OnMapTitleButtonRightTapped"
                                        AutomationProperties.Name="{Binding Title}"
                                        AutomationProperties.HelpText="Opens copy, save and layout options for the map."
                                        ToolTipService.ToolTip="Map title · Click, right-click or Shift+F10 for copy, save and layout options">
                                    <TextBlock x:Name="MapTitleText" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                </Button>
                                <Button x:Name="UnsavedBadge" MinHeight="0" MinWidth="0" Padding="6,1" CornerRadius="8" VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"
                                        Click="OnUnsavedBadgeClick"
                                        RightTapped="OnUnsavedBadgeRightTapped"
                                        AutomationProperties.Name="Unsaved changes"
                                        ToolTipService.ToolTip="Changes since the last save · Click, right-click or Shift+F10 for save options (Ctrl+S saves)">
                                    <TextBlock Text="Unsaved" FontSize="10" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Your documents and how they connect" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: search and zoom -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search the map" Width="200"
                                        QueryIcon="Find" AutomationProperties.Name="Search the map"
                                        TextChanged="OnSearchTextChanged" QuerySubmitted="OnSearchQuerySubmitted"
                                        KeyDown="OnSearchBoxKeyDown" Loaded="OnSearchBoxLoaded"
                                        DoubleTapped="OnSearchBoxDoubleTapped"
                                        ToolTipService.ToolTip="Search map (Ctrl+F) · Enter/F3 next, Shift+F3 prev, Esc clears, Double-click selects all, Right-click or Shift+F10 for options" />
                        <Button x:Name="TagFilterButton" Padding="8,4" Height="32"
                                Click="OnTagFilterButtonClick"
                                RightTapped="OnTagFilterButtonRightTapped"
                                AutomationProperties.Name="Filter by tag"
                                ToolTipService.ToolTip="Filter by hashtag (#tag) · Esc clears the filter">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8EC;" FontSize="12" />
                                <TextBlock x:Name="TagFilterLabel" Text="Tags" FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="TagFilterFlyout" Opening="OnTagFilterFlyoutOpening">
                                    <MenuFlyoutItem Text="All Tags (Clear Filter)" Click="OnClearTagFilterClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Border x:Name="SearchStepperPill"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="6,2"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVis}}"
                                ToolTipService.ToolTip="Search navigation (Enter/F3 next, Shift+F3 prev, Esc clears, Right-click or Shift+F10 for options)"
                                RightTapped="OnSearchStepperPillRightTapped">
                            <StackPanel x:Name="GalaxySearchStepperCluster" Orientation="Horizontal" Spacing="4" XYFocusKeyboardNavigation="Enabled" TabFocusNavigation="Once" AutomationProperties.Name="Search match navigation">
                                <!-- A button so Tab reaches the match count and its menu. It used to be a
                                     TextBlock whose only action was a double-click copy. -->
                                <HyperlinkButton x:Name="SearchMatchButton" Padding="4,0" MinHeight="0" VerticalAlignment="Center"
                                                 Click="OnSearchMatchButtonClick"
                                                 AutomationProperties.HelpText="Opens copy, next, previous and clear options for the search."
                                                 ToolTipService.ToolTip="Search match count · Click, right-click or Shift+F10 for options">
                                    <TextBlock x:Name="SearchMatchLabel" Text="{Binding SearchMatchText}" VerticalAlignment="Center" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </HyperlinkButton>
                                <Button x:Name="SearchPrevMatchButton" Width="20" Height="20" Padding="0"
                                        Style="{StaticResource DefaultButtonStyle}"
                                        Background="Transparent" BorderThickness="0"
                                        Click="OnSearchPrevMatchClick"
                                        ToolTipService.ToolTip="Previous match (Shift+F3 · Shift+F10 for search options)">
                                    <FontIcon Glyph="&#xE70E;" FontSize="9" />
                                </Button>
                                <Button x:Name="SearchNextMatchButton" Width="20" Height="20" Padding="0"
                                        Style="{StaticResource DefaultButtonStyle}"
                                        Background="Transparent" BorderThickness="0"
                                        Click="OnSearchNextMatchClick"
                                        ToolTipService.ToolTip="Next match (F3 / Enter · Shift+F10 for search options)">
                                    <FontIcon Glyph="&#xE70D;" FontSize="9" />
                                </Button>
                                <Button x:Name="SearchClearButton" Width="20" Height="20" Padding="0"
                                        Style="{StaticResource DefaultButtonStyle}"
                                        Background="Transparent" BorderThickness="0"
                                        Click="OnSearchClearClick"
                                        ToolTipService.ToolTip="Clear search (Esc · Shift+F10 for search options)">
                                    <FontIcon Glyph="&#xE711;" FontSize="9" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="ZoomControlCluster" Orientation="Horizontal" Spacing="2"
                                    XYFocusKeyboardNavigation="Enabled" TabFocusNavigation="Once" AutomationProperties.Name="Galaxy zoom controls">
                            <Button x:Name="ZoomOutButton" Click="OnZoomOutClick" RightTapped="OnZoomResetRightTapped" ToolTipService.ToolTip="Zoom out (Ctrl+−, Right-click or Shift+F10 for zoom presets)" AutomationProperties.Name="Zoom out" Width="32" Height="32" Padding="0"><FontIcon Glyph="&#xE71F;" FontSize="13" /></Button>
                            <Button x:Name="ZoomResetButton" Click="OnZoomResetClick" RightTapped="OnZoomResetRightTapped" Content="{Binding ZoomLevelText}" MinWidth="52" Height="32" Padding="6,0" FontSize="12"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="Zoom to 100% (Ctrl+1) · Right-click or Shift+F10 for zoom presets" AutomationProperties.Name="Zoom to 100 percent" />
                            <Button x:Name="ZoomInButton" Click="OnZoomInClick" RightTapped="OnZoomResetRightTapped" ToolTipService.ToolTip="Zoom in (Ctrl++, Right-click or Shift+F10 for zoom presets)" AutomationProperties.Name="Zoom in" Width="32" Height="32" Padding="0"><FontIcon Glyph="&#xE8A3;" FontSize="13" /></Button>
                            <Button x:Name="FitToWindowButton" Click="OnFitToWindowClick" RightTapped="OnZoomResetRightTapped" ToolTipService.ToolTip="Fit the whole map in the window (Ctrl+0, Right-click or Shift+F10 for zoom presets)" AutomationProperties.Name="Fit to window" Width="32" Height="32" Padding="0"><FontIcon Glyph="&#xE9A6;" FontSize="13" /></Button>
                            <Button x:Name="CenterOnRootButton" Click="OnCenterOnRootClick" RightTapped="OnCenterOnRootRightTapped" ToolTipService.ToolTip="Center on root document node (Home · Right-click or Shift+F10 to center at 100% and more)" AutomationProperties.Name="Center on root node" Width="32" Height="32" Padding="0"><FontIcon Glyph="&#xE80F;" FontSize="13" /></Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Action tools -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                              VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                    <StackPanel x:Name="GalaxyActionCluster" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center"
                                XYFocusKeyboardNavigation="Enabled" TabFocusNavigation="Once"
                                AutomationProperties.Name="MindMap action tools">
                        <Button x:Name="AddChildToolButton" Command="{Binding AddChildNodeCommand}" Style="{StaticResource GalaxyToolButton}"
                                RightTapped="OnAddChildButtonRightTapped"
                                ToolTipService.ToolTip="Add a node under the selected one (Tab, Right-click or Shift+F10 for options)" AutomationProperties.Name="Add child">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="Add child" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddSiblingToolButton" Command="{Binding AddSiblingNodeCommand}" Style="{StaticResource GalaxyToolButton}"
                                RightTapped="OnAddSiblingButtonRightTapped"
                                ToolTipService.ToolTip="Add a node beside the selected one (Enter, Right-click or Shift+F10 for options)" AutomationProperties.Name="Add sibling">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="Add sibling" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="LinkToolButton" Click="OnConnectSelectedClick" Style="{StaticResource GalaxyToolButton}"
                                RightTapped="OnLinkToolButtonRightTapped"
                                ToolTipService.ToolTip="Link the selected node to another one and say why (Ctrl+L, Right-click or Shift+F10 for options)" AutomationProperties.Name="Link">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE71B;" FontSize="12" />
                                <TextBlock Text="Link" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteToolButton" Command="{Binding DeleteSelectionCommand}" IsEnabled="{Binding HasSelection}" Style="{StaticResource GalaxyToolButton}"
                                RightTapped="OnDeleteToolButtonRightTapped"
                                ToolTipService.ToolTip="Delete the selected node or link (Delete, Right-click or Shift+F10 for options)" AutomationProperties.Name="Delete">
                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                        </Button>

                        <AppBarSeparator />

                        <Button x:Name="UndoToolButton" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Style="{StaticResource GalaxyToolButton}"
                                RightTapped="OnUndoToolButtonRightTapped"
                                ToolTipService.ToolTip="{Binding UndoToolTip}" AutomationProperties.Name="Undo">
                            <FontIcon Glyph="&#xE7A7;" FontSize="12" />
                        </Button>
                        <Button x:Name="RedoToolButton" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Style="{StaticResource GalaxyToolButton}"
                                RightTapped="OnRedoToolButtonRightTapped"
                                ToolTipService.ToolTip="{Binding RedoToolTip}" AutomationProperties.Name="Redo">
                            <FontIcon Glyph="&#xE7A6;" FontSize="12" />
                        </Button>

                        <AppBarSeparator />

                        <DropDownButton x:Name="ArrangeDropDownButton" Padding="10,5" MinHeight="32"
                                        RightTapped="OnArrangeDropDownRightTapped"
                                        ToolTipService.ToolTip="Rearrange every node automatically (Right-click or Shift+F10 for options)"
                                        AutomationProperties.Name="Arrange">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xECA5;" FontSize="12" />
                                <TextBlock x:Name="ArrangeModeLabel" Text="Arrange · Tree" FontSize="12" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyoutItem Text="Tree, left to right" Click="OnLayoutTreeClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81E;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Tree, right to left" Click="OnLayoutTreeRtlClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81F;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Hierarchy, top down" Click="OnLayoutHierarchyClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF003;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Hierarchy, bottom up" Click="OnLayoutHierarchyBottomUpClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74A;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Radial, around the root" Click="OnLayoutRadialClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE707;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Clusters, by tag and link" Click="OnLayoutClustersClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF0E2;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Force-directed web" Click="OnLayoutForceClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEC26;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="AutoColorizeHierarchyItem" Text="Auto-colorize nodes by hierarchy depth" Click="OnAutoColorizeHierarchyClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="AttachOrphansItem" Text="Cluster &amp; attach orphaned nodes to root" Click="OnAttachOrphansClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B3;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="RollupSubtreeProgressItem" Text="Roll up subtree completion progress to parent hubs" Click="OnRollupSubtreeProgressClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D2;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="AutoColorizeByTagItem" Text="Auto-colorize nodes by primary tag" Click="OnAutoColorizeByTagClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8EC;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyTagCoOccurrenceItem" Text="Copy tag co-occurrence matrix" Click="OnCopyTagCoOccurrenceClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CenterOnMassItem" Text="Re-center viewport on galaxy center-of-mass" Click="OnCenterOnMassClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE809;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="CopyQuadrantBalanceItem" Text="Copy spatial quadrant balance summary" Click="OnCopyQuadrantBalanceClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE809;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="NormalizeNodeCasingItem" Text="Normalize node text casing (Title Case)" Click="OnNormalizeNodeCasingClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E4;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutSubItem Text="Diagnostics" ToolTipService.ToolTip="Read-only checks that summarise and copy a report">
                                        <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutSubItem.Icon>
                                        <MenuFlyoutItem x:Name="AuditBiconnectivityItem" Text="Audit biconnected blocks, articulation points &amp; bridges" Click="OnAuditBiconnectivityClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditBipartitePartitionItem" Text="Audit bipartite 2-coloring &amp; odd cycle partition" Click="OnAuditBipartitePartitionClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72A;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditClosenessCentralityItem" Text="Audit closeness centrality, harmonic distance &amp; propagation" Click="OnAuditClosenessCentralityClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditClusterHullsItem" Text="Audit cluster convex hulls &amp; spatial extent" Click="OnAuditClusterHullsClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditGraphArticulationItem" Text="Audit graph articulation cut vertices, bridge bottlenecks &amp; network resilience" Click="OnAuditGraphArticulationClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditGraphAssortativityItem" Text="Audit graph assortative mixing &amp; hub-degree correlation" Click="OnAuditGraphAssortativityClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditGraphBetweennessBottlenecksItem" Text="Audit graph betweenness centrality &amp; bridge bottleneck identification" Click="OnAuditGraphBetweennessBottlenecksClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditBetweennessCentralityItem" Text="Audit graph betweenness centrality, bottlenecks &amp; bridge concepts" Click="OnAuditBetweennessCentralityClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE817;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditGraphArticulationPointsItem" Text="Audit graph biconnected components, cut vertices &amp; bridge fragility" Click="OnAuditGraphArticulationPointsClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditGraphBiconnectedComponentsItem" Text="Audit graph biconnected components, cut vertices &amp; single point of failure bottlenecks" Click="OnAuditGraphBiconnectedComponentsClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditGraphBipartiteItem" Text="Audit graph bipartite 2-mode network partition, odd cycles &amp; modularity balance" Click="OnAuditGraphBipartiteClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE736;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditGraphBipartitenessOddCyclesItem" Text="Audit graph bipartiteness &amp; 2-colorability compliance" Click="OnAuditGraphBipartitenessAndOddCyclesClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE736;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditGraphBranchSymmetryItem" Text="Audit graph branch leaf density &amp; subtree symmetry balance" Click="OnAuditGraphBranchSymmetryClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF003;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditGraphVulnerabilityItem" Text="Audit graph bridge links &amp; articulation vulnerability" Click="OnAuditGraphVulnerabilityClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE817;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditGraphMedianClosenessPlacementItem" Text="Audit graph closeness centrality &amp; topological median placement" Click="OnAuditGraphMedianClosenessPlacementClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditClusteringTransitivityItem" Text="Audit graph clustering coefficient &amp; triadic closure" Click="OnAuditClusteringTransitivityClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81E;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditGraphClusteringCoefficientItem" Text="Audit graph clustering coefficient, small-world topology &amp; triadic closure" Click="OnAuditGraphClusteringCoefficientClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xECA5;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditCommunityModularityItem" Text="Audit graph community modularity &amp; cluster density" Click="OnAuditCommunityModularityClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xECA5;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditKCoreDecompositionItem" Text="Audit graph core-periphery structure &amp; k-core shell decomposition" Click="OnAuditKCoreDecompositionClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF158;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditGraphCyclesItem" Text="Audit graph cycle detection, feedback loops &amp; strongly connected components (SCC)" Click="OnAuditGraphCyclesClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE895;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditGraphCyclesFeedbackArcSetItem" Text="Audit graph cycles, back-edges &amp; feedback arc set minimization" Click="OnAuditGraphCyclesAndFeedbackArcSetClick">
                                        
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE895;" /></MenuFlyoutItem.Icon>
                                        
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditGraphFeedbackArcSetItem" Text="Audit graph DAG feedback loops &amp; strongly connected components" Click="OnAuditGraphFeedbackArcSetClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE895;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditDegreeCentralityItem" Text="Audit graph degree centrality &amp; node hubs" Click="OnAuditDegreeCentralityClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C1;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditGraphDegreeDistributionAndHubsItem" Text="Audit graph degree distribution &amp; hyper-connected hub skewness" Click="OnAuditGraphDegreeDistributionAndHubsClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditGraphDegreeDistributionTopologyItem" Text="Audit graph degree distribution, scale-free power law &amp; hub centrality" Click="OnAuditGraphDegreeDistributionTopologyClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="AuditGraphDiameterSmallWorldItem" Text="Audit graph diameter, average path length &amp; small-world navigation" Click="OnAuditGraphDiameterAndSmallWorldClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xECA5;" /></MenuFlyoutItem.Icon>

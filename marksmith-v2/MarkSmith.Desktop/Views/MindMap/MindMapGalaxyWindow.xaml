<Window
    x:Class="MarkSmith.Views.MindMap.MindMapGalaxyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:MarkSmith.Converters"
    xmlns:vm="using:MarkSmith.ViewModels.MindMap"
    mc:Ignorable="d"
    Title="Document Galaxy &amp; Mind Map Library — MarkSmith">

    <Grid x:Name="RootGrid" Background="#12131C">
        <Grid.Resources>
            <conv:FillBrushConverter x:Key="FillBrushConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR & HEADER -->
        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                    <StackPanel Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            <!-- Unsaved marker -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="6,1" VerticalAlignment="Center"
                                    Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="unsaved" FontSize="10" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Interconnected Vault · Markdown, Word, PDF &amp; Visual Graph" FontSize="11" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>

                <!-- Center: Action Tools -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Command="{Binding AddChildNodeCommand}" ToolTipService.ToolTip="Add child node (Tab)" Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="Child" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddSiblingNodeCommand}" ToolTipService.ToolTip="Add sibling node (Enter)" Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="Sibling" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnConnectSelectedClick" ToolTipService.ToolTip="Link two documents and name the relationship (Ctrl+L)" Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71B;" FontSize="12" />
                            <TextBlock Text="Link" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteSelectionCommand}" ToolTipService.ToolTip="Delete node or link (Del)" Padding="8,5">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                    </Button>

                    <AppBarSeparator />

                    <Button Command="{Binding UndoCommand}" ToolTipService.ToolTip="Undo (Ctrl+Z)" Padding="8,5"
                            IsEnabled="{Binding CanUndo}">
                        <FontIcon Glyph="&#xE7A7;" FontSize="12" />
                    </Button>
                    <Button Command="{Binding RedoCommand}" ToolTipService.ToolTip="Redo (Ctrl+Y)" Padding="8,5"
                            IsEnabled="{Binding CanRedo}">
                        <FontIcon Glyph="&#xE7A6;" FontSize="12" />
                    </Button>

                    <AppBarSeparator />

                    <!-- Layout Dropdown -->
                    <DropDownButton Padding="8,5" ToolTipService.ToolTip="Automatic layout arrangements">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B9;" FontSize="12" />
                            <TextBlock Text="Auto-Layout" FontSize="12" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Horizontal Tree" Click="OnLayoutTreeClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE81E;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Radial Constellation" Click="OnLayoutRadialClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE707;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Force-Directed Cluster" Click="OnLayoutForceClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE946;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Hierarchy (Top-Down)" Click="OnLayoutHierarchyClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B9;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Clustered Islands" Click="OnLayoutClustersClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7C3;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button Click="OnToggleFocusModeClick" ToolTipService.ToolTip="Focus mode — dim everything the selected document isn't connected to (F)" Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEA80;" FontSize="12" />
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="6" Padding="5,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsFocusModeEnabled, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="ON" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Click="OnImportFolderClick" ToolTipService.ToolTip="Scan a folder and auto-link everything in it" Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                            <TextBlock Text="Import Vault" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <DropDownButton Padding="8,5" ToolTipService.ToolTip="Export document network">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEDE1;" FontSize="12" />
                            <TextBlock Text="Export" FontSize="12" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Word Document (.docx)" Click="OnExportDocxClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74E;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Copy Mermaid Flowchart" Click="OnCopyMermaidFlowchartClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE943;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Copy Mermaid Mindmap" Click="OnCopyMermaidMindmapClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B9;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Save Map File (.msmap)..." Click="OnSaveAsClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74E;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button Click="OnSaveClick" ToolTipService.ToolTip="Save galaxy (Ctrl+S)" Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="12" />
                            <TextBlock Text="Save" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: Search & Zoom Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search titles, notes, tags, paths..." Width="210"
                                    TextChanged="OnSearchTextChanged" QuerySubmitted="OnSearchQuerySubmitted"
                                    ToolTipService.ToolTip="Ctrl+F to focus · Enter to jump to the next match" />
                    <TextBlock Text="{Binding SearchMatchCount}" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                               Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVis}}" />
                    <Button Click="OnZoomOutClick" ToolTipService.ToolTip="Zoom out (Ctrl+-)" Padding="6,5"><FontIcon Glyph="&#xE738;" FontSize="11" /></Button>
                    <TextBlock Text="{Binding ZoomLevelText}" VerticalAlignment="Center" Width="42" TextAlignment="Center" FontSize="11" Opacity="0.7" />
                    <Button Click="OnZoomInClick" ToolTipService.ToolTip="Zoom in (Ctrl++)" Padding="6,5"><FontIcon Glyph="&#xE710;" FontSize="11" /></Button>
                    <Button Click="OnFitToWindowClick" ToolTipService.ToolTip="Fit the whole network on screen (Ctrl+0)" Padding="6,5"><FontIcon Glyph="&#xE740;" FontSize="11" /></Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN INTERACTIVE CANVAS BODY + SIDEBAR -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- GALAXY CANVAS AREA -->
            <Grid Grid.Column="0" Background="#12131C" x:Name="CanvasContainer" SizeChanged="OnCanvasContainerSizeChanged">
                <!-- Interactive pan & zoom canvas. Nodes and connectors are built once from
                     code-behind and then retained: the whole map lives in WorldCanvas in world
                     coordinates, so panning and zooming move a single transform instead of
                     rebuilding every card. -->
                <Canvas x:Name="GalaxyCanvas" Background="Transparent"
                        PointerPressed="OnCanvasPointerPressed"
                        PointerMoved="OnCanvasPointerMoved"
                        PointerReleased="OnCanvasPointerReleased"
                        PointerWheelChanged="OnCanvasPointerWheelChanged">
                    <Canvas x:Name="WorldCanvas">
                        <Canvas.RenderTransform>
                            <CompositeTransform x:Name="WorldTransform" />
                        </Canvas.RenderTransform>
                        <Canvas x:Name="EdgeLayer" />
                        <Canvas x:Name="NodeLayer" />
                    </Canvas>
                </Canvas>

                <!-- TOP OVERLAY STACK: first-run tour banner, then the tag filter pills -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Spacing="8">

                    <!-- GUIDED TOUR BANNER -->
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10"
                            MaxWidth="760"
                            Visibility="{Binding IsTutorialActive, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Interactive Guided Tour" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Folders force you to pick one home per file. Here each document preserves all relationships it has earned across projects."
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="500" />
                            </StackPanel>
                            <StackPanel Spacing="6" VerticalAlignment="Center">
                                <Button Click="OnImportFolderClick" Style="{StaticResource AccentButtonStyle}"
                                        FontSize="11" Padding="10,4" CornerRadius="6" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="11" />
                                        <TextBlock Text="Import Vault" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ClearTutorialCommand}" Background="Transparent" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" Padding="10,4" CornerRadius="6" HorizontalAlignment="Stretch"
                                        ToolTipService.ToolTip="Dismiss tour nodes and keep user-created nodes">
                                    <TextBlock Text="Dismiss Tour" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- FLOATING TAG FILTER PILL BAR -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="8,4" HorizontalAlignment="Center"
                            Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8EC;" FontSize="11" VerticalAlignment="Center" Margin="2,0,4,0" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <Button Click="OnAllTagsClick" Padding="8,3" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <TextBlock Text="All Tags" FontSize="11" />
                            </Button>
                            <ItemsControl ItemsSource="{Binding DistinctTags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="OnTagPillClick" Tag="{Binding}" Padding="8,3" CornerRadius="12"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- CONNECTION LEGEND (bottom-centre) -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6"
                        IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle Width="16" Height="2" Fill="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="hierarchy" FontSize="10" Opacity="0.75" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle Width="16" Height="2.5" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="manual link" FontSize="10" Opacity="0.75" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle Width="16" Height="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="inferred" FontSize="10" Opacity="0.75" />
                        </StackPanel>
                        <TextBlock Text="·  drag to position  ·  double-click to edit  ·  right-click for menu" FontSize="10" Opacity="0.5" />
                    </StackPanel>
                </Border>

                <!-- FLOATING MINIMAP RADAR HUD (Bottom-Left) -->
                <Border x:Name="MinimapOverlay"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="24,0,0,24" Width="180" Height="120"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="6">
                    <Grid>
                        <Canvas x:Name="MinimapCanvas" Background="Transparent"
                                PointerPressed="OnMinimapPointerPressed"
                                PointerMoved="OnMinimapPointerMoved"
                                PointerReleased="OnMinimapPointerReleased" />
                        <TextBlock Text="RADAR" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- FLOATING MARKDOWN PREVIEW CARD (Overlay) -->
                <Border x:Name="PreviewOverlayCard"
                        Visibility="{Binding IsPreviewCardVisible, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,24,24" Width="420" MaxHeight="340"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="14">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8A5;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="{Binding PreviewTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                            </StackPanel>
                            <Button Click="OnClosePreviewCardClick" HorizontalAlignment="Right" Padding="4,2" Background="Transparent" BorderThickness="0">
                                <FontIcon Glyph="&#xE711;" FontSize="10" Opacity="0.7" />
                            </Button>
                        </Grid>

                        <!-- Markdown snippet scroll -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding PreviewMarkdown}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontFamily="Consolas, monospace" />
                        </ScrollViewer>

                        <!-- Open in MarkSmith Action -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <TextBlock Text="{Binding PreviewFilePath}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                            <Button Click="OnPreviewVersionHistoryClick" Background="{ThemeResource SubtleFillColorSecondaryBrush}" FontSize="11" Padding="8,4" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE823;" FontSize="11" />
                                    <TextBlock Text="History" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnOpenInEditorClick" Style="{StaticResource AccentButtonStyle}" FontSize="11" Padding="10,4" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Open in Editor" FontSize="11" />
                                    <FontIcon Glyph="&#xE76C;" FontSize="10" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT PROPERTY & APPEARANCE INSPECTOR -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">

                        <!-- SECTION 0: GALAXY HEALTH -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="DOCUMENT VAULT TOPOLOGY" FontSize="11" FontWeight="Bold" Opacity="0.6" CharacterSpacing="60" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding InsightsSummary}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <Button Click="OnShowInsightsClick" HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="11" Padding="8,4" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE9D9;" FontSize="11" />
                                            <TextBlock Text="Topology Report" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <MenuFlyoutSeparator />

                        <!-- SECTION 1: APPEARANCE & THEMES -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="NETWORK APPEARANCE" FontSize="11" FontWeight="Bold" Opacity="0.6" CharacterSpacing="60" />
                            <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedThemeName, Mode=TwoWay}" HorizontalAlignment="Stretch" SelectionChanged="OnThemeChanged" />

                            <TextBlock Text="Branch accent swatches" FontSize="11" Opacity="0.6" Margin="0,4,0,0" />
                            <ItemsControl ItemsSource="{Binding PaletteColors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="40" ItemHeight="36" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="OnPaletteSwatchClick" Tag="{Binding}" Padding="0" Margin="3" Width="32" Height="30" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <Border CornerRadius="5" Background="{Binding Converter={StaticResource FillBrushConverter}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <MenuFlyoutSeparator />

                        <!-- EMPTY-SELECTION HINT -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12"
                                Visibility="{Binding HasSelectedNode, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Nothing selected" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Click a node on the canvas to edit its title, file, tags and notes — or a connector to edit the relationship."
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- SECTION 2: NODE DETAILS & LINKING -->
                        <StackPanel Spacing="10" DataContext="{Binding SelectedNode}"
                                    Visibility="{Binding ElementName=RootGrid, Path=DataContext.HasSelectedNode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="SELECTED DOCUMENT / NODE" FontSize="11" FontWeight="Bold" Opacity="0.6" CharacterSpacing="60" />

                            <TextBox Header="Title" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Document title..." />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="Linked file" Text="{Binding FilePath, Mode=TwoWay}" PlaceholderText="C:\docs\project.md" />
                                <Button Grid.Column="1" Click="OnBrowseForFileClick" VerticalAlignment="Bottom" Padding="8,6"
                                        ToolTipService.ToolTip="Pick the document this node stands for">
                                    <FontIcon Glyph="&#xE723;" FontSize="12" />
                                </Button>
                            </Grid>

                            <!-- Missing-file warning -->
                            <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5"
                                    Visibility="{Binding IsFileMissing, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="That file is no longer on disk. The node keeps the path so you can repoint it."
                                           FontSize="10.5" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                            </Border>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Header="Node type" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding ElementName=RootGrid, Path=DataContext.AvailableNodeTypes}"
                                          SelectedItem="{Binding NodeType, Mode=TwoWay}" />
                                <TextBox Grid.Column="1" Header="Icon" Text="{Binding Icon, Mode=TwoWay}" MaxLength="4" HorizontalAlignment="Stretch" />
                            </Grid>

                            <!-- Progress Slider -->
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Text="Completion / progress" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                </Grid>
                                <Slider Value="{Binding Progress, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="5" />
                            </StackPanel>

                            <!-- Tags -->
                            <TextBox Header="Tags (space separated)" Text="{Binding TagSummary, Mode=OneWay}" IsReadOnly="True"
                                     PlaceholderText="no tags yet" />
                            <Button Click="OnEditTagsClick" HorizontalAlignment="Stretch" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    FontSize="11" Padding="8,4" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8EC;" FontSize="11" />
                                    <TextBlock Text="Edit Tags" FontSize="11" />
                                </StackPanel>
                            </Button>

                            <!-- Markdown Notes -->
                            <TextBox Header="Markdown summary / notes" Text="{Binding MarkdownContent, Mode=TwoWay}" AcceptsReturn="True" Height="120" TextWrapping="Wrap" PlaceholderText="# Notes &amp; details..." />

                            <!-- Action Buttons -->
                            <Button Click="OnOpenSelectedDocumentClick" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="11" />
                                    <TextBlock Text="Open Document in MarkSmith" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnOpenVersionHistoryClick" HorizontalAlignment="Stretch" Background="{ThemeResource SubtleFillColorSecondaryBrush}" FontWeight="SemiBold" Margin="0,6,0,0" ToolTipService.ToolTip="Open version history &amp; time machine for this document">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE823;" FontSize="12" />
                                    <TextBlock Text="Document Time Machine" FontSize="12" />
                                    <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="10" Padding="6,1" Margin="4,0,0,0" Visibility="{Binding HasVersions, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding VersionCountText}" FontSize="10" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- SECTION 3: SELECTED RELATIONSHIP -->
                        <StackPanel Spacing="10"
                                    Visibility="{Binding HasSelectedLink, Converter={StaticResource BoolToVis}}">
                            <MenuFlyoutSeparator />
                            <TextBlock Text="SELECTED RELATIONSHIP" FontSize="11" FontWeight="Bold" Opacity="0.6" CharacterSpacing="60" />
                            <TextBlock Text="{Binding SelectedLinkDescription}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <StackPanel DataContext="{Binding SelectedLink}" Spacing="10">
                                <TextBox Header="Why are these connected?" Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="e.g. grew out of, evidence for, supersedes" />
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6"
                                        Visibility="{Binding IsInferred, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE946;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="MarkSmith inferred this connection during directory scan."
                                                   FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Button Click="OnReverseLinkClick" HorizontalAlignment="Stretch" Background="{ThemeResource SubtleFillColorSecondaryBrush}" FontSize="11" Padding="8,4" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8AB;" FontSize="11" />
                                    <TextBlock Text="Reverse Direction" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteSelectionCommand}" HorizontalAlignment="Stretch" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="11" Padding="8,4" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                    <TextBlock Text="Delete Relationship" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,240,0" />
                <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding NodesCountText}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding LinksCountText}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

        <!-- MAIN INTERACTIVE CANVAS BODY + SIDEBAR -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- GALAXY CANVAS AREA -->
            <Grid Grid.Column="0" Background="#12131C" x:Name="CanvasContainer" SizeChanged="OnCanvasContainerSizeChanged">
                <!-- Interactive pan & zoom canvas. Nodes and connectors are built once from
                     code-behind and then retained: the whole map lives in WorldCanvas in world
                     coordinates, so panning and zooming move a single transform instead of
                     rebuilding every card. -->
                <Canvas x:Name="GalaxyCanvas" Background="Transparent"
                        IsTabStop="True" UseSystemFocusVisuals="False"
                        AutomationProperties.Name="Map canvas"
                        PointerPressed="OnCanvasPointerPressed"
                        PointerMoved="OnCanvasPointerMoved"
                        PointerReleased="OnCanvasPointerReleased"
                        PointerCaptureLost="OnCanvasPointerCaptureLost"
                        PointerWheelChanged="OnCanvasPointerWheelChanged"
                        DoubleTapped="OnCanvasDoubleTapped"
                        RightTapped="OnCanvasRightTapped"
                        ToolTipService.ToolTip="Document Galaxy canvas · Double-click to add node here, Right-click for canvas &amp; export options">
                    <Canvas x:Name="WorldCanvas">
                        <Canvas.RenderTransform>
                            <CompositeTransform x:Name="WorldTransform" />
                        </Canvas.RenderTransform>
                        <Canvas x:Name="EdgeLayer" />
                        <Canvas x:Name="NodeLayer" />
                        <Canvas x:Name="GuideLayer" IsHitTestVisible="False" />
                    </Canvas>
                </Canvas>

                <!-- EMPTY GALAXY STATE: shown when every node has been deleted or the tour was
                     dismissed with nothing of the user's own left, so the canvas is never just a
                     blank void with no next step. -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="28,24"
                        Visibility="{Binding IsGalaxyEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xEC26;" FontSize="36" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Your map is empty" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Add a first node and grow the map from it, or import a folder and MarkSmith will link every document in it for you."
                                   FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button Command="{Binding AddRootNodeCommand}" Style="{StaticResource AccentButtonStyle}" Padding="12,6"
                                    AutomationProperties.Name="Add first node">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Add first node" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnImportFolderClick" Padding="12,6"
                                    ToolTipService.ToolTip="Map a folder: every document in it becomes a node"
                                    AutomationProperties.Name="Import folder">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                                    <TextBlock Text="Import folder" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- TOP OVERLAY STACK: first-run tour banner, then the tag filter pills -->
                <StackPanel x:Name="TopOverlay" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,12,16,0" Spacing="8">

                    <!-- GUIDED TOUR BANNER. The breadcrumb bar (built in code, top-left) drops below this
                         overlay when they would overlap; both sat at y=12 and the crumbs covered the heading. -->
                    <Border x:Name="TourBanner" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10"
                            MaxWidth="760"
                            Visibility="{Binding IsTutorialActive, Converter={StaticResource BoolToVis}}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7BE;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="This is a guided tour" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="A folder makes each file live in one place. Here a document keeps every connection it has, across projects. Import a folder to map your own."
                                           FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Click="OnImportFolderClick" Style="{StaticResource AccentButtonStyle}" FontSize="12" Padding="10,5"
                                        AutomationProperties.Name="Import folder">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                                        <TextBlock Text="Import folder" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ClearTutorialCommand}" FontSize="12" Padding="10,5"
                                        ToolTipService.ToolTip="Remove the tour's nodes. Anything you added stays."
                                        AutomationProperties.Name="Clear the tour">
                                    <TextBlock Text="Clear the tour" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- FLOATING TAG FILTER PILL BAR. The pill for the active filter is drawn in the
                         accent colour (see UpdateTagPills); before, nothing showed a filter was on. -->
                    <Border Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="8,4" HorizontalAlignment="Center"
                            Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                            <StackPanel x:Name="GalaxyTagPillsCluster" Orientation="Horizontal" Spacing="4" PreviewKeyDown="OnTagPillsPreviewKeyDown" XYFocusKeyboardNavigation="Enabled" TabFocusNavigation="Once" AutomationProperties.Name="Filter tag pills">
                                <FontIcon Glyph="&#xE8EC;" FontSize="12" VerticalAlignment="Center" Margin="4,0,4,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button x:Name="AllTagsPill" Click="OnAllTagsClick" Padding="10,3" CornerRadius="12" FontSize="11"
                                        Content="All tags" ToolTipService.ToolTip="Show every node (Esc clears filter) · Right-click or Shift+F10 for options"
                                        Loaded="OnTagPillLoaded" Unloaded="OnTagPillUnloaded" RightTapped="OnAllTagsPillRightTapped" />
                                <ItemsControl ItemsSource="{Binding DistinctTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button services:HoverPolish.ApplyOnLoad="True" Click="OnTagPillClick" Tag="{Binding}" Content="{Binding}"
                                                    Padding="10,3" CornerRadius="12" FontSize="11"
                                                    ToolTipService.ToolTip="Filter nodes by tag · Right-click or Shift+F10 for options"
                                                    Loaded="OnTagPillLoaded" Unloaded="OnTagPillUnloaded" RightTapped="OnDynamicTagPillRightTapped" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="TagFilterClearButton" Click="OnTagFilterClearClick" Padding="6,3" CornerRadius="12" FontSize="11"
                                        Style="{StaticResource DefaultButtonStyle}" Background="Transparent" BorderThickness="0"
                                        Visibility="Collapsed"
                                        AutomationProperties.Name="Clear tag filter"
                                        ToolTipService.ToolTip="Clear tag filter (Esc)">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <FontIcon Glyph="&#xE711;" FontSize="9" />
                                        <TextBlock Text="Clear" FontSize="10.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- CONNECTION LEGEND (bottom-centre, offset clear of the bottom-left minimap) -->
                <Border x:Name="ConnectionLegend" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="216,0,24,18"
                        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6"
                        IsHitTestVisible="True"
                        DoubleTapped="OnConnectionLegendDoubleTapped"
                        RightTapped="OnConnectionLegendRightTapped"
                        ToolTipService.ToolTip="Connection legend · Double-click to toggle, Right-click for options">
                    <!-- Wraps the hint onto its own line when the map is narrow (it used to be cut off). -->
                    <ui:WrapRow HorizontalSpacing="14" VerticalSpacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle Width="16" Height="2" Fill="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Parent and child" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Line X1="0" Y1="0" X2="16" Y2="0" StrokeThickness="2.5" Stroke="{ThemeResource SystemFillColorSuccessBrush}" StrokeDashArray="1.5,1" VerticalAlignment="Center" />
                            <TextBlock Text="Your link" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Line X1="0" Y1="0" X2="16" Y2="0" StrokeThickness="1.6" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeDashArray="2,1.6" VerticalAlignment="Center" />
                            <TextBlock Text="Found on import" FontSize="11" FontStyle="Italic" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="Drag or Alt+Arrows to move · Arrows to navigate · Double-click to open" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </ui:WrapRow>
                </Border>

                <!-- FLOATING MINIMAP (Bottom-Left) -->
                <Border x:Name="MinimapOverlay"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="24,0,0,24" Width="180" Height="120"
                        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="6"
                        DoubleTapped="OnMinimapOverlayDoubleTapped"
                        RightTapped="OnMinimapOverlayRightTapped"
                        ToolTipService.ToolTip="Overview: click or drag to move around map · Double-click to fit all in window · Right-click for options">
                    <Canvas x:Name="MinimapCanvas" Background="Transparent"
                            AutomationProperties.Name="Map overview"
                            PointerPressed="OnMinimapPointerPressed"
                            PointerMoved="OnMinimapPointerMoved"
                            PointerReleased="OnMinimapPointerReleased"
                            PointerCaptureLost="OnMinimapPointerCaptureLost" />
                </Border>

                <!-- Everything floating over the map (tour banner, tag pills, legend, minimap, this card) uses
                     a solid fill: the translucent card brushes let nodes and links show through the
                     preview text once the map was panned under them (run #47). -->
                <!-- FLOATING PREVIEW CARD: shows whichever node is under the pointer (or was double-
                     clicked), and its buttons act on that node — not on the selection. -->
                <Border x:Name="PreviewOverlayCard" SizeChanged="OnPreviewCardSizeChanged"
                        Visibility="{Binding IsPreviewCardVisible, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,24,24" Width="400" MaxHeight="320"
                        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="14,12"
                        RightTapped="OnPreviewOverlayCardRightTapped"
                        ToolTipService.ToolTip="Document preview (Right-click for document options)">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8A5;" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding PreviewTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Click="OnClosePreviewCardClick" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="Close the preview (Esc)" AutomationProperties.Name="Close the preview">
                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding PreviewMarkdown}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" IsTextSelectionEnabled="True" />
                        </ScrollViewer>

                        <Grid Grid.Row="2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PreviewFilePath}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <StackPanel x:Name="PreviewCardActionsCluster" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" XYFocusKeyboardNavigation="Enabled" TabFocusNavigation="Once" AutomationProperties.Name="Preview actions">
                            <Button x:Name="PreviewHistoryButton" Click="OnPreviewVersionHistoryClick" IsEnabled="{Binding PreviewHasFile}" FontSize="12" Padding="10,4"
                                    RightTapped="OnPreviewOverlayCardRightTapped"
                                    ToolTipService.ToolTip="Earlier versions of this document · Right-click or Shift+F10 for options" AutomationProperties.Name="Version history">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE81C;" FontSize="12" />
                                    <TextBlock Text="History" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PreviewOpenButton" Click="OnOpenInEditorClick" IsEnabled="{Binding PreviewHasFile}" Style="{StaticResource AccentButtonStyle}" FontSize="12" Padding="10,4"
                                    RightTapped="OnPreviewOverlayCardRightTapped"
                                    ToolTipService.ToolTip="Open this document in the editor · Right-click or Shift+F10 for options" AutomationProperties.Name="Open in editor">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Open" FontSize="12" />
                                    <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                </StackPanel>
                            </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT INSPECTOR -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,16,16">
                    <StackPanel Spacing="18">

                        <!-- MAP OVERVIEW -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Map overview" Style="{StaticResource InspectorHeading}" />
                            <TextBlock x:Name="InsightsSummaryText" Text="{Binding InsightsSummary}" Style="{StaticResource InspectorCaption}" />
                            <Button Click="OnShowInsightsClick" HorizontalAlignment="Stretch" Padding="10,5"
                                    ToolTipService.ToolTip="Counts, the most connected documents, formats, tags and anything not linked yet"
                                    AutomationProperties.Name="Map report">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="12" />
                                    <TextBlock Text="Map report" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- APPEARANCE -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Appearance" Style="{StaticResource InspectorHeading}" />
                            <ComboBox AutomationProperties.Name="Map appearance" ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedThemeName, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- EMPTY-SELECTION HINT -->
                        <StackPanel Spacing="6" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <FontIcon Glyph="&#xE8B0;" FontSize="20" HorizontalAlignment="Left" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="Nothing selected" Style="{StaticResource InspectorHeading}" />
                            <TextBlock Text="Click a node to edit its title, file, tags and notes, or click a link to say why two documents are connected."
                                       Style="{StaticResource InspectorCaption}" />
                        </StackPanel>

                        <!-- SELECTED NODE -->
                        <StackPanel Spacing="12" DataContext="{Binding SelectedNode}"
                                    Visibility="{Binding ElementName=RootGrid, Path=DataContext.HasSelectedNode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Selected node" Style="{StaticResource InspectorHeading}" />

                            <TextBox x:Name="TitleBox" Header="Title" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Name this document" KeyDown="OnInspectorFieldKeyDown"
                                     DoubleTapped="OnTitleBoxDoubleTapped"
                                     ToolTipService.ToolTip="Document title · Double-click to select all, Right-click or Shift+F10 for options" />

                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Header="Linked file" Text="{Binding FilePath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             PlaceholderText="No file attached" KeyDown="OnInspectorFieldKeyDown" />
                                    <Button Grid.Column="1" Click="OnBrowseForFileClick" VerticalAlignment="Bottom" Width="34" Height="32" Padding="0"
                                            ToolTipService.ToolTip="Choose the document this node stands for" AutomationProperties.Name="Choose a file">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="13" />
                                    </Button>
                                </Grid>
                                <!-- Missing-file warning -->
                                <InfoBar IsOpen="{Binding IsFileMissing}" IsClosable="False" Severity="Warning" Padding="0"
                                         Message="That file isn't there any more. Choose it again to point the node at its new place." />
                            </StackPanel>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="124" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Header="Type" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding ElementName=RootGrid, Path=DataContext.AvailableNodeTypes}"
                                          SelectedItem="{Binding NodeType, Mode=TwoWay}" />
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Icon-font glyphs sit high on the text line (about 3 px above centre in the
                                         stock 10,5,6,6 padding), so the top padding is larger. -->
                                    <TextBox x:Name="NodeIconBox" Grid.Column="0" Text="{Binding Icon, Mode=TwoWay}" MaxLength="4" HorizontalAlignment="Stretch" TextAlignment="Center"
                                             Padding="10,8,6,3"
                                             FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Emoji, Segoe UI"
                                             DoubleTapped="OnNodeIconBoxDoubleTapped"
                                             ToolTipService.ToolTip="An emoji or Segoe Fluent icon · Double-click to clear/default · Right-click, Shift+F10 or the picker for presets" KeyDown="OnInspectorFieldKeyDown">
                                        <TextBox.Header>
                                            <TextBlock Text="Icon" FontFamily="{ThemeResource ContentControlThemeFontFamily}" />
                                        </TextBox.Header>
                                    </TextBox>
                                    <Button x:Name="NodeIconPickerButton" Grid.Column="1" VerticalAlignment="Bottom" Width="30" Height="32" Padding="0" Margin="4,0,0,0"
                                            Click="OnNodeIconPickerButtonClick" RightTapped="OnNodeIconBoxRightTapped"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            ToolTipService.ToolTip="Pick icon (Segoe Fluent / Emoji) · Right-click or Shift+F10 for options" AutomationProperties.Name="Pick node icon">
                                        <!-- An emoji face, not the colour palette: this picks the node's icon. -->
                                        <FontIcon Glyph="&#xE76E;" FontSize="13" />
                                    </Button>
                                </Grid>
                            </Grid>

                            <!-- Colour: lives with the node it recolours. In "Appearance" above, a click
                                 with nothing selected silently did nothing. -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Colour" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <ItemsControl ItemsSource="{Binding ElementName=RootGrid, Path=DataContext.PaletteColors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button services:HoverPolish.ApplyOnLoad="True" Click="OnPaletteSwatchClick" Tag="{Binding}" Padding="3" Width="30" Height="30" CornerRadius="15"
                                                    BorderThickness="2" BorderBrush="Transparent" Background="Transparent"
                                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                    Loaded="OnSwatchLoaded" Unloaded="OnSwatchUnloaded">
                                                <!-- Content must stretch: with the default centred alignment this unsized swatch measured 0x0 and every button rendered empty. -->
                                                <Border CornerRadius="11" Background="{Binding Converter={StaticResource FillBrushConverter}}"
                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <Grid x:Name="NodeProgressHeaderGrid"
                                      IsHitTestVisible="True"
                                      DoubleTapped="OnNodeProgressSliderDoubleTapped"
                                      RightTapped="OnNodeProgressSliderRightTapped"
                                      ToolTipService.ToolTip="Document progress readout (Double-click to toggle completion, Right-click for presets)">
                                    <TextBlock Text="Progress" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="NodeProgressSlider" Value="{Binding Progress, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="5" SmallChange="5" LargeChange="25"
                                        DoubleTapped="OnNodeProgressSliderDoubleTapped"
                                        RightTapped="OnNodeProgressSliderRightTapped"
                                        ToolTipService.ToolTip="Document progress (0..100%) · Double-click to toggle completion, Right-click or Shift+F10 for progress presets"
                                        AutomationProperties.Name="Progress" />
                            </StackPanel>

                            <TextBox x:Name="TagsBox" Header="Tags" Text="{Binding TagsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     PlaceholderText="#research #q3, separated by spaces" KeyDown="OnInspectorFieldKeyDown"
                                     DoubleTapped="OnTagsBoxDoubleTapped"
                                     ToolTipService.ToolTip="Separate tags with spaces or commas · Double-click to select all, Right-click or Shift+F10 for tag suggestions &amp; options" />

                            <TextBox Header="Notes" Text="{Binding MarkdownContent, Mode=TwoWay}" AcceptsReturn="True" Height="130" TextWrapping="Wrap"
                                     PlaceholderText="What this document is and why it matters (Markdown)" />

                            <StackPanel Spacing="6">
                                <Button Click="OnOpenSelectedDocumentClick" IsEnabled="{Binding HasFile}" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Padding="10,6"
                                        ToolTipService.ToolTip="Open the linked file in the editor (double-click the node)"
                                        AutomationProperties.Name="Open in editor">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                        <TextBlock Text="Open in editor" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnOpenVersionHistoryClick" IsEnabled="{Binding HasFile}" HorizontalAlignment="Stretch" Padding="10,6"
                                        ToolTipService.ToolTip="Every saved version of the linked file, with what changed"
                                        AutomationProperties.Name="Version history">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE81C;" FontSize="12" />
                                        <TextBlock Text="Version history" FontSize="12" />
                                        <Border Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="9" Padding="7,1" Visibility="{Binding HasVersions, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding VersionCountText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- SELECTED LINK -->
                        <StackPanel Spacing="12"
                                    Visibility="{Binding HasSelectedLink, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Selected link" Style="{StaticResource InspectorHeading}" />
                            <TextBlock Text="{Binding SelectedLinkDescription}" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                            <StackPanel DataContext="{Binding SelectedLink}" Spacing="8">
                                <TextBox x:Name="LinkLabelBox" Header="Why are these connected?" Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="e.g. grew out of, evidence for, supersedes" KeyDown="OnInspectorFieldKeyDown"
                                         DoubleTapped="OnLinkLabelBoxDoubleTapped"
                                         ToolTipService.ToolTip="Relationship label shown on the connector (F2 · Double-click to select all, Right-click or Shift+F10 for text options)" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding IsInferred, Converter={StaticResource BoolToVis}}">
                                    <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                    <TextBlock Text="MarkSmith found this link when the folder was imported. Give it a reason to make it yours."
                                               Style="{StaticResource InspectorCaption}" />
                                </StackPanel>
                            </StackPanel>
                            <Grid x:Name="LinkActionsCluster" ColumnSpacing="8"
                                  XYFocusKeyboardNavigation="Enabled" TabFocusNavigation="Once"
                                  AutomationProperties.Name="Link actions">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ReverseLinkButton" Click="OnReverseLinkClick" RightTapped="OnReverseLinkButtonRightTapped" HorizontalAlignment="Stretch" Padding="10,6"
                                        ToolTipService.ToolTip="Flip which way the arrow points (Right-click or Shift+F10 for direction presets)"
                                        AutomationProperties.Name="Reverse link">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8AB;" FontSize="12" />
                                        <TextBlock Text="Reverse" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DeleteLinkButton" Grid.Column="1" Command="{Binding DeleteSelectionCommand}" RightTapped="OnDeleteLinkButtonRightTapped" HorizontalAlignment="Stretch" Padding="10,6"
                                        ToolTipService.ToolTip="Delete this link (Delete · Right-click or Shift+F10 for options)"
                                        AutomationProperties.Name="Delete link">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <TextBlock Text="Delete link" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="14,6"
                RightTapped="OnStatusBarRightTapped" DoubleTapped="OnStatusBarDoubleTapped"
                ToolTipService.ToolTip="Document Galaxy status (Double-click to fit to window, Right-click for options)">
            <Grid ColumnSpacing="16" RightTapped="OnStatusBarRightTapped" DoubleTapped="OnStatusBarDoubleTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusBarText" Text="{Binding StatusMessage}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"
                           RightTapped="OnStatusBarRightTapped" DoubleTapped="OnStatusBarDoubleTapped" />
                <StackPanel x:Name="GalaxyStatusCluster" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                            XYFocusKeyboardNavigation="Enabled" TabFocusNavigation="Once"
                            AutomationProperties.Name="Galaxy status counts">
                    <HyperlinkButton x:Name="NodesCountButton" Padding="4,0" MinHeight="0" VerticalAlignment="Center"
                                     Click="OnNodesCountClick" RightTapped="OnNodesCountRightTapped"
                                     AutomationProperties.Name="{Binding NodesCountText}"
                                     AutomationProperties.HelpText="Opens node navigation and copy options."
                                     ToolTipService.ToolTip="Total nodes · Click, right-click or Shift+F10 for navigation &amp; options">
                        <TextBlock x:Name="NodesCountText" Text="{Binding NodesCountText}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </HyperlinkButton>
                    <TextBlock Text="·" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <HyperlinkButton x:Name="LinksCountButton" Padding="4,0" MinHeight="0" VerticalAlignment="Center"
                                     Click="OnLinksCountClick" RightTapped="OnLinksCountRightTapped"
                                     AutomationProperties.Name="{Binding LinksCountText}"
                                     AutomationProperties.HelpText="Opens connection copy and layout options."
                                     ToolTipService.ToolTip="Total connections · Click, right-click or Shift+F10 for connection actions">
                        <TextBlock x:Name="LinksCountText" Text="{Binding LinksCountText}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </HyperlinkButton>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

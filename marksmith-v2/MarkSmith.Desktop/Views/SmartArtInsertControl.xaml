<UserControl
    x:Class="MarkSmith.Views.SmartArtInsertControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Width="460" Spacing="14">
        <!-- Header description -->
        <TextBlock Text="Choose a SmartArt diagram layout and enter your steps or milestones:"
                   FontSize="12" Opacity="0.75" TextWrapping="Wrap" />

        <!-- Visual Layout Selector (Grid of 4 visual cards) -->
        <Grid ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Process Card -->
            <Button x:Name="ProcessCard" Grid.Row="0" Grid.Column="0" Click="OnLayoutCardClick" Tag="process"
                    HorizontalAlignment="Stretch" Padding="10,8" Height="58"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8A9;" FontSize="20" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Process" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Sequential steps / timeline" FontSize="11" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- List Card -->
            <Button x:Name="ListCard" Grid.Row="0" Grid.Column="1" Click="OnLayoutCardClick" Tag="list"
                    HorizontalAlignment="Stretch" Padding="10,8" Height="58">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xEA37;" FontSize="20" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="List" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Grouped feature blocks" FontSize="11" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- Cycle Card -->
            <Button x:Name="CycleCard" Grid.Row="1" Grid.Column="0" Click="OnLayoutCardClick" Tag="cycle"
                    HorizontalAlignment="Stretch" Padding="10,8" Height="58">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE895;" FontSize="20" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cycle" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Continuous repeating loop" FontSize="11" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- Hierarchy Card -->
            <Button x:Name="HierarchyCard" Grid.Row="1" Grid.Column="1" Click="OnLayoutCardClick" Tag="hierarchy"
                    HorizontalAlignment="Stretch" Padding="10,8" Height="58">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE836;" FontSize="20" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Hierarchy" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Organizational / tree structure" FontSize="11" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Template Quick-Picks Row -->
        <StackPanel Spacing="6">
            <TextBlock Text="Quick Templates:" FontSize="11" FontWeight="SemiBold" Opacity="0.65" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="🚀 Project Phases" Click="OnTemplateClick" Tag="phases" Padding="8,4" FontSize="11" />
                    <Button Content="🔄 PDCA Cycle" Click="OnTemplateClick" Tag="pdca" Padding="8,4" FontSize="11" />
                    <Button Content="🏢 Org Hierarchy" Click="OnTemplateClick" Tag="org" Padding="8,4" FontSize="11" />
                    <Button Content="💡 Feature List" Click="OnTemplateClick" Tag="features" Padding="8,4" FontSize="11" />
                </StackPanel>
            </ScrollViewer>
        </StackPanel>

        <!-- Items Input Box -->
        <StackPanel Spacing="6">
            <Grid>
                <TextBlock Text="Steps / Items (one per line):" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="ItemCountBadge" Text="3 items" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <TextBox x:Name="StepsBox" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="110" MaxHeight="180" FontSize="13" IsSpellCheckEnabled="False"
                     PlaceholderText="Step 1: Planning&#x0a;Step 2: Development&#x0a;Step 3: Launch"
                     TextChanged="OnStepsTextChanged" />
        </StackPanel>

        <!-- Live Code Preview Box -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="10,8">
            <StackPanel Spacing="4">
                <TextBlock Text="Live Markdown Preview:" FontSize="11" FontWeight="SemiBold" Opacity="0.65" />
                <TextBlock x:Name="PreviewCodeText" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

<Window
    x:Class="MarkSmith.Views.SmartArtStudio.SmartArtDesignStudioWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:MarkSmith.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:MarkSmith.Converters"
    xmlns:ui="using:MarkSmith.Controls"
    mc:Ignorable="d"
    Title="SmartArt Studio — MarkSmith">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" KeyDown="OnRootGridKeyDown">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="SmartArtThumbTileBrush" Color="#FFF8F9FA" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="SmartArtThumbTileBrush" Color="#FFEDEDF0" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
                <conv:LevelToIndentConverter x:Key="LevelToIndentConverter" />
                <conv:SelectedBrushConverter x:Key="SelectedBrushConverter" />
                <conv:SvgMarkupToImageSourceConverter x:Key="SvgMarkupToImageSourceConverter" />
                <Style x:Key="ToolIconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="0" />
                </Style>
                <Style x:Key="PaneCaption" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar + window commands -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="56" Padding="16,0" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xF003;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SmartArt Studio" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Write the outline, pick a layout — it exports as real, editable Word SmartArt"
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="UndoStudioButton" Style="{StaticResource ToolIconButton}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"
                        AutomationProperties.Name="Undo" ToolTipService.ToolTip="Undo (Ctrl+Z, Right-click or Shift+F10 for options)"
                        RightTapped="OnUndoButtonRightTapped"><FontIcon Glyph="&#xE7A7;" FontSize="14" /></Button>
                <Button x:Name="RedoStudioButton" Style="{StaticResource ToolIconButton}" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"
                        AutomationProperties.Name="Redo" ToolTipService.ToolTip="Redo (Ctrl+Y, Right-click or Shift+F10 for options)"
                        RightTapped="OnRedoButtonRightTapped"><FontIcon Glyph="&#xE7A6;" FontSize="14" /></Button>
                <Button x:Name="InsertIntoDocumentButton" Command="{Binding InsertIntoDocumentCommand}" Style="{StaticResource AccentButtonStyle}" Margin="4,0,0,0"
                        AutomationProperties.Name="Insert into document"
                        RightTapped="OnInsertIntoDocumentButtonRightTapped"
                        ToolTipService.ToolTip="Add this SmartArt to the open document (Ctrl+Enter, Right-click or Shift+F10 for options)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                        <TextBlock Text="Insert into document" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" ColumnSpacing="10" Padding="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="424" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: layout gallery -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="8" Padding="12,12,12,6">
                        <Grid>
                            <TextBlock Text="Layouts" FontWeight="SemiBold" FontSize="14" />
                            <!-- A button so Tab reaches the count's menu. A double-click used to clear the search
                                 or copy the count depending on the filter, which nothing on screen said. -->
                            <HyperlinkButton x:Name="LayoutCountButton" Padding="4,0" MinHeight="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                             Click="OnLayoutCountButtonClick" RightTapped="OnLayoutCountButtonRightTapped"
                                             AutomationProperties.Name="{Binding LayoutCountText}"
                                             AutomationProperties.HelpText="Opens layout search, filter and copy options."
                                             ToolTipService.ToolTip="Layout count · Click, right-click or Shift+F10 for search, filter and copy options">
                                <TextBlock x:Name="LayoutCountLabel" Text="{Binding LayoutCountText}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           AutomationProperties.LiveSetting="Polite" />
                            </HyperlinkButton>
                        </Grid>
                        <AutoSuggestBox x:Name="LayoutSearch" AutomationProperties.Name="Search layouts" PlaceholderText="Search layouts"
                                        QueryIcon="Find" TextChanged="OnLayoutSearchTextChanged" KeyDown="OnLayoutSearchKeyDown"
                                        DoubleTapped="OnLayoutSearchDoubleTapped"
                                        ToolTipService.ToolTip="Search layouts by name or category (Double-click to select all, Right-click or Shift+F10 for options)" />
                        <ComboBox x:Name="LayoutCategoryCombo" AutomationProperties.Name="Layout type" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                  KeyDown="OnLayoutCategoryComboKeyDown"
                                  DoubleTapped="OnLayoutCategoryComboDoubleTapped"
                                  RightTapped="OnLayoutCategoryComboRightTapped"
                                  ToolTipService.ToolTip="Filter by layout category (Enter to browse, Esc to reset, Double-click to cycle, Right-click or Shift+F10 for options)" />
                    </StackPanel>
                    <ListView Grid.Row="1" x:Name="LayoutList" ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout, Mode=TwoWay}"
                              Padding="4,0,4,8" AutomationProperties.Name="Layouts" RightTapped="OnLayoutListRightTapped" KeyDown="OnLayoutListKeyDown"
                              DoubleTapped="OnLayoutListDoubleTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,7" ColumnSpacing="10" AutomationProperties.Name="{Binding DisplayName}"
                                      ToolTipService.ToolTip="{Binding AliasHint}"
                                      PointerEntered="OnLayoutTilePointerEntered" PointerExited="OnLayoutTilePointerExited"
                                      PointerPressed="OnLayoutTilePointerPressed" PointerReleased="OnLayoutTilePointerReleased">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- A live miniature of the layout's drawing (the same shapes the preview
                                         draws), on a light tile because the drawing's colours are made
                                         for a white page. -->
                                    <Border Width="64" Height="44" CornerRadius="6" Padding="4" CenterPoint="32,22,0"
                                            Background="{ThemeResource SmartArtThumbTileBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Border.ScaleTransition>
                                            <Vector3Transition Duration="0:0:0.14" />
                                        </Border.ScaleTransition>
                                        <Image Source="{Binding ThumbnailSvg, Converter={StaticResource SvgMarkupToImageSourceConverter}, ConverterParameter=112}"
                                               Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="NoMatchesPanel" Grid.Row="1" Spacing="6" Margin="16,24,16,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                                Background="Transparent" IsHitTestVisible="True"
                                RightTapped="OnNoMatchesPanelRightTapped"
                                ToolTipService.ToolTip="No matching layouts (Right-click for options)"
                                Visibility="{Binding HasNoLayoutMatches, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE721;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="NoMatchesTitleText" Text="No layouts match" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   RightTapped="OnNoMatchesPanelRightTapped" />
                        <TextBlock Text="Try a shorter term, set the type back to All, or search for &quot;cycle&quot; or &quot;pyramid&quot;." FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CENTER: Outline | Markdown -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Tabs first, then the pills; the pane is a fixed 424 px, so the pills wrap onto a
                         second line rather than squeezing the Outline | Markdown tabs to nothing. -->
                    <ui:WrapRow Grid.Row="0" Margin="6,4,6,4" HorizontalSpacing="6" VerticalSpacing="2">
                        <SelectorBar x:Name="EditorTabs" SelectionChanged="OnEditorTabsChanged"
                                     DoubleTapped="OnEditorTabsDoubleTapped"
                                     RightTapped="OnEditorTabsRightTapped">
                            <SelectorBarItem x:Name="OutlineTab" Text="Outline" IsSelected="True">
                                <SelectorBarItem.Icon><FontIcon Glyph="&#xE8FD;" /></SelectorBarItem.Icon>
                            </SelectorBarItem>
                            <SelectorBarItem x:Name="MarkdownTab" Text="Markdown">
                                <SelectorBarItem.Icon><FontIcon Glyph="&#xE943;" /></SelectorBarItem.Icon>
                            </SelectorBarItem>
                        </SelectorBar>
                            <Button x:Name="OutlineStatsPill" MinHeight="0" MinWidth="0" VerticalAlignment="Center"
                                    Padding="8,3" CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    RightTapped="OnOutlineStatsPillRightTapped"
                                    AutomationProperties.Name="Outline stats"
                                    ToolTipService.ToolTip="Outline stats · Click for navigation and outline tools, right-click or Shift+F10 for the same menu">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8EC;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="OutlineStatsText" Text="0 nodes · Depth 0" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="OutlineStatsFlyout">
                                        <MenuFlyoutItem Text="Select root node (Top)" Click="OnSelectRootNodeClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74A;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Select deepest node" Click="OnSelectDeepestNodeClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74B;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutSubItem Text="Copy">
                                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutSubItem.Icon>
                                            <MenuFlyoutItem Text="Copy outline hierarchy summary" Click="OnCopyOutlineSummaryClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="OutlineHierarchyMetricsItem" Text="Copy hierarchy depth &amp; leaf stats" Click="OnCopyHierarchyMetricsClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="OutlineRootsOnlyItem" Text="Copy top-level outline roots only" Click="OnCopyOutlineRootsOnlyClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="OutlineHierarchyBreakdownItem" Text="Copy hierarchy level breakdown (L1, L2...)" Click="OnCopyOutlineHierarchyBreakdownClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSubItem Text="Restructure">
                                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8FD;" /></MenuFlyoutSubItem.Icon>
                                            <MenuFlyoutItem Text="Promote all items (Shift out 1 level)" Click="OnPromoteAllClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE76B;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Demote all items (Shift in 1 level)" Click="OnDemoteAllClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE76C;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Flatten all items to root level" Click="OnFlattenAllClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DE;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Reverse outline items" Click="OnReverseOutlineClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE747;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Sort outline items (A to Z)" Click="OnSortOutlineAscendingClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8CB;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Sort outline items (Z to A)" Click="OnSortOutlineDescendingClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8CC;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="ReverseHierarchyOutlineItem" Text="Reverse top-level outline blocks (Preserve subtrees)" Click="OnReverseHierarchyOutlineClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8CB;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="SplitLongOutlineItem" Text="Split long outline items into parent + sub-bullet (&gt;45 chars)" Click="OnSplitLongOutlineClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C6;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="StructureByDelimiterOutlineItem" Text="Structure flat outline by delimiter (Category: Item → Subtree)" Click="OnStructureByDelimiterOutlineClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E4;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="BalanceOutlineDepthItem" Text="Balance outline nesting depth (Clamp to max depth 2)" Click="OnBalanceOutlineDepthClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="AutoNumberOutlineItem" Text="Apply hierarchical outline numbering (1., 1.1., 2.)" Click="OnAutoNumberOutlineClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSubItem Text="Clean up">
                                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE90F;" /></MenuFlyoutSubItem.Icon>
                                            <MenuFlyoutItem Text="Trim trailing whitespace" Click="OnTrimTrailingWhitespaceClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE75C;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Standardise bullet points (-)" Click="OnStandardiseBulletsClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="OutlineNormalizeIndentItem" Text="Normalize indentation (2 spaces per level)" Click="OnNormalizeIndentationClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E7;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="DeduplicateOutlineItem" Text="Remove duplicate sibling bullets" Click="OnDeduplicateOutlineClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="NormalizeMatrixQuadrantsItem" Text="Normalize 2x2 matrix quadrant titles (SWOT / Eisenhower / BCG)" Click="OnNormalizeMatrixQuadrantsClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSubItem Text="Suggest">
                                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE82F;" /></MenuFlyoutSubItem.Icon>
                                            <MenuFlyoutItem x:Name="RecommendLayoutsOutlineItem" Text="Recommend best-fitting SmartArt layouts for outline" Click="OnRecommendLayoutsOutlineClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="RecommendIconsOutlineItem" Text="Recommend icons for outline keywords" Click="OnRecommendIconsOutlineClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B3;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutSubItem Text="Diagnostics">
                                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutSubItem.Icon>
                                            <MenuFlyoutItem x:Name="OutlineStatsAuditMatrixQuadrantGeometryItem" Text="Audit 2x2 matrix / quadrant geometry &amp; text balance symmetry" Click="OnOutlineStatsAuditMatrixQuadrantGeometryClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80A;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="OutlineStatsAuditMatrixQuadrantSymmetryItem" Text="Audit 2x2 matrix quadrant axis symmetry &amp; item distribution" Click="OnAuditMatrixQuadrantSymmetryClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF158;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="AuditMatrixQuadrantBalanceItem" Text="Audit 2x2 matrix quadrant balance &amp; distribution" Click="OnAuditMatrixQuadrantBalanceClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74C;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="OutlineStatsAuditQuadrantGridBalanceItem" Text="Audit 2x2 matrix quadrant grid balance &amp; diagonal symmetry" Click="OnOutlineStatsAuditQuadrantGridBalanceClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80A;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="OutlineStatsAuditChevronProcessStrideGeometryItem" Text="Audit chevron &amp; arrow process flow stride proportionality &amp; phase length" Click="OnOutlineStatsAuditChevronProcessStrideGeometryClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72A;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="OutlineStatsAuditProcessSequencePacingItem" Text="Audit chevron &amp; linear process sequence pacing &amp; aspect ratio" Click="OnAuditProcessSequencePacingClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72A;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="AuditLinearFlowRhythmItem" Text="Audit chevron / linear flow arrowhead aspect ratio &amp; progression rhythm" Click="OnAuditLinearFlowRhythmClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE823;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="OutlineStatsAuditChevronGeometryItem" Text="Audit chevron / process arrow gap &amp; angle consistency" Click="OnOutlineStatsAuditChevronGeometryClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72A;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="OutlineStatsAuditChevronProcessMilestoneProgressionItem" Text="Audit chevron process milestone monotonic progression &amp; phase skips" Click="OnOutlineStatsAuditChevronProcessMilestoneProgressionClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72A;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="OutlineStatsAuditTargetBullseyeRingGeometryItem" Text="Audit concentric target &amp; bullseye ring radial symmetry &amp; label alignment" Click="OnOutlineStatsAuditTargetBullseyeRingGeometryClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEA3A;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="AuditContainerDensityItem" Text="Audit container slide width density &amp; overflow risk" Click="OnAuditContainerDensityClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE809;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="OutlineStatsAuditCycleProcessDirectionalityItem" Text="Audit cycle process flow closed-loop directionality &amp; arrow parity" Click="OnOutlineStatsAuditCycleProcessDirectionalityClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE895;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="OutlineStatsAuditCycleIntervalItem" Text="Audit cycle process interval uniformity &amp; radial chord balance" Click="OnOutlineStatsAuditCycleIntervalClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEA3A;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="AuditCyclicFlowContinuityItem" Text="Audit cyclic flow continuity &amp; loop closure" Click="OnAuditCyclicFlowContinuityClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="AuditCyclicConvergenceItem" Text="Audit cyclic process loop convergence &amp; recurrence closure" Click="OnAuditCyclicConvergenceClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="OutlineStatsAuditFunnelStageProportionalityItem" Text="Audit funnel / pipeline stage conversion rate proportionality" Click="OnOutlineStatsAuditFunnelStageProportionalityClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71C;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="OutlineStatsAuditFunnelPyramidProgressionItem" Text="Audit funnel/pyramid progression volume &amp; stage ingestion taper" Click="OnOutlineStatsAuditFunnelPyramidProgressionClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71C;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="OutlineStatsAuditGearMechanismGeometryItem" Text="Audit gear &amp; cogwheel intermeshing teeth, pitch radii &amp; kinematic loop" Click="OnOutlineStatsAuditGearMechanismGeometryClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="AuditBranchingFactorItem" Text="Audit hierarchy branching factor &amp; depth balance" Click="OnAuditBranchingFactorClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE809;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="AuditHierarchySpanItem" Text="Audit hierarchy span of control, branching &amp; manager ratios" Click="OnAuditHierarchySpanClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="OutlineStatsAuditHierarchyBranchingItem" Text="Audit hierarchy tree aspect ratio, branching balance &amp; fan ergonomics" Click="OnAuditHierarchyBranchingClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF158;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="OutlineStatsAuditHierarchyTreeFanOutRatioItem" Text="Audit hierarchy tree fan-out ratio &amp; management span of control" Click="OnOutlineStatsAuditHierarchyTreeFanOutRatioClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF003;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="AuditAspectRatioFitItem" Text="Audit layout aspect ratio &amp; container fit" Click="OnAuditAspectRatioFitClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xECAA;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="AuditTypographyFontFitItem" Text="Audit layout typography scaling, label font-fit &amp; text clipping" Click="OnAuditTypographyFontFitClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D2;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="OutlineAuditLineLengthsItem" Text="Audit line lengths (max 40 chars recommended)" Click="OnAuditOutlineLineLengthsClick">

<Window
    x:Class="MarkSmith.Views.SmartArtStudio.SmartArtDesignStudioWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:MarkSmith.Converters"
    mc:Ignorable="d"
    Title="SmartArt Design Studio">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" KeyDown="OnRootGridKeyDown">
        <Grid.Resources>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:LevelToIndentConverter x:Key="LevelToIndentConverter" />
            <conv:SelectedBrushConverter x:Key="SelectedBrushConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Command bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="52" Padding="16,0" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8FD;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="SmartArt Design Studio" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="Structure → Markdown → Word SmartArt" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Insert into document" Click="OnInsertIntoDocumentClick" Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Add this SmartArt as Markdown to the active document — it renders in the preview and becomes native Word SmartArt on DOCX export." />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" ColumnSpacing="12" Padding="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: layout gallery -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
                        <TextBlock Text="Layout Gallery" FontWeight="SemiBold" FontSize="14" />
                        <TextBox PlaceholderText="Search..." MaxHeight="32"
                                 Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding Alias}" FontSize="11" Opacity="0.6" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{ThemeResource SystemControlBackgroundAccentBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}" FontSize="9" Foreground="White" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- CENTER: the designer — outline editor + design toolbar -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Design toolbar -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Design" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Button Command="{Binding AddChildCommand}" ToolTipService.ToolTip="Add child under the selected node">
                                <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock Text="Child" /></StackPanel>
                            </Button>
                            <Button Command="{Binding AddSiblingCommand}" ToolTipService.ToolTip="Add sibling after the selected node">
                                <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE8FD;" FontSize="13" /><TextBlock Text="Sibling" /></StackPanel>
                            </Button>
                            <Button Command="{Binding BeginRenameCommand}" Click="OnRenameClick" ToolTipService.ToolTip="Rename (F2 or double-click)">
                                <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE70F;" FontSize="13" /><TextBlock Text="Rename" /></StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteSelectedCommand}" ToolTipService.ToolTip="Delete (Del)">
                                <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE74D;" FontSize="13" /><TextBlock Text="Delete" /></StackPanel>
                            </Button>
                            <AppBarSeparator />
                            <Button Command="{Binding MoveUpCommand}" ToolTipService.ToolTip="Move up"><FontIcon Glyph="&#xE70A;" FontSize="14" /></Button>
                            <Button Command="{Binding MoveDownCommand}" ToolTipService.ToolTip="Move down"><FontIcon Glyph="&#xE70B;" FontSize="14" /></Button>
                            <Button Command="{Binding PromoteCommand}" ToolTipService.ToolTip="Promote (outdent)"><FontIcon Glyph="&#xE76B;" FontSize="14" /></Button>
                            <Button Command="{Binding DemoteCommand}" ToolTipService.ToolTip="Demote (indent)"><FontIcon Glyph="&#xE76C;" FontSize="14" /></Button>
                            <AppBarSeparator />
                            <Button Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTipService.ToolTip="Undo (Ctrl+Z)"><FontIcon Glyph="&#xE7A7;" FontSize="14" /></Button>
                            <Button Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTipService.ToolTip="Redo (Ctrl+Y)"><FontIcon Glyph="&#xE7A6;" FontSize="14" /></Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Outline editor: one row per node, indented by depth; double-click or F2 to
                         rename inline; + button adds a child, ✕ deletes. -->
                    <ScrollViewer x:Name="OutlineScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding OutlineRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,4" Margin="{Binding Depth, Converter={StaticResource LevelToIndentConverter}}"
                                          Background="{Binding IsSelected, Converter={StaticResource SelectedBrushConverter}, ConverterParameter=themed}"
                                          PointerPressed="OnRowPointerPressed" DoubleTapped="OnRowDoubleTapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="▪" FontSize="11" Opacity="0.55"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" FontSize="13"
                                                   Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                        <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 KeyDown="OnRenameKeyDown" LostFocus="OnRenameLostFocus"
                                                 FontSize="13" Padding="4,2" MinHeight="26" />
                                        <Button Grid.Column="2" Click="OnRowAddChildClick" Padding="6,2" Margin="4,0,0,0"
                                                ToolTipService.ToolTip="Add child" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        </Button>
                                        <Button Grid.Column="3" Click="OnRowDeleteClick" Padding="6,2" Margin="2,0,0,0"
                                                ToolTipService.ToolTip="Delete" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT: live preview -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="12" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Live Preview" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    </Grid>
                    <WebView2 x:Name="PreviewWebView" Grid.Row="1" Margin="0" />
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom: markdown + status -->
        <Grid Grid.Row="2" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" Padding="16,8"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Expander Header="Markdown Data" HorizontalAlignment="Left" MinWidth="520">
                    <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150"
                             Text="{Binding MarkdownText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" FontSize="12" />
                </Expander>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

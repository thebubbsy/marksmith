                                    AutomationProperties.Name="Duplicate" ToolTipService.ToolTip="Duplicate (Ctrl+D · Right-click or Shift+F10 for options)">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                            <Button x:Name="DeleteButton" Style="{StaticResource ToolIconButton}" Command="{Binding DeleteSelectedCommand}" RightTapped="OnDeleteButtonRightTapped"
                                    IsEnabled="{Binding HasSelection}"
                                    AutomationProperties.Name="Delete" ToolTipService.ToolTip="Delete (Del · Right-click or Shift+F10 for options)">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                            <Rectangle Width="1" Height="20" Margin="2,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                            <Button x:Name="MoveUpButton" Style="{StaticResource ToolIconButton}" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}" AutomationProperties.Name="Move up" DoubleTapped="OnMoveUpButtonDoubleTapped" RightTapped="OnMoveUpButtonRightTapped" ToolTipService.ToolTip="Move up (Alt+Up · Double-click to move to top · Right-click or Shift+F10 for options)"><FontIcon Glyph="&#xE74A;" FontSize="14" /></Button>
                            <Button x:Name="MoveDownButton" Style="{StaticResource ToolIconButton}" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}" AutomationProperties.Name="Move down" DoubleTapped="OnMoveDownButtonDoubleTapped" RightTapped="OnMoveDownButtonRightTapped" ToolTipService.ToolTip="Move down (Alt+Down · Double-click to move to bottom · Right-click or Shift+F10 for options)"><FontIcon Glyph="&#xE74B;" FontSize="14" /></Button>
                            <Button x:Name="PromoteButton" Style="{StaticResource ToolIconButton}" Command="{Binding PromoteCommand}" IsEnabled="{Binding CanPromote}" AutomationProperties.Name="Promote" DoubleTapped="OnPromoteButtonDoubleTapped" RightTapped="OnPromoteButtonRightTapped" ToolTipService.ToolTip="Promote — move one level out (Shift+Tab · Double-click to promote to root · Right-click or Shift+F10 for options)"><FontIcon Glyph="&#xE76B;" FontSize="14" /></Button>
                            <Button x:Name="DemoteButton" Style="{StaticResource ToolIconButton}" Command="{Binding DemoteCommand}" IsEnabled="{Binding CanDemote}" AutomationProperties.Name="Demote" DoubleTapped="OnDemoteButtonDoubleTapped" RightTapped="OnDemoteButtonRightTapped" ToolTipService.ToolTip="Demote — move one level in (Tab · Double-click to demote to deepest level · Right-click or Shift+F10 for options)"><FontIcon Glyph="&#xE76C;" FontSize="14" /></Button>
                        </ui:WrapRow>

                        <!-- One row per item, indented by depth; double-click or F2 renames inline. The
                             row's own + / delete buttons are subtle (chrome on hover only) so a long
                             outline isn't a wall of boxed buttons. -->
                        <ScrollViewer x:Name="OutlineScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      IsTabStop="True" PreviewKeyDown="OnOutlineKeyDown" RightTapped="OnOutlineAreaRightTapped" AutomationProperties.Name="Outline"
                                      AutomationProperties.HelpText="Up and Down select · Alt+Up/Down move · Tab/Shift+Tab or Alt+Right/Left indent and outdent · Enter adds a sibling · Insert adds a child · Ctrl+D duplicates · F2 renames · Delete deletes">
                            <ItemsControl x:Name="OutlineItemsControl" ItemsSource="{Binding OutlineRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="{Binding Depth, Converter={StaticResource LevelToIndentConverter}, ConverterParameter=depth}" CornerRadius="4" Background="Transparent"
                                                services:HoverPolish.ApplyOnLoad="True"
                                                PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited">
                                            <Border.BackgroundTransition>
                                                <BrushTransition Duration="0:0:0.12" />
                                            </Border.BackgroundTransition>
                                            <Grid Padding="8,2,4,2" MinHeight="36" CornerRadius="4"
                                                  Background="{Binding IsSelected, Converter={StaticResource SelectedBrushConverter}, ConverterParameter=subtle}"
                                                  PointerPressed="OnRowPointerPressed" DoubleTapped="OnRowDoubleTapped" RightTapped="OnRowRightTapped"
                                                  PointerWheelChanged="OnRowPointerWheelChanged"
                                                  ToolTipService.ToolTip="Outline item · Drag to reorder · Double-click to rename · Alt+Wheel to move · Shift+Wheel to indent · Right-click for options"
                                                  AutomationProperties.Name="{Binding Text}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="6" Height="6" Margin="0,0,10,0" VerticalAlignment="Center"
                                                         Fill="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="True"
                                                         DoubleTapped="OnRowBulletDoubleTapped" RightTapped="OnRowBulletRightTapped"
                                                         ToolTipService.ToolTip="Hierarchy bullet (Double-click to toggle indent, Right-click for reorder &amp; hierarchy options)" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" FontSize="13"
                                                           Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                                <TextBox Grid.Column="1" AutomationProperties.Name="Item text" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                                         KeyDown="OnRenameKeyDown" LostFocus="OnRenameLostFocus"
                                                         DoubleTapped="OnRenameTextBoxDoubleTapped" Loaded="OnRenameTextBoxLoaded"
                                                         FontSize="13" Padding="6,3" MinHeight="28"
                                                         ToolTipService.ToolTip="Item text (Enter to commit · Esc to cancel · Double-click to select all · Right-click or Shift+F10 for casing options)" />
                                                <Button Grid.Column="2" Click="OnRowAddChildClick" Style="{StaticResource SubtleButtonStyle}" Width="30" Height="28" Padding="0" Margin="4,0,0,0"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                                        RightTapped="OnRowRightTapped"
                                                        AutomationProperties.Name="Add child" ToolTipService.ToolTip="Add child (Insert · Right-click for options)" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                                </Button>
                                                <Button Grid.Column="3" Click="OnRowDeleteClick" Style="{StaticResource SubtleButtonStyle}" Width="30" Height="28" Padding="0"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                                        RightTapped="OnRowRightTapped"
                                                        AutomationProperties.Name="Delete item" ToolTipService.ToolTip="Delete (Del · Right-click for options)" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                </Button>
                                                <Button Grid.Column="2" Click="OnRowCommitRenameClick" Style="{StaticResource SubtleButtonStyle}" Width="30" Height="28" Padding="0" Margin="4,0,0,0"
                                                        AllowFocusOnInteraction="False" IsTabStop="False"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        RightTapped="OnRowRightTapped"
                                                        AutomationProperties.Name="Commit rename" ToolTipService.ToolTip="Commit rename (Enter · Right-click for item options)" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                </Button>
                                                <Button Grid.Column="3" Click="OnRowCancelRenameClick" Style="{StaticResource SubtleButtonStyle}" Width="30" Height="28" Padding="0"
                                                        AllowFocusOnInteraction="False" IsTabStop="False"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        RightTapped="OnRowRightTapped"
                                                        AutomationProperties.Name="Cancel rename" ToolTipService.ToolTip="Cancel rename (Esc · Right-click for item options)" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty state: shown once every item has been deleted. -->
                        <StackPanel x:Name="OutlineEmptyPanel" Grid.Row="1" Spacing="10" MaxWidth="300" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="Transparent" IsHitTestVisible="True"
                                    DoubleTapped="OnOutlineEmptyPanelDoubleTapped"
                                    RightTapped="OnOutlineEmptyPanelRightTapped"
                                    ToolTipService.ToolTip="The outline is empty · Double-click to add first item, Right-click for starter diagram options"
                                    Visibility="{Binding IsOutlineEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xF003;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="The outline is empty" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Add a first item, then build it out with Child and Sibling — or paste bullets on the Markdown tab."
                                       Style="{StaticResource PaneCaption}" TextAlignment="Center" />
                            <Button Click="OnAddFirstNodeClick" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                   
                                    RightTapped="OnOutlineEmptyPanelRightTapped"
                                    ToolTipService.ToolTip="Add first item (Insert · Right-click for starter options)">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock Text="Add first item" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Markdown source -->
                    <Grid x:Name="MarkdownPanel" Grid.Row="1" Padding="12,8,12,12" RowSpacing="8" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Indented bullets — each indent is one level of the diagram. Edits here and in the outline stay in sync."
                                   Style="{StaticResource PaneCaption}" />
                        <TextBox x:Name="MarkdownTextBox" Grid.Row="1" AutomationProperties.Name="Markdown" AcceptsReturn="True" TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Text="{Binding MarkdownText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnMarkdownTextBoxKeyDown"
                                 PreviewKeyDown="OnMarkdownTextBoxPreviewKeyDown"
                                 DoubleTapped="OnMarkdownTextBoxDoubleTapped"
                                 ToolTipService.ToolTip="Indented Markdown bullets · Double-click to select all, Ctrl+Enter to insert into document, Right-click or Shift+F10 for options"
                                 FontFamily="Consolas" FontSize="13" />
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT: live preview -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                    RightTapped="OnPreviewPaneRightTapped">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- When the pane is too narrow for the layout name beside the tools (it read "O…"),
                         UpdatePreviewHeaderLayout moves the tools to a second row. -->
                    <Grid x:Name="PreviewHeaderGrid" Grid.Row="0" Padding="14,8,10,8" ColumnSpacing="8" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="8,8,0,0"
                          RightTapped="OnPreviewPaneRightTapped" SizeChanged="OnPreviewHeaderSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="PreviewHeaderLabel" Text="Preview" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        <!-- A button so Tab reaches the title's menu. Its double-click copied the diagram
                             block or the title depending on whether the outline was empty. -->
                        <HyperlinkButton x:Name="PreviewTitleButton" Grid.Column="1" Padding="4,0" MinHeight="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Click="OnPreviewTitleButtonClick" RightTapped="OnPreviewTitleButtonRightTapped"
                                         AutomationProperties.Name="{Binding PreviewTitle}"
                                         AutomationProperties.HelpText="Opens copy, refresh and palette options for the preview."
                                         ToolTipService.ToolTip="Preview diagram title · Click, right-click or Shift+F10 for copy and preview options">
                            <TextBlock x:Name="PreviewTitleLabel" Text="{Binding PreviewTitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </HyperlinkButton>
                        <StackPanel x:Name="PreviewHeaderTools" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button x:Name="PaletteButton" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="0"
                                    Click="OnPaletteButtonClick"
                                   
                                    RightTapped="OnPaletteButtonRightTapped"
                                    AutomationProperties.Name="Color palette"
                                    ToolTipService.ToolTip="Color palette (Right-click or Shift+F10 for options)">
                                <FontIcon Glyph="&#xE790;" FontSize="12" />
                                <Button.Flyout>
                                    <Flyout x:Name="PaletteFlyout" Placement="BottomEdgeAlignedRight" Opening="OnPaletteFlyoutOpening">
                                        <StackPanel Spacing="8" Width="260">
                                            <TextBlock Text="SmartArt colour palette" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Recolours the diagram SVG preview to match your document theme." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <ListView x:Name="PaletteList" SelectionMode="Single" Margin="-12,0" SelectionChanged="OnPaletteListSelectionChanged" AutomationProperties.Name="SmartArt colour palettes">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Padding="0,6" Spacing="6" AutomationProperties.Name="{Binding Name}">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="✓" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding Swatches}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Width="26" Height="12" CornerRadius="3" Background="{Binding}" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
                                            <TextBlock Text="Custom accent override" FontWeight="SemiBold" FontSize="12" />
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="CustomPaletteHexBox" PlaceholderText="#0078D4" FontSize="12" MaxLength="7"
                                                         TextChanged="OnCustomPaletteHexBoxTextChanged" KeyDown="OnCustomPaletteHexBoxKeyDown"
                                                         ToolTipService.ToolTip="Enter 6-digit hex color code (#RRGGBB)" />
                                                <Border Grid.Column="1" x:Name="CustomPaletteSwatch" Width="26" Height="26" CornerRadius="4"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                                        VerticalAlignment="Center" ToolTipService.ToolTip="Color preview swatch" />
                                                <Button Grid.Column="2" x:Name="ApplyCustomPaletteButton" Style="{StaticResource DefaultButtonStyle}"
                                                        Width="28" Height="28" Padding="0" Click="OnApplyCustomPaletteClick" ToolTipService.ToolTip="Apply custom accent to preview">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="11" />
                                                </Button>
                                                <Button Grid.Column="3" x:Name="ResetCustomPaletteButton" Style="{StaticResource DefaultButtonStyle}"
                                                        Width="28" Height="28" Padding="0" Click="OnResetCustomPaletteClick" ToolTipService.ToolTip="Reset to default theme palette">
                                                    <FontIcon Glyph="&#xE777;" FontSize="11" />
                                                </Button>
                                            </Grid>
                                            <TextBlock x:Name="CustomPaletteStatusText" Text="" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                       Visibility="Collapsed" />
                                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Harmony palette generator" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock x:Name="HarmonyModeLabel" Grid.Column="1" Text="Monochromatic" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button x:Name="HarmonyMonoBtn" Style="{StaticResource SubtleButtonStyle}" Padding="8,3" Height="26"
                                                        Click="OnHarmonyMonoClick" ToolTipService.ToolTip="Monochromatic harmony (stepped lightness)">
                                                    <TextBlock Text="Mono" FontSize="11" />
                                                </Button>
                                                <Button x:Name="HarmonyAnalogousBtn" Style="{StaticResource SubtleButtonStyle}" Padding="8,3" Height="26"
                                                        Click="OnHarmonyAnalogousClick" ToolTipService.ToolTip="Analogous harmony (adjacent ±30° hues)">
                                                    <TextBlock Text="Analogous" FontSize="11" />
                                                </Button>
                                                <Button x:Name="HarmonyTriadicBtn" Style="{StaticResource SubtleButtonStyle}" Padding="8,3" Height="26"
                                                        Click="OnHarmonyTriadicClick" ToolTipService.ToolTip="Triadic harmony (balanced 120° split hues)">
                                                    <TextBlock Text="Triadic" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                            <StackPanel x:Name="HarmonySwatchesPanel" Orientation="Horizontal" Spacing="4" Margin="0,2" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="CopyOutlineMarkdownButton" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="0"
                                    Click="OnCopyOutlineMarkdownClick"
                                   
                                    RightTapped="OnCopyOutlineMarkdownButtonRightTapped"
                                    AutomationProperties.Name="Copy outline bullets"
                                    ToolTipService.ToolTip="Copy indented outline bullets (Ctrl+C · Right-click or Shift+F10 for options)">
                                <FontIcon Glyph="&#xE8FD;" FontSize="12" />
                            </Button>
                            <Button x:Name="CopySmartArtBlockButton" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="0"
                                    Click="OnCopySmartArtBlockClick"
                                   
                                    RightTapped="OnCopySmartArtBlockButtonRightTapped"
                                    AutomationProperties.Name="Copy SmartArt Markdown"
                                    ToolTipService.ToolTip="Copy :::smartart Markdown block (Ctrl+Shift+C · Right-click or Shift+F10 for options)">
                                <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                            </Button>
                            <Button x:Name="ExportSvgButton" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="0"
                                    Click="OnExportSvgButtonClick"
                                   
                                    RightTapped="OnExportSvgButtonRightTapped"
                                    AutomationProperties.Name="Export SVG diagram"
                                    ToolTipService.ToolTip="Export SVG diagram (Right-click or Shift+F10 for resolution presets)">
                                <FontIcon Glyph="&#xEDE1;" FontSize="12" />
                                <Button.Flyout>
                                    <MenuFlyout x:Name="ExportSvgFlyout">
                                        <MenuFlyoutItem Text="Copy SVG (1x · Standard Web)" Click="OnCopySvg1xClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Copy SVG (2x · Retina / HiDPI)" Click="OnCopySvg2xClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Copy SVG (4x · Ultra HD 4K)" Click="OnCopySvg4xClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Copy SVG (Print 300 DPI)" Click="OnCopySvgPrintClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE749;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Save SVG file…" Click="OnSaveSvgFileClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Copy Data URI (base64)" Click="OnCopySvgDataUriClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="DiagramBgButton" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="0"
                                    Click="OnDiagramBgButtonClick"
                                   
                                    RightTapped="OnDiagramBgButtonRightTapped"
                                    AutomationProperties.Name="Diagram canvas background"
                                    ToolTipService.ToolTip="Diagram canvas background (Default Card, Dark Slate, Checkerboard, Dot Grid)">
                                <FontIcon Glyph="&#xE81E;" FontSize="12" />
                                <Button.Flyout>
                                    <MenuFlyout x:Name="DiagramBgFlyout">
                                        <MenuFlyoutItem x:Name="BgDefaultPaperItem" Text="Default Document Card (White)" Click="OnBgDefaultPaperClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="BgDarkSlateItem" Text="Dark Slate Slide (#0F172A)" Click="OnBgDarkSlateClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE708;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="BgCheckerboardItem" Text="Transparency Checkerboard" Click="OnBgCheckerboardClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF0E2;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="BgDotGridItem" Text="Blueprint Dot Grid" Click="OnBgDotGridClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80A;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="NodeGeometryButton" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="0"
                                    Click="OnNodeGeometryButtonClick"
                                   
                                    RightTapped="OnNodeGeometryButtonRightTapped"
                                    AutomationProperties.Name="Diagram node shape geometry"
                                    ToolTipService.ToolTip="Diagram node shape geometry (Default, Pill Rounded, Sharp Box, Soft Shadow, Contrast Borders)">
                                <FontIcon Glyph="&#xE7FB;" FontSize="12" />
                                <Button.Flyout>
                                    <MenuFlyout x:Name="NodeGeometryFlyout">
                                        <MenuFlyoutItem x:Name="GeomDefaultItem" Text="Default Layout Geometry" Click="OnGeomDefaultClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="GeomPillRoundedItem" Text="Pill Rounded (20px)" Click="OnGeomPillRoundedClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE944;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="GeomSharpBoxItem" Text="Sharp Box (0px)" Click="OnGeomSharpBoxClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C3;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="GeomModernSoftItem" Text="Modern Soft Shadow" Click="OnGeomModernSoftClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="GeomContrastBorderItem" Text="Bold Contrast Borders" Click="OnGeomContrastBorderClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="AspectRatioButton" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="0"
                                    Click="OnAspectRatioButtonClick"
                                   
                                    RightTapped="OnAspectRatioButtonRightTapped"
                                    AutomationProperties.Name="Diagram preview aspect ratio"
                                    ToolTipService.ToolTip="Diagram preview aspect ratio (Default, 16:9 Slide, 4:3 Document, 1:1 Square, 21:9 Banner)">
                                <FontIcon Glyph="&#xE799;" FontSize="12" />
                                <Button.Flyout>
                                    <MenuFlyout x:Name="AspectRatioFlyout">
                                        <MenuFlyoutItem x:Name="AspectDefaultItem" Text="Default Fluid Canvas" Click="OnAspectDefaultClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="Aspect16x9Item" Text="16:9 Widescreen Slide (PowerPoint)" Click="OnAspect16x9Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="Aspect4x3Item" Text="4:3 Standard Document Figure" Click="OnAspect4x3Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C3;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="Aspect1x1Item" Text="1:1 Square Card" Click="OnAspect1x1Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73B;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="Aspect21x9Item" Text="21:9 Ultrawide Banner" Click="OnAspect21x9Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE944;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="ZoomButton" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="0"
                                    Click="OnZoomButtonClick"
                                   
                                    RightTapped="OnZoomButtonRightTapped"
                                    AutomationProperties.Name="Diagram preview zoom"
                                    ToolTipService.ToolTip="Diagram preview zoom (Fit to View, 50%, 75%, 100%, 125%, 150%, 200% · Right-click to toggle Fit)">
                                <FontIcon Glyph="&#xE8A3;" FontSize="12" />
                                <Button.Flyout>
                                    <MenuFlyout x:Name="ZoomFlyout">
                                        <MenuFlyoutItem x:Name="ZoomFitItem" Text="Fit to View (Auto)" Click="OnZoomFitClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9A6;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="Zoom50Item" Text="50% Compact" Click="OnZoom50Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71F;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="Zoom75Item" Text="75%" Click="OnZoom75Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71F;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="Zoom100Item" Text="100% Actual Size (Default)" Click="OnZoom100Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="Zoom125Item" Text="125%" Click="OnZoom125Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A3;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="Zoom150Item" Text="150%" Click="OnZoom150Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A3;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="Zoom200Item" Text="200% High Detail" Click="OnZoom200Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE738;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <!-- Quick Layout Visual Thumbnail Strip -->
                    <Border x:Name="QuickLayoutCarouselBorder" Grid.Row="1"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                            Padding="8,4">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                            <Button x:Name="CarouselPrevButton" Click="OnCarouselPrevClick" Style="{StaticResource SubtleButtonStyle}"
                                    Width="24" Height="44" Padding="0" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Scroll layouts left" AutomationProperties.Name="Scroll layouts left">
                                <FontIcon Glyph="&#xE76B;" FontSize="10" />
                            </Button>
                            <ListView x:Name="QuickLayoutCarouselList" Grid.Column="1"
                                      ItemsSource="{Binding Layouts}"
                                      SelectedItem="{Binding SelectedLayout, Mode=TwoWay}"
                                      SelectionMode="Single"
                                      IsItemClickEnabled="True"
                                      ItemClick="OnCarouselLayoutItemClick"
                                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      ScrollViewer.HorizontalScrollMode="Enabled"
                                      ScrollViewer.VerticalScrollMode="Disabled">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <!-- The name sits under the thumbnail, not over it: the overlay hid the
                                             lower half of every miniature. -->
                                        <Grid Width="68" Margin="2,0" RowSpacing="2"
                                              ToolTipService.ToolTip="{Binding DisplayName}"
                                              AutomationProperties.Name="{Binding DisplayName}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="38" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Padding="2" CornerRadius="6"
                                                    Background="{ThemeResource SmartArtThumbTileBrush}"
                                                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                <Image Source="{Binding ThumbnailSvg, Converter={StaticResource SvgMarkupToImageSourceConverter}, ConverterParameter=96}"
                                                       Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding DisplayName}" FontSize="9" TextAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button x:Name="CarouselNextButton" Grid.Column="2" Click="OnCarouselNextClick" Style="{StaticResource SubtleButtonStyle}"
                                    Width="24" Height="44" Padding="0" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Scroll layouts right" AutomationProperties.Name="Scroll layouts right">
                                <FontIcon Glyph="&#xE76C;" FontSize="10" />
                            </Button>
                        </Grid>
                    </Border>
                    <InfoBar x:Name="PreviewHintBar" Grid.Row="2" Margin="12,10,12,0" Severity="Informational" IsClosable="False"
                             IsOpen="{Binding HasPreviewHint}" Message="{Binding PreviewHint}" AutomationProperties.LiveSetting="Polite" />
                    <Grid Grid.Row="3">
                        <WebView2 x:Name="PreviewWebView" Margin="0" />
                        <!-- Floating SVG Viewport Zoom Controls -->
                        <Border x:Name="PreviewZoomHudPill" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,16,16"
                                Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="4,2"
                                IsHitTestVisible="True"
                                ToolTipService.ToolTip="Preview zoom controls (Click/Double-click to reset, Right-click for presets)">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="PreviewZoomOutBtn" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="0"
                                        Click="OnPreviewZoomOutClick" ToolTipService.ToolTip="Zoom out (Ctrl+−)" AutomationProperties.Name="Zoom out preview">
                                    <FontIcon Glyph="&#xE71F;" FontSize="11" />
                                </Button>
                                <Button x:Name="PreviewZoomResetBtn" Style="{StaticResource SubtleButtonStyle}" MinWidth="46" Height="28" Padding="4,0"
                                        Click="OnPreviewZoomResetClick" RightTapped="OnPreviewZoomResetRightTapped"
                                        ToolTipService.ToolTip="Current zoom (Click to reset 100%, Right-click or Shift+F10 for presets)" AutomationProperties.Name="Reset preview zoom">
                                    <TextBlock x:Name="PreviewZoomFactorText" Text="100%" FontSize="11" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                                    <Button.Flyout>
                                        <MenuFlyout x:Name="PreviewZoomFlyout">
                                            <MenuFlyoutItem Text="50%" Click="OnPreviewZoomPresetClick" Tag="0.5" />
                                            <MenuFlyoutItem Text="75%" Click="OnPreviewZoomPresetClick" Tag="0.75" />
                                            <MenuFlyoutItem Text="100% (Actual size)" Click="OnPreviewZoomPresetClick" Tag="1.0" />
                                            <MenuFlyoutItem Text="125%" Click="OnPreviewZoomPresetClick" Tag="1.25" />
                                            <MenuFlyoutItem Text="150%" Click="OnPreviewZoomPresetClick" Tag="1.5" />
                                            <MenuFlyoutItem Text="200%" Click="OnPreviewZoomPresetClick" Tag="2.0" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Fit to preview width" Click="OnPreviewZoomFitWidthClick" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="PreviewZoomInBtn" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="0"
                                        Click="OnPreviewZoomInClick" ToolTipService.ToolTip="Zoom in (Ctrl++)" AutomationProperties.Name="Zoom in preview">
                                    <FontIcon Glyph="&#xE710;" FontSize="11" />
                                </Button>
                                <Rectangle Width="1" Height="16" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,0" VerticalAlignment="Center" />
                                <Button x:Name="PreviewZoomFitBtn" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="0"
                                        Click="OnPreviewZoomFitWidthClick" ToolTipService.ToolTip="Fit diagram in preview (Ctrl+0)" AutomationProperties.Name="Fit preview to width">
                                    <FontIcon Glyph="&#xE9A6;" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status -->
        <Grid Grid.Row="2" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" Padding="14,7"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="12"
              RightTapped="OnStatusBarRightTapped" DoubleTapped="OnStatusBarDoubleTapped"
              ToolTipService.ToolTip="SmartArt Studio status (Double-click to copy, Right-click for options)">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusBarText" Text="{Binding StatusMessage}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"
                       RightTapped="OnStatusBarRightTapped" DoubleTapped="OnStatusBarDoubleTapped" />
            <!-- A button so the keyboard reaches the outline menu (its double-click copy is the menu's
                 "Copy outline bullets", also Ctrl+C). -->
            <HyperlinkButton x:Name="OutlineSummaryButton" Grid.Column="1" Padding="4,0" Margin="0,-2" MinHeight="0" VerticalAlignment="Center"
                             Click="OnOutlineSummaryButtonClick" RightTapped="OnOutlineSummaryButtonRightTapped"
                             DoubleTapped="OnOutlineSummaryButtonDoubleTapped"
                             AutomationProperties.Name="{Binding OutlineSummaryText}"
                             AutomationProperties.HelpText="Opens copy and outline options."
                             ToolTipService.ToolTip="Outline summary · Click, right-click or Shift+F10 for copy and outline options">
                <TextBlock x:Name="OutlineSummaryLabel" Text="{Binding OutlineSummaryText}" FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </HyperlinkButton>
        </Grid>
    </Grid>
</Window>

<Window
    x:Class="MarkSmith.Views.SmartArtStudio.SmartArtDesignStudioWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:MarkSmith.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:MarkSmith.Converters"
    mc:Ignorable="d"
    Title="SmartArt Studio — MarkSmith">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" KeyDown="OnRootGridKeyDown">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="SmartArtThumbTileBrush" Color="#FFF8F9FA" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="SmartArtThumbTileBrush" Color="#FFEDEDF0" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
                <conv:LevelToIndentConverter x:Key="LevelToIndentConverter" />
                <conv:SelectedBrushConverter x:Key="SelectedBrushConverter" />
                <conv:SvgMarkupToImageSourceConverter x:Key="SvgMarkupToImageSourceConverter" />
                <Style x:Key="ToolIconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="0" />
                </Style>
                <Style x:Key="PaneCaption" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar + window commands -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="56" Padding="16,0" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xF003;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SmartArt Studio" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Write the outline, pick a layout — it exports as real, editable Word SmartArt"
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="UndoStudioButton" Style="{StaticResource ToolIconButton}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"
                        AutomationProperties.Name="Undo" ToolTipService.ToolTip="Undo (Ctrl+Z, Right-click for options)"
                        RightTapped="OnUndoButtonRightTapped"><FontIcon Glyph="&#xE7A7;" FontSize="14" /></Button>
                <Button x:Name="RedoStudioButton" Style="{StaticResource ToolIconButton}" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"
                        AutomationProperties.Name="Redo" ToolTipService.ToolTip="Redo (Ctrl+Y, Right-click for options)"
                        RightTapped="OnRedoButtonRightTapped"><FontIcon Glyph="&#xE7A6;" FontSize="14" /></Button>
                <Button x:Name="InsertIntoDocumentButton" Command="{Binding InsertIntoDocumentCommand}" Style="{StaticResource AccentButtonStyle}" Margin="4,0,0,0"
                        AutomationProperties.Name="Insert into document"
                        RightTapped="OnInsertIntoDocumentButtonRightTapped"
                        ToolTipService.ToolTip="Add this SmartArt to the open document (Ctrl+Enter, Right-click for options)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                        <TextBlock Text="Insert into document" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" ColumnSpacing="10" Padding="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="424" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: layout gallery -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="8" Padding="12,12,12,6">
                        <Grid>
                            <TextBlock Text="Layouts" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock x:Name="LayoutCountLabel" Text="{Binding LayoutCountText}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"
                                       IsHitTestVisible="True"
                                       DoubleTapped="OnLayoutCountLabelDoubleTapped"
                                       RightTapped="OnLayoutCountLabelRightTapped"
                                       ToolTipService.ToolTip="Layout count · Double-click to focus search or reset filter, right-click for layout options" />
                        </Grid>
                        <AutoSuggestBox x:Name="LayoutSearch" AutomationProperties.Name="Search layouts" PlaceholderText="Search layouts"
                                        QueryIcon="Find" TextChanged="OnLayoutSearchTextChanged" KeyDown="OnLayoutSearchKeyDown"
                                        DoubleTapped="OnLayoutSearchDoubleTapped"
                                        RightTapped="OnLayoutSearchRightTapped"
                                        ToolTipService.ToolTip="Search layouts by name or category (Double-click to select all, Right-click for options)" />
                        <ComboBox x:Name="LayoutCategoryCombo" AutomationProperties.Name="Layout type" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                  KeyDown="OnLayoutCategoryComboKeyDown"
                                  DoubleTapped="OnLayoutCategoryComboDoubleTapped"
                                  RightTapped="OnLayoutCategoryComboRightTapped"
                                  ToolTipService.ToolTip="Filter by layout category (Enter to browse, Esc to reset, Double-click to cycle, Right-click for options)" />
                    </StackPanel>
                    <ListView Grid.Row="1" x:Name="LayoutList" ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout, Mode=TwoWay}"
                              Padding="4,0,4,8" AutomationProperties.Name="Layouts" RightTapped="OnLayoutListRightTapped" KeyDown="OnLayoutListKeyDown"
                              DoubleTapped="OnLayoutListDoubleTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,7" ColumnSpacing="10" AutomationProperties.Name="{Binding DisplayName}"
                                      ToolTipService.ToolTip="{Binding AliasHint}"
                                      PointerEntered="OnLayoutTilePointerEntered" PointerExited="OnLayoutTilePointerExited"
                                      PointerPressed="OnLayoutTilePointerPressed" PointerReleased="OnLayoutTilePointerReleased">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- A live miniature of the layout's drawing (the same shapes the preview
                                         draws), on a light tile because the drawing's colours are made
                                         for a white page. -->
                                    <Border Width="64" Height="44" CornerRadius="6" Padding="4" CenterPoint="32,22,0"
                                            Background="{ThemeResource SmartArtThumbTileBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Border.ScaleTransition>
                                            <Vector3Transition Duration="0:0:0.14" />
                                        </Border.ScaleTransition>
                                        <Image Source="{Binding ThumbnailSvg, Converter={StaticResource SvgMarkupToImageSourceConverter}, ConverterParameter=112}"
                                               Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="NoMatchesPanel" Grid.Row="1" Spacing="6" Margin="16,24,16,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                                Background="Transparent" IsHitTestVisible="True"
                                RightTapped="OnNoMatchesPanelRightTapped"
                                ToolTipService.ToolTip="No matching layouts (Right-click for options)"
                                Visibility="{Binding HasNoLayoutMatches, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE721;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="NoMatchesTitleText" Text="No layouts match" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   RightTapped="OnNoMatchesPanelRightTapped" />
                        <TextBlock Text="Try a shorter term, set the type back to All, or search for &quot;cycle&quot; or &quot;pyramid&quot;." FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CENTER: Outline | Markdown -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <SelectorBar x:Name="EditorTabs" Margin="6,4,6,0" SelectionChanged="OnEditorTabsChanged"
                                 DoubleTapped="OnEditorTabsDoubleTapped"
                                 RightTapped="OnEditorTabsRightTapped">
                        <SelectorBarItem x:Name="OutlineTab" Text="Outline" IsSelected="True">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE8FD;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="MarkdownTab" Text="Markdown">
                            <SelectorBarItem.Icon><FontIcon Glyph="&#xE943;" /></SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>

                    <!-- Outline editor -->
                    <Grid x:Name="OutlinePanel" Grid.Row="1" Padding="10,6,10,10" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="OutlineToolbar" Orientation="Horizontal" Spacing="3"
                                    Background="Transparent" IsHitTestVisible="True"
                                    RightTapped="OnOutlineToolbarRightTapped"
                                    ToolTipService.ToolTip="Outline actions (Right-click for options)">
                            <Button Command="{Binding AddChildCommand}" Click="OnToolbarAddNodeClick" RightTapped="OnOutlineToolbarRightTapped" Height="32" Padding="9,0" ToolTipService.ToolTip="Add a child under the selected item (Insert, Right-click for options)">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock Text="Child" /></StackPanel>
                            </Button>
                            <Button Command="{Binding AddSiblingCommand}" Click="OnToolbarAddNodeClick" RightTapped="OnOutlineToolbarRightTapped" Height="32" Padding="9,0" ToolTipService.ToolTip="Add an item after the selected one, at the same level (Enter, Right-click for options)">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock Text="Sibling" /></StackPanel>
                            </Button>
                            <Rectangle Width="1" Height="20" Margin="4,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                            <Button x:Name="RenameButton" Style="{StaticResource ToolIconButton}" Click="OnRenameClick" DoubleTapped="OnRenameButtonDoubleTapped" RightTapped="OnRenameButtonRightTapped"
                                    IsEnabled="{Binding HasSelection}"
                                    AutomationProperties.Name="Rename" ToolTipService.ToolTip="Rename (F2 · Double-click to rename · Right-click for options)">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                            </Button>
                            <Button x:Name="DuplicateButton" Style="{StaticResource ToolIconButton}" Command="{Binding DuplicateSelectedCommand}" DoubleTapped="OnDuplicateButtonDoubleTapped" RightTapped="OnDuplicateButtonRightTapped"
                                    IsEnabled="{Binding HasSelection}"
                                    AutomationProperties.Name="Duplicate" ToolTipService.ToolTip="Duplicate (Ctrl+D · Double-click to duplicate branch · Right-click for options)">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                            <Button x:Name="DeleteButton" Style="{StaticResource ToolIconButton}" Command="{Binding DeleteSelectedCommand}" DoubleTapped="OnDeleteButtonDoubleTapped" RightTapped="OnDeleteButtonRightTapped"
                                    IsEnabled="{Binding HasSelection}"
                                    AutomationProperties.Name="Delete" ToolTipService.ToolTip="Delete (Del · Double-click to delete item and children · Right-click for options)">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                            <Rectangle Width="1" Height="20" Margin="4,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                            <Button x:Name="MoveUpButton" Style="{StaticResource ToolIconButton}" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}" AutomationProperties.Name="Move up" DoubleTapped="OnMoveUpButtonDoubleTapped" RightTapped="OnMoveUpButtonRightTapped" ToolTipService.ToolTip="Move up (Alt+Up · Double-click to move to top · Right-click for options)"><FontIcon Glyph="&#xE74A;" FontSize="14" /></Button>
                            <Button x:Name="MoveDownButton" Style="{StaticResource ToolIconButton}" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}" AutomationProperties.Name="Move down" DoubleTapped="OnMoveDownButtonDoubleTapped" RightTapped="OnMoveDownButtonRightTapped" ToolTipService.ToolTip="Move down (Alt+Down · Double-click to move to bottom · Right-click for options)"><FontIcon Glyph="&#xE74B;" FontSize="14" /></Button>
                            <Button x:Name="PromoteButton" Style="{StaticResource ToolIconButton}" Command="{Binding PromoteCommand}" IsEnabled="{Binding CanPromote}" AutomationProperties.Name="Promote" DoubleTapped="OnPromoteButtonDoubleTapped" RightTapped="OnPromoteButtonRightTapped" ToolTipService.ToolTip="Promote — move one level out (Shift+Tab · Double-click to promote to root · Right-click for options)"><FontIcon Glyph="&#xE76B;" FontSize="14" /></Button>
                            <Button x:Name="DemoteButton" Style="{StaticResource ToolIconButton}" Command="{Binding DemoteCommand}" IsEnabled="{Binding CanDemote}" AutomationProperties.Name="Demote" DoubleTapped="OnDemoteButtonDoubleTapped" RightTapped="OnDemoteButtonRightTapped" ToolTipService.ToolTip="Demote — move one level in (Tab · Double-click to demote to deepest level · Right-click for options)"><FontIcon Glyph="&#xE76C;" FontSize="14" /></Button>
                        </StackPanel>

                        <!-- One row per item, indented by depth; double-click or F2 renames inline. The
                             row's own + / delete buttons are subtle (chrome on hover only) so a long
                             outline isn't a wall of boxed buttons. -->
                        <ScrollViewer x:Name="OutlineScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      IsTabStop="True" PreviewKeyDown="OnOutlineKeyDown" RightTapped="OnOutlineAreaRightTapped" AutomationProperties.Name="Outline"
                                      AutomationProperties.HelpText="Up and Down select · Alt+Up/Down move · Tab/Shift+Tab or Alt+Right/Left indent and outdent · Enter adds a sibling · Insert adds a child · Ctrl+D duplicates · F2 renames · Delete deletes">
                            <ItemsControl x:Name="OutlineItemsControl" ItemsSource="{Binding OutlineRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="{Binding Depth, Converter={StaticResource LevelToIndentConverter}, ConverterParameter=depth}" CornerRadius="4" Background="Transparent"
                                                services:HoverPolish.ApplyOnLoad="True"
                                                PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited">
                                            <Border.BackgroundTransition>
                                                <BrushTransition Duration="0:0:0.12" />
                                            </Border.BackgroundTransition>
                                            <Grid Padding="8,2,4,2" MinHeight="36" CornerRadius="4"
                                                  Background="{Binding IsSelected, Converter={StaticResource SelectedBrushConverter}, ConverterParameter=subtle}"
                                                  PointerPressed="OnRowPointerPressed" DoubleTapped="OnRowDoubleTapped" RightTapped="OnRowRightTapped"
                                                  PointerWheelChanged="OnRowPointerWheelChanged"
                                                  ToolTipService.ToolTip="Outline item · Drag to reorder · Double-click to rename · Alt+Wheel to move · Shift+Wheel to indent · Right-click for options"
                                                  AutomationProperties.Name="{Binding Text}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="6" Height="6" Margin="0,0,10,0" VerticalAlignment="Center"
                                                         Fill="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="True"
                                                         DoubleTapped="OnRowBulletDoubleTapped" RightTapped="OnRowBulletRightTapped"
                                                         ToolTipService.ToolTip="Hierarchy bullet (Double-click to toggle indent, Right-click for reorder &amp; hierarchy options)" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" FontSize="13"
                                                           Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                                <TextBox Grid.Column="1" AutomationProperties.Name="Item text" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                                         KeyDown="OnRenameKeyDown" LostFocus="OnRenameLostFocus"
                                                         DoubleTapped="OnRenameTextBoxDoubleTapped" RightTapped="OnRenameTextBoxRightTapped"
                                                         FontSize="13" Padding="6,3" MinHeight="28"
                                                         ToolTipService.ToolTip="Item text (Enter to commit · Esc to cancel · Double-click to select all · Right-click for casing options)" />
                                                <Button Grid.Column="2" Click="OnRowAddChildClick" DoubleTapped="OnRowAddChildDoubleTapped" Style="{StaticResource SubtleButtonStyle}" Width="30" Height="28" Padding="0" Margin="4,0,0,0"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                                        RightTapped="OnRowRightTapped"
                                                        AutomationProperties.Name="Add child" ToolTipService.ToolTip="Add child (Insert · Double-click to add sibling · Right-click for options)" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                                </Button>
                                                <Button Grid.Column="3" Click="OnRowDeleteClick" DoubleTapped="OnRowDeleteDoubleTapped" Style="{StaticResource SubtleButtonStyle}" Width="30" Height="28" Padding="0"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                                        RightTapped="OnRowRightTapped"
                                                        AutomationProperties.Name="Delete item" ToolTipService.ToolTip="Delete (Del · Double-click to delete item and all children · Right-click for options)" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                </Button>
                                                <Button Grid.Column="2" Click="OnRowCommitRenameClick" Style="{StaticResource SubtleButtonStyle}" Width="30" Height="28" Padding="0" Margin="4,0,0,0"
                                                        AllowFocusOnInteraction="False" IsTabStop="False"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        RightTapped="OnRowRightTapped"
                                                        AutomationProperties.Name="Commit rename" ToolTipService.ToolTip="Commit rename (Enter · Right-click for item options)" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                </Button>
                                                <Button Grid.Column="3" Click="OnRowCancelRenameClick" Style="{StaticResource SubtleButtonStyle}" Width="30" Height="28" Padding="0"
                                                        AllowFocusOnInteraction="False" IsTabStop="False"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        RightTapped="OnRowRightTapped"
                                                        AutomationProperties.Name="Cancel rename" ToolTipService.ToolTip="Cancel rename (Esc · Right-click for item options)" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty state: shown once every item has been deleted. -->
                        <StackPanel x:Name="OutlineEmptyPanel" Grid.Row="1" Spacing="10" MaxWidth="300" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="Transparent" IsHitTestVisible="True"
                                    DoubleTapped="OnOutlineEmptyPanelDoubleTapped"
                                    RightTapped="OnOutlineEmptyPanelRightTapped"
                                    ToolTipService.ToolTip="The outline is empty · Double-click to add first item, Right-click for starter diagram options"
                                    Visibility="{Binding IsOutlineEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xF003;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="The outline is empty" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Add a first item, then build it out with Child and Sibling — or paste bullets on the Markdown tab."
                                       Style="{StaticResource PaneCaption}" TextAlignment="Center" />
                            <Button Click="OnAddFirstNodeClick" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                    DoubleTapped="OnOutlineEmptyPanelDoubleTapped"
                                    RightTapped="OnOutlineEmptyPanelRightTapped"
                                    ToolTipService.ToolTip="Add first item (Insert · Double-click to add, Right-click for starter options)">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="13" /><TextBlock Text="Add first item" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Markdown source -->
                    <Grid x:Name="MarkdownPanel" Grid.Row="1" Padding="12,8,12,12" RowSpacing="8" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Indented bullets — each indent is one level of the diagram. Edits here and in the outline stay in sync."
                                   Style="{StaticResource PaneCaption}" />
                        <TextBox x:Name="MarkdownTextBox" Grid.Row="1" AutomationProperties.Name="Markdown" AcceptsReturn="True" TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Text="{Binding MarkdownText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnMarkdownTextBoxKeyDown"
                                 DoubleTapped="OnMarkdownTextBoxDoubleTapped"
                                 RightTapped="OnMarkdownTextBoxRightTapped"
                                 ToolTipService.ToolTip="Indented Markdown bullets · Double-click to select all, Ctrl+Enter to insert into document, Right-click for options"
                                 FontFamily="Consolas" FontSize="13" />
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT: live preview -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                    RightTapped="OnPreviewPaneRightTapped">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="14,8,10,8" ColumnSpacing="8" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" CornerRadius="8,8,0,0"
                          RightTapped="OnPreviewPaneRightTapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Preview" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="PreviewTitleLabel" Grid.Column="1" Text="{Binding PreviewTitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="True"
                                   DoubleTapped="OnPreviewTitleLabelDoubleTapped"
                                   RightTapped="OnPreviewTitleLabelRightTapped"
                                   ToolTipService.ToolTip="Preview diagram title · Double-click to copy diagram Markdown, right-click for options" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button x:Name="PaletteButton" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="0"
                                    Click="OnPaletteButtonClick"
                                    DoubleTapped="OnPaletteButtonDoubleTapped"
                                    RightTapped="OnPaletteButtonRightTapped"
                                    AutomationProperties.Name="Color palette"
                                    ToolTipService.ToolTip="Color palette (Double-click to cycle palettes, Right-click for options)">
                                <FontIcon Glyph="&#xEA3B;" FontSize="12" />
                                <Button.Flyout>
                                    <Flyout x:Name="PaletteFlyout" Placement="BottomEdgeAlignedRight" Opening="OnPaletteFlyoutOpening">
                                        <StackPanel Spacing="8" Width="260">
                                            <TextBlock Text="SmartArt colour palette" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="Recolours the diagram SVG preview to match your document theme." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <ListView x:Name="PaletteList" SelectionMode="Single" Margin="-12,0" SelectionChanged="OnPaletteListSelectionChanged" AutomationProperties.Name="SmartArt colour palettes">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Padding="0,6" Spacing="6" AutomationProperties.Name="{Binding Name}">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="✓" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding Swatches}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Width="26" Height="12" CornerRadius="3" Background="{Binding}" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
                                            <TextBlock Text="Custom accent override" FontWeight="SemiBold" FontSize="12" />
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="CustomPaletteHexBox" PlaceholderText="#0078D4" FontSize="12" MaxLength="7"
                                                         TextChanged="OnCustomPaletteHexBoxTextChanged" KeyDown="OnCustomPaletteHexBoxKeyDown"
                                                         ToolTipService.ToolTip="Enter 6-digit hex color code (#RRGGBB)" />
                                                <Border Grid.Column="1" x:Name="CustomPaletteSwatch" Width="26" Height="26" CornerRadius="4"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                                        VerticalAlignment="Center" ToolTipService.ToolTip="Color preview swatch" />
                                                <Button Grid.Column="2" x:Name="ApplyCustomPaletteButton" Style="{StaticResource DefaultButtonStyle}"
                                                        Width="28" Height="28" Padding="0" Click="OnApplyCustomPaletteClick" ToolTipService.ToolTip="Apply custom accent to preview">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="11" />
                                                </Button>
                                                <Button Grid.Column="3" x:Name="ResetCustomPaletteButton" Style="{StaticResource DefaultButtonStyle}"
                                                        Width="28" Height="28" Padding="0" Click="OnResetCustomPaletteClick" ToolTipService.ToolTip="Reset to default theme palette">
                                                    <FontIcon Glyph="&#xE777;" FontSize="11" />
                                                </Button>
                                            </Grid>
                                            <TextBlock x:Name="CustomPaletteStatusText" Text="" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                       Visibility="Collapsed" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="CopyOutlineMarkdownButton" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="0"
                                    Click="OnCopyOutlineMarkdownClick"
                                    DoubleTapped="OnCopyOutlineMarkdownButtonDoubleTapped"
                                    RightTapped="OnCopyOutlineMarkdownButtonRightTapped"
                                    AutomationProperties.Name="Copy outline bullets"
                                    ToolTipService.ToolTip="Copy indented outline bullets (Ctrl+C · Double-click to copy, Right-click for options)">
                                <FontIcon Glyph="&#xE8FD;" FontSize="12" />
                            </Button>
                            <Button x:Name="CopySmartArtBlockButton" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="0"
                                    Click="OnCopySmartArtBlockClick"
                                    DoubleTapped="OnCopySmartArtBlockButtonDoubleTapped"
                                    RightTapped="OnCopySmartArtBlockButtonRightTapped"
                                    AutomationProperties.Name="Copy SmartArt Markdown"
                                    ToolTipService.ToolTip="Copy :::smartart Markdown block (Ctrl+Shift+C · Double-click to copy, Right-click for options)">
                                <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                            </Button>
                            <Button x:Name="ExportSvgButton" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="0"
                                    Click="OnExportSvgButtonClick"
                                    DoubleTapped="OnExportSvgButtonDoubleTapped"
                                    RightTapped="OnExportSvgButtonRightTapped"
                                    AutomationProperties.Name="Export SVG diagram"
                                    ToolTipService.ToolTip="Export SVG diagram (Double-click to copy 2x SVG, Right-click for resolution presets)">
                                <FontIcon Glyph="&#xEDE1;" FontSize="12" />
                                <Button.Flyout>
                                    <MenuFlyout x:Name="ExportSvgFlyout">
                                        <MenuFlyoutItem Text="Copy SVG (1x · Standard Web)" Click="OnCopySvg1xClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Copy SVG (2x · Retina / HiDPI)" Click="OnCopySvg2xClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Copy SVG (4x · Ultra HD 4K)" Click="OnCopySvg4xClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Copy SVG (Print 300 DPI)" Click="OnCopySvgPrintClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE749;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Save SVG file…" Click="OnSaveSvgFileClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Copy Data URI (base64)" Click="OnCopySvgDataUriClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <!-- Quick Layout Visual Thumbnail Strip -->
                    <Border x:Name="QuickLayoutCarouselBorder" Grid.Row="1"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                            Padding="8,4">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                            <Button x:Name="CarouselPrevButton" Click="OnCarouselPrevClick" Style="{StaticResource SubtleButtonStyle}"
                                    Width="24" Height="44" Padding="0" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Scroll layouts left" AutomationProperties.Name="Scroll layouts left">
                                <FontIcon Glyph="&#xE76B;" FontSize="10" />
                            </Button>
                            <ListView x:Name="QuickLayoutCarouselList" Grid.Column="1"
                                      ItemsSource="{Binding Layouts}"
                                      SelectedItem="{Binding SelectedLayout, Mode=TwoWay}"
                                      SelectionMode="Single"
                                      IsItemClickEnabled="True"
                                      ItemClick="OnCarouselLayoutItemClick"
                                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      ScrollViewer.HorizontalScrollMode="Enabled"
                                      ScrollViewer.VerticalScrollMode="Disabled">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="64" Height="42" Padding="2" Margin="2,0" CornerRadius="6"
                                              Background="{ThemeResource SmartArtThumbTileBrush}"
                                              BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                              ToolTipService.ToolTip="{Binding DisplayName}"
                                              AutomationProperties.Name="{Binding DisplayName}">
                                            <Image Source="{Binding ThumbnailSvg, Converter={StaticResource SvgMarkupToImageSourceConverter}, ConverterParameter=96}"
                                                   Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
                                            <Border VerticalAlignment="Bottom" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                                                    CornerRadius="0,0,5,5" Margin="-2,0,-2,-2" Padding="2,1">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="8.5" TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button x:Name="CarouselNextButton" Grid.Column="2" Click="OnCarouselNextClick" Style="{StaticResource SubtleButtonStyle}"
                                    Width="24" Height="44" Padding="0" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Scroll layouts right" AutomationProperties.Name="Scroll layouts right">
                                <FontIcon Glyph="&#xE76C;" FontSize="10" />
                            </Button>
                        </Grid>
                    </Border>
                    <InfoBar x:Name="PreviewHintBar" Grid.Row="2" Margin="12,10,12,0" Severity="Informational" IsClosable="False"
                             IsOpen="{Binding HasPreviewHint}" Message="{Binding PreviewHint}" AutomationProperties.LiveSetting="Polite" />
                    <Grid Grid.Row="3">
                        <WebView2 x:Name="PreviewWebView" Margin="0" />
                        <!-- Floating SVG Viewport Zoom Controls -->
                        <Border x:Name="PreviewZoomHudPill" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,16,16"
                                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="4,2"
                                IsHitTestVisible="True"
                                ToolTipService.ToolTip="Preview zoom controls (Click/Double-click to reset, Right-click for presets)">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="PreviewZoomOutBtn" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="0"
                                        Click="OnPreviewZoomOutClick" ToolTipService.ToolTip="Zoom out (Ctrl+−)" AutomationProperties.Name="Zoom out preview">
                                    <FontIcon Glyph="&#xE71F;" FontSize="11" />
                                </Button>
                                <Button x:Name="PreviewZoomResetBtn" Style="{StaticResource SubtleButtonStyle}" MinWidth="46" Height="28" Padding="4,0"
                                        Click="OnPreviewZoomResetClick" DoubleTapped="OnPreviewZoomResetDoubleTapped" RightTapped="OnPreviewZoomResetRightTapped"
                                        ToolTipService.ToolTip="Current zoom (Click to reset 100%, Right-click for presets)" AutomationProperties.Name="Reset preview zoom">
                                    <TextBlock x:Name="PreviewZoomFactorText" Text="100%" FontSize="11" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                                    <Button.Flyout>
                                        <MenuFlyout x:Name="PreviewZoomFlyout">
                                            <MenuFlyoutItem Text="50%" Click="OnPreviewZoomPresetClick" Tag="0.5" />
                                            <MenuFlyoutItem Text="75%" Click="OnPreviewZoomPresetClick" Tag="0.75" />
                                            <MenuFlyoutItem Text="100% (Actual size)" Click="OnPreviewZoomPresetClick" Tag="1.0" />
                                            <MenuFlyoutItem Text="125%" Click="OnPreviewZoomPresetClick" Tag="1.25" />
                                            <MenuFlyoutItem Text="150%" Click="OnPreviewZoomPresetClick" Tag="1.5" />
                                            <MenuFlyoutItem Text="200%" Click="OnPreviewZoomPresetClick" Tag="2.0" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Fit to preview width" Click="OnPreviewZoomFitWidthClick" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="PreviewZoomInBtn" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="0"
                                        Click="OnPreviewZoomInClick" ToolTipService.ToolTip="Zoom in (Ctrl++)" AutomationProperties.Name="Zoom in preview">
                                    <FontIcon Glyph="&#xE710;" FontSize="11" />
                                </Button>
                                <Rectangle Width="1" Height="16" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,0" VerticalAlignment="Center" />
                                <Button x:Name="PreviewZoomFitBtn" Style="{StaticResource SubtleButtonStyle}" Width="28" Height="28" Padding="0"
                                        Click="OnPreviewZoomFitWidthClick" ToolTipService.ToolTip="Fit diagram in preview (Ctrl+0)" AutomationProperties.Name="Fit preview to width">
                                    <FontIcon Glyph="&#xE9A6;" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status -->
        <Grid Grid.Row="2" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" Padding="14,7"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="12"
              RightTapped="OnStatusBarRightTapped" DoubleTapped="OnStatusBarDoubleTapped"
              ToolTipService.ToolTip="SmartArt Studio status (Double-click to copy, Right-click for options)">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusBarText" Text="{Binding StatusMessage}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"
                       RightTapped="OnStatusBarRightTapped" DoubleTapped="OnStatusBarDoubleTapped" />
            <TextBlock x:Name="OutlineSummaryLabel" Grid.Column="1" Text="{Binding OutlineSummaryText}" FontSize="12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"
                       IsHitTestVisible="True"
                       DoubleTapped="OnOutlineSummaryLabelDoubleTapped"
                       RightTapped="OnOutlineSummaryLabelRightTapped"
                       ToolTipService.ToolTip="Outline summary · Double-click to copy outline bullets, right-click for outline options" />
        </Grid>
    </Grid>
</Window>

                                    IsEnabled="{Binding HasSelection}"
                                    AutomationProperties.Name="Rename" ToolTipService.ToolTip="Rename (F2 · Right-click or Shift+F10 for options)">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                            </Button>
                            <Button x:Name="DuplicateButton" Style="{StaticResource ToolIconButton}" Command="{Binding DuplicateSelectedCommand}" RightTapped="OnDuplicateButtonRightTapped"

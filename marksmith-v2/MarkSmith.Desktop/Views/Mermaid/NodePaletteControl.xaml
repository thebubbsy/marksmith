<UserControl
    x:Class="MarkSmith.Views.Mermaid.NodePaletteControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:MarkSmith.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:MermaidShapeThumbnailConverter x:Key="ShapeThumb" />
    </UserControl.Resources>

    <Grid Background="#181825" Padding="12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header & Search -->
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Shape Palette" FontWeight="SemiBold" FontSize="14" Foreground="#EDF2F4" />
            <TextBox x:Name="SearchTextBox"
                     PlaceholderText="Search primitives…"
                     TextChanged="OnSearchTextChanged"
                     FontSize="12" />
        </StackPanel>

        <!-- Category SelectorBar Pills -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="6" Padding="0,2">
                <ToggleButton x:Name="CatAll" Content="All" IsChecked="True" Click="OnCategoryPillClick" Padding="10,4" CornerRadius="12" FontSize="11" />
                <ToggleButton x:Name="CatFlowchart" Content="Flowchart" Click="OnCategoryPillClick" Padding="10,4" CornerRadius="12" FontSize="11" />
                <ToggleButton x:Name="CatSequence" Content="Sequence" Click="OnCategoryPillClick" Padding="10,4" CornerRadius="12" FontSize="11" />
                <ToggleButton x:Name="CatClass" Content="Class" Click="OnCategoryPillClick" Padding="10,4" CornerRadius="12" FontSize="11" />
                <ToggleButton x:Name="CatState" Content="State" Click="OnCategoryPillClick" Padding="10,4" CornerRadius="12" FontSize="11" />
                <ToggleButton x:Name="CatGantt" Content="Gantt" Click="OnCategoryPillClick" Padding="10,4" CornerRadius="12" FontSize="11" />
                <ToggleButton x:Name="CatER" Content="ER" Click="OnCategoryPillClick" Padding="10,4" CornerRadius="12" FontSize="11" />
                <ToggleButton x:Name="CatMindmap" Content="Mindmap" Click="OnCategoryPillClick" Padding="10,4" CornerRadius="12" FontSize="11" />
            </StackPanel>
        </ScrollViewer>

        <!-- Palette Items List -->
        <ListView x:Name="PaletteListView"
                  Grid.Row="2"
                  ItemsSource="{Binding PaletteItems}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="OnPaletteItemClick"
                  CanDragItems="True"
                  DragItemsStarting="OnPaletteDragItemsStarting">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="#2B2D42"
                            BorderBrush="#3D405B"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,3"
                            PointerEntered="OnRowPointerEntered"
                            PointerExited="OnRowPointerExited"
                            PointerCanceled="OnRowPointerExited"
                            ToolTipService.ToolTip="Click to add to the middle of the canvas, or drag it where you want it">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- The shape itself, outlined, rather than a glyph that approximates it. -->
                            <Path Grid.Column="0" Width="20" Height="14" VerticalAlignment="Center"
                                  Data="{Binding ShapeType, Converter={StaticResource ShapeThumb}}"
                                  Stroke="#4CC9F0" StrokeThickness="1.4" StrokeLineJoin="Round" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#EDF2F4" />
                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#8D99AE" />
                            </StackPanel>
                            <!-- "+" says what a click does; it was a Play glyph, which suggested nothing. -->
                            <FontIcon Grid.Column="2" Glyph="&#xE710;" FontSize="12" Foreground="#8D99AE" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>

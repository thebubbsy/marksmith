<UserControl
    x:Class="MarkSmith.Views.Mermaid.MermaidDiagramStudioControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:MarkSmith.Converters"
    mc:Ignorable="d"
    RequestedTheme="Dark">

    <UserControl.Resources>
        <!-- Inspector color converters (hex string <-> Color / Brush) -->
        <conv:HexStringToColorConverter x:Key="HexToColor" />
        <conv:HexStringToBrushConverter x:Key="HexToBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- The Studio is always dark with a cyan accent, regardless of the user's Windows
             accent color (otherwise default-styled buttons/toggles bleed through purple or
             whatever the OS accent is, clashing with the grey main window). -->
        <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#4CC9F0" />
        <SolidColorBrush x:Key="SystemControlHighlightAltAccentBrush" Color="#4CC9F0" />
        <SolidColorBrush x:Key="SystemControlHighlightAltListAccentHighBrush" Color="#4CC9F0" />
        <SolidColorBrush x:Key="SystemControlHighlightAltListAccentLowBrush" Color="#334CC9F0" />
        <SolidColorBrush x:Key="SystemControlHighlightAltListAccentMediumBrush" Color="#664CC9F0" />
        <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#4CC9F0" />
        <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#334CC9F0" />
        <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#664CC9F0" />
        <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#4CC9F0" />
        <!-- Fluent accent fills (AccentButtonStyle, checked ToggleButtons) in the same cyan. -->
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4CC9F0" />
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E64CC9F0" />
        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC4CC9F0" />
        <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0D1B2A" />
        <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#1B2A3A" />

        <Style x:Key="InspectorSectionStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#4CC9F0" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="#1E1E2E">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="Z" Invoked="OnUndoAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Y" Invoked="OnRedoAcceleratorInvoked" />
            <!-- World-class editing shortcuts -->
            <KeyboardAccelerator Key="Delete" Invoked="OnDeleteAcceleratorInvoked" />
            <KeyboardAccelerator Key="Back" Invoked="OnDeleteAcceleratorInvoked" />
            <KeyboardAccelerator Key="F2" Invoked="OnRenameAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="D" Invoked="OnDuplicateAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="C" Invoked="OnCopyAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="C" Invoked="OnCopySvgAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="E" Invoked="OnExportSvgAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="V" Invoked="OnPasteAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="A" Invoked="OnSelectAllAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFindShapesAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Enter" Invoked="OnSyncAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Menu" Key="Enter" Invoked="OnFocusInspectorAcceleratorInvoked" />
            <KeyboardAccelerator Key="Tab" Invoked="OnTabCycleAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Shift" Key="Tab" Invoked="OnTabCycleAcceleratorInvoked" />
            <KeyboardAccelerator Key="Application" Invoked="OnContextMenuAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Shift" Key="F10" Invoked="OnContextMenuAcceleratorInvoked" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAcceleratorInvoked" />
            <!-- Arrow-key nudge (fine) and Shift+arrow (coarse) -->
            <KeyboardAccelerator Key="Left" Invoked="OnNudgeAcceleratorInvoked" />
            <KeyboardAccelerator Key="Right" Invoked="OnNudgeAcceleratorInvoked" />
            <KeyboardAccelerator Key="Up" Invoked="OnNudgeAcceleratorInvoked" />
            <KeyboardAccelerator Key="Down" Invoked="OnNudgeAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Shift" Key="Left" Invoked="OnNudgeAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Shift" Key="Right" Invoked="OnNudgeAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Shift" Key="Up" Invoked="OnNudgeAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Shift" Key="Down" Invoked="OnNudgeAcceleratorInvoked" />
            <!-- Zoom shortcuts -->
            <KeyboardAccelerator Modifiers="Control" Key="Add" Invoked="OnZoomInAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Subtract" Invoked="OnZoomOutAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Number0" Invoked="OnZoomResetAcceleratorInvoked" />
            <!-- Tab switching shortcuts -->
            <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="OnSelectShapesTabAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="OnSelectCodeTabAcceleratorInvoked" />
            <KeyboardAccelerator Modifiers="Control" Key="Number3" Invoked="OnSelectPreviewTabAcceleratorInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" /> <!-- App Title Bar Area -->
            <RowDefinition Height="48" /> <!-- Studio Toolbar (compact single-row controls) -->
            <RowDefinition Height="*" />  <!-- Main Workspace -->
            <RowDefinition Height="28" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Custom App Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="12,0,0,0" Background="#1E1E2E">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="Diagram Studio" FontWeight="SemiBold" FontSize="13" Foreground="#EDF2F4" VerticalAlignment="Center" />
                <TextBlock Text="·" Opacity="0.4" Foreground="#8D99AE" VerticalAlignment="Center" />
                <TextBlock Text="Draw it here, then sync it back into your document" FontSize="12" Foreground="#8D99AE" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Studio Toolbar -->
        <Border x:Name="StudioToolbar" Grid.Row="1" Background="#232334" BorderBrush="#2B2D42" BorderThickness="0,0,0,1" Padding="12,6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Tools (compact, icon-driven so the full set fits the default window) -->
                <StackPanel x:Name="DiagramToolsCluster" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            XYFocusKeyboardNavigation="Enabled" TabFocusNavigation="Once"
                            AutomationProperties.Name="Diagram tools">
                    <Button x:Name="TemplatesButton" Click="OnTemplatesClick" ToolTipService.ToolTip="Start from a template diagram (Right-click or Shift+F10 for options)"
                            RightTapped="OnTemplatesButtonRightTapped"
                            Background="#2B2D42" BorderBrush="#4CC9F0" BorderThickness="1" Foreground="#EDF2F4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="#4CC9F0" />
                            <TextBlock Text="Templates" FontSize="12" Foreground="#EDF2F4" />
                            <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="#8D99AE" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="AutoLayoutButton" Click="OnAutoLayoutClick" ToolTipService.ToolTip="Auto-arrange nodes (Right-click or Shift+F10 for layout options)"
                            AutomationProperties.Name="Auto-arrange nodes"
                            RightTapped="OnAutoLayoutButtonRightTapped"
                            Background="#2B2D42" BorderBrush="#8D99AE" BorderThickness="1" Foreground="#EDF2F4">
                        <FontIcon Glyph="&#xECA5;" FontSize="14" Foreground="#4CC9F0" />
                    </Button>

                    <!-- Snap to grid. A bare switch read "On" with no hint of what was on, so it's a
                         labelled toggle button in the same family as the rest of the toolbar. -->
                    <ToggleButton x:Name="GridSnapToggle"
                                  IsChecked="{Binding IsGridSnapEnabled, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Snap nodes to a 10 px grid while dragging (Right-click or Shift+F10 for options)"
                                  AutomationProperties.Name="Snap to grid"
                                  RightTapped="OnGridSnapToggleRightTapped"
                                  Background="#2B2D42" BorderBrush="#8D99AE" BorderThickness="1" Foreground="#EDF2F4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE80A;" FontSize="14" />
                            <TextBlock Text="Snap" FontSize="12" />
                        </StackPanel>
                    </ToggleButton>

                    <Button x:Name="DeleteSelectedButton" Click="OnDeleteSelectedClick" ToolTipService.ToolTip="Delete the selection (Del)"
                            AutomationProperties.Name="Delete selection" IsEnabled="False"
                            Background="#2B2D42" BorderBrush="#8D99AE" BorderThickness="1" Foreground="#EDF2F4">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#EF476F" />
                    </Button>

                    <!-- Align & Distribute flyout (draw.io / Whimsical parity). Acts on the
                         current multi-selection; each op is one undo step. -->
                    <Button x:Name="AlignButton" ToolTipService.ToolTip="Align &amp; distribute — select two or more nodes first (Right-click or Shift+F10 for options)"
                            AutomationProperties.Name="Align and distribute" IsEnabled="False"
                            RightTapped="OnAlignButtonRightTapped"
                            Background="#2B2D42" BorderBrush="#8D99AE" BorderThickness="1" Foreground="#EDF2F4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Width="14" Height="14" Data="M0.88,0.88 h1.31 v12.25 h-1.31 Z M3.5,3.06 h8.75 v2.62 h-8.75 Z M3.5,8.31 h5.25 v2.62 h-5.25 Z" Foreground="#4CC9F0" />
                            <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="#8D99AE" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Align Left" Click="OnAlignLeftClick">
                                    <MenuFlyoutItem.Icon><PathIcon Data="M1,1 h1.5 v14 h-1.5 Z M4,3.5 h10 v3 h-10 Z M4,9.5 h6 v3 h-6 Z" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Align Center" Click="OnAlignHCenterClick">
                                    <MenuFlyoutItem.Icon><PathIcon Data="M7.25,1 h1.5 v14 h-1.5 Z M2,3.5 h12 v3 h-12 Z M4,9.5 h8 v3 h-8 Z" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Align Right" Click="OnAlignRightClick">
                                    <MenuFlyoutItem.Icon><PathIcon Data="M13.5,1 h1.5 v14 h-1.5 Z M2,3.5 h10 v3 h-10 Z M6,9.5 h6 v3 h-6 Z" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Align Top" Click="OnAlignTopClick">
                                    <MenuFlyoutItem.Icon><PathIcon Data="M1,1 h14 v1.5 h-14 Z M3.5,4 h3 v10 h-3 Z M9.5,4 h3 v6 h-3 Z" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Align Middle" Click="OnAlignVMiddleClick">
                                    <MenuFlyoutItem.Icon><PathIcon Data="M1,7.25 h14 v1.5 h-14 Z M3.5,2 h3 v12 h-3 Z M9.5,4 h3 v8 h-3 Z" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Align Bottom" Click="OnAlignBottomClick">
                                    <MenuFlyoutItem.Icon><PathIcon Data="M1,13.5 h14 v1.5 h-14 Z M3.5,2 h3 v10 h-3 Z M9.5,6 h3 v6 h-3 Z" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Distribute Horizontally" Click="OnDistributeHClick">
                                    <MenuFlyoutItem.Icon><PathIcon Data="M1,1 h1.5 v14 h-1.5 Z M13.5,1 h1.5 v14 h-1.5 Z M6.5,4 h3 v8 h-3 Z" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Distribute Vertically" Click="OnDistributeVClick">
                                    <MenuFlyoutItem.Icon><PathIcon Data="M1,1 h14 v1.5 h-14 Z M1,13.5 h14 v1.5 h-14 Z M4,6.5 h8 v3 h-8 Z" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button x:Name="UndoToolbarButton" Click="OnUndoClick" IsEnabled="{Binding CanUndo}" ToolTipService.ToolTip="Undo (Ctrl+Z, Right-click or Shift+F10 for options)" AutomationProperties.Name="Undo"
                            RightTapped="OnUndoButtonRightTapped"
                            Background="#2B2D42" BorderBrush="#8D99AE" BorderThickness="1" Foreground="#EDF2F4">
                        <FontIcon Glyph="&#xE7A7;" FontSize="14" Foreground="#4CC9F0" />
                    </Button>

                    <Button x:Name="RedoToolbarButton" Click="OnRedoClick" IsEnabled="{Binding CanRedo}" ToolTipService.ToolTip="Redo (Ctrl+Y, Right-click or Shift+F10 for options)" AutomationProperties.Name="Redo"
                            RightTapped="OnRedoButtonRightTapped"
                            Background="#2B2D42" BorderBrush="#8D99AE" BorderThickness="1" Foreground="#EDF2F4">
                        <FontIcon Glyph="&#xE7A6;" FontSize="14" Foreground="#4CC9F0" />
                    </Button>

                    <!-- Flowchart layout direction (Top-Down / Left-Right / …) — emitted as
                         `flowchart TD|LR|…` and restored on load. Headerless + tooltip to stay compact. -->
                    <ComboBox x:Name="DirectionComboBox"
                              SelectedIndex="{Binding FlowchartDirectionIndex, Mode=TwoWay}"
                              ToolTipService.ToolTip="Flowchart layout direction"
                              AutomationProperties.Name="Layout direction"
                              Visibility="{Binding ShowsDirectionPicker, Converter={StaticResource BoolToVisConverter}}"
                              Width="132" Margin="4,0,0,0" VerticalAlignment="Center">
                        <ComboBoxItem Content="Top-Down" />
                        <ComboBoxItem Content="Left-Right" />
                        <ComboBoxItem Content="Bottom-Up" />
                        <ComboBoxItem Content="Right-Left" />
                    </ComboBox>

                    <!-- Connector curve routing (QODER task 5). Headerless + tooltip to stay compact. -->
                    <ComboBox x:Name="RoutingComboBox"
                              SelectedIndex="{Binding ConnectorRoutingIndex, Mode=TwoWay}"
                              ToolTipService.ToolTip="Connector routing (elbow, straight, curved)"
                              AutomationProperties.Name="Connector routing"
                              Visibility="{Binding ShowsRoutingPicker, Converter={StaticResource BoolToVisConverter}}"
                              Width="132" Margin="4,0,0,0" VerticalAlignment="Center">
                        <ComboBoxItem Content="Elbow (90°)" />
                        <ComboBoxItem Content="Straight" />
                        <ComboBoxItem Content="Curved" />
                    </ComboBox>
                </StackPanel>

                <!-- Zoom lives on the canvas overlay (−, %, +, Fit) and Ctrl+wheel; the toolbar slider
                     duplicated it and read a bare "1" for 100%. -->

                <!-- Right Actions (Export/Copy are icon-only; Sync keeps its label as the primary action) -->
                <StackPanel x:Name="DiagramActionCluster" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            XYFocusKeyboardNavigation="Enabled" TabFocusNavigation="Once" AutomationProperties.Name="Diagram studio actions">
                    <Button x:Name="ExportSvgButton" Click="OnExportSvgClick" ToolTipService.ToolTip="Export the canvas as an SVG file (Ctrl+Shift+E, Right-click or Shift+F10 for options)" AutomationProperties.Name="Export SVG (Ctrl+Shift+E)"
                            RightTapped="OnExportSvgButtonRightTapped"
                            Background="#2B2D42" BorderBrush="#8D99AE" BorderThickness="1" Foreground="#EDF2F4">
                        <FontIcon Glyph="&#xEDE1;" FontSize="14" Foreground="#4CC9F0" />
                    </Button>

                    <Button x:Name="CopySvgButton" Click="OnCopySvgClick" ToolTipService.ToolTip="Copy the diagram as SVG to the clipboard (Ctrl+Shift+C, Right-click or Shift+F10 for options)" AutomationProperties.Name="Copy SVG (Ctrl+Shift+C)"
                            RightTapped="OnCopySvgButtonRightTapped"
                            Background="#2B2D42" BorderBrush="#8D99AE" BorderThickness="1" Foreground="#EDF2F4">
                        <FontIcon x:Name="CopySvgIcon" Glyph="&#xE8C8;" FontSize="14" Foreground="#4CC9F0" />
                    </Button>

                    <!-- The window's one primary action: filled in the studio's cyan accent. -->
                    <Button x:Name="SyncToMarkdownButton" Click="OnSyncToMarkdownClick" ToolTipService.ToolTip="Write the diagram back into the document's Mermaid block (Ctrl+Enter, Right-click or Shift+F10 for options)"
                            RightTapped="OnSyncToMarkdownButtonRightTapped"
                            Style="{StaticResource AccentButtonStyle}" Foreground="#0D1B2A">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Sync to Markdown" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- Main Workspace (Palette | Canvas | Inspector) -->
        <Grid Grid.Row="2" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="200" />
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="280" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <!-- Left Pane: tabbed Shapes palette + Code editor (mermaid.live-style bidirectional
                 editing — type Mermaid and the canvas updates, drag on the canvas and the code
                 updates). -->
            <Border Grid.Column="0" Background="#1E1E2E" BorderBrush="#2B2D42" BorderThickness="0,0,1,0">
                <Pivot x:Name="LeftPanePivot" SelectedIndex="0" TabFocusNavigation="Once" AutomationProperties.Name="Left workspace panel tabs">
                    <Pivot.Resources>
                        <!-- Compact pivot headers to match the studio's dark chrome -->
                        <Style TargetType="PivotHeaderItem">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="#8D99AE" />
                            <Setter Property="Padding" Value="10,6" />
                        </Style>
                    </Pivot.Resources>
                    <PivotItem Header="Shapes" Margin="0,6,0,0">
                        <Border x:Name="PaletteContainer" />
                    </PivotItem>
                    <PivotItem Header="Code" Margin="0,6,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="CodeEditorTextBox"
                                     Grid.Row="0"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                     FontSize="12"
                                     Background="#181825"
                                     Foreground="#C8D3F5"
                                     BorderThickness="0"
                                     Padding="8"
                                     AutomationProperties.Name="Mermaid source code"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ToolTipService.ToolTip="Edit the Mermaid source; the canvas follows when you pause. Ctrl+Enter writes it to the document, Right-click or Shift+F10 for options" />
                            <Border Grid.Row="1" Background="#232334" Padding="8,4">
                                <!-- Wraps: clipboard errors carry the exception text and run wider than the pane. -->
                                <TextBlock x:Name="CodeStatusText" FontSize="10" Foreground="#8D99AE" TextWrapping="WrapWholeWords"
                                           AutomationProperties.LiveSetting="Polite"
                                           Text="Edits sync to the canvas automatically" />
                            </Border>
                        </Grid>
                    </PivotItem>
                    <!-- Rendered preview: the canonical mermaid.js output (exactly what lands in
                         the exported PDF/HTML), rendered offline by the bundled mermaid.min.js.
                         The WebView2 host is created lazily the first time this tab is opened. -->
                    <PivotItem Header="Preview" Tag="PREVIEW" Margin="0,6,0,0">
                        <Border x:Name="PreviewContainer" Background="#181825" />
                    </PivotItem>
                </Pivot>
            </Border>

            <!-- Center Pane: Canvas Workspace Container -->
            <Border x:Name="CanvasContainer" Grid.Column="1" />

            <!-- Right Pane: Property Inspector -->
            <Border Grid.Column="2" Background="#1E1E2E" BorderBrush="#2B2D42" BorderThickness="1,0,0,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Properties" FontWeight="SemiBold" FontSize="14" Foreground="#EDF2F4" />
                        <Rectangle Height="1" Fill="#2B2D42" />

                        <!-- Nothing selected: say what the panel is for instead of showing a column of
                             blank fields. The panels below show only for what is selected. -->
                        <StackPanel x:Name="InspectorEmptyState" Spacing="8" Padding="4,24,4,8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8B0;" FontSize="28" Foreground="#5A6478" HorizontalAlignment="Center" />
                            <TextBlock Text="Nothing selected" FontSize="13" FontWeight="SemiBold" Foreground="#EDF2F4" HorizontalAlignment="Center" />
                            <TextBlock Text="Click a node or connector to edit it. Drag from a node's anchor dot to another node to connect them; double-click or press F2 to rename."
                                       FontSize="12" Foreground="#8D99AE" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220" />
                        </StackPanel>

                        <!-- Node Inspector Panel -->
                        <StackPanel x:Name="NodeInspectorPanel" Spacing="10" Visibility="Collapsed">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Node" Style="{StaticResource InspectorSectionStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedNode.Id}" FontSize="11" Foreground="#8D99AE"
                                           FontFamily="Cascadia Mono, Consolas" IsTextSelectionEnabled="True"
                                           ToolTipService.ToolTip="The node's ID in the Mermaid source" />
                            </Grid>
                            <TextBox x:Name="NodeLabelTextBox"
                                     Header="Label"
                                     AutomationProperties.Name="Node label"
                                     Text="{Binding SelectedNode.LabelText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnInspectorInputKeyDown"
                                     ToolTipService.ToolTip="Node label (Esc or Ctrl+Enter returns to canvas)"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />

                            <!-- Tag is the stored shape name; Content is what people read. -->
                            <ComboBox x:Name="NodeShapeCombo" Header="Shape"
                                      AutomationProperties.Name="Node shape"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding SelectedNode.Shape, Mode=TwoWay}"
                                      KeyDown="OnInspectorInputKeyDown"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Rectangle" Tag="Rectangle" />
                                <ComboBoxItem Content="Rounded rectangle" Tag="RoundedRectangle" />
                                <ComboBoxItem Content="Stadium (pill)" Tag="Stadium" />
                                <ComboBoxItem Content="Subroutine" Tag="Subroutine" />
                                <ComboBoxItem Content="Circle" Tag="Circle" />
                                <ComboBoxItem Content="Decision (rhombus)" Tag="Rhombus" />
                                <ComboBoxItem Content="Hexagon" Tag="Hexagon" />
                                <ComboBoxItem Content="Database" Tag="CylindricalDatabase" />
                                <ComboBoxItem Content="Actor" Tag="Actor" />
                            </ComboBox>

                            <!-- Per-node Fill / Stroke color pickers -->
                            <Grid x:Name="NodeColorPickersCluster" ColumnSpacing="8"
                                      XYFocusKeyboardNavigation="Enabled" TabFocusNavigation="Once"
                                      AutomationProperties.Name="Node color pickers">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="NodeFillColorButton" Grid.Column="0" HorizontalAlignment="Stretch" Padding="8,6"
                                        Background="#2B2D42" BorderBrush="#8D99AE" BorderThickness="1"
                                        AutomationProperties.Name="Node fill color"
                                        ToolTipService.ToolTip="Node fill color">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3"
                                                   Fill="{Binding SelectedNode.FillColor, Converter={StaticResource HexToBrush}}"
                                                   Stroke="#8D99AE" StrokeThickness="1" />
                                        <TextBlock Text="Fill" FontSize="12" Foreground="#EDF2F4" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout Placement="Left">
                                            <ColorPicker Color="{Binding SelectedNode.FillColor, Mode=TwoWay, Converter={StaticResource HexToColor}}"
                                                         ColorSpectrumShape="Ring"
                                                         IsAlphaEnabled="False"
                                                         IsColorSliderVisible="True"
                                                         IsColorChannelTextInputVisible="False"
                                                         IsHexInputVisible="True"
                                                         IsMoreButtonVisible="False" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <Button x:Name="NodeBorderColorButton" Grid.Column="1" HorizontalAlignment="Stretch" Padding="8,6"
                                        Background="#2B2D42" BorderBrush="#8D99AE" BorderThickness="1"
                                        AutomationProperties.Name="Node border color"
                                        ToolTipService.ToolTip="Node border color">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3"
                                                   Fill="{Binding SelectedNode.StrokeColor, Converter={StaticResource HexToBrush}}"
                                                   Stroke="#8D99AE" StrokeThickness="1" />
                                        <TextBlock Text="Border" FontSize="12" Foreground="#EDF2F4" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout Placement="Left">
                                            <ColorPicker Color="{Binding SelectedNode.StrokeColor, Mode=TwoWay, Converter={StaticResource HexToColor}}"
                                                         ColorSpectrumShape="Ring"
                                                         IsAlphaEnabled="False"
                                                         IsColorSliderVisible="True"
                                                         IsColorChannelTextInputVisible="False"
                                                         IsHexInputVisible="True"
                                                         IsMoreButtonVisible="False" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="NodeXBox" Grid.Column="0" Header="X" AutomationProperties.Name="Node X"
                                           Value="{Binding SelectedNode.X, Mode=TwoWay}" SpinButtonPlacementMode="Hidden"
                                           KeyDown="OnInspectorSingleLineKeyDown" />
                                <NumberBox x:Name="NodeYBox" Grid.Column="1" Header="Y" AutomationProperties.Name="Node Y"
                                           Value="{Binding SelectedNode.Y, Mode=TwoWay}" SpinButtonPlacementMode="Hidden"
                                           KeyDown="OnInspectorSingleLineKeyDown" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="NodeWidthBox" Grid.Column="0" Header="Width" AutomationProperties.Name="Node width"
                                           Value="{Binding SelectedNode.Width, Mode=TwoWay}" Minimum="20" SpinButtonPlacementMode="Hidden"
                                           KeyDown="OnInspectorSingleLineKeyDown" />
                                <NumberBox x:Name="NodeHeightBox" Grid.Column="1" Header="Height" AutomationProperties.Name="Node height"
                                           Value="{Binding SelectedNode.Height, Mode=TwoWay}" Minimum="20" SpinButtonPlacementMode="Hidden"
                                           KeyDown="OnInspectorSingleLineKeyDown" />
                            </Grid>
                            <Button x:Name="FitNodeToLabelButton"
                                    Click="OnFitNodeToLabelClick"
                                    HorizontalAlignment="Stretch"
                                    Background="#2B2D42" BorderBrush="#8D99AE" BorderThickness="1" Foreground="#EDF2F4" Padding="8,6"
                                    AutomationProperties.Name="Fit node size to label"
                                    ToolTipService.ToolTip="Resize this shape to fit its label text">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE740;" FontSize="12" Foreground="#4CC9F0" />
                                    <TextBlock Text="Fit size to label" FontSize="12" Foreground="#EDF2F4" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Connector Inspector Panel -->
                        <StackPanel x:Name="ConnectorInspectorPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="Connector" Style="{StaticResource InspectorSectionStyle}" />
                            <!-- From -> To by node name (the ids are internal), with a one-click Reverse button in the middle. -->
                            <Grid x:Name="ConnectorEndpointsCluster" ColumnSpacing="6"
                                  XYFocusKeyboardNavigation="Enabled" TabFocusNavigation="Once"
                                  AutomationProperties.Name="Connector endpoint nodes">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#2B2D42" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="ConnectorFromText" FontSize="12" Foreground="#EDF2F4" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Button x:Name="ReverseConnectorButton" Grid.Column="1"
                                        Click="OnReverseConnectorClick"
                                        Padding="6,4" Background="#2B2D42" BorderBrush="#8D99AE" BorderThickness="1"
                                        AutomationProperties.Name="Reverse connector direction"
                                        ToolTipService.ToolTip="Reverse connector direction (swap source and target)">
                                    <FontIcon Glyph="&#xE8AB;" FontSize="12" Foreground="#4CC9F0" />
                                </Button>
                                <Border Grid.Column="2" Background="#2B2D42" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="ConnectorToText" FontSize="12" Foreground="#EDF2F4" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>
                            <TextBox x:Name="ConnectorLabelTextBox"
                                     Header="Label"
                                     AutomationProperties.Name="Connector label"
                                     Text="{Binding SelectedConnector.Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnInspectorSingleLineKeyDown"
                                     PlaceholderText="No label" />
                            <!-- Each Mermaid grammar has its own connector vocabulary; only the one
                                 for the current diagram type is shown (UpdateSelectionChrome). -->
                            <ComboBox x:Name="ConnectorLineCombo" Header="Line" SelectedValuePath="Tag" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Connector line style"
                                      KeyDown="OnInspectorInputKeyDown"
                                      SelectedValue="{Binding SelectedConnector.LineStyle, Mode=TwoWay}">
                                <ComboBoxItem Content="Solid" Tag="Solid" />
                                <ComboBoxItem Content="Dashed" Tag="Dashed" />
                                <ComboBoxItem Content="Thick" Tag="Thick" />
                            </ComboBox>
                            <ComboBox x:Name="ConnectorHeadCombo" Header="Arrow head" SelectedValuePath="Tag" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Connector arrow head"
                                      KeyDown="OnInspectorInputKeyDown"
                                      SelectedValue="{Binding SelectedConnector.EndHead, Mode=TwoWay}">
                                <ComboBoxItem Content="Arrow" Tag="Normal" />
                                <ComboBoxItem Content="None" Tag="None" />
                                <ComboBoxItem Content="Circle" Tag="Circle" />
                                <ComboBoxItem Content="Cross" Tag="Cross" />
                            </ComboBox>
                            <ComboBox x:Name="ConnectorMessageCombo" Header="Message" SelectedValuePath="Tag" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Sequence message type"
                                      KeyDown="OnInspectorInputKeyDown"
                                      SelectedValue="{Binding SelectedConnector.LineStyle, Mode=TwoWay}" Visibility="Collapsed">
                                <ComboBoxItem Content="Call (solid arrow)" Tag="SolidArrow" />
                                <ComboBoxItem Content="Reply (dashed arrow)" Tag="DashedArrow" />
                                <ComboBoxItem Content="Async (open arrow)" Tag="PointArrow" />
                                <ComboBoxItem Content="Async reply (dashed open arrow)" Tag="DashedPoint" />
                                <ComboBoxItem Content="Lost (cross)" Tag="CrossArrow" />
                                <ComboBoxItem Content="Lost reply (dashed cross)" Tag="DashedCross" />
                                <ComboBoxItem Content="Solid line" Tag="SolidOpen" />
                                <ComboBoxItem Content="Dashed line" Tag="DashedOpen" />
                            </ComboBox>
                            <ComboBox x:Name="ConnectorRelationCombo" Header="Relationship" SelectedValuePath="Tag" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Class relationship type"
                                      KeyDown="OnInspectorInputKeyDown"
                                      SelectedValue="{Binding SelectedConnector.EndHead, Mode=TwoWay}" Visibility="Collapsed">
                                <ComboBoxItem Content="Association" Tag="Association" />
                                <ComboBoxItem Content="Inheritance" Tag="Inheritance" />
                                <ComboBoxItem Content="Realization" Tag="Realization" />
                                <ComboBoxItem Content="Dependency" Tag="Dependency" />
                                <ComboBoxItem Content="Aggregation" Tag="Aggregation" />
                                <ComboBoxItem Content="Composition" Tag="Composition" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Style Presets (QODER task 5): one-click recolor of node fills, borders
                             and connector lines; the active choice is persisted as an %%{init}%%
                             directive on sync. -->
                        <Rectangle Height="1" Fill="#2B2D42" />
                        <StackPanel x:Name="DiagramStylePresetsCluster" Spacing="8"
                                    XYFocusKeyboardNavigation="Enabled" TabFocusNavigation="Once"
                                    AutomationProperties.Name="Style presets">
                            <TextBlock Text="Style presets" Style="{StaticResource InspectorSectionStyle}" />
                            <TextBlock Text="Recolours every node and connector." FontSize="11" Foreground="#8D99AE" TextWrapping="Wrap" />
                            <Button x:Name="PresetCatppuccin" Tag="Catppuccin Slate" Click="OnPalettePresetClick"
                                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                     AutomationProperties.Name="Catppuccin Slate style preset"
                                     Background="#2B2D42" BorderBrush="#8D99AE" BorderThickness="1" Padding="8,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="#313244" Stroke="#89B4FA" />
                                    <TextBlock Text="Catppuccin Slate" FontSize="12" Foreground="#EDF2F4" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PresetNord" Tag="Nord Ocean" Click="OnPalettePresetClick"
                                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                     AutomationProperties.Name="Nord Ocean style preset"
                                     Background="#2B2D42" BorderBrush="#8D99AE" BorderThickness="1" Padding="8,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="#2E3440" Stroke="#88C0D0" />
                                    <TextBlock Text="Nord Ocean" FontSize="12" Foreground="#EDF2F4" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PresetEmerald" Tag="Emerald Corporate" Click="OnPalettePresetClick"
                                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                     AutomationProperties.Name="Emerald Corporate style preset"
                                     Background="#2B2D42" BorderBrush="#8D99AE" BorderThickness="1" Padding="8,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="#062E23" Stroke="#34D399" />
                                    <TextBlock Text="Emerald Corporate" FontSize="12" Foreground="#EDF2F4" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PresetMono" Tag="Monochrome Print" Click="OnPalettePresetClick"
                                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                     AutomationProperties.Name="Monochrome Print style preset"
                                     Background="#2B2D42" BorderBrush="#8D99AE" BorderThickness="1" Padding="8,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="#FFFFFF" Stroke="#1F2937" />
                                    <TextBlock Text="Monochrome Print" FontSize="12" Foreground="#EDF2F4" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="3" Background="#232334" Padding="12,0" VerticalAlignment="Stretch"
                RightTapped="OnStatusBarRightTapped" DoubleTapped="OnStatusBarDoubleTapped"
                ToolTipService.ToolTip="Diagram Studio status · Double-click to fit the diagram, right-click for options">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusBarText" Grid.Column="0" Text="{Binding StatusText}" FontSize="11" Foreground="#8D99AE" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite"
                           IsHitTestVisible="True"
                           RightTapped="OnStatusBarRightTapped" />
                <!-- Filled from code: "3 nodes · 2 connectors · Snap on" (bare counts read as noise).
                     A button so the keyboard reaches it: Enter copies the summary, Shift+F10 / the Menu
                     key opens the status-bar menu (bridged). It used to be a double-click-only TextBlock. -->
                <Button x:Name="CanvasSummaryButton" Grid.Column="1" Height="22" Padding="6,0" MinWidth="0"
                        VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                        Click="OnCanvasSummaryClick" RightTapped="OnStatusBarRightTapped"
                        AutomationProperties.Name="Diagram canvas summary"
                        AutomationProperties.HelpText="Copies the diagram summary. Shift+F10 for status bar options."
                        ToolTipService.ToolTip="Diagram summary · Click to copy, right-click or Shift+F10 for options">
                    <!-- Not a live region: it changes with every edit, and the status line already reads out each one. -->
                    <TextBlock x:Name="CanvasSummaryText" FontSize="11" Foreground="#8D99AE" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl
    x:Class="MarkSmith.Views.Mermaid.MermaidCanvasControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:MarkSmith.Converters"
    xmlns:vm="using:MarkSmith.ViewModels.Mermaid"
    xmlns:local="using:MarkSmith.Views.Mermaid"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:ShapeToVisibilityConverter x:Key="ShapeVisConverter" />
        <conv:ShapeFallbackVisibilityConverter x:Key="ShapeFallbackVisConverter" />
        <conv:MermaidNodeCornerConverter x:Key="NodeCornerConverter" />
    </UserControl.Resources>

    <Grid x:Name="CanvasRootGrid" Background="#1E1E2E">
        <ScrollViewer x:Name="CanvasScrollViewer"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Hidden"
                      ZoomMode="Enabled"
                      MinZoomFactor="0.2"
                      MaxZoomFactor="4.0">

             <Grid x:Name="InfiniteCanvasGrid"
                  Width="4000"
                  Height="3000"
                  Background="Transparent"
                  AllowDrop="True"
                  DragOver="OnCanvasDragOver"
                  Drop="OnCanvasDrop"
                  PointerPressed="OnCanvasPointerPressed"
                  PointerMoved="OnCanvasPointerMoved"
                  PointerReleased="OnCanvasPointerReleased"
                  DoubleTapped="OnCanvasDoubleTapped">

                <!-- Layer 1: Background Grid Pattern -->
                <Canvas x:Name="GridPatternCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                <!-- Layer 2: Connector Lines Layer -->
                <ItemsControl x:Name="ConnectorsItemsControl" ItemsSource="{Binding Connectors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DiagramConnectorViewModel">
                            <!-- Everything a connector draws comes from DiagramConnectorViewModel /
                                 Core ConnectorAppearance: dash, weight, the marker on each end (the
                                 three Mermaid grammars store these differently), selection and hover. -->
                            <Canvas PointerEntered="OnConnectorPointerEntered" PointerExited="OnConnectorPointerExited">
                                <!-- Soft halo: hover and selection feedback -->
                                <Path Data="{Binding PathData}"
                                      Stroke="#4CC9F0"
                                      StrokeThickness="10"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Opacity="{Binding HaloOpacity}"
                                      IsHitTestVisible="False">
                                    <Path.OpacityTransition>
                                        <ScalarTransition Duration="0:0:0.12" />
                                    </Path.OpacityTransition>
                                </Path>

                                <!-- Wide invisible hit target: a 2 px line is too thin to click -->
                                <Path Data="{Binding PathData}"
                                      Stroke="Transparent"
                                      StrokeThickness="14"
                                      IsHitTestVisible="True" />

                                <!-- The line itself: solid or dashed -->
                                <Path Data="{Binding PathData}"
                                      Stroke="{Binding DisplayStroke}"
                                      StrokeThickness="{Binding DisplayStrokeWidth}"
                                      StrokeLineJoin="Round"
                                      Visibility="{Binding IsDashed, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}"
                                      IsHitTestVisible="False" />
                                <Path Data="{Binding PathData}"
                                      Stroke="{Binding DisplayStroke}"
                                      StrokeThickness="{Binding DisplayStrokeWidth}"
                                      StrokeDashArray="4,3"
                                      StrokeLineJoin="Round"
                                      Visibility="{Binding IsDashed, Converter={StaticResource BoolToVisConverter}}"
                                      IsHitTestVisible="False" />

                                <!-- End markers -->
                                <Path Data="{Binding StartMarkerData}"
                                      Fill="{Binding StartMarkerFill}"
                                      Stroke="{Binding DisplayStroke}"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      IsHitTestVisible="False" />
                                <Path Data="{Binding EndMarkerData}"
                                      Fill="{Binding EndMarkerFill}"
                                      Stroke="{Binding DisplayStroke}"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      IsHitTestVisible="False" />

                                <!-- Label, centred on the route's midpoint; only when there is one -->
                                <Grid Canvas.Left="{Binding MidpointX}"
                                      Canvas.Top="{Binding MidpointY}"
                                      Width="240" Height="80" Margin="-120,-40,0,0"
                                      Visibility="{Binding HasLabel, Converter={StaticResource BoolToVisConverter}}">
                                    <Border HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#2B2D42"
                                            BorderBrush="{Binding DisplayStroke}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="7,3">
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="220"
                                                   TextAlignment="Center"
                                                   Foreground="#EDF2F4" />
                                    </Border>
                                </Grid>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Layer 3: Diagram Nodes Layer -->
                <ItemsControl x:Name="NodesItemsControl" ItemsSource="{Binding Nodes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DiagramNodeViewModel">
                            <Grid Width="{Binding Width}"
                                  Height="{Binding Height}"
                                  Canvas.ZIndex="{Binding ZIndex}"
                                  IsHitTestVisible="True"
                                  Background="Transparent"
                                  PointerEntered="OnNodePointerEntered"
                                  PointerExited="OnNodePointerExited"
                                  Loaded="OnNodeTemplateLoaded">
                                <Grid.RenderTransform>
                                    <TranslateTransform X="{Binding X}" Y="{Binding Y}" />
                                </Grid.RenderTransform>

                                <!-- Connection Target Highlight Ring (bright pulse while a connector
                                     is being drawn and this node is the prospective drop target) -->
                                <Border BorderBrush="#4CC9F0"
                                        BorderThickness="3"
                                        Background="#224CC9F0"
                                        CornerRadius="14"
                                        Margin="-7"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding IsConnectionTarget, Converter={StaticResource BoolToVisConverter}}" />

                                <!-- Visual Selection Indicator Border -->
                                <Border BorderBrush="#4CC9F0"
                                        BorderThickness="2"
                                        Background="#144CC9F0"
                                        CornerRadius="12"
                                        Margin="-4"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}" />

                                <!-- Hover Glow Border (subtle lift on pointer-over) -->
                                <Border BorderBrush="#664CC9F0"
                                        BorderThickness="1.5"
                                        CornerRadius="12"
                                        Margin="-4"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding IsHovered, Converter={StaticResource BoolToVisConverter}}" />

                                <!-- Shapes Area -->
                                <Grid>
                                    <!-- Fallback / Rectangular Shapes: visible for any shape that does not
                                         have a dedicated visual below, so a node can never disappear. -->
                                    <Border Background="{Binding FillColor}"
                                            BorderBrush="{Binding StrokeColor}"
                                            BorderThickness="{Binding StrokeWidth}"
                                            CornerRadius="{Binding BoxCornerRadius, Converter={StaticResource NodeCornerConverter}}"
                                            Padding="10"
                                            Translation="0,0,12"
                                            Visibility="{Binding Shape, Converter={StaticResource ShapeFallbackVisConverter}, ConverterParameter='Circle,RootNode,Rhombus,RhombusDiamond,Choice,ChoiceState,Milestone,Hexagon,Actor,CylindricalDatabase,Start,End'}">
                                        <Border.Shadow>
                                            <ThemeShadow />
                                        </Border.Shadow>
                                        <TextBlock Text="{Binding LabelText}"
                                                   Foreground="{Binding LabelColor}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Subroutine: the inner side bars Mermaid draws for [[ ]] -->
                                    <Grid IsHitTestVisible="False"
                                          Visibility="{Binding Shape, Converter={StaticResource ShapeVisConverter}, ConverterParameter='Subroutine'}">
                                        <Border Width="{Binding StrokeWidth}" Background="{Binding StrokeColor}"
                                                HorizontalAlignment="Left" Margin="9,0,0,0" />
                                        <Border Width="{Binding StrokeWidth}" Background="{Binding StrokeColor}"
                                                HorizontalAlignment="Right" Margin="0,0,9,0" />
                                    </Grid>

                                    <!-- Circular Shape -->
                                    <Grid Visibility="{Binding Shape, Converter={StaticResource ShapeVisConverter}, ConverterParameter='Circle,RootNode'}">
                                        <Ellipse Fill="{Binding FillColor}"
                                                 Stroke="{Binding StrokeColor}"
                                                 StrokeThickness="{Binding StrokeWidth}" />
                                        <TextBlock Text="{Binding LabelText}"
                                                   Foreground="{Binding LabelColor}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <!-- Rhombus / Diamond / Choice Shape -->
                                    <Grid Visibility="{Binding Shape, Converter={StaticResource ShapeVisConverter}, ConverterParameter='Rhombus,RhombusDiamond,Choice,ChoiceState,Milestone'}">
                                        <Polygon Fill="{Binding FillColor}"
                                                 Stroke="{Binding StrokeColor}"
                                                 StrokeThickness="{Binding StrokeWidth}"
                                                 Points="50,0 100,50 50,100 0,50"
                                                 Stretch="Fill" />
                                        <TextBlock Text="{Binding LabelText}"
                                                   Foreground="{Binding LabelColor}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <!-- Hexagon Shape -->
                                    <Grid Visibility="{Binding Shape, Converter={StaticResource ShapeVisConverter}, ConverterParameter='Hexagon'}">
                                        <Polygon Fill="{Binding FillColor}"
                                                 Stroke="{Binding StrokeColor}"
                                                 StrokeThickness="{Binding StrokeWidth}"
                                                 Points="25,0 75,0 100,50 75,100 25,100 0,50"
                                                 Stretch="Fill" />
                                        <TextBlock Text="{Binding LabelText}"
                                                   Foreground="{Binding LabelColor}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <!-- State diagram [*]: UML start dot / end bullseye -->
                                    <Grid Visibility="{Binding Shape, Converter={StaticResource ShapeVisConverter}, ConverterParameter='Start'}">
                                        <Ellipse Fill="{Binding StrokeColor}" />
                                    </Grid>
                                    <Grid Visibility="{Binding Shape, Converter={StaticResource ShapeVisConverter}, ConverterParameter='End'}">
                                        <Ellipse Stroke="{Binding StrokeColor}" StrokeThickness="2" />
                                        <Ellipse Fill="{Binding StrokeColor}" Margin="6" />
                                    </Grid>

                                    <!-- Actor Shape -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding Shape, Converter={StaticResource ShapeVisConverter}, ConverterParameter='Actor'}">
                                        <FontIcon Glyph="&#xE77B;" FontSize="26" Foreground="{Binding StrokeColor}" />
                                        <TextBlock Text="{Binding LabelText}"
                                                   Foreground="#EDF2F4"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Cylindrical Database Shape: fills the node like every other shape
                                         (it was a 40 px icon with the label underneath, so resizing the
                                         node did nothing and the label sat outside it). -->
                                    <Grid Visibility="{Binding Shape, Converter={StaticResource ShapeVisConverter}, ConverterParameter='CylindricalDatabase'}">
                                        <Path Fill="{Binding FillColor}"
                                              Stroke="{Binding StrokeColor}"
                                              StrokeThickness="{Binding StrokeWidth}"
                                              Stretch="Fill"
                                              Data="M0,12 A50,12 0 0 1 100,12 V88 A50,12 0 0 1 0,88 Z M0,12 A50,12 0 0 0 100,12" />
                                        <TextBlock Text="{Binding LabelText}"
                                                   Foreground="{Binding LabelColor}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Margin="8,14,8,4"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Grid>

                                <!-- Anchor Handles Overlay (Top, Right, Bottom, Left) — revealed on
                                     hover/selection so the canvas stays clean at rest. -->
                                <Grid Width="26" Height="26" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-13,0,0" Tag="Top"
                                      Visibility="{Binding ShowAnchors, Converter={StaticResource BoolToVisConverter}}">
                                    <Ellipse Width="12" Height="12" Fill="#4CC9F0" Stroke="#1E1E2E" StrokeThickness="1" IsHitTestVisible="False" />
                                </Grid>
                                <Grid Width="26" Height="26" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-13,0" Tag="Right"
                                      Visibility="{Binding ShowAnchors, Converter={StaticResource BoolToVisConverter}}">
                                    <Ellipse Width="12" Height="12" Fill="#4CC9F0" Stroke="#1E1E2E" StrokeThickness="1" IsHitTestVisible="False" />
                                </Grid>
                                <Grid Width="26" Height="26" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-13" Tag="Bottom"
                                      Visibility="{Binding ShowAnchors, Converter={StaticResource BoolToVisConverter}}">
                                    <Ellipse Width="12" Height="12" Fill="#4CC9F0" Stroke="#1E1E2E" StrokeThickness="1" IsHitTestVisible="False" />
                                </Grid>
                                <Grid Width="26" Height="26" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-13,0,0,0" Tag="Left"
                                      Visibility="{Binding ShowAnchors, Converter={StaticResource BoolToVisConverter}}">
                                    <Ellipse Width="12" Height="12" Fill="#4CC9F0" Stroke="#1E1E2E" StrokeThickness="1" IsHitTestVisible="False" />
                                </Grid>

                                <!-- Resize Handles (corners, visible only when selected). Edge midpoints are
                                     reserved for the connector anchor dots above, so resizing lives on the four
                                     corners — the standard diagram-editor convention. -->
                                <Grid Width="16" Height="16" Background="Transparent" Tag="ResizeNW"
                                      HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-8,-8,0,0"
                                      Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}">
                                    <Rectangle Width="9" Height="9" Fill="#EDF2F4" Stroke="#4CC9F0" StrokeThickness="1.5" IsHitTestVisible="False" />
                                </Grid>
                                <Grid Width="16" Height="16" Background="Transparent" Tag="ResizeNE"
                                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0"
                                      Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}">
                                    <Rectangle Width="9" Height="9" Fill="#EDF2F4" Stroke="#4CC9F0" StrokeThickness="1.5" IsHitTestVisible="False" />
                                </Grid>
                                <Grid Width="16" Height="16" Background="Transparent" Tag="ResizeSW"
                                      HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-8,0,0,-8"
                                      Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}">
                                    <Rectangle Width="9" Height="9" Fill="#EDF2F4" Stroke="#4CC9F0" StrokeThickness="1.5" IsHitTestVisible="False" />
                                </Grid>
                                <Grid Width="16" Height="16" Background="Transparent" Tag="ResizeSE"
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-8,-8"
                                      Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}">
                                    <Rectangle Width="9" Height="9" Fill="#EDF2F4" Stroke="#4CC9F0" StrokeThickness="1.5" IsHitTestVisible="False" />
                                </Grid>

                                <!-- Quick-Add Hover Container with Opacity transition -->
                                <Grid x:Name="QuickAddHoverContainer"
                                      Background="Transparent"
                                      Opacity="0"
                                      IsHitTestVisible="True">


                                    <!-- Directional Quick-Add Buttons (Top, Right, Bottom, Left) -->
                                    <Button Width="22" Height="22" Padding="0" CornerRadius="11" Background="#2B2D42" BorderBrush="#4CC9F0" BorderThickness="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-26,0,0" Tag="Top" Click="OnQuickAddButtonClick">
                                        <TextBlock Text="▲" FontSize="9" Foreground="#4CC9F0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" CornerRadius="11" Background="#2B2D42" BorderBrush="#4CC9F0" BorderThickness="1"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-26,0" Tag="Right" Click="OnQuickAddButtonClick">
                                        <TextBlock Text="►" FontSize="9" Foreground="#4CC9F0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" CornerRadius="11" Background="#2B2D42" BorderBrush="#4CC9F0" BorderThickness="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-26" Tag="Bottom" Click="OnQuickAddButtonClick">
                                        <TextBlock Text="▼" FontSize="9" Foreground="#4CC9F0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" CornerRadius="11" Background="#2B2D42" BorderBrush="#4CC9F0" BorderThickness="1"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-26,0,0,0" Tag="Left" Click="OnQuickAddButtonClick">
                                        <TextBlock Text="◄" FontSize="9" Foreground="#4CC9F0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Layer 4: Interactive Draft Line Overlay Layer -->
                <Canvas x:Name="OverlayHandleCanvas" IsHitTestVisible="False">
                    <Path x:Name="DraftConnectorPath"
                          Stroke="#4CC9F0"
                          StrokeThickness="2"
                          StrokeDashArray="4,2"
                          Visibility="Collapsed" />
                    <Rectangle x:Name="RubberbandSelectionBox"
                               Fill="#334CC9F0"
                               Stroke="#4CC9F0"
                               StrokeThickness="1"
                               StrokeDashArray="3,3"
                               Visibility="Collapsed" />
                    <!-- Smart alignment guides (Figma/draw.io-style snap lines). Shown while a
                         node is dragged into edge/center alignment with a sibling node. -->
                    <Line x:Name="VerticalAlignGuide" Stroke="#FF6EC7" StrokeThickness="1"
                          StrokeDashArray="4,3" Visibility="Collapsed" />
                    <Line x:Name="HorizontalAlignGuide" Stroke="#FF6EC7" StrokeThickness="1"
                          StrokeDashArray="4,3" Visibility="Collapsed" />
                </Canvas>

                <!-- Layer 5: Floating Inline TextBox Editor -->
                <Canvas x:Name="InPlaceEditorCanvas" Visibility="Collapsed" Canvas.ZIndex="100">
                    <!-- Solid in every state: the default focused brushes are translucent, so the
                         node's own label showed through behind the text being edited. Same font
                         and centring as the node label, so editing doesn't jump the text around. -->
                    <TextBox x:Name="InlineEditTextBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             FontWeight="SemiBold"
                             FontSize="13"
                             Background="#2B2D42"
                             Foreground="#EDF2F4"
                             BorderBrush="#4CC9F0"
                             BorderThickness="2"
                             CornerRadius="6"
                             LostFocus="OnInlineEditLostFocus"
                             PreviewKeyDown="OnInlineEditKeyDown"
                             ToolTipService.ToolTip="Enter to save · Shift+Enter for a new line · Esc to cancel">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2B2D42" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2B2D42" />
                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#EDF2F4" />
                            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#EDF2F4" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#4CC9F0" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#4CC9F0" />
                            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#4CC9F0" />
                        </TextBox.Resources>
                    </TextBox>
                </Canvas>

            </Grid>
        </ScrollViewer>

        <!-- Empty-canvas hint: a blank dark slab gave no clue where to start. Click-through, and
             hidden as soon as the first node exists (EmptyCanvasHint in code-behind). -->
        <StackPanel x:Name="EmptyCanvasHint" IsHitTestVisible="False" Spacing="8" MaxWidth="340"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <FontIcon Glyph="&#xE9F9;" FontSize="34" Foreground="#4CC9F0" Opacity="0.85" />
            <TextBlock Text="Start your diagram" FontSize="16" FontWeight="SemiBold" Foreground="#EDF2F4"
                       HorizontalAlignment="Center" />
            <TextBlock Foreground="#8D99AE" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap"
                       Text="Click or drag a shape from the palette, double-click here to drop a node, or pick a starting point from Templates." />
        </StackPanel>

        <!-- Zoom Controls Overlay -->
        <Border HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Margin="20"
                Background="#2B2D42"
                CornerRadius="8"
                BorderBrush="#8D99AE"
                BorderThickness="1"
                Padding="4">
            <StackPanel Orientation="Horizontal">
                <Button Width="32" Height="32" Padding="0" Click="OnZoomOutClick" Background="Transparent" Foreground="#EDF2F4" BorderThickness="0" ToolTipService.ToolTip="Zoom out (Ctrl+wheel)" AutomationProperties.Name="Zoom out"><FontIcon Glyph="&#xE738;" FontSize="12" /></Button>
                <TextBlock x:Name="ZoomLevelText" Text="100%" VerticalAlignment="Center" Margin="8,0" Foreground="#EDF2F4" Width="45" TextAlignment="Center" ToolTipService.ToolTip="Canvas zoom level" />
                <Button Width="32" Height="32" Padding="0" Click="OnZoomInClick" Background="Transparent" Foreground="#EDF2F4" BorderThickness="0" ToolTipService.ToolTip="Zoom in (Ctrl+wheel)" AutomationProperties.Name="Zoom in"><FontIcon Glyph="&#xE710;" FontSize="12" /></Button>
                <Button Content="Fit" Width="40" Height="32" Click="OnZoomFitClick" Background="Transparent" Foreground="#EDF2F4" BorderThickness="0" Margin="4,0,0,0" ToolTipService.ToolTip="Fit the whole diagram in view" AutomationProperties.Name="Fit to content" />
            </StackPanel>
        </Border>

        <!-- Minimap overlay: a scaled-down overview of the whole diagram with the current viewport
             outlined. Click or drag on it to jump the canvas to that region. -->
        <local:MermaidMinimapControl x:Name="MinimapControl"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Bottom"
                                     Margin="20" />
    </Grid>
</UserControl>

<UserControl
    x:Class="MarkSmith.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:MarkSmith.Converters">

    <UserControl.Resources>
        <!-- Declared locally: this view is hosted inside a ContentDialog, so it can't rely on
             MainWindow's Grid.Resources being reachable for StaticResource lookups. -->
        <conv:BoolToVisibilityConverter x:Key="SettingsBoolToVisibilityConverter" />
    </UserControl.Resources>

    <!-- Tabbed so each concern gets its own page and nothing needs to scroll; Plugins in
         particular is expected to grow, so it lives apart from the always-there basics. -->
    <Pivot MinWidth="500" MaxWidth="500" Height="560">

        <!-- ===== General ===== -->
        <PivotItem Header="General">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" Margin="0,12,10,0">
                <Border Style="{StaticResource PipelineCardStyle}">
                    <Grid Padding="16,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Advanced mode" />
                            <TextBlock Text="Show power-user styling options in the Style panel — cleanup controls and formatting transforms."
                                       Style="{StaticResource StepCaptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{Binding AdvancedMode, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource PipelineCardStyle}">
                    <Grid Padding="16,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Pro mode" />
                            <TextBlock Text="Skip the interactive pickers — Insert ▸ Image drops the raw markdown placeholder straight into the editor instead of opening the drag &amp; drop / URL dialog."
                                       Style="{StaticResource StepCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{Binding ProMode, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource PipelineCardStyle}">
                    <Grid Padding="16,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Hardware acceleration" />
                            <TextBlock Text="Render the live preview on the GPU. Turn off to work around graphics-driver problems (black preview, flickering, crashes). Takes effect after you restart the app."
                                       Style="{StaticResource StepCaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{Binding HardwareAcceleration, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource PipelineCardStyle}">
                    <StackPanel Padding="16,12" Spacing="6">
                        <TextBlock Text="Export file name" />
                        <TextBlock Text="Template for generated file names. Tokens: {title}, {date}, {time}, {format}."
                                   Style="{StaticResource StepCaptionStyle}" />
                        <TextBox Text="{Binding FileNameTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{}{title}" IsSpellCheckEnabled="False" />
                        <TextBlock Text="Example: “{date} {title}” → 2026-07-24 My Report.pdf"
                                   Style="{StaticResource StepCaptionStyle}" Opacity="0.6" />
                    </StackPanel>
                </Border>

                <!-- Typography preset (Task 16) -->
                <Border Style="{StaticResource PipelineCardStyle}">
                    <StackPanel Padding="16,12" Spacing="6">
                        <TextBlock Text="Document font" FontWeight="SemiBold" />
                        <TextBlock Text="Fallback typography preset (only used when no document font is set — the document font field governs)"
                                   Style="{StaticResource StepCaptionStyle}" TextWrapping="Wrap" />
                        <ComboBox SelectedItem="{Binding FontPreset, Mode=TwoWay}" HorizontalAlignment="Stretch">
                            <x:String>System</x:String>
                            <x:String>Serif</x:String>
                            <x:String>Sans-Serif</x:String>
                            <x:String>Monospace</x:String>
                            <x:String>Dyslexic-friendly</x:String>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Export + behavior preferences -->
                <Border Style="{StaticResource PipelineCardStyle}">
                    <StackPanel Padding="16,12" Spacing="10">
                        <TextBlock Text="Export &amp; Behavior" FontWeight="SemiBold" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Default output format" Style="{StaticResource StepCaptionStyle}" />
                            <ComboBox SelectedItem="{Binding TargetFormat, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <x:String>docx</x:String>
                                <x:String>pdf</x:String>
                                <x:String>pptx</x:String>
                                <x:String>epub</x:String>
                            </ComboBox>
                            <TextBlock Text="Used by the browser extension, watch folder and quick-export shortcuts."
                                       Style="{StaticResource StepCaptionStyle}" Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="When a choice is ambiguous" Style="{StaticResource StepCaptionStyle}" />
                            <ComboBox SelectedIndex="{Binding AmbiguityMode, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <x:String>Always ask me</x:String>
                                <x:String>Use the default</x:String>
                                <x:String>Remember my choices</x:String>
                            </ComboBox>
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Check for updates on startup" />
                                <TextBlock Text="Poll GitHub Releases once at launch and notify you when a newer MarkSmith is available."
                                           Style="{StaticResource StepCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{Binding CheckForUpdatesOnStartup, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Automatically install updates on launch" />
                                <TextBlock Text="Download and install new versions silently in the background without installer prompts."
                                           Style="{StaticResource StepCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{Binding AutoInstallUpdatesOnLaunch, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Relaunch automatically after update" />
                                <TextBlock Text="Restart MarkSmith immediately when background installation finishes."
                                           Style="{StaticResource StepCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{Binding AutoRestartAfterUpdate, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Word count in preview" />
                                <TextBlock Text="Show the reading-time pill at the top of the live preview."
                                           Style="{StaticResource StepCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{Binding ShowWordCount, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- ===== PDF ===== -->
        <PivotItem Header="PDF">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Margin="0,12,10,0">
                    <!-- Page chrome: header / footer & page numbers (Task 10) -->
                    <Border Style="{StaticResource PipelineCardStyle}">
                        <StackPanel Padding="16,12" Spacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Header &amp; Footer / Page Numbers" FontWeight="SemiBold" />
                                <TextBlock Text="Add a running header and footer to PDF exports. Tokens: {title}, {page}, {pages}, {date}."
                                           Style="{StaticResource StepCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Page number position" Style="{StaticResource StepCaptionStyle}" />
                                <ComboBox SelectedItem="{Binding PdfPageNumberPosition, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                    <x:String>None</x:String>
                                    <x:String>BottomRight</x:String>
                                    <x:String>BottomCenter</x:String>
                                    <x:String>TopRight</x:String>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Header template" Style="{StaticResource StepCaptionStyle}" />
                                <TextBox Text="{Binding PdfHeaderTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="e.g. {title} — {date}" IsSpellCheckEnabled="False" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Footer template" Style="{StaticResource StepCaptionStyle}" />
                                <TextBox Text="{Binding PdfFooterTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="e.g. Page {page} of {pages}" IsSpellCheckEnabled="False" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock Text="Preview" Style="{StaticResource StepCaptionStyle}" Opacity="0.7" />
                                <TextBlock Text="{Binding PdfFooterPreview}" Style="{StaticResource StepCaptionStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: PDF Security — password protection + permissions (Task 18) -->
                    <Border Style="{StaticResource PipelineCardStyle}">
                        <StackPanel Padding="16,12" Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Password Protection" FontWeight="SemiBold" />
                                    <TextBlock Text="Encrypt the exported PDF and control who can open, print or edit it."
                                               Style="{StaticResource StepCaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding PdfEncrypt, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Spacing="8" Visibility="{Binding PdfEncrypt, Converter={StaticResource SettingsBoolToVisibilityConverter}}">
                                <PasswordBox Header="Open password (required to view)"
                                             Password="{Binding PdfUserPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Leave blank for no open password" />
                                <PasswordBox Header="Permissions password (required to change restrictions)"
                                             Password="{Binding PdfOwnerPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Auto-generated if left blank"
                                             ToolTipService.ToolTip="If you restrict permissions below but leave both passwords blank, a random owner password is generated automatically." />

                                <StackPanel Spacing="2">
                                    <TextBlock Text="Allowed actions" Style="{StaticResource StepCaptionStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <CheckBox Content="Print" IsChecked="{Binding PdfAllowPrinting, Mode=TwoWay}" />
                                        <CheckBox Content="Copy" IsChecked="{Binding PdfAllowCopying, Mode=TwoWay}" />
                                        <CheckBox Content="Modify" IsChecked="{Binding PdfAllowModifying, Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- ===== Automation ===== -->
        <PivotItem Header="Automation">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Margin="0,12,10,0">
                    <!-- Card 1: Local REST API Server -->
                    <Border Style="{StaticResource PipelineCardStyle}">
                        <StackPanel Padding="16,12" Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Local REST API server" FontWeight="SemiBold" />
                                    <TextBlock Text="Listens on loopback (127.0.0.1) for conversion requests from local scripts and browser extension."
                                               Style="{StaticResource StepCaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding ApiEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Spacing="4" Margin="0,4,0,0">
                                <TextBlock Text="API Port" Style="{StaticResource StepCaptionStyle}" />
                                <NumberBox Value="{Binding ApiPort, Mode=TwoWay}" Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Compact" Width="180" HorizontalAlignment="Left" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Cloud Storage Auto-Publish (Task 9) -->
                    <Border Style="{StaticResource PipelineCardStyle}">
                        <StackPanel Padding="16,12" Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Cloud Storage Sync" FontWeight="SemiBold" />
                                    <TextBlock Text="Mirror every export into a cloud drive. Uses the provider's own desktop sync client — no API keys needed for local providers."
                                               Style="{StaticResource StepCaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding CloudAutoPublish, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Provider" Style="{StaticResource StepCaptionStyle}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding CloudProviders}"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding CloudProviderId, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              PlaceholderText="Select a cloud drive…"
                                              HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Click="OnRescanCloud" ToolTipService.ToolTip="Re-scan this PC for cloud sync folders">
                                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Subfolder" Style="{StaticResource StepCaptionStyle}" />
                                <TextBox Text="{Binding CloudSubfolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Marksmith" IsSpellCheckEnabled="False" />
                                <TextBlock Text="Exports are saved into this folder inside your cloud drive."
                                           Style="{StaticResource StepCaptionStyle}" Opacity="0.6" />
                            </StackPanel>

                            <!-- WebDAV fields (shown when the user picks the WebDAV provider) -->
                            <StackPanel Spacing="4" Visibility="{Binding IsWebDavProvider, Converter={StaticResource SettingsBoolToVisibilityConverter}}">
                                <TextBlock Text="WebDAV Endpoint" Style="{StaticResource StepCaptionStyle}" />
                                <TextBox Text="{Binding WebDavEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="https://dav.example.com/remote.php/dav/files/user/" IsSpellCheckEnabled="False" />
                                <TextBlock Text="Username" Style="{StaticResource StepCaptionStyle}" />
                                <TextBox Text="{Binding WebDavUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="user@example.com" IsSpellCheckEnabled="False" />
                                <TextBlock Text="Token / Password" Style="{StaticResource StepCaptionStyle}" />
                                <PasswordBox Password="{Binding WebDavToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="App password or access token" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Browser Extension Connector & Extension ID Pairing -->
                    <Border Style="{StaticResource PipelineCardStyle}">
                        <StackPanel Padding="16,12" Spacing="10">
                            <TextBlock Text="Browser Extension Pairing Key" FontWeight="SemiBold" />
                            <TextBlock Text="Copy your Extension ID from the Chrome/Edge extension popup and paste it here to authorize 1-click prompt ingestion."
                                       Style="{StaticResource StepCaptionStyle}" TextWrapping="Wrap" />

                            <TextBox Text="{Binding AllowedExtensionId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Paste your Extension ID (e.g. ext-xxxx or Chrome Extension ID)"
                                     IsSpellCheckEnabled="False" />

                            <TextBlock Text="Leave blank to allow all local requests on loopback."
                                       Style="{StaticResource StepCaptionStyle}" Opacity="0.7" />
                        </StackPanel>
                    </Border>

                    <!-- Card 4: House-Style Template Import (Zero-Click Pipeline) -->
                    <Border Style="{StaticResource PipelineCardStyle}">
                        <StackPanel Padding="16,12" Spacing="10">
                            <TextBlock Text="Company House-Style Template" FontWeight="SemiBold" />
                            <TextBlock Text="Import a .dotx template to extract your brand colors and fonts. The extension sends the style summary to your web AI to generate a matching Marksmith theme."
                                       Style="{StaticResource StepCaptionStyle}" TextWrapping="Wrap" />
                            <Button Content="Import Company Template (.dotx)"
                                    IsEnabled="{Binding ExtensionConnected}"
                                    ToolTipService.ToolTip="Connect Marksmith Browser Extension to enable"
                                    Click="OnImportDotxClick" />
                            <TextBlock Text="{Binding HouseStyleStatus}" TextWrapping="Wrap"
                                       Style="{StaticResource StepCaptionStyle}"
                                       Visibility="{Binding HasHouseStyleStatus, Converter={StaticResource SettingsBoolToVisibilityConverter}}" />
                            <!-- Manual fallback: if the extension round-trip stalls, the user can copy
                                 this prompt into any web chat and paste the JSON reply back. -->
                            <TextBox Header="AI prompt (manual fallback — copy into your web chat)"
                                     Text="{Binding HouseStylePrompt, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                     MaxHeight="140" FontSize="12" IsSpellCheckEnabled="False"
                                     Visibility="{Binding HasHouseStylePrompt, Converter={StaticResource SettingsBoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- ===== License ===== -->
        <PivotItem Header="License">
            <StackPanel Spacing="14" Margin="0,12,0,0">
                <Border Style="{StaticResource PipelineCardStyle}">
                    <StackPanel Padding="16" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE734;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding EditionStatus}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="MarkSmith Pro unlocks DOCX export (with editable equations), hands-free automation, and removes the footer from your exports."
                                   Style="{StaticResource StepCaptionStyle}" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="KeyBox" PlaceholderText="Paste your license key" Width="290" IsSpellCheckEnabled="False" />
                            <Button x:Name="ActivateButton" Content="Activate" Click="OnActivateLicense"
                                    ToolTipService.ToolTip="Validate the key and unlock Pro features" />
                        </StackPanel>
                        <TextBlock x:Name="LicenseStatus" Text="" Style="{StaticResource StepCaptionStyle}"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed" />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Click="OnBuyPro" Style="{StaticResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="Open the MarkSmith Pro purchase page">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE719;" FontSize="14" />
                                    <TextBlock Text="Buy MarkSmith Pro" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DeactivateButton" Content="Remove license" Click="OnDeactivateLicense" Visibility="Collapsed"
                                    ToolTipService.ToolTip="Deactivate this PC — the key can be used on another machine" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </PivotItem>

        <!-- ===== Plugins ===== -->
        <PivotItem Header="Plugins">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Margin="0,12,10,0">
                    <TextBlock Text="Optional, separately-downloaded capabilities. Nothing here is bundled with MarkSmith — install only what you use."
                               Style="{StaticResource StepCaptionStyle}" TextWrapping="Wrap" />
                    <!-- One card per registered plugin, built in code-behind from App.Plugins.All
                         (manifest-driven — see MarkSmith.Core/Plugins). -->
                    <StackPanel x:Name="PluginsPanel" Spacing="10" />
                    <TextBlock x:Name="PluginWarnings" Text="" Style="{StaticResource StepCaptionStyle}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed" />
                    <HyperlinkButton Content="Browse more plugins &amp; write your own"
                                     NavigateUri="https://github.com/thebubbsy/MarkSmith-plugins" Padding="0" />
                </StackPanel>
            </ScrollViewer>
        </PivotItem>

        <!-- ===== About ===== -->
        <PivotItem Header="About">
            <StackPanel Spacing="14" Margin="0,12,0,0">
                <Border Style="{StaticResource PipelineCardStyle}">
                    <StackPanel Padding="16" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Image Source="ms-appx:///Assets/logo.png" Width="44" Height="44" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="MarkSmith" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock x:Name="VersionText" Text="Version 1.0.0"
                                           Style="{StaticResource StepCaptionStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Turn AI chats into polished documents." Opacity="0.8" />

                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button x:Name="CheckButton" Click="OnCheckForUpdates"
                                    ToolTipService.ToolTip="Check GitHub for a newer MarkSmith release">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE895;" FontSize="14" />
                                    <TextBlock Text="Check for updates" />
                                </StackPanel>
                            </Button>
                            <ProgressRing x:Name="CheckRing" IsActive="False" Width="18" Height="18" />
                        </StackPanel>
                        <TextBlock x:Name="UpdateStatus" Text="" Style="{StaticResource StepCaptionStyle}"
                                   IsTextSelectionEnabled="True" TextWrapping="Wrap" Visibility="Collapsed" />
                        <HyperlinkButton x:Name="DownloadLink" Content="Download the latest release"
                                         Visibility="Collapsed" Padding="0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PipelineCardStyle}">
                    <StackPanel Padding="8,4">
                        <HyperlinkButton Content="GitHub repository" NavigateUri="https://github.com/thebubbsy/MarkSmith" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                        <HyperlinkButton Content="Releases &amp; changelog" NavigateUri="https://github.com/thebubbsy/MarkSmith/releases" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                        <HyperlinkButton Content="Report an issue" NavigateUri="https://github.com/thebubbsy/MarkSmith/issues" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                        <HyperlinkButton Content="License agreement (EULA)" NavigateUri="https://github.com/thebubbsy/MarkSmith/blob/main/LICENSE" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                        <HyperlinkButton Content="Third-party notices" NavigateUri="https://github.com/thebubbsy/MarkSmith/blob/main/THIRD-PARTY-NOTICES.md" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                        <!-- ISS-008: tip jar for the project. -->
                        <HyperlinkButton Content="☕ Buy Me a Coffee — support development" NavigateUri="https://buymeacoffee.com/marksmith" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                    </StackPanel>
                </Border>

                <TextBlock Text="© 2026 thebubbsy · All rights reserved · Built with WinUI 3, .NET 8 and WebView2"
                           Style="{StaticResource StepCaptionStyle}" HorizontalAlignment="Center" />
            </StackPanel>
        </PivotItem>
    </Pivot>
</UserControl>


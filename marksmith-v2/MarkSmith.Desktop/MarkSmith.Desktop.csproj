<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MarkSmith.Desktop</RootNamespace>
    <!-- Ship the binary as Marksmith.exe -->
    <AssemblyName>Marksmith</AssemblyName>
    <!-- Versioning scheme (see docs/VERSIONING.md + Directory.Build.props):
         * <Version> is a SemVer PRERELEASE for every local build: "2.18.0-dev.<utc-revision>".
           The prerelease suffix (a) sorts below the future stable 2.18.0 yet above every lower
           stable tag, so a dev copy never looks "outdated" against the last release, and (b) is
           the marker UpdateService.IsDevelopmentBuild uses to short-circuit update checks —
           dev builds are compared against nothing on the releases feed.
         * The revision is a UTC timestamp (MddHHmm — unique per minute, monotonic within a year),
           so EVERY dev build gets its own increasing number and the About screen, the updater and
           the running binary always agree.
         * <AssemblyVersion> stays a plain four-part value because Roslyn rejects components above
           9999 there; <FileVersion> keeps a numeric four-part form for the Win32 version resource.
         * Release builds override all of this via -p:Version=<tag> in release.yml, which wipes the
           -dev suffix too: shipped installers carry clean SemVer (e.g. 2.17.0). -->
    <BuildRevision>$([System.DateTime]::UtcNow.ToString("MddHHmm"))</BuildRevision>
    <Version>$(MarksmithBaseVersion)-dev.$(BuildRevision)</Version>
    <AssemblyVersion>$(MarksmithBaseVersion).0</AssemblyVersion>
    <FileVersion>$(MarksmithBaseVersion).$(BuildRevision)</FileVersion>
    <!-- Embedded into the exe (Explorer/taskbar); the runtime title-bar icon is set via
         AppWindow.SetIcon in MainWindow, which needs the .ico copied to the output folder. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!-- WindowsAppSDKSelfContained needs a concrete architecture; default plain
         `dotnet build`/`dotnet run` (AnyCPU) to x64 so they work without extra flags. -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(Platform)</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Required true even for unpackaged apps: gates the PRI-generation targets that produce
         resources.pri (the compiled XAML the app loads at startup). With this false, the app
         builds fine but dies at launch with XamlParseException because resources.pri is missing. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK: WinUI 3 controls, XAML compiler, Mica/Acrylic backdrops -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <!-- Chromium rendering engine used for live preview + PDF export (CoreWebView2.PrintToPdfAsync) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
    <!-- MVVM source generators: [ObservableProperty], [RelayCommand] -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <!-- Markdown -> HTML, mirrors markdown-it-py + front-matter/footnote/table plugins on the Python side -->
    <PackageReference Include="Markdig" Version="0.37.0" />
    <!-- Native DOCX generation (no pandoc dependency) — see DocxExportService.cs -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <!-- System tray icon (WinUI 3 has no built-in NotifyIcon) -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\tray.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\tray.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\LaunchVideo.mp4" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\splash_video.mp4" CopyToOutputDirectory="PreserveNewest" />
    <!-- Bundled web assets (mermaid, KaTeX + fonts, highlight.js) served offline via a WebView2
         virtual host — no CDN calls, works without internet, faster preview. -->
    <Content Include="Assets\web\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unified Core Engine (Models/Services/ViewModels/SmartArt) -->
    <ProjectReference Include="..\MarkSmith.Core\MarkSmith.Core.csproj" />
  </ItemGroup>

</Project>

<UserControl
    x:Class="MarkSmith.Controls.SettingsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One Settings row in the Windows 11 Settings shape: icon, title and description on the left,
         the setting's control right-aligned in its own column, optional details underneath aligned
         with the text. Named parts are filled from code (SettingsCard.xaml.cs). -->
    <Border x:Name="CardBorder" MinHeight="68" Padding="16,14" CornerRadius="8" BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
            <FontIcon x:Name="IconPart" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderPart" TextWrapping="Wrap" />
                <TextBlock x:Name="DescriptionPart" TextWrapping="Wrap"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ContentPresenter x:Name="ActionPart" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" />
            <ContentPresenter x:Name="DetailsPart" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" />
        </Grid>
    </Border>
</UserControl>

<UserControl
    x:Class="MarkSmith.Controls.ExtensionHintBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="RootControl">

    <Grid>
        <Border CornerRadius="8" Margin="0,0,0,10" 
                Background="{ThemeResource SystemControlBackgroundAccentBrush}" Opacity="0.1" />
        
        <Border CornerRadius="8" Margin="0,0,0,10" 
                BorderBrush="{ThemeResource SystemControlForegroundAccentBrush}" BorderThickness="1"
                Background="Transparent" Padding="16,12">
            
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" VerticalAlignment="Center" />
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="That paste looks like plain text" FontWeight="SemiBold" />
                    <TextBlock Text="Headings, tables, code, math ($...$), tabs (:::tabs), SmartArt (:::smartart), vector shapes (:::shapes), timelines, columns, and callouts were probably lost on the way. In your AI chat, use the MarkSmith Connector's 'Copy as Markdown' button (it's pulsing there now) to preserve full native formatting and diagrams."
                               TextWrapping="Wrap" Opacity="0.75" />
                </StackPanel>
                
                <Button Grid.Column="2" Content="Get the extension" Click="OnGetExtensionClick" 
                        ToolTipService.ToolTip="Open the MarkSmith Connector browser extension page"
                        Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center" />
                
                <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Click="OnCloseClick"
                        ToolTipService.ToolTip="Dismiss this hint"
                        VerticalAlignment="Center" Padding="4">
                    <FontIcon Glyph="&#xE711;" FontSize="12" Opacity="0.8" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>


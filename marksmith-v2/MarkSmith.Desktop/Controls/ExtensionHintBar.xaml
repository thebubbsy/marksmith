<UserControl
    x:Class="MarkSmith.Controls.ExtensionHintBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="RootControl">

    <!-- Same chrome as the Source pane's ExtensionTip (theme card, accent only on the glyph + CTA)
         so the two Connector nudges read as one family. The CTA sits beside the text when the bar
         is wide and drops under it when narrow (switched in code-behind on SizeChanged). -->
    <Border CornerRadius="10" Margin="0,0,0,10" Padding="14,12"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Grid x:Name="LayoutGrid" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto"
              ColumnSpacing="12" RowSpacing="8">
            <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                      VerticalAlignment="Top" Margin="0,2,0,0" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="That paste looks like plain text" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Headings, tables, code and diagrams were probably lost on the way. Next time, use the MarkSmith Connector's “Copy as Markdown” button in your AI chat — it's pulsing there now — to keep the full formatting."
                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Button x:Name="GetExtensionButton" Grid.Column="2" Click="OnGetExtensionClick"
                    ToolTipService.ToolTip="Set up the MarkSmith Connector in Edge or Chrome: about a minute, once"
                    Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xEA86;" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="Get the extension" />
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Click="OnCloseClick"
                    ToolTipService.ToolTip="Dismiss this hint" AutomationProperties.Name="Dismiss this hint"
                    VerticalAlignment="Top" Width="28" Height="28" Padding="0">
                <FontIcon Glyph="&#xE711;" FontSize="11" Opacity="0.8" />
            </Button>
        </Grid>
    </Border>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MarkSmith.Controls.OcrExperienceOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed"
    IsTabStop="True"
    KeyDown="OnOverlayKeyDown"
    AutomationProperties.Name="MarkSmith OCR live document reader">

    <Grid x:Name="RootGrid">
        <!-- Standard WinUI smoke scrim matching CommandPalette and ContentDialog -->
        <Rectangle x:Name="Scrim" Fill="{ThemeResource SmokeFillColorDefaultBrush}" />

        <Border x:Name="TheaterCard"
                MaxWidth="1120" MaxHeight="720"
                Margin="36,28"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="12">

            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <!-- Row 0: Top Header with MarkSmith logo, Engine badge, Page counter, Telemetry, and Skip button -->
                <Grid Grid.Row="0" Padding="20,14,16,12" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/logo.png" Width="28" Height="28"
                               VerticalAlignment="Center"
                               AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="MarkSmith Document Reader" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Border x:Name="EngineBadge" CornerRadius="4" Padding="7,1,7,2"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="EngineBadgeText" Text="MarkSmith OCR" FontSize="11"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                </Border>
                                <Border x:Name="PagePill" CornerRadius="4" Padding="7,1,7,2"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="PagePillText" Text="Page 1 of 1" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="SubtitleText"
                                       Text="Decomposing page geometry, extracting visuals &amp; diagrams, and assembling Markdown"
                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                       FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Telemetry counters in header -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border CornerRadius="6" Padding="10,4"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Elements" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ElementsCountText" Text="0" FontSize="12" FontWeight="Bold"
                                           FontFamily="Consolas"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="6" Padding="10,4"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Visuals &amp; Shapes" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="VisualsCountText" Text="0" FontSize="12" FontWeight="Bold"
                                           FontFamily="Consolas"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="6" Padding="10,4"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Words" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="WordsCountText" Text="0" FontSize="12" FontWeight="Bold"
                                           FontFamily="Consolas"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="6" Padding="10,4"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Blocks" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="BlocksCountText" Text="0" FontSize="12" FontWeight="Bold"
                                           FontFamily="Consolas"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button x:Name="SkipButton" Grid.Column="2" Click="OnSkipClick" RightTapped="OnSkipButtonRightTapped"
                            Padding="10,5" CornerRadius="6"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                            ToolTipService.ToolTip="Skip animation and jump straight to the editor (Esc)"
                            AutomationProperties.Name="Skip OCR animation and open in editor">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Text="Skip to editor" FontSize="12" VerticalAlignment="Center" />
                            <Border CornerRadius="3" Padding="5,0,5,1"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <TextBlock Text="Esc" FontSize="10.5"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas" />
                            </Border>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Row 1: 4-Stage Pipeline Stepper Strip -->
                <Grid Grid.Row="1" Padding="20,8" ColumnDefinitions="*,*,*,*" ColumnSpacing="8"
                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Border x:Name="Step1Pill" Grid.Column="0" CornerRadius="6" Padding="10,5"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                            <FontIcon x:Name="Step1Icon" Glyph="&#xE890;" FontSize="12"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="Step1Text" Text="1 · Scan &amp; Deskew" FontSize="11.5"
                                       FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="Step2Pill" Grid.Column="1" CornerRadius="6" Padding="10,5"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                            <FontIcon x:Name="Step2Icon" Glyph="&#xE8A9;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="Step2Text" Text="2 · Break Apart Text, Pics &amp; Diagrams" FontSize="11.5"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="Step3Pill" Grid.Column="2" CornerRadius="6" Padding="10,5"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                            <FontIcon x:Name="Step3Icon" Glyph="&#xE945;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="Step3Text" Text="3 · Recognise Words &amp; Shapes" FontSize="11.5"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="Step4Pill" Grid.Column="3" CornerRadius="6" Padding="10,5"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                            <FontIcon x:Name="Step4Icon" Glyph="&#xE8FD;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="Step4Text" Text="4 · Piece Together .md + Word Shapes" FontSize="11.5"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 2: Main Split Stage (Left = Document Decomposition, Middle = Transfer Bridge, Right = Markdown Assembly) -->
                <Grid Grid.Row="2" Padding="18,14" ColumnDefinitions="*,56,*">
                    <!-- Left Stage: Source Document & OCR Bounding-Box Decomposition -->
                    <Border Grid.Column="0" Style="{StaticResource PipelineCardStyle}"
                            CornerRadius="10" Padding="12">
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="SOURCE DOCUMENT &amp; ELEMENT DETECTION"
                                               FontSize="11" FontWeight="SemiBold" CharacterSpacing="30"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="ScanDimensionsText" Grid.Column="1" Text=""
                                           FontSize="11" FontFamily="Consolas"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>

                            <!-- Viewport well that sizes PageSheetGrid to the exact aspect ratio of the page -->
                            <Border Grid.Row="1" CornerRadius="6" Padding="6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid x:Name="PageViewportGrid"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      SizeChanged="OnPageViewportSizeChanged">
                                    <Border x:Name="PageSheetBorder"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            CornerRadius="4"
                                            Background="#FFFFFF"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid x:Name="PageSheetGrid" Width="360" Height="495" Clip="{x:Null}">
                                            <Image x:Name="DocumentImage" Stretch="Fill" />
                                            <!-- Direct Canvas wrapper for XY-cut guides, element frames, and word boxes -->
                                            <Canvas x:Name="ScanOverlayCanvas" Width="360" Height="495" IsHitTestVisible="False" />
                                            <!-- Direct Canvas wrapper for the sweeping scan line -->
                                            <Canvas x:Name="LaserCanvas" Width="360" Height="495" IsHitTestVisible="False">
                                                <Border x:Name="LaserBeam" Height="3" Width="360"
                                                        Visibility="Collapsed" CornerRadius="1.5"
                                                        Background="#D91A8CFF">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform x:Name="LaserTransform" Y="0" />
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Canvas>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Word Stream HUD Ticker -->
                            <Border x:Name="WordStreamBar" Grid.Row="2" CornerRadius="6" Padding="10,6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="WORD STREAM" FontSize="10.5" FontWeight="Bold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" FontFamily="Consolas" />
                                    <TextBlock x:Name="WordStreamText" Grid.Column="1"
                                               Text="Calibrating optical recogniser…"
                                               FontSize="11.5" FontFamily="Consolas"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="WordRateText" Grid.Column="2"
                                               Text="" FontSize="11" FontFamily="Consolas"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Center Bridge: Block Transfer Conduit -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                        <Border x:Name="BridgePulseBorder" Width="40" Height="40" CornerRadius="20"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1.5"
                                HorizontalAlignment="Center">
                            <FontIcon x:Name="BridgeIcon" Glyph="&#xE72A;" FontSize="14"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      AutomationProperties.AccessibilityView="Raw" />
                        </Border>
                        <TextBlock x:Name="BridgeBlockText" Text="→ .md"
                                   FontSize="10.5" FontFamily="Consolas" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>

                    <!-- Right Stage: Piecing Blocks Together in Order into Markdown -->
                    <Border Grid.Column="2" Style="{StaticResource PipelineCardStyle}"
                            CornerRadius="10" Padding="12">
                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="MARKDOWN RECONSTRUCTION (IN READING ORDER)"
                                               FontSize="11" FontWeight="SemiBold" CharacterSpacing="30"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="BlocksProgressText" Grid.Column="1" Text="Waiting for layout…"
                                           FontSize="11" FontFamily="Consolas"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <!-- Block-by-block assembly stack -->
                                <ScrollViewer x:Name="MarkdownScrollViewer"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="2,0,6,0">
                                    <StackPanel x:Name="MarkdownBlocksPanel" Spacing="8" Padding="0,2,0,12" />
                                </ScrollViewer>

                                <!-- Finalized unified Markdown sheet shown before handing off to the editor -->
                                <Border x:Name="FinalMarkdownSheetBorder"
                                        Visibility="Collapsed"
                                        CornerRadius="8" Padding="14"
                                        RightTapped="OnFinalSheetRightTapped"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                        <Border Grid.Row="0" CornerRadius="6" Padding="10,6"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="13"
                                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                              AutomationProperties.AccessibilityView="Raw" />
                                                    <TextBlock x:Name="FinalBannerText"
                                                               Text="Page assembled in Markdown — opening in editor…"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Button x:Name="CopyFinalMarkdownButton" Grid.Column="1" Click="OnCopyFinalMarkdownClick" RightTapped="OnCopyFinalMarkdownButtonRightTapped"
                                                        Padding="8,3" CornerRadius="4"
                                                        ToolTipService.ToolTip="Copy assembled Markdown to clipboard (Ctrl+C)"
                                                        AutomationProperties.Name="Copy assembled Markdown">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                                        <TextBlock Text="Copy Markdown" FontSize="11.5" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <TextBlock x:Name="FinalMarkdownTextBlock"
                                                       FontFamily="Consolas" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       TextWrapping="Wrap" MaxLines="24"
                                                       TextTrimming="CharacterEllipsis"
                                                       LineHeight="19" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Row 3: Footer Live Status & Progress Bar -->
                <Grid Grid.Row="3" Padding="20,10,20,14" RowDefinitions="Auto,Auto" RowSpacing="6"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="StageStatusText"
                                   Text="Preparing document for optical character recognition…"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="ElapsedText" Grid.Column="1" Text=""
                                   FontSize="11.5" FontFamily="Consolas"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <ProgressBar x:Name="StageProgressBar" Grid.Row="1"
                                 Minimum="0" Maximum="100" Value="8"
                                 Height="4" CornerRadius="2"
                                 Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                 Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

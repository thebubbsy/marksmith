<UserControl
    x:Class="MarkSmith.Controls.ExtensionTip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="RootControl">

    <!-- One-time tip card for the browser Connector. Styled as a plain theme card (same chrome as
         the pipeline cards) with the accent reserved for the glyph + CTA — no off-theme gradients,
         and text uses the theme's default type scale instead of hardcoded sizes. -->
    <Border CornerRadius="10" Padding="14,12"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <!-- Stacked, not side-by-side: the card lives in the ~320px Source column, where a
             four-column row squeezed the body into one word per line. Icon + title + dismiss on
             top, the body under the title, the CTA under the body (aligned to the text). -->
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
            <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                      VerticalAlignment="Center" />

            <TextBlock Grid.Column="1" Text="Work in your AI chat as normal" FontWeight="SemiBold"
                       TextWrapping="Wrap" VerticalAlignment="Center" />

            <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Click="OnCloseClick"
                    ToolTipService.ToolTip="Dismiss this tip" AutomationProperties.Name="Dismiss this tip"
                    VerticalAlignment="Center" Width="28" Height="28" Padding="0" Margin="0,-4,-6,-4">
                <FontIcon Glyph="&#xE711;" FontSize="11" Opacity="0.8" />
            </Button>

            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="Install the MarkSmith Connector browser extension to send ChatGPT, Gemini and Claude replies straight here — then export a polished PDF whenever you're ready."
                       TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Click="OnGetExtensionClick"
                    Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left" Margin="0,4,0,0"
                    ToolTipService.ToolTip="Open the MarkSmith Connector browser extension page">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Get the extension" />
                    <FontIcon Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>

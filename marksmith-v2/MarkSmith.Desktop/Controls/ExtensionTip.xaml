<UserControl
    x:Class="MarkSmith.Controls.ExtensionTip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="RootControl">

    <Grid>
        <Border CornerRadius="8" Padding="1" Margin="0,0,0,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#800078D7" Offset="0.0" />
                    <GradientStop Color="#80800080" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border CornerRadius="7" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <FontIcon Glyph="&#xE774;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center">
                        <FontIcon.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF0078D7" Offset="0.0" />
                                <GradientStop Color="#FF800080" Offset="1.0" />
                            </LinearGradientBrush>
                        </FontIcon.Foreground>
                    </FontIcon>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Work in your AI chat as normal" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                        <TextBlock Text="Install the MarkSmith Connector browser extension to send ChatGPT, Gemini and Claude replies straight here — then export a polished PDF whenever you're ready."
                                   TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                    </StackPanel>

                    <HyperlinkButton Grid.Column="2" Content="Get the extension" 
                                     NavigateUri="https://github.com/thebubbsy/MarkSmith/tree/main/extension"
                                     VerticalAlignment="Center" Margin="16,0,8,0" />

                    <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Click="OnCloseClick"
                            ToolTipService.ToolTip="Dismiss this tip"
                            VerticalAlignment="Center" Padding="4">
                        <FontIcon Glyph="&#xE711;" FontSize="12" Opacity="0.6" />
                    </Button>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>


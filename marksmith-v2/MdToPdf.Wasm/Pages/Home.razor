@page "/"
@using Markdig
@inject IJSRuntime JS

<PageTitle>Marksmith Web — Markdown to PDF</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-6 editor-pane">
            <h5 class="pane-header">📝 Markdown Source</h5>
            <textarea class="form-control md-editor" @bind="markdown" @bind:event="oninput"
                      placeholder="Type or paste Markdown here..." spellcheck="false"></textarea>
            <div class="editor-footer">
                <small>@wordCount words · @charCount chars · ~@readingTime min read</small>
                <button class="btn btn-sm btn-outline-secondary" @onclick="LoadSample">Load Sample</button>
            </div>
        </div>
        <div class="col-md-6 preview-pane">
            <h5 class="pane-header">👁️ Live Preview</h5>
            <div class="md-preview">
                @((MarkupString)renderedHtml)
            </div>
        </div>
    </div>
</div>

@code {
    private string markdown = "# Welcome to Marksmith Web\n\nType **Markdown** on the left, see the *rendered preview* on the right.\n\n## Features\n\n- GitHub-flavoured tables\n- Math via `$...$` and `$$...$$`\n- Code highlighting\n- Pipe tables\n\n| Feature | Status |\n|---------|--------|\n| Tables | ✅ |\n| Math | ✅ |\n| Code | ✅ |\n\n> Marksmith: the document converter that respects your words.\n";

    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .UsePipeTables()
        .UseMathematics()
        .UseEmphasisExtras()
        .UseAutoLinks()
        .Build();

    private string renderedHtml => Markdown.ToHtml(markdown ?? "", Pipeline);

    private int wordCount => string.IsNullOrWhiteSpace(markdown) ? 0
        : markdown.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;

    private int charCount => markdown?.Length ?? 0;

    private int readingTime => Math.Max(1, wordCount / 200);

    private void LoadSample()
    {
        markdown = string.Join("\n", new[]
        {
            "# Marksmith Sample Document",
            "",
            "## Introduction",
            "This is a **sample document** rendered entirely in your browser via WebAssembly.",
            "No server, no installation, no data leaves your machine.",
            "",
            "## Code Example",
            "```csharp",
            "var doc = Markdown.Parse(\"Hello *world*\");",
            "Console.WriteLine(doc.ToHtml());",
            "```",
            "",
            "## Mathematics",
            "The quadratic formula: $x = \\frac{-b \\pm \\sqrt{b^2-4ac}}{2a}$",
            "",
            "## Table",
            "| Format | Engine | Size |",
            "|--------|--------|------|",
            "| PDF | Chromium | 45 KB |",
            "| DOCX | OpenXml | 12 KB |",
            "| EPUB | Custom | 8 KB |",
            "",
            "---",
            "*Generated by Marksmith WASM Edition*",
        });
    }
}

<?xml version="1.0" encoding="utf-8"?>
<dgm:layoutDef xmlns:dgm="http://schemas.openxmlformats.org/drawingml/2006/diagram"
               xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"
               uniqueId="urn:microsoft.com/office/officeart/2005/8/layout/venn1"
               title="Basic Venn"
               desc="Overlapping set Venn diagram layout"
               clrgName="Colorful"
               clrType="colorful">
  <dgm:title val="Basic Venn"/>
  <dgm:desc val="Overlapping set Venn diagram layout"/>
  <dgm:catLst>
    <dgm:cat type="relationship" pri="1"/>
  </dgm:catLst>
  <dgm:layoutNode name="diagram">
    <dgm:alg type="venn"/>
    <dgm:shape type="circle"/>
    <dgm:forEach axis="ch" refNode="node">
      <dgm:layoutNode name="node">
        <dgm:alg type="tx"/>
        <dgm:shape type="circle"/>
        
      </dgm:layoutNode>
    </dgm:forEach>
  </dgm:layoutNode>
</dgm:layoutDef>
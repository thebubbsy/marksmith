<?xml version="1.0" encoding="utf-8"?>
<layoutDef xmlns="http://schemas.openxmlformats.org/drawingml/2006/diagram"
           xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"
           uniqueId="urn:microsoft.com/office/officeart/2005/8/layout/venn1">
  <title val="Basic Venn"/>
  <desc val="Basic Venn"/>
  <catLst>
    <cat type="relationship" pri="1"/>
  </catLst>
  <layoutNode name="diagram">
    <varLst>
      <dir val="norm"/>
      <resizeHandles val="rel"/>
    </varLst>
    <alg type="composite">
      <param type="ar" val="1.4"/>
    </alg>
    <shape type="ellipse"/>
    <presOf/>
    <forEach axis="ch" ptType="node">
      <layoutNode name="node1" styleLbl="node1">
        <varLst>
          <bulletEnabled val="true"/>
        </varLst>
        <alg type="tx"/>
        <shape type="ellipse"/>
        <presOf axis="desOrSelf" ptType="node"/>
      </layoutNode>
    </forEach>
  </layoutNode>
</layoutDef>
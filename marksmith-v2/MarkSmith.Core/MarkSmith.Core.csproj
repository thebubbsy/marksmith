<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MarkSmith.Core</RootNamespace>
    <!-- No Version/FileVersion here: the app's version lives on the EXE (MarkSmith.Desktop stamps
         2.14.0.<build>). A stale hardcoded 2.0.0.x here leaked into UpdateService.CurrentVersion
         (which read this assembly's file version) and made the update banner fire on every launch. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ColorCode.Core" Version="2.0.15" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <PackageReference Include="SharpCompress" Version="0.49.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="Svg.Skia" Version="2.0.0.5" />
    <PackageReference Include="PDFsharp" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\EmbeddedGlox\*.glox" />
    <EmbeddedResource Include="Resources\EmbeddedGlox\*.xml" />
    <EmbeddedResource Include="Resources\SmartArtLayouts\*.xml" />
  </ItemGroup>
</Project>

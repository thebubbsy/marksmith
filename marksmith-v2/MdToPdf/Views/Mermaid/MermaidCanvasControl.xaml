<UserControl
    x:Class="MdToPdf.Views.Mermaid.MermaidCanvasControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:MdToPdf.Converters"
    xmlns:vm="using:MdToPdf.ViewModels.Mermaid"
    xmlns:local="using:MdToPdf.Views.Mermaid"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:ShapeToVisibilityConverter x:Key="ShapeVisConverter" />
        <conv:ShapeFallbackVisibilityConverter x:Key="ShapeFallbackVisConverter" />
    </UserControl.Resources>

    <Grid x:Name="CanvasRootGrid" Background="#1E1E2E">
        <ScrollViewer x:Name="CanvasScrollViewer"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Hidden"
                      ZoomMode="Enabled"
                      MinZoomFactor="0.2"
                      MaxZoomFactor="4.0">

             <Grid x:Name="InfiniteCanvasGrid"
                  Width="4000"
                  Height="3000"
                  Background="Transparent"
                  AllowDrop="True"
                  DragOver="OnCanvasDragOver"
                  Drop="OnCanvasDrop"
                  PointerPressed="OnCanvasPointerPressed"
                  PointerMoved="OnCanvasPointerMoved"
                  PointerReleased="OnCanvasPointerReleased">

                <!-- Layer 1: Background Grid Pattern -->
                <Canvas x:Name="GridPatternCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                <!-- Layer 2: Connector Lines Layer -->
                <ItemsControl x:Name="ConnectorsItemsControl" ItemsSource="{Binding Connectors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DiagramConnectorViewModel">
                            <Canvas>
                                <!-- Line Path -->
                                <Path Data="{Binding PathData}"
                                      Stroke="{Binding StrokeColor}"
                                      StrokeThickness="{Binding StrokeWidth}"
                                      IsHitTestVisible="True" />

                                <!-- Connector Label Overlay -->
                                <Border Canvas.Left="{Binding MidpointX}"
                                        Canvas.Top="{Binding MidpointY}"
                                        Background="#2B2D42"
                                        BorderBrush="#8D99AE"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        Margin="-30,-12,0,0">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="11"
                                               Foreground="#EDF2F4" />
                                </Border>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Layer 3: Diagram Nodes Layer -->
                <ItemsControl x:Name="NodesItemsControl" ItemsSource="{Binding Nodes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DiagramNodeViewModel">
                            <Grid Width="{Binding Width}"
                                  Height="{Binding Height}"
                                  IsHitTestVisible="True"
                                  Background="Transparent">
                                <Grid.RenderTransform>
                                    <TranslateTransform X="{Binding X}" Y="{Binding Y}" />
                                </Grid.RenderTransform>

                                <!-- Visual Selection Indicator Border -->
                                <Border BorderBrush="#4CC9F0"
                                        BorderThickness="2"
                                        Background="#144CC9F0"
                                        CornerRadius="12"
                                        Margin="-4"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}" />

                                <!-- Shapes Area -->
                                <Grid>
                                    <!-- Fallback / Rectangular Shapes: visible for any shape that does not
                                         have a dedicated visual below, so a node can never disappear. -->
                                    <Border Background="{Binding FillColor}"
                                            BorderBrush="{Binding StrokeColor}"
                                            BorderThickness="{Binding StrokeWidth}"
                                            CornerRadius="10"
                                            Padding="10"
                                            Visibility="{Binding Shape, Converter={StaticResource ShapeFallbackVisConverter}, ConverterParameter='Circle,Rhombus,RhombusDiamond,Choice,Hexagon,Actor,CylindricalDatabase'}">
                                        <TextBlock Text="{Binding LabelText}"
                                                   Foreground="#EDF2F4"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Circular Shape -->
                                    <Grid Visibility="{Binding Shape, Converter={StaticResource ShapeVisConverter}, ConverterParameter='Circle'}">
                                        <Ellipse Fill="{Binding FillColor}"
                                                 Stroke="{Binding StrokeColor}"
                                                 StrokeThickness="{Binding StrokeWidth}" />
                                        <TextBlock Text="{Binding LabelText}"
                                                   Foreground="#EDF2F4"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <!-- Rhombus / Diamond / Choice Shape -->
                                    <Grid Visibility="{Binding Shape, Converter={StaticResource ShapeVisConverter}, ConverterParameter='Rhombus,RhombusDiamond,Choice'}">
                                        <Polygon Fill="{Binding FillColor}"
                                                 Stroke="{Binding StrokeColor}"
                                                 StrokeThickness="{Binding StrokeWidth}"
                                                 Points="50,0 100,50 50,100 0,50"
                                                 Stretch="Fill" />
                                        <TextBlock Text="{Binding LabelText}"
                                                   Foreground="#EDF2F4"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <!-- Hexagon Shape -->
                                    <Grid Visibility="{Binding Shape, Converter={StaticResource ShapeVisConverter}, ConverterParameter='Hexagon'}">
                                        <Polygon Fill="{Binding FillColor}"
                                                 Stroke="{Binding StrokeColor}"
                                                 StrokeThickness="{Binding StrokeWidth}"
                                                 Points="25,0 75,0 100,50 75,100 25,100 0,50"
                                                 Stretch="Fill" />
                                        <TextBlock Text="{Binding LabelText}"
                                                   Foreground="#EDF2F4"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <!-- Actor Shape -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding Shape, Converter={StaticResource ShapeVisConverter}, ConverterParameter='Actor'}">
                                        <FontIcon Glyph="&#xE77B;" FontSize="40" Foreground="{Binding StrokeColor}" />
                                        <TextBlock Text="{Binding LabelText}"
                                                   Foreground="#EDF2F4"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>

                                    <!-- Cylindrical Database Shape -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding Shape, Converter={StaticResource ShapeVisConverter}, ConverterParameter='CylindricalDatabase'}">
                                        <FontIcon Glyph="&#xEAF5;" FontSize="40" Foreground="{Binding StrokeColor}" />
                                        <TextBlock Text="{Binding LabelText}"
                                                   Foreground="#EDF2F4"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Anchor Handles Overlay (Top, Right, Bottom, Left) -->
                                <Grid Width="26" Height="26" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-13,0,0" Tag="Top">
                                    <Ellipse Width="12" Height="12" Fill="#4CC9F0" Stroke="#1E1E2E" StrokeThickness="1" IsHitTestVisible="False" />
                                </Grid>
                                <Grid Width="26" Height="26" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-13,0" Tag="Right">
                                    <Ellipse Width="12" Height="12" Fill="#4CC9F0" Stroke="#1E1E2E" StrokeThickness="1" IsHitTestVisible="False" />
                                </Grid>
                                <Grid Width="26" Height="26" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-13" Tag="Bottom">
                                    <Ellipse Width="12" Height="12" Fill="#4CC9F0" Stroke="#1E1E2E" StrokeThickness="1" IsHitTestVisible="False" />
                                </Grid>
                                <Grid Width="26" Height="26" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-13,0,0,0" Tag="Left">
                                    <Ellipse Width="12" Height="12" Fill="#4CC9F0" Stroke="#1E1E2E" StrokeThickness="1" IsHitTestVisible="False" />
                                </Grid>

                                <!-- Quick-Add Hover Container with Opacity transition -->
                                <Grid x:Name="QuickAddHoverContainer"
                                      Background="Transparent"
                                      Opacity="0"
                                      IsHitTestVisible="True">


                                    <!-- Directional Quick-Add Buttons (Top, Right, Bottom, Left) -->
                                    <Button Width="22" Height="22" Padding="0" CornerRadius="11" Background="#2B2D42" BorderBrush="#4CC9F0" BorderThickness="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-26,0,0" Tag="Top" Click="OnQuickAddButtonClick">
                                        <TextBlock Text="▲" FontSize="9" Foreground="#4CC9F0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" CornerRadius="11" Background="#2B2D42" BorderBrush="#4CC9F0" BorderThickness="1"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-26,0" Tag="Right" Click="OnQuickAddButtonClick">
                                        <TextBlock Text="►" FontSize="9" Foreground="#4CC9F0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" CornerRadius="11" Background="#2B2D42" BorderBrush="#4CC9F0" BorderThickness="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-26" Tag="Bottom" Click="OnQuickAddButtonClick">
                                        <TextBlock Text="▼" FontSize="9" Foreground="#4CC9F0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" CornerRadius="11" Background="#2B2D42" BorderBrush="#4CC9F0" BorderThickness="1"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-26,0,0,0" Tag="Left" Click="OnQuickAddButtonClick">
                                        <TextBlock Text="◄" FontSize="9" Foreground="#4CC9F0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Layer 4: Interactive Draft Line Overlay Layer -->
                <Canvas x:Name="OverlayHandleCanvas" IsHitTestVisible="False">
                    <Path x:Name="DraftConnectorPath"
                          Stroke="#4CC9F0"
                          StrokeThickness="2"
                          StrokeDashArray="4,2"
                          Visibility="Collapsed" />
                    <Rectangle x:Name="RubberbandSelectionBox"
                               Fill="#334CC9F0"
                               Stroke="#4CC9F0"
                               StrokeThickness="1"
                               StrokeDashArray="3,3"
                               Visibility="Collapsed" />
                </Canvas>

                <!-- Layer 5: Floating Inline TextBox Editor -->
                <Canvas x:Name="InPlaceEditorCanvas" Visibility="Collapsed" Canvas.ZIndex="100">
                    <TextBox x:Name="InlineEditTextBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="Cascadia Mono, Consolas, Segoe UI"
                             FontSize="13"
                             Background="#2B2D42"
                             Foreground="#EDF2F4"
                             BorderBrush="#4CC9F0"
                             BorderThickness="2"
                             LostFocus="OnInlineEditLostFocus"
                             KeyDown="OnInlineEditKeyDown" />
                </Canvas>

            </Grid>
        </ScrollViewer>

        <!-- Zoom Controls Overlay -->
        <Border HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Margin="20"
                Background="#2B2D42"
                CornerRadius="8"
                BorderBrush="#8D99AE"
                BorderThickness="1"
                Padding="4">
            <StackPanel Orientation="Horizontal">
                <Button Content="-" Width="32" Height="32" Click="OnZoomOutClick" Background="Transparent" Foreground="#EDF2F4" BorderThickness="0" ToolTipService.ToolTip="Zoom Out" FontSize="18" FontWeight="Bold" />
                <TextBlock x:Name="ZoomLevelText" Text="100%" VerticalAlignment="Center" Margin="8,0" Foreground="#EDF2F4" Width="45" TextAlignment="Center" />
                <Button Content="+" Width="32" Height="32" Click="OnZoomInClick" Background="Transparent" Foreground="#EDF2F4" BorderThickness="0" ToolTipService.ToolTip="Zoom In" FontSize="18" FontWeight="Bold" />
                <Button Content="Fit" Width="40" Height="32" Click="OnZoomFitClick" Background="Transparent" Foreground="#EDF2F4" BorderThickness="0" Margin="4,0,0,0" ToolTipService.ToolTip="Fit to Content" />
            </StackPanel>
        </Border>

        <!-- Minimap overlay: a scaled-down overview of the whole diagram with the current viewport
             outlined. Click or drag on it to jump the canvas to that region. -->
        <local:MermaidMinimapControl x:Name="MinimapControl"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Bottom"
                                     Margin="20" />
    </Grid>
</UserControl>

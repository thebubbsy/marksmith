<UserControl
    x:Class="MdToPdf.Views.ImageInsertControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Interactive image picker shown by Insert ▸ Image (default experience). Three ways in:
         drag & drop a file onto the zone, browse with the file picker, or paste a URL.
         Pro mode (Settings ▸ General) bypasses this dialog entirely. -->
    <StackPanel Width="420" Spacing="12">

        <!-- Drop zone: highlights while an image file hovers over it. -->
        <Border x:Name="DropZone" AllowDrop="True"
                DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="2" CornerRadius="8" Padding="24,26">
            <StackPanel HorizontalAlignment="Center" Spacing="6">
                <FontIcon x:Name="DropIcon" Glyph="&#xE898;" FontSize="30" Opacity="0.55"
                          HorizontalAlignment="Center" />
                <TextBlock x:Name="DropTitle" Text="Drag &amp; drop an image here"
                           HorizontalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="PNG · JPG · GIF · WebP · SVG" HorizontalAlignment="Center"
                           FontSize="11" Opacity="0.55" />
            </StackPanel>
        </Border>

        <Button x:Name="BrowseButton" Click="OnBrowseClick" HorizontalAlignment="Stretch"
                ToolTipService.ToolTip="Pick an image file from this PC" AutomationProperties.Name="Pick an image file from this PC">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                <TextBlock Text="Browse for an image…" />
            </StackPanel>
        </Button>

        <!-- Divider with a centred "or" chip. -->
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Height="1" VerticalAlignment="Center"
                       Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
            <TextBlock Grid.Column="1" Text="or" FontSize="11" Opacity="0.55"
                       VerticalAlignment="Center" />
            <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center"
                       Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Grid>

        <TextBox x:Name="UrlBox" PlaceholderText="Paste your image URL here (https://…)"
                 IsSpellCheckEnabled="False" KeyDown="OnUrlKeyDown" />

        <Button x:Name="UrlInsertButton" Click="OnUrlInsertClick" HorizontalAlignment="Stretch"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="Insert the image from the web address above" AutomationProperties.Name="Insert the image from the web address above">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE71B;" FontSize="14" />
                <TextBlock Text="Insert from URL" />
            </StackPanel>
        </Button>

        <TextBlock x:Name="StatusText" Text="" FontSize="11" Opacity="0.7"
                   TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</UserControl>

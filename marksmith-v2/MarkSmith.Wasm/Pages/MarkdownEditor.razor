@page "/"
@page "/editor"
@using Markdig
@using MarkSmith.Models
@using MarkSmith.Services
@using MarkSmith.Services.Mermaid
@using MarkSmith.Core.AST
@using MarkSmith.Core.Glox
@using MarkSmith.Core.Preview
@using MarkSmith.Wasm.Services
@using System.Text
@using System.Text.Json
@using System.Text.RegularExpressions
@inject IJSRuntime JS

<PageTitle>Marksmith — Web Edition</PageTitle>

<style>
    /* ═══ Marksmith Web — faithful replica of the desktop app's shell ═══
       Palette mirrors MainWindow.xaml theme resources:
       window #1b1b1f · card #25252a · card-secondary #2b2b31 · stroke #33333a
       text #e8e8ea · dim #9a9ab0 · accent #0078D4 */
    :root {
        --bg: #1b1b1f; --card: #25252a; --card2: #2b2b31; --line: #33333a;
        --text: #e8e8ea; --dim: #9a9ab0; --accent: #0078d4; --accent-hi: #2b8be8;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; height: 100%; }
    body { background: var(--bg); color: var(--text); font-family: "Segoe UI", system-ui, sans-serif; font-size: 13px; }
    .shell { display: flex; flex-direction: column; height: 100vh; }

    /* ── title / command bar ── */
    .topbar { display: flex; align-items: center; gap: 12px; padding: 0 16px; height: 52px;
              background: #202026; border-bottom: 1px solid var(--line); flex: none; }
    .topbar .logo { font-size: 18px; }
    .topbar h1 { font-size: 15px; font-weight: 700; margin: 0; }
    .topbar .pill { background: var(--accent); color: #fff; font-size: 10.5px; font-weight: 600;
                    padding: 3px 10px; border-radius: 10px; }
    .topbar .spacer { flex: 1; }
    .topbar .chip { font-size: 11px; color: var(--dim); }

    /* ── three-pane body ── */
    .body { display: flex; flex: 1; gap: 12px; padding: 12px 16px 8px; min-height: 0; }
    .pane { background: var(--card); border: 1px solid var(--line); border-radius: 12px;
            display: flex; flex-direction: column; min-height: 0; }
    .pane.left { width: 290px; flex: none; }
    .pane.center { flex: 1; min-width: 360px; }
    .pane.right { width: 360px; flex: none; }
    .pane-title { font-size: 10.5px; text-transform: uppercase; letter-spacing: .8px; color: var(--dim);
                  font-weight: 600; padding: 12px 14px 8px; }

    /* ── left: Source & Files ── */
    .pane.left .src-scroll { flex: 1; overflow: auto; padding: 0 14px 14px; }
    .pane.left textarea { width: 100%; min-height: 260px; resize: vertical; background: var(--bg);
                          color: var(--text); border: 1px solid var(--line); border-radius: 8px;
                          padding: 10px; font-family: "Cascadia Mono", Consolas, monospace; font-size: 12.5px; }
    .pane.left .src-actions { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
    .pane.left .hint { font-size: 11px; color: var(--dim); margin-top: 10px; line-height: 1.5; }

    /* ── center: Looking Glass (editor + preview) ── */
    .lg-tabs { display: flex; gap: 6px; padding: 10px 14px 0; }
    .lg-tabs button { background: transparent; border: 1px solid var(--line); color: var(--dim);
                      font-size: 11.5px; font-weight: 600; padding: 5px 14px; border-radius: 7px; cursor: pointer; }
    .lg-tabs button.on { background: var(--accent); border-color: var(--accent); color: #fff; }
    .lg-body { flex: 1; display: flex; flex-direction: column; gap: 10px; padding: 10px 14px 14px; min-height: 0; }
    .lg-editor, .lg-preview { border: 1px solid var(--line); border-radius: 10px; background: var(--bg); min-height: 0; }
    .lg-editor { display: flex; flex-direction: column; }
    .lg-preview { flex: 1; overflow: auto; padding: 18px; }
    .lg-editor textarea { flex: 1; width: 100%; background: transparent; color: var(--text); border: none;
                          outline: none; resize: none; padding: 14px; font-family: "Cascadia Mono", Consolas, monospace;
                          font-size: 13px; line-height: 1.55; }
    .lg-editor .bar, .lg-preview .bar { font-size: 10.5px; color: var(--dim); padding: 6px 12px;
                                        border-bottom: 1px solid var(--line); text-transform: uppercase;
                                        letter-spacing: .6px; font-weight: 600; }
    .lg-preview .bar { border-bottom: none; border-top: 1px solid var(--line); }
    .lg-preview { display: flex; flex-direction: column; }
    .lg-preview .doc { flex: 1; overflow: auto; padding: 20px 28px; }
    .lg-preview .doc h1, .lg-preview .doc h2 { border-bottom: 1px solid var(--line); padding-bottom: 6px; }
    .lg-preview .doc table { border-collapse: collapse; }
    .lg-preview .doc td, .lg-preview .doc th { border: 1px solid var(--line); padding: 4px 10px; }
    .lg-preview .doc pre { background: #14141d; border: 1px solid var(--line); border-radius: 8px; padding: 10px; overflow: auto; }
    .lg-preview .doc blockquote { border-left: 3px solid var(--accent); margin-left: 0; padding-left: 14px; color: var(--dim); }
    .lg-preview .doc code { background: #14141d; border-radius: 4px; padding: 1px 5px; }
    .lg-preview .doc a { color: var(--accent-hi); }

    /* ── right: Style panel (desktop dropdown groups) ── */
    .pane.right .style-scroll { flex: 1; overflow: auto; padding: 0 12px 12px; }
    details.group { background: var(--card); border: 1px solid var(--line); border-radius: 10px; margin-bottom: 10px; overflow: hidden; }
    details.group > summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 8px;
                              padding: 10px 12px; font-weight: 600; font-size: 12.5px; user-select: none; }
    details.group > summary::-webkit-details-marker { display: none; }
    details.group > summary .chev { margin-left: auto; color: var(--dim); transition: transform .15s; font-size: 10px; }
    details.group[open] > summary .chev { transform: rotate(90deg); }
    details.group .group-body { padding: 2px 12px 12px; display: flex; flex-direction: column; gap: 10px; }
    .field-row { display: flex; align-items: center; gap: 8px; justify-content: space-between; }
    .field-row label { font-size: 12px; color: var(--text); }
    .field-row .hint { font-size: 10.5px; color: var(--dim); line-height: 1.4; }
    select, input[type=number], input[type=text] { background: var(--bg); color: var(--text);
        border: 1px solid var(--line); border-radius: 6px; padding: 4px 8px; font-size: 12px; }
    .switch { position: relative; width: 38px; height: 20px; flex: none; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .switch .sl { position: absolute; inset: 0; background: #3c3c44; border-radius: 20px; transition: .15s; }
    .switch .sl::before { content: ""; position: absolute; width: 14px; height: 14px; left: 3px; top: 3px;
                          background: #fff; border-radius: 50%; transition: .15s; }
    .switch input:checked + .sl { background: var(--accent); }
    .switch input:checked + .sl::before { transform: translateX(18px); }

    /* ── buttons ── */
    .btn { background: var(--accent); color: #fff; border: none; border-radius: 7px; padding: 7px 14px;
           font-size: 12.5px; font-weight: 600; cursor: pointer; }
    .btn:hover { background: var(--accent-hi); }
    .btn.ghost { background: transparent; border: 1px solid var(--line); color: var(--text); }
    .btn.ghost:hover { border-color: var(--accent); }
    .btn:disabled { opacity: .45; cursor: not-allowed; }
    .btn-row { display: flex; gap: 8px; }

    /* ── looking glass portal eye ── */
    .lg-wrap { position: relative; flex: 1; display: flex; flex-direction: column; min-height: 0; }
    .portal { position: absolute; inset: 0; z-index: 20; background: rgba(27,27,31,.94);
              border: 2px solid var(--accent); border-radius: 10px; display: flex; flex-direction: column; }
    .portal .bar { font-size: 10.5px; color: var(--accent-hi); padding: 6px 12px; text-transform: uppercase;
                   letter-spacing: .6px; font-weight: 600; border-bottom: 1px solid var(--line); }
    .portal textarea { flex: 1; width: 100%; background: transparent; color: #d4f1ff; border: none;
                       outline: none; resize: none; padding: 14px; font-family: "Cascadia Mono", Consolas, monospace;
                       font-size: 13px; line-height: 1.55; }
    .lg-toolbar { display: flex; gap: 4px; padding: 6px 12px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
    .lg-toolbar button { background: transparent; border: 1px solid transparent; color: var(--dim);
                         font-size: 11.5px; font-weight: 600; padding: 3px 9px; border-radius: 5px; cursor: pointer; }
    .lg-toolbar button:hover { border-color: var(--line); color: var(--text); }
    .lg-toolbar .sep { width: 1px; background: var(--line); margin: 2px 4px; }

    /* ── status bar ── */
    .statusbar { display: flex; align-items: center; gap: 14px; padding: 7px 16px; background: #202026;
                 border-top: 1px solid var(--line); font-size: 11.5px; color: var(--dim); flex: none; }
    .statusbar .ok { color: #3fb950; }
    .statusbar .err { color: #f85149; }
</style>

<div class="shell">
    <!-- Command bar -->
    <div class="topbar">
        <span class="logo">M</span>
        <h1>Marksmith</h1>
        <span class="pill">Web Edition</span>
        <div class="spacer"></div>
        <button class="btn ghost" @onclick="LoadSample">Load sample</button>
        <button class="btn ghost" @onclick="Clear">Clear</button>
    </div>

    <div class="body">
        <!-- LEFT: Source & Files -->
        <aside class="pane left">
            <div class="pane-title">Source &amp; Files</div>
            <div class="src-scroll">
                <textarea id="srcBox" @bind="markdown" @bind:event="oninput" spellcheck="false"
                          placeholder="Paste Markdown, an AI reply, or a :::smartart block — everything compiles in your browser."></textarea>
                <div class="src-actions">
                    <button class="btn" disabled="@exporting" @onclick="ExportDocx">Export DOCX</button>
                    <button class="btn ghost" disabled="@exporting" @onclick="ExportEpub">Export EPUB</button>
                </div>
                <div class="hint">Draft autosaves as you type. Mermaid diagrams in the preview are rebuilt as native Word shapes on export.</div>
            </div>
        </aside>

        <!-- CENTER: Looking Glass (editor / split / preview) -->
        <main class="pane center">
            <div class="lg-tabs">
                <button class="@TabClass(ViewCode)" @onclick="() => SetView(ViewCode)">Code</button>
                <button class="@TabClass(ViewSplit)" @onclick="() => SetView(ViewSplit)">Split</button>
                <button class="@TabClass(ViewPreview)" @onclick="() => SetView(ViewPreview)">Preview</button>
            </div>
            <div class="lg-body">
                @if (view != ViewPreview)
                {
                    <div class="lg-editor" style="@SplitStyle()">
                        <div class="lg-toolbar">
                            <button @onclick="() => Insert(MdB, MdB)" title="Bold">B</button>
                            <button @onclick="() => Insert(MdI, MdI)" title="Italic">I</button>
                            <button @onclick="() => Insert(MdH1, MdH1)" title="Heading 1">H1</button>
                            <button @onclick="() => Insert(MdH2, MdH2)" title="Heading 2">H2</button>
                            <button @onclick="() => Insert(MdH3, MdH3)" title="Heading 3">H3</button>
                            <span class="sep"></span>
                            <button @onclick="() => Insert(MdList, MdList)" title="Bullet list">List</button>
                            <button @onclick="() => Insert(MdNum, MdNum)" title="Numbered list">1.</button>
                            <button @onclick="() => Insert(MdTable, MdTable)" title="Table">Table</button>
                            <button @onclick="() => Insert(MdLink, MdLink)" title="Link">Link</button>
                            <button @onclick="() => Insert(MdCode, MdCode)" title="Inline code">Code</button>
                            <button @onclick="() => Insert(MdSmart, MdSmart)" title="Insert SmartArt block">SmartArt</button>
                            <span class="sep"></span>
                            <button class="@(portalOn ? "on" : "")" style="@(portalOn ? "color:var(--accent-hi)" : "")" @onclick="TogglePortal" title="Looking Glass portal — edit raw Markdown over the preview">Eye</button>
                        </div>
                        <textarea @ref="editorRef" @bind="markdown" @bind:event="oninput" spellcheck="false"></textarea>
                    </div>
                }
                <div class="lg-wrap" style="@(view == ViewPreview ? "flex: 1;" : (view == ViewSplit ? "flex: 1;" : "display:none;"))">
                    @if (view != ViewCode)
                    {
                        <div class="lg-preview" style="height:100%">
                            <div class="doc">@((MarkupString)renderedHtml)</div>
                        </div>
                    }
                    @if (portalOn)
                    {
                        <div class="portal">
                            <div class="bar">Looking Glass portal — source over the rendered preview</div>
                            <textarea @bind="markdown" @bind:event="oninput" spellcheck="false" autofocus></textarea>
                        </div>
                    }
                </div>
            </div>
        </main>

        <!-- RIGHT: Style panel (desktop dropdown groups) -->
        <aside class="pane right">
            <div class="pane-title">Style &amp; Export</div>
            <div class="style-scroll">
                <details class="group" open>
                    <summary>Appearance <span class="chev">▶</span></summary>
                    <div class="group-body">
                        <div class="field-row">
                            <label>Theme</label>
                            <select @bind="settings.Theme" @bind:after="OnSettingsChanged" style="width:150px">
                                @foreach (var t in Themes)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                        <div class="field-row">
                            <label>Page width (px)</label>
                            <input type="number" style="width:90px" @bind="settings.ContentWidth" @bind:after="OnSettingsChanged" min="400" max="2400" />
                        </div>
                        <div class="field-row">
                            <label>A4 lock</label>
                            <label class="switch"><input type="checkbox" @bind="settings.A4FixedWidth" @bind:after="OnSettingsChanged" /><span class="sl"></span></label>
                        </div>
                    </div>
                </details>

                <details class="group" open>
                    <summary>Formatting &amp; text <span class="chev">▶</span></summary>
                    <div class="group-body">
                        <div class="field-row">
                            <label>Heading level shift</label>
                            <input type="number" style="width:70px" @bind="settings.HeadingShift" @bind:after="OnSettingsChanged" min="-5" max="5" />
                        </div>
                        <div class="field-row">
                            <label>Bold</label>
                            <select style="width:130px" @bind="settings.BoldMode" @bind:after="OnSettingsChanged">
                                <option value="0">Keep</option>
                                <option value="1">Remove</option>
                                <option value="2">→ Italic</option>
                            </select>
                        </div>
                        <div class="field-row">
                            <label>Italic</label>
                            <select style="width:130px" @bind="settings.ItalicMode" @bind:after="OnSettingsChanged">
                                <option value="0">Keep</option>
                                <option value="1">Remove</option>
                            </select>
                        </div>
                        <div class="field-row">
                            <label>Em dashes</label>
                            <select style="width:130px" @bind="settings.DashMode" @bind:after="OnSettingsChanged">
                                <option value="0">Keep as-is</option>
                                <option value="1">→ hyphen</option>
                                <option value="2">→ spaced ( - )</option>
                                <option value="3">Custom…</option>
                            </select>
                        </div>
                        <div class="field-row">
                            <label>No emoji mode</label>
                            <label class="switch"><input type="checkbox" @bind="settings.NoEmoji" @bind:after="OnSettingsChanged" /><span class="sl"></span></label>
                        </div>
                    </div>
                </details>

                <details class="group" open>
                    <summary>Content &amp; cleanup <span class="chev">▶</span></summary>
                    <div class="group-body">
                        <div class="field-row">
                            <label>Normalize AI quirks</label>
                            <label class="switch"><input type="checkbox" @bind="settings.NormalizeLlm" @bind:after="OnSettingsChanged" /><span class="sl"></span></label>
                        </div>
                        <div class="hint">Detects the assistant (ChatGPT / Gemini / Claude / Copilot), repairs copy artifacts, and normalizes its formatting quirks — same engine as the desktop app.</div>
                    </div>
                </details>

                <details class="group">
                    <summary>SmartArt <span class="chev">▶</span></summary>
                    <div class="group-body">
                        <div class="hint">Include a <code>:::smartart type="hierarchy"</code> block (nested <code>- </code> bullets) in your Markdown. It previews here as a diagram and exports as <b>native Word SmartArt</b> — 176 layouts.</div>
                        <div class="hint">Try: <code>type="process"</code>, <code>"cycle"</code>, <code>"matrix"</code>, <code>"pyramid"</code>, <code>"venn"</code>, <code>"picturelist"</code>.</div>
                    </div>
                </details>
            </div>
        </aside>
    </div>

    <!-- Status bar -->
    <div class="statusbar">
        <span>WebAssembly · zero server · offline</span>
        <span class="spacer" style="flex:1"></span>
        <span>@charCount chars</span>
        @if (classificationLabel.Length > 0)
        {
            <span>@classificationLabel</span>
        }
        @if (exporting)
        {
            <span>Converting — entirely in your browser…</span>
        }
        else if (exportStatus is { Length: > 0 })
        {
            <span class="@(exportOk ? "ok" : "err")">@exportStatus</span>
        }
    </div>
</div>

@code {
    private string markdown = @"# Executive Technical Overview

## Architecture

This document is compiled **natively in your browser** — Markdown in, schema-valid Word OOXML out. Zero server, zero desktop app.

| Feature | Status | Engine |
|---|---|---|
| Pipe Tables | ✅ | Markdig |
| Math | $E = mc^2$ | KaTeX |
| Diagrams | ```mermaid
flowchart TD
    A[Source] --> B[Style] --> C[Export]
``` | mermaid |
| SmartArt | :::smartart type=""hierarchy"" | 176 native layouts |

> [!NOTE]
> The cleanup engine runs first: heading shift, bold/italic modes, em-dash handling and no-emoji all apply to the preview *and* the export — exactly like the desktop app.

:::smartart type=""hierarchy""
- Executive Board
  - Engineering
    - Backend
    - Frontend
  - Product
:::
";

    private bool portalOn;
    private ElementReference editorRef;

    private const string MdB = "**";
    private const string MdI = "*";
    private const string MdH1 = "# ";
    private const string MdH2 = "## ";
    private const string MdH3 = "### ";
    private const string MdList = "- ";
    private const string MdNum = "1. ";
    private const string MdTable = "| Col A | Col B |\n| --- | --- |\n|  |  |";
    private const string MdLink = "[text](url)";
    private const string MdCode = "`";
    private const string MdSmart = "\n\n:::smartart type=\"hierarchy\"\n- Item\n  - Sub\n:::";

    private async Task Insert(string before, string after)
    {
        try { await JS.InvokeVoidAsync("marksmithInsertAtCaret", editorRef, before, after); } catch { /* editor hidden in preview mode */ }
    }

    private void TogglePortal() => portalOn = !portalOn;

    private string view = "split";
    private const string ViewCode = "code";
    private const string ViewSplit = "split";
    private const string ViewPreview = "preview";
    private string TabClass(string v) => view == v ? "on" : "";
    private string SplitStyle() => view == ViewSplit ? "flex: 1;" : "flex: 3;";

    private readonly AppSettings settings = new();
    private bool settingsLoaded;
    private bool exporting;
    private string? exportStatus;
    private bool exportOk;
    private string? currentThemeName;
    private string classificationLabel = "";
    private string _lastSavedDraft = "";

    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .UsePipeTables()
        .UseMathematics()
        .UseEmphasisExtras()
        .UseAutoLinks()
        .UseTaskLists()
        .UseGenericAttributes()
        .Build();

    private static readonly Regex SmartArtBlock = new(
        @"(?s)(?:\A|\n\n)\s*:::smartart\s+type=""([^""]+)""\s*\r?\n(.*?)\r?\n:::\s*",
        RegexOptions.Compiled);

    private IEnumerable<string> Themes
    {
        get
        {
            try
            {
                return AppServices.Themes.All.Select(t => t.Name).Distinct().OrderBy(n => n);
            }
            catch
            {
                return new[] { "Default", "GitHub Light", "GitHub Dark", "Solarized Light", "Dracula", "Obsidian" };
            }
        }
    }

    private int charCount => markdown?.Length ?? 0;

    protected override async Task OnInitializedAsync()
    {
        var store = new WasmSettingsStore(JS);
        var saved = await store.LoadAsync();
        CopySettings(saved, settings);
        if (string.IsNullOrWhiteSpace(settings.Theme)) settings.Theme = "GitHub Light";
        try
        {
            var draft = await JS.InvokeAsync<string>("marksmithStorageGet", "marksmith.draft");
            if (!string.IsNullOrWhiteSpace(draft)) markdown = draft;
        }
        catch { /* first run */ }
        settingsLoaded = true;
    }

    private static void CopySettings(AppSettings from, AppSettings to)
    {
        to.Theme = from.Theme;
        to.ContentWidth = from.ContentWidth;
        to.A4FixedWidth = from.A4FixedWidth;
        to.HeadingShift = from.HeadingShift;
        to.BoldMode = from.BoldMode;
        to.ItalicMode = from.ItalicMode;
        to.NoEmoji = from.NoEmoji;
        to.DashMode = from.DashMode;
        to.DashCustom = from.DashCustom;
        to.NormalizeLlm = from.NormalizeLlm;
    }

    private void SetView(string v) => view = v;

    private async void OnSettingsChanged()
    {
        if (!settingsLoaded) return;
        currentThemeName = settings.Theme;
        if (settings.A4FixedWidth) settings.ContentWidth = 794;
        try
        {
            await new WasmSettingsStore(JS).SaveAsync(settings);
        }
        catch { /* persistence is best-effort */ }
        StateHasChanged();
    }

    // ── the full desktop preview pipeline, client-side ──────────────────────
    private string renderedHtml
    {
        get
        {
            try
            {
                var md = markdown ?? "";

                // AI-source parity (desktop PrepareMarkdown): detect the assistant, repair
                // copy artifacts ALWAYS, and normalize style when the toggle is on.
                try
                {
                    var classification = AppServices.LlmSource.Classify(md);
                    classificationLabel = classification.Source == LlmSource.Generic
                        ? ""
                        : $"{classification.SourceDescription} · {classification.Confidence}%";
                    (md, _) = AppServices.LlmSource.RepairArtifacts(md, classification);
                    if (settings.NormalizeLlm)
                        (md, _) = AppServices.LlmSource.NormalizeStyle(md, classification);
                }
                catch
                {
                    classificationLabel = "";
                }

                var smartArt = new List<(string Alias, string Inner)>();
                md = SmartArtBlock.Replace(md, m =>
                {
                    smartArt.Add((m.Groups[1].Value.Trim().ToLowerInvariant(), m.Groups[2].Value.Trim()));
                    return $"\n\n<!--SMARTART:{smartArt.Count - 1}-->\n\n";
                });

                md = FormattingService.Apply(md, settings);
                md = DialectNormalizer.Apply(md, settings.DashMode);
                md = DashReplacer.Apply(md, settings.DashMode, settings.DashCustom);

                var body = Markdown.ToHtml(md, Pipeline);
                if (settings.NoEmoji) body = EmojiStripper.Strip(body);

                for (int i = 0; i < smartArt.Count; i++)
                {
                    try
                    {
                        var ast = MarkdownAstParser.Parse(smartArt[i].Inner);
                        var pkg = SmartArtLayoutCatalog.Shared.TryResolve(smartArt[i].Alias);
                        string alias = pkg != null ? smartArt[i].Alias : "hierarchy";
                        var svg = HtmlPreviewRenderer.RenderHtml(ast, alias, pkg?.Title ?? alias);
                        body = body.Replace($"<!--SMARTART:{i}-->", $"<div class=\"border rounded p-2 my-2\" style=\"background:#f8f9fa\">{svg}</div>");
                    }
                    catch
                    {
                        body = body.Replace($"<!--SMARTART:{i}-->", "<div class=\"text-danger\">SmartArt could not render.</div>");
                    }
                }
                return body;
            }
            catch (Exception ex)
            {
                return $"<div class=\"text-danger\">Preview error: {ex.Message}</div>";
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            currentThemeName = settings.Theme;
            StateHasChanged();
        }
        if (markdown != _lastSavedDraft)
        {
            _lastSavedDraft = markdown;
            try { await JS.InvokeVoidAsync("marksmithStorageSet", "marksmith.draft", markdown); } catch { /* best effort */ }
        }
        try { await JS.InvokeVoidAsync("marksmithEnhancePreview"); } catch { /* best effort */ }
    }

    // ── exports: the same Core exporters the desktop uses ───────────────────
    private async Task ExportDocx()
    {
        if (string.IsNullOrWhiteSpace(markdown)) { exportStatus = "Nothing to export — type or paste Markdown first."; exportOk = false; return; }
        await RunExport("marksmith-export.docx", async (path) =>
        {
            List<HarvestedDiagram>? geometry = null;
            try
            {
                var json = await JS.InvokeAsync<string>("marksmithHarvestMermaid");
                if (!string.IsNullOrWhiteSpace(json))
                {
                    var parsed = JsonSerializer.Deserialize<List<HarvestedDiagram>>(json);
                    if (parsed is { Count: > 0 }) geometry = parsed;
                }
            }
            catch { /* no preview rendered — export without geometry */ }
            await new DocxExportService().ExportAsync(markdown, path, settings, null, null, geometry);
        });
    }

    private async Task ExportEpub()
    {
        if (string.IsNullOrWhiteSpace(markdown)) { exportStatus = "Nothing to export — type or paste Markdown first."; exportOk = false; return; }
        await RunExport("marksmith-export.epub", (path) => new EpubExportService().ExportAsync(markdown, path, settings));
    }

    private async Task RunExport(string filename, Func<string, Task> convert)
    {
        exporting = true;
        exportStatus = null;
        StateHasChanged();
        try
        {
            await convert(filename);
            var bytes = await System.IO.File.ReadAllBytesAsync(filename);
            await JS.InvokeVoidAsync("marksmithDownload", filename, bytes);
            exportStatus = $"Downloaded {filename} ({bytes.Length} bytes) — compiled natively in your browser.";
            exportOk = true;
        }
        catch (Exception ex)
        {
            exportStatus = $"Export failed: {ex.Message}";
            exportOk = false;
        }
        finally
        {
            exporting = false;
            StateHasChanged();
        }
    }


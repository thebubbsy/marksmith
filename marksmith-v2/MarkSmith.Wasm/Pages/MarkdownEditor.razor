@page "/"
@page "/editor"
@using Markdig
@using MarkSmith.Models
@using MarkSmith.Services
@inject IJSRuntime JS

<PageTitle>Marksmith Web — Markdown Editor & Preview</PageTitle>

<div class="container-fluid h-100 p-3">
    <div class="row h-100 g-3">
        <div class="col-md-6 d-flex flex-column h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0 fw-bold">📝 Markdown Source</h5>
                <div>
                    <button class="btn btn-sm btn-outline-success me-2" disabled="@exporting" @onclick="ExportDocx">📄 Export DOCX</button>
                    <button class="btn btn-sm btn-outline-secondary me-2" @onclick="LoadSample">Load Sample</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="Clear">Clear</button>
                </div>
            </div>
            <textarea class="form-control flex-grow-1 font-monospace md-editor-input"
                      @bind="markdown" @bind:event="oninput"
                      placeholder="Type or paste Markdown here..." spellcheck="false"></textarea>
            <div class="d-flex justify-content-between align-items-center mt-2 text-muted small">
                <span>@wordCount words · @charCount chars · ~@readingTime min read</span>
                <span class="badge bg-secondary">Client-Side WASM</span>
            </div>
            <div class="mt-1 small">
                @if (exporting)
                {
                    <span class="text-primary">Converting to native .docx — entirely in your browser…</span>
                }
                else if (exportStatus is not null && exportStatus.Length > 0)
                {
                    <span class="@(exportOk ? "text-success" : "text-danger")">@exportStatus</span>
                }
            </div>
        </div>
        <div class="col-md-6 d-flex flex-column h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0 fw-bold">👁️ Live Preview</h5>
                <span class="badge bg-success">Markdig Pipeline</span>
            </div>
            <div class="border rounded p-3 flex-grow-1 overflow-auto bg-body md-preview-pane">
                @((MarkupString)renderedHtml)
            </div>
        </div>
    </div>
</div>

@code {
    private string markdown = @"# Welcome to Marksmith Web

Type **Markdown** on the left, see the *live preview* on the right.

## Features

- **GitHub-Flavoured Tables**
- **Callouts & Admonitions**
- **Task Lists**
- **Math Formulations**

| Feature | Status | Engine |
|---------|--------|--------|
| Pipe Tables | ✅ | Markdig |
| Task Lists | ✅ | Markdig |
| Math Expressions | ✅ | KaTeX-Ready |

> [!NOTE]
> Marksmith Web compiles and renders entirely in your browser. Zero server processing.

```csharp
public static string ConvertToHtml(string markdown)
{
    var pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();
    return Markdown.ToHtml(markdown, pipeline);
}
```
";

    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .UsePipeTables()
        .UseMathematics()
        .UseEmphasisExtras()
        .UseAutoLinks()
        .UseTaskLists()
        .UseGenericAttributes()
        .Build();

    private string renderedHtml => Markdown.ToHtml(markdown ?? "", Pipeline);

    private int wordCount => string.IsNullOrWhiteSpace(markdown) ? 0
        : markdown.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;

    private int charCount => markdown?.Length ?? 0;

    private int readingTime => Math.Max(1, wordCount / 200);

    private void LoadSample()
    {
        markdown = string.Join("\n", new[]
        {
            "# Executive Technical Overview",
            "",
            "## Architecture",
            "This document was compiled natively in client WebAssembly.",
            "",
            "```json",
            "{",
            "  \"app\": \"Marksmith WASM\",",
            "  \"version\": \"2.8.0\",",
            "  \"offline\": true",
            "}",
            "```",
            "",
            "## Performance Metrics",
            "| Operation | Latency | Memory |",
            "|---|---|---|",
            "| Markdig Parse | < 2ms | 120 KB |",
            "| HTML Render | < 1ms | 45 KB |",
        });
    }

    private void Clear()
    {
        markdown = string.Empty;
    }

    // ── in-browser DOCX export (the WASM spike) ─────────────────────────────
    // Proves MarkSmith.Core's full OOXML pipeline runs under WebAssembly: the file is written
    // to the in-memory FS, read back as bytes, and handed to the browser for download — zero
    // server, zero desktop app.
    private bool exporting;
    private string? exportStatus;
    private bool exportOk;

    private async Task ExportDocx()
    {
        if (string.IsNullOrWhiteSpace(markdown))
        {
            exportStatus = "Nothing to export — type or paste Markdown first.";
            exportOk = false;
            return;
        }
        exporting = true;
        exportStatus = null;
        StateHasChanged();
        try
        {
            const string filename = "marksmith-export.docx";
            var settings = new AppSettings();
            await new DocxExportService().ExportAsync(markdown, filename, settings);
            var bytes = await System.IO.File.ReadAllBytesAsync(filename);
            await JS.InvokeVoidAsync("marksmithDownload", filename, bytes);
            exportStatus = $"Downloaded {filename} ({bytes.Length} bytes) — native Word OOXML, compiled in your browser.";
            exportOk = true;
        }
        catch (Exception ex)
        {
            exportStatus = $"Export failed: {ex.Message}";
            exportOk = false;
        }
        finally
        {
            exporting = false;
            StateHasChanged();
        }
    }
}

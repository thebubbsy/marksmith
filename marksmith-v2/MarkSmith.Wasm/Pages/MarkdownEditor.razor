@page "/"
@page "/editor"
@using Markdig
@using MarkSmith.Models
@using MarkSmith.Services
@using MarkSmith.Services.Mermaid
@using MarkSmith.Core.AST
@using MarkSmith.Core.Glox
@using MarkSmith.Core.Preview
@using MarkSmith.Wasm.Services
@using Microsoft.JSInterop
@using System.Text
@using System.Text.Json
@using System.Text.RegularExpressions
@inject IJSRuntime JS

<PageTitle>Marksmith — Web Edition</PageTitle>

<style>
    /* ═══ Marksmith Web — desktop-app aesthetic ═══
       Monochromatic dark palette, borderless panels separated by background
       tone + generous space, numbered workflow columns, white-paper preview. */
    :root {
        --bg: #1b1b1f; --pane: #202026; --pane2: #26262c; --line: #2e2e35;
        --text: #e8e8ea; --dim: #9a9ab0; --accent: #0078d4; --accent-hi: #2b8be8;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; height: 100%; }
    body { background: var(--bg); color: var(--text); font-family: "Segoe UI", system-ui, sans-serif; font-size: 13px; }
    .shell { display: flex; flex-direction: column; height: 100vh; }

    /* ── slim top bar ── */
    .topbar { display: flex; align-items: center; gap: 12px; padding: 0 20px; height: 48px; flex: none; }
    .topbar .logo { width: 22px; height: 22px; border-radius: 6px; background: var(--accent); color: #fff;
                    display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 13px; }
    .topbar h1 { font-size: 14.5px; font-weight: 700; margin: 0; letter-spacing: .2px; }
    .topbar .spacer { flex: 1; }
    .topbar button { background: transparent; border: 1px solid var(--line); color: var(--dim); font-size: 12px;
                     padding: 5px 14px; border-radius: 7px; cursor: pointer; }
    .topbar button:hover { color: var(--text); border-color: #3a3a44; }

    /* ── three-pane body ── */
    .body { display: flex; flex: 1; gap: 14px; padding: 0 20px 10px; min-height: 0; }
    .pane { display: flex; flex-direction: column; min-height: 0; }
    .pane.left { width: 272px; flex: none; }
    .pane.center { flex: 1; min-width: 360px; }
    .pane.right { width: 332px; flex: none; }
    .pane-title { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--dim);
                  font-weight: 600; padding: 4px 2px 10px; display: flex; align-items: center; gap: 8px; }
    .step { width: 18px; height: 18px; border-radius: 50%; background: var(--accent); color: #fff;
            font-size: 10.5px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }

    /* ── left: Source ── */
    .pane.left .inner { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 12px; }
    .dropzone { border: 2px dashed #3a3a44; border-radius: 14px; padding: 30px 18px; text-align: center;
                color: var(--dim); font-size: 12.5px; cursor: pointer; transition: .15s; }
    .dropzone b { color: var(--text); font-weight: 600; }
    .dropzone.over { border-color: var(--accent); background: rgba(0,120,212,.07); color: var(--text); }
    .pane.left .hint { font-size: 11px; color: var(--dim); line-height: 1.55; }

    /* ── center: editor + paper preview ── */
    .lg-tabs { display: flex; gap: 2px; margin-bottom: 10px; }
    .lg-tabs button { background: transparent; border: none; color: var(--dim); font-size: 12px; font-weight: 600;
                      padding: 6px 14px; border-radius: 8px; cursor: pointer; }
    .lg-tabs button:hover { color: var(--text); background: var(--pane2); }
    .lg-tabs button.on { background: var(--pane2); color: var(--text); }
    .lg-row { display: flex; gap: 14px; flex: 1; min-height: 0; }
    .editor-wrap { position: relative; display: flex; flex-direction: column; flex: 1; min-width: 0;
                   background: var(--pane2); border-radius: 12px; overflow: hidden; }
    .editor-wrap textarea { flex: 1; width: 100%; background: transparent; color: var(--text); border: none;
                            outline: none; resize: none; padding: 18px; padding-bottom: 52px;
                            font-family: "Cascadia Mono", Consolas, monospace; font-size: 13px; line-height: 1.6; }
    .pill { position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%); z-index: 5;
            display: flex; align-items: center; gap: 2px; background: #1a1a1f; border: 1px solid var(--line);
            border-radius: 999px; padding: 5px 8px; box-shadow: 0 8px 24px rgba(0,0,0,.45); white-space: nowrap; }
    .pill button { background: transparent; border: none; color: var(--dim); font-size: 11.5px; font-weight: 700;
                   padding: 4px 8px; border-radius: 999px; cursor: pointer; }
    .pill button:hover { color: #fff; background: #2b2b33; }
    .pill .sep { width: 1px; height: 14px; background: var(--line); margin: 0 3px; }
    .pill .words { color: var(--dim); font-size: 10.5px; padding: 0 8px; font-weight: 400; }

    .preview-wrap { position: relative; flex: 1; min-width: 0; display: flex; flex-direction: column;
                    background: var(--pane); border-radius: 12px; overflow: hidden; }
    .lg-preview { flex: 1; overflow: auto; padding: 22px; }
    .paper { background: #ffffff; color: #1a1a1a; max-width: 820px; margin: 0 auto; padding: 46px 54px;
             box-shadow: 0 6px 30px rgba(0,0,0,.5); border-radius: 2px; font-size: 13.5px; line-height: 1.6; }
    .paper h1, .paper h2 { border-bottom: 1px solid #d0d7de; padding-bottom: 5px; color: #1a1a1a; }
    .paper table { border-collapse: collapse; margin: 12px 0; }
    .paper td, .paper th { border: 1px solid #d0d7de; padding: 5px 12px; }
    .paper pre { background: #f6f8fa; border: 1px solid #d0d7de; border-radius: 8px; padding: 12px; overflow: auto; color: #24292f; }
    .paper code { background: #eff1f3; border-radius: 4px; padding: 1px 5px; color: #24292f; }
    .paper pre code { background: transparent; padding: 0; }
    .paper blockquote { border-left: 3px solid #d0d7de; margin-left: 0; padding-left: 14px; color: #57606a; }
    .paper a { color: #0969da; }
    .paper hr { border: none; border-top: 1px solid #d0d7de; }

    /* portal eye overlay */
    .portal { position: absolute; inset: 0; z-index: 20; background: rgba(27,27,31,.95); display: flex;
              flex-direction: column; }
    .portal .bar { font-size: 10.5px; color: var(--accent-hi); padding: 8px 14px; letter-spacing: .8px;
                   font-weight: 600; text-transform: uppercase; border-bottom: 1px solid var(--line); }
    .portal textarea { flex: 1; width: 100%; background: transparent; color: #cfe9ff; border: none; outline: none;
                       resize: none; padding: 16px; font-family: "Cascadia Mono", Consolas, monospace; font-size: 13px; line-height: 1.6; }

    /* ── right: Style & Export ── */
    .pane.right .inner { flex: 1; min-height: 0; overflow: auto; display: flex; flex-direction: column; gap: 10px;
                         padding-right: 2px; }
    details.group { background: var(--pane2); border-radius: 12px; overflow: hidden; }
    details.group > summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 8px;
                              padding: 11px 14px; font-weight: 600; font-size: 12.5px; user-select: none; color: var(--text); }
    details.group > summary::-webkit-details-marker { display: none; }
    details.group > summary .chev { margin-left: auto; color: var(--dim); transition: transform .15s; font-size: 9px; }
    details.group[open] > summary .chev { transform: rotate(90deg); }
    details.group .group-body { padding: 2px 14px 14px; display: flex; flex-direction: column; gap: 12px; }
    .field-row { display: flex; align-items: center; gap: 10px; justify-content: space-between; }
    .field-row label { font-size: 12px; color: var(--text); }
    .field-row .hint, .group-body .hint { font-size: 11px; color: var(--dim); line-height: 1.5; }
    select, input[type=number] { background: #1a1a1f; color: var(--text); border: 1px solid var(--line);
        border-radius: 7px; padding: 5px 9px; font-size: 12px; }
    select:focus, input[type=number]:focus { outline: none; border-color: var(--accent); }
    .switch { position: relative; width: 40px; height: 21px; flex: none; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .switch .sl { position: absolute; inset: 0; background: #3c3c46; border-radius: 20px; transition: .15s; }
    .switch .sl::before { content: ""; position: absolute; width: 15px; height: 15px; left: 3px; top: 3px;
                          background: #fff; border-radius: 50%; transition: .15s; }
    .switch input:checked + .sl { background: var(--accent); }
    .switch input:checked + .sl::before { transform: translateX(19px); }

    /* ── status bar / finish line ── */
    .statusbar { display: flex; align-items: center; gap: 14px; padding: 9px 20px; border-top: 1px solid var(--line);
                 font-size: 11.5px; color: var(--dim); flex: none; }
    .statusbar .spacer { flex: 1; }
    .statusbar .gen { background: var(--accent); color: #fff; border: none; border-radius: 8px; padding: 8px 18px;
                      font-size: 12.5px; font-weight: 700; cursor: pointer; }
    .statusbar .gen:hover { background: var(--accent-hi); }
    .statusbar .gen:disabled { opacity: .5; cursor: not-allowed; }
    .statusbar .ghost { background: transparent; border: 1px solid var(--line); color: var(--text);
                        border-radius: 8px; padding: 7px 14px; font-size: 12px; cursor: pointer; }
    .statusbar .ok { color: #3fb950; }
    .statusbar .err { color: #f85149; }
</style>

<div class="shell">
    <!-- Slim top bar -->
    <div class="topbar">
        <span class="logo">M</span>
        <h1>Marksmith</h1>
        <div class="spacer"></div>
        <button @onclick="LoadSample">Load sample</button>
        <button @onclick="Clear">Clear</button>
    </div>

    <div class="body">
        <!-- 1 · Source -->
        <aside class="pane left">
            <div class="pane-title"><span class="step">1</span> Source</div>
            <div class="inner">
                <div class="dropzone" id="dropZone">
                    <b>Drop a .md file here</b><br />
                    or paste into the editor
                </div>
                <div class="hint">Your document autosaves as you type and resumes on reload. Mermaid diagrams in the preview are rebuilt as native Word shapes on export.</div>
            </div>
        </aside>

        <!-- 2 · Editor & Preview -->
        <main class="pane center">
            <div class="pane-title"><span class="step">2</span> Editor &amp; Preview</div>
            <div class="lg-tabs">
                <button class="@TabClass(ViewCode)" @onclick="() => SetView(ViewCode)">Code</button>
                <button class="@TabClass(ViewSplit)" @onclick="() => SetView(ViewSplit)">Split</button>
                <button class="@TabClass(ViewPreview)" @onclick="() => SetView(ViewPreview)">Preview</button>
            </div>
            <div class="lg-row">
                @if (view != ViewPreview)
                {
                    <div class="editor-wrap" style="@(view == ViewCode ? "flex: 1;" : "flex: 1;")">
                        <textarea @ref="editorRef" @bind="markdown" @bind:event="oninput" spellcheck="false"></textarea>
                        <div class="pill">
                            <span class="words">@wordCount words</span>
                            <span class="sep"></span>
                            <button @onclick="() => Insert(MdB, MdB)" title="Bold">B</button>
                            <button @onclick="() => Insert(MdI, MdI)" title="Italic">I</button>
                            <button @onclick="() => Insert(MdH1, MdH1)" title="Heading 1">H1</button>
                            <button @onclick="() => Insert(MdH2, MdH2)" title="Heading 2">H2</button>
                            <button @onclick="() => Insert(MdH3, MdH3)" title="Heading 3">H3</button>
                            <span class="sep"></span>
                            <button @onclick="() => Insert(MdList, MdList)" title="Bullet list">List</button>
                            <button @onclick="() => Insert(MdNum, MdNum)" title="Numbered list">1.</button>
                            <button @onclick="() => Insert(MdTable, MdTable)" title="Table">Table</button>
                            <button @onclick="() => Insert(MdLink, MdLink)" title="Link">Link</button>
                            <button @onclick="() => Insert(MdCode, MdCode)" title="Inline code">Code</button>
                            <button @onclick="() => Insert(MdSmart, MdSmart)" title="Insert SmartArt block">SmartArt</button>
                            <span class="sep"></span>
                            <button @onclick="TogglePortal" title="Looking Glass portal — edit raw Markdown over the preview"
                                    style="@(portalOn ? "color:var(--accent-hi)" : "")">Eye</button>
                        </div>
                    </div>
                }
                @if (view != ViewCode)
                {
                    <div class="preview-wrap" style="@(view == ViewPreview ? "flex: 1;" : "flex: 1;")">
                        <div class="lg-preview">
                            <div class="paper">@((MarkupString)renderedHtml)</div>
                        </div>
                        @if (portalOn)
                        {
                            <div class="portal">
                                <div class="bar">Looking Glass portal — source over the rendered preview</div>
                                <textarea @bind="markdown" @bind:event="oninput" spellcheck="false" autofocus></textarea>
                            </div>
                        }
                    </div>
                }
            </div>
        </main>

        <!-- 3 · Style & Export -->
        <aside class="pane right">
            <div class="pane-title"><span class="step">3</span> Style &amp; Export</div>
            <div class="inner">
                <details class="group" open>
                    <summary>Appearance <span class="chev">▶</span></summary>
                    <div class="group-body">
                        <div class="field-row">
                            <label>Theme</label>
                            <select @bind="settings.Theme" @bind:after="OnSettingsChanged" style="width:150px">
                                @foreach (var t in Themes)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                        <div class="field-row">
                            <label>Page width (px)</label>
                            <input type="number" style="width:90px" @bind="settings.ContentWidth" @bind:after="OnSettingsChanged" min="400" max="2400" />
                        </div>
                        <div class="field-row">
                            <label>A4 lock</label>
                            <label class="switch"><input type="checkbox" @bind="settings.A4FixedWidth" @bind:after="OnSettingsChanged" /><span class="sl"></span></label>
                        </div>
                    </div>
                </details>

                <details class="group" open>
                    <summary>Formatting &amp; text <span class="chev">▶</span></summary>
                    <div class="group-body">
                        <div class="field-row">
                            <label>Heading level shift</label>
                            <input type="number" style="width:70px" @bind="settings.HeadingShift" @bind:after="OnSettingsChanged" min="-5" max="5" />
                        </div>
                        <div class="field-row">
                            <label>Bold</label>
                            <select style="width:130px" @bind="settings.BoldMode" @bind:after="OnSettingsChanged">
                                <option value="0">Keep</option>
                                <option value="1">Remove</option>
                                <option value="2">To italic</option>
                            </select>
                        </div>
                        <div class="field-row">
                            <label>Italic</label>
                            <select style="width:130px" @bind="settings.ItalicMode" @bind:after="OnSettingsChanged">
                                <option value="0">Keep</option>
                                <option value="1">Remove</option>
                            </select>
                        </div>
                        <div class="field-row">
                            <label>Em dashes</label>
                            <select style="width:130px" @bind="settings.DashMode" @bind:after="OnSettingsChanged">
                                <option value="0">Keep as-is</option>
                                <option value="1">To hyphen</option>
                                <option value="2">Spaced ( - )</option>
                                <option value="3">Custom…</option>
                            </select>
                        </div>
                        <div class="field-row">
                            <label>No emoji mode</label>
                            <label class="switch"><input type="checkbox" @bind="settings.NoEmoji" @bind:after="OnSettingsChanged" /><span class="sl"></span></label>
                        </div>
                    </div>
                </details>

                <details class="group" open>
                    <summary>Content &amp; cleanup <span class="chev">▶</span></summary>
                    <div class="group-body">
                        <div class="field-row">
                            <label>Normalize AI quirks</label>
                            <label class="switch"><input type="checkbox" @bind="settings.NormalizeLlm" @bind:after="OnSettingsChanged" /><span class="sl"></span></label>
                        </div>
                        <div class="hint">Detects the assistant (ChatGPT, Gemini, Claude, Copilot), repairs copy artifacts, and normalizes its formatting quirks — same engine as the desktop app.</div>
                    </div>
                </details>

                <details class="group">
                    <summary>SmartArt <span class="chev">▶</span></summary>
                    <div class="group-body">
                        <div class="hint">Include a <code>:::smartart type="hierarchy"</code> block (nested <code>- </code> bullets) in your Markdown. It previews as a diagram and exports as native Word SmartArt — 176 layouts.</div>
                    </div>
                </details>
            </div>
        </aside>
    </div>

    <!-- Finish line -->
    <div class="statusbar">
        <span>WebAssembly · zero server · offline</span>
        @if (classificationLabel.Length > 0)
        {
            <span>@classificationLabel</span>
        }
        <div class="spacer"></div>
        @if (exporting)
        {
            <span>Converting…</span>
        }
        else if (exportStatus is { Length: > 0 })
        {
            <span class="@(exportOk ? "ok" : "err")">@exportStatus</span>
        }
        <button class="ghost" disabled="@exporting" @onclick="ExportEpub">EPUB</button>
        <button class="gen" disabled="@exporting" @onclick="ExportDocx">Generate Word (.docx)</button>
    </div>
</div>

@code {
    private string markdown = @"# Executive Technical Overview

## Architecture

This document is compiled **natively in your browser** — Markdown in, schema-valid Word OOXML out. Zero server, zero desktop app.

| Feature | Status | Engine |
|---|---|---|
| Pipe Tables | ✅ | Markdig |
| Math | $E = mc^2$ | KaTeX |
| Diagrams | ```mermaid
flowchart TD
    A[Source] --> B[Style] --> C[Export]
``` | mermaid |
| SmartArt | :::smartart type=""hierarchy"" | 176 native layouts |

> [!NOTE]
> The cleanup engine runs first: heading shift, bold/italic modes, em-dash handling and no-emoji all apply to the preview *and* the export — exactly like the desktop app.

:::smartart type=""hierarchy""
- Executive Board
  - Engineering
    - Backend
    - Frontend
  - Product
:::
";

    private string view = "split";
    private const string ViewCode = "code";
    private const string ViewSplit = "split";
    private const string ViewPreview = "preview";
    private string TabClass(string v) => view == v ? "on" : "";

    private bool portalOn;
    private ElementReference editorRef;
    private DotNetObjectReference<MarkdownEditor>? _ref;

    private const string MdB = "**";
    private const string MdI = "*";
    private const string MdH1 = "# ";
    private const string MdH2 = "## ";
    private const string MdH3 = "### ";
    private const string MdList = "- ";
    private const string MdNum = "1. ";
    private const string MdTable = "| Col A | Col B |\n| --- | --- |\n|  |  |";
    private const string MdLink = "[text](url)";
    private const string MdCode = "`";
    private const string MdSmart = "\n\n:::smartart type=\"hierarchy\"\n- Item\n  - Sub\n:::";

    private async Task Insert(string before, string after)
    {
        try { await JS.InvokeVoidAsync("marksmithInsertAtCaret", editorRef, before, after); } catch { /* editor hidden */ }
    }

    private void TogglePortal() => portalOn = !portalOn;

    [JSInvokable]
    public void LoadDroppedFile(string text)
    {
        if (!string.IsNullOrWhiteSpace(text))
        {
            markdown = text;
            exportStatus = null;
        }
    }

    private readonly AppSettings settings = new();
    private bool settingsLoaded;
    private bool exporting;
    private string? exportStatus;
    private bool exportOk;
    private string classificationLabel = "";
    private string _lastSavedDraft = "";

    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .UsePipeTables()
        .UseMathematics()
        .UseEmphasisExtras()
        .UseAutoLinks()
        .UseTaskLists()
        .UseGenericAttributes()
        .Build();

    private static readonly Regex SmartArtBlock = new(
        @"(?s)(?:\A|\n\n)\s*:::smartart\s+type=""([^""]+)""\s*\r?\n(.*?)\r?\n:::\s*",
        RegexOptions.Compiled);

    private IEnumerable<string> Themes
    {
        get
        {
            try
            {
                return AppServices.Themes.All.Select(t => t.Name).Distinct().OrderBy(n => n);
            }
            catch
            {
                return new[] { "Default", "GitHub Light", "GitHub Dark", "Solarized Light", "Dracula", "Obsidian" };
            }
        }
    }

    private int charCount => markdown?.Length ?? 0;
    private int wordCount => string.IsNullOrWhiteSpace(markdown) ? 0
        : markdown.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;

    protected override async Task OnInitializedAsync()
    {
        var store = new WasmSettingsStore(JS);
        var saved = await store.LoadAsync();
        CopySettings(saved, settings);
        if (string.IsNullOrWhiteSpace(settings.Theme)) settings.Theme = "GitHub Light";
        try
        {
            var draft = await JS.InvokeAsync<string>("marksmithStorageGet", "marksmith.draft");
            if (!string.IsNullOrWhiteSpace(draft)) markdown = draft;
        }
        catch { /* first run */ }
        settingsLoaded = true;
    }

    private static void CopySettings(AppSettings from, AppSettings to)
    {
        to.Theme = from.Theme;
        to.ContentWidth = from.ContentWidth;
        to.A4FixedWidth = from.A4FixedWidth;
        to.HeadingShift = from.HeadingShift;
        to.BoldMode = from.BoldMode;
        to.ItalicMode = from.ItalicMode;
        to.NoEmoji = from.NoEmoji;
        to.DashMode = from.DashMode;
        to.DashCustom = from.DashCustom;
        to.NormalizeLlm = from.NormalizeLlm;
    }

    private void SetView(string v) => view = v;

    private async void OnSettingsChanged()
    {
        if (!settingsLoaded) return;
        if (settings.A4FixedWidth) settings.ContentWidth = 794;
        try
        {
            await new WasmSettingsStore(JS).SaveAsync(settings);
        }
        catch { /* persistence is best-effort */ }
        StateHasChanged();
    }

    // ── the full desktop preview pipeline, client-side ──────────────────────
    private string renderedHtml
    {
        get
        {
            try
            {
                var md = markdown ?? "";

                try
                {
                    var classification = AppServices.LlmSource.Classify(md);
                    classificationLabel = classification.Source == LlmSource.Generic
                        ? ""
                        : $"{classification.SourceDescription} · {classification.Confidence}%";
                    (md, _) = AppServices.LlmSource.RepairArtifacts(md, classification);
                    if (settings.NormalizeLlm)
                        (md, _) = AppServices.LlmSource.NormalizeStyle(md, classification);
                }
                catch
                {
                    classificationLabel = "";
                }

                var smartArt = new List<(string Alias, string Inner)>();
                md = SmartArtBlock.Replace(md, m =>
                {
                    smartArt.Add((m.Groups[1].Value.Trim().ToLowerInvariant(), m.Groups[2].Value.Trim()));
                    return $"\n\n<!--SMARTART:{smartArt.Count - 1}-->\n\n";
                });

                md = FormattingService.Apply(md, settings);
                md = DialectNormalizer.Apply(md, settings.DashMode);
                md = DashReplacer.Apply(md, settings.DashMode, settings.DashCustom);

                var body = Markdown.ToHtml(md, Pipeline);
                if (settings.NoEmoji) body = EmojiStripper.Strip(body);

                for (int i = 0; i < smartArt.Count; i++)
                {
                    try
                    {
                        var ast = MarkdownAstParser.Parse(smartArt[i].Inner);
                        var pkg = SmartArtLayoutCatalog.Shared.TryResolve(smartArt[i].Alias);
                        string alias = pkg != null ? smartArt[i].Alias : "hierarchy";
                        var svg = HtmlPreviewRenderer.RenderHtml(ast, alias, pkg?.Title ?? alias);
                        body = body.Replace($"<!--SMARTART:{i}-->", $"<div class=\"border rounded p-2 my-2\" style=\"background:#f8f9fa\">{svg}</div>");
                    }
                    catch
                    {
                        body = body.Replace($"<!--SMARTART:{i}-->", "<div class=\"text-danger\">SmartArt could not render.</div>");
                    }
                }
                return body;
            }
            catch (Exception ex)
            {
                return $"<div class=\"text-danger\">Preview error: {ex.Message}</div>";
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ref = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("marksmithInitDropZone", "dropZone", _ref); } catch { /* drop zone best-effort */ }
        }
        if (markdown != _lastSavedDraft)
        {
            _lastSavedDraft = markdown;
            try { await JS.InvokeVoidAsync("marksmithStorageSet", "marksmith.draft", markdown); } catch { /* best effort */ }
        }
        try { await JS.InvokeVoidAsync("marksmithEnhancePreview"); } catch { /* best effort */ }
    }

    // ── exports ──────────────────────────────────────────────────────────────
    private async Task ExportDocx()
    {
        if (string.IsNullOrWhiteSpace(markdown)) { exportStatus = "Nothing to export — type or paste Markdown first."; exportOk = false; return; }
        await RunExport("marksmith-export.docx", async (path) =>
        {
            List<HarvestedDiagram>? geometry = null;
            try
            {
                var json = await JS.InvokeAsync<string>("marksmithHarvestMermaid");
                if (!string.IsNullOrWhiteSpace(json))
                {
                    var parsed = JsonSerializer.Deserialize<List<HarvestedDiagram>>(json);
                    if (parsed is { Count: > 0 }) geometry = parsed;
                }
            }
            catch { /* no preview rendered — export without geometry */ }
            await new DocxExportService().ExportAsync(markdown, path, settings, null, null, geometry);
        });
    }

    private async Task ExportEpub()
    {
        if (string.IsNullOrWhiteSpace(markdown)) { exportStatus = "Nothing to export — type or paste Markdown first."; exportOk = false; return; }
        await RunExport("marksmith-export.epub", (path) => new EpubExportService().ExportAsync(markdown, path, settings));
    }

    private async Task RunExport(string filename, Func<string, Task> convert)
    {
        exporting = true;
        exportStatus = null;
        StateHasChanged();
        try
        {
            await convert(filename);
            var bytes = await System.IO.File.ReadAllBytesAsync(filename);
            await JS.InvokeVoidAsync("marksmithDownload", filename, bytes);
            exportStatus = $"Downloaded {filename} ({bytes.Length} bytes) — compiled natively in your browser.";
            exportOk = true;
        }
        catch (Exception ex)
        {
            exportStatus = $"Export failed: {ex.Message}";
            exportOk = false;
        }
        finally
        {
            exporting = false;
            StateHasChanged();
        }
    }


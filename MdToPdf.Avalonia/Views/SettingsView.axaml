<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:MdToPdf.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="640"
             x:Class="MdToPdf.Avalonia.Views.SettingsView"
             x:DataType="core:MainViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
        <StackPanel Spacing="14" MinWidth="460" MaxWidth="460" Margin="2,4,12,4">

            <!-- ===== General ===== -->
            <TextBlock Text="General" FontWeight="SemiBold" Opacity="0.7" />
            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="16,12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Advanced mode" />
                        <TextBlock Text="Show power-user styling options in the Style panel — cleanup controls and formatting transforms."
                                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AdvancedMode, Mode=TwoWay}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </Border>

            <!-- ===== Marksmith Pro (licensing) ===== -->
            <TextBlock Text="License" FontWeight="SemiBold" Opacity="0.7" Margin="0,6,0,0" />
            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding EditionStatus}" FontWeight="SemiBold" />
                    <TextBlock Text="Marksmith Pro unlocks DOCX export (with editable equations), hands-free automation, and removes the footer from your exports."
                               Opacity="0.7" FontSize="12" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="KeyBox" PlaceholderText="Paste your license key" Width="280" />
                        <Button x:Name="ActivateButton" Content="Activate" Click="OnActivateLicense" />
                    </StackPanel>
                    <SelectableTextBlock x:Name="LicenseStatus" Text="" Opacity="0.7" FontSize="12"
                                         TextWrapping="Wrap" IsVisible="False" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Click="OnBuyPro" Classes="accent" Content="Buy Marksmith Pro" />
                        <Button x:Name="DeactivateButton" Content="Remove license" Click="OnDeactivateLicense" IsVisible="False" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Plugins ===== -->
            <TextBlock Text="Plugins" FontWeight="SemiBold" Opacity="0.7" Margin="0,6,0,0" />
            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Optional, separately-downloaded capabilities. Nothing here is bundled with Marksmith — install only what you use."
                               Opacity="0.7" FontSize="12" TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="PlantUML Diagrams" FontWeight="SemiBold" />
                            <TextBlock Text="Renders ```plantuml / ```puml code blocks as diagrams. Downloads a private Java runtime + the PlantUML engine (~90 MB), isolated from any Java already on your system."
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" MaxWidth="320" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ui:FAProgressRing x:Name="PlantUmlInstallRing" IsActive="False" Width="18" Height="18" />
                            <Button x:Name="PlantUmlInstallButton" Content="Install" Click="OnInstallPlantUml" />
                            <Button x:Name="PlantUmlUninstallButton" Content="Remove" Click="OnUninstallPlantUml" IsVisible="False" />
                        </StackPanel>
                        <SelectableTextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="PlantUmlStatus" Text="" Opacity="0.7" FontSize="12"
                                             TextWrapping="Wrap" Margin="0,8,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== About & updates ===== -->
            <TextBlock Text="About &amp; updates" FontWeight="SemiBold" Opacity="0.7" Margin="0,6,0,0" />
            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Image Source="/Assets/logo.png" Width="44" Height="44" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Marksmith" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock x:Name="VersionText" Text="Version 1.0.0" Opacity="0.7" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Turn AI chats into polished documents." Opacity="0.8" />

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="CheckButton" Content="Check for updates" Click="OnCheckForUpdates" />
                        <ui:FAProgressRing x:Name="CheckRing" IsActive="False" Width="18" Height="18" />
                    </StackPanel>
                    <SelectableTextBlock x:Name="UpdateStatus" Text="" Opacity="0.7" FontSize="12"
                                         IsVisible="False" TextWrapping="Wrap" />
                    <HyperlinkButton x:Name="DownloadLink" Content="Download the latest release"
                                     IsVisible="False" Padding="0" />
                </StackPanel>
            </Border>

            <!-- ===== Links ===== -->
            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="8,4">
                <StackPanel>
                    <HyperlinkButton Content="GitHub repository" NavigateUri="https://github.com/thebubbsy/marksmith" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                    <HyperlinkButton Content="Releases &amp; changelog" NavigateUri="https://github.com/thebubbsy/marksmith/releases" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                    <HyperlinkButton Content="Report an issue" NavigateUri="https://github.com/thebubbsy/marksmith/issues" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                    <HyperlinkButton Content="License agreement (EULA)" NavigateUri="https://github.com/thebubbsy/marksmith/blob/main/LICENSE" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                    <HyperlinkButton Content="Third-party notices" NavigateUri="https://github.com/thebubbsy/marksmith/blob/main/THIRD-PARTY-NOTICES.md" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                </StackPanel>
            </Border>

            <TextBlock Text="© 2026 thebubbsy · All rights reserved · Built with Avalonia UI, .NET 10 and WebView"
                       Opacity="0.7" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

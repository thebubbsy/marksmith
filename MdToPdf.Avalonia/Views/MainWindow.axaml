<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:MdToPdf.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:webview="using:Avalonia.Controls"
        xmlns:conv="using:MdToPdf.Avalonia.Converters"
        xmlns:models="using:MdToPdf.Models"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="MdToPdf.Avalonia.Views.MainWindow"
        x:DataType="core:MainViewModel"
        Icon="/Assets/logo.png"
        Width="1280" Height="800"
        Title="Marksmith">

    <Window.Resources>
        <x:Double x:Key="IconFontSize">14</x:Double>
    </Window.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header bar: logo + title (stands in for the WinUI app's Mica custom title bar) -->
        <Border Grid.Row="0" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="/Assets/logo.png" Width="22" Height="22" />
                <TextBlock Text="Marksmith" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="·" Opacity="0.4" VerticalAlignment="Center" />
                <TextBlock Text="AI chats → polished documents" Opacity="0.55" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Spacing="6" Margin="16,8,16,0">
            <!-- Trial / upgrade banner -->
            <ui:FAInfoBar x:Name="LicenseBanner" IsOpen="False" IsClosable="True">
                <ui:FAInfoBar.ActionButton>
                    <Button Content="Upgrade to Pro" Click="OnUpgradeClick" />
                </ui:FAInfoBar.ActionButton>
            </ui:FAInfoBar>
        </StackPanel>

        <!-- Left-to-right pipeline: 1 Source -> 2 Style -> 3 Preview & Export -->
        <Grid Grid.Row="2" Margin="16,6,16,16" ColumnDefinitions="380,Auto,300,Auto,*">

            <!-- ============ 1 · SOURCE ============ -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource SystemAccentColor}">
                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Source" FontWeight="SemiBold" />
                        <TextBlock Text="Pick a file or paste Markdown" Opacity="0.6" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        DragDrop.AllowDrop="True" DragDrop.DragOver="OnSourceDragOver" DragDrop.Drop="OnSourceDrop">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14" Spacing="12">

                            <!-- File / Paste tab switch (SelectorBar equivalent) -->
                            <StackPanel Orientation="Horizontal" Spacing="0">
                                <ToggleButton x:Name="FileTab" Content="File" Click="OnFileTabClick"
                                              IsChecked="{Binding !UsePasteSource}" CornerRadius="4,0,0,4" />
                                <ToggleButton x:Name="PasteTab" Content="Paste" Click="OnPasteTabClick"
                                              IsChecked="{Binding UsePasteSource}" CornerRadius="0,4,4,0" />
                            </StackPanel>

                            <!-- File mode -->
                            <StackPanel x:Name="FilePanel" Spacing="12" IsVisible="{Binding !UsePasteSource}">
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16,24">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                        <TextBlock Text="Drop a .md file here" HorizontalAlignment="Center" Opacity="0.75" />
                                        <TextBlock Text="or" HorizontalAlignment="Center" Opacity="0.4" FontSize="12" />
                                        <Button Content="Browse files" Click="OnBrowseFileClick" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Selected file" FontSize="12" Opacity="0.7" />
                                    <TextBox Text="{Binding InputFilePath, Mode=TwoWay}" PlaceholderText="No file selected" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Recent &amp; found .md files" VerticalAlignment="Bottom" FontSize="12" Opacity="0.8" />
                                    <Button Grid.Column="1" x:Name="RescanButton" Click="OnRescanMarkdownClick" Padding="4,0" Classes="transparent">
                                        <TextBlock Text="Rescan" FontSize="12" />
                                    </Button>
                                </Grid>
                                <ComboBox x:Name="MarkdownFilesCombo" ItemsSource="{Binding MarkdownFiles}"
                                          SelectionChanged="OnMarkdownFileSelected" HorizontalAlignment="Stretch"
                                          PlaceholderText="Pick a Markdown file from your PC...">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock x:Name="ScanningLabel" Text="Scanning your files…" Opacity="0.6" FontSize="12" IsVisible="False" />
                            </StackPanel>

                            <!-- Paste mode -->
                            <Grid x:Name="PastePanel" RowDefinitions="*,Auto" IsVisible="{Binding UsePasteSource}" MinHeight="220">
                                <TextBox Grid.Row="0" MinHeight="180"
                                         Text="{Binding PastedMarkdown, Mode=TwoWay}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         FontFamily="Cascadia Mono,Consolas,monospace" FontSize="13"
                                         PlaceholderText="Paste or type Markdown here..."
                                         VerticalContentAlignment="Top" />
                                <TextBlock Grid.Row="1" Text="{Binding WordCountText}" HorizontalAlignment="Right" FontSize="12" Opacity="0.6" />
                            </Grid>

                            <!-- Automation: settings are shared with the desktop app's clipboard/folder/API watchers.
                                 NOTE: this Avalonia build does not yet run those watchers itself — the toggles persist
                                 the setting but only the WinUI build currently acts on it. -->
                            <Expander Header="Automation" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="10">
                                    <ToggleSwitch Content="Auto-ingest AI chats from clipboard"
                                                  OnContent="Watching" OffContent="Off"
                                                  IsChecked="{Binding AutoClipboardIngest, Mode=TwoWay}" />
                                    <ToggleSwitch Content="Auto-generate PDF from AI-chat ingests"
                                                  OnContent="On" OffContent="Off"
                                                  IsChecked="{Binding AutoConvertIngests, Mode=TwoWay}" />
                                    <ToggleSwitch Content="Append DOCX ingests to a running document"
                                                  OnContent="On" OffContent="Off"
                                                  IsChecked="{Binding AppendToRunningDoc, Mode=TwoWay}" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding RunningDocPath, Mode=TwoWay}"
                                                 PlaceholderText="e.g. C:\Docs\AI-notebook.docx" />
                                        <Button Grid.Column="1" Click="OnBrowseRunningDocClick" Content="…" />
                                    </Grid>
                                    <ToggleSwitch Content="Watch a folder for Markdown exports"
                                                  OnContent="Watching" OffContent="Off"
                                                  IsChecked="{Binding WatchFolderEnabled, Mode=TwoWay}" />
                                    <ToggleSwitch Content="Auto-convert watched files to PDF"
                                                  OnContent="Hands-free" OffContent="Ingest only"
                                                  IsChecked="{Binding WatchFolderAutoConvert, Mode=TwoWay}" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding WatchFolder, Mode=TwoWay}"
                                                 PlaceholderText="e.g. your Downloads folder" />
                                        <Button Grid.Column="1" Click="OnBrowseWatchFolderClick" Content="…" />
                                    </Grid>
                                    <ToggleSwitch Content="Local REST API" OnContent="Running" OffContent="Off"
                                                  IsChecked="{Binding ApiEnabled, Mode=TwoWay}" />
                                    <ui:FANumberBox Header="Port" Value="{Binding ApiPort, Mode=TwoWay}"
                                                  Minimum="1024" Maximum="65535" />
                                    <ToggleSwitch Content="Keep running in system tray when closed"
                                                  OnContent="Tray mode" OffContent="Off"
                                                  IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <TextBlock Grid.Column="1" Text="→" FontSize="20" Opacity="0.35" VerticalAlignment="Center" Margin="8,0" />

            <!-- ============ 2 · STYLE ============ -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource SystemAccentColor}">
                        <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Style" FontWeight="SemiBold" />
                        <TextBlock Text="Theme and page layout" Opacity="0.6" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" Spacing="14">

                            <!-- Export presets -->
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Preset" FontSize="12" Opacity="0.7" />
                                    <ComboBox x:Name="PresetsCombo" ItemsSource="{Binding Presets}" DisplayMemberBinding="{Binding Name}"
                                              PlaceholderText="Apply a saved preset…" HorizontalAlignment="Stretch"
                                              SelectionChanged="OnPresetSelected" />
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnSavePresetClick" Content="Save"
                                        ToolTip.Tip="Save current settings as a preset" Margin="4,0,0,0" />
                                <Button Grid.Column="2" VerticalAlignment="Bottom" Click="OnDeletePresetClick" Content="Del"
                                        ToolTip.Tip="Delete the selected preset" Margin="4,0,0,0" />
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource CardStrokeColorDefaultBrush}" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Theme" FontSize="12" Opacity="0.7" />
                                <ComboBox ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding SelectedThemeName, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <ui:FANumberBox Header="Page width (px)" Value="{Binding ContentWidth, Mode=TwoWay}"
                                          SpinButtonPlacementMode="Inline" Minimum="400" Maximum="2400" SmallChange="50" />

                            <Rectangle Height="1" Fill="{DynamicResource CardStrokeColorDefaultBrush}" />

                            <ToggleSwitch Content="Lock to A4 width" IsChecked="{Binding A4FixedWidth, Mode=TwoWay}" />
                            <ToggleSwitch Content="Single continuous page (no page breaks)"
                                          OnContent="On · PDF only" OffContent="Off"
                                          IsChecked="{Binding UnlimitedHeight, Mode=TwoWay}" />

                            <Rectangle Height="1" Fill="{DynamicResource CardStrokeColorDefaultBrush}" />

                            <TextBlock Text="AI documents" FontWeight="SemiBold" />
                            <ToggleSwitch Content="Normalize AI formatting quirks" IsChecked="{Binding NormalizeLlm, Mode=TwoWay}" />
                            <ToggleSwitch Content="Source attribution strip in export" IsChecked="{Binding ShowAttribution, Mode=TwoWay}" />
                            <ToggleSwitch Content="Table of contents" IsChecked="{Binding IncludeToc, Mode=TwoWay}" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Diagrams in Word exports" FontSize="12" Opacity="0.7" />
                                <ComboBox SelectedIndex="{Binding MermaidDocxMode, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Snapshot — picture of the diagram" />
                                    <ComboBoxItem Content="ShapeForge™ — editable Word shapes" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Large diagrams (won't fit a page)" FontSize="12" Opacity="0.7" />
                                <ComboBox SelectedIndex="{Binding OversizedDiagramMode, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Ask me each time" />
                                    <ComboBoxItem Content="Keep exact layout (Web Layout view)" />
                                    <ComboBoxItem Content="Reflow to fit the page" />
                                </ComboBox>
                            </StackPanel>

                            <Expander HorizontalAlignment="Stretch" Margin="0,10,0,0">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Export Branding" />
                                        <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="4" Padding="5,1"
                                                VerticalAlignment="Center" IsVisible="{Binding ShowProBadge}">
                                            <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Spacing="14">
                                    <ToggleSwitch Content="Include Cover Page (Logo, Title, Date)" IsChecked="{Binding BrandCoverPage, Mode=TwoWay}" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Company Logo (PNG/JPEG)" FontSize="12" Opacity="0.7" />
                                            <TextBox Text="{Binding BrandLogoPath, Mode=TwoWay}" PlaceholderText="Select logo image..." />
                                        </StackPanel>
                                        <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnBrowseLogoClick" Content="…" />
                                    </Grid>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Custom Document Font Family" FontSize="12" Opacity="0.7" />
                                        <TextBox Text="{Binding BrandFontFamily, Mode=TwoWay}" PlaceholderText="e.g. Segoe UI, Inter (leave blank for default)" />
                                    </StackPanel>
                                    <TextBlock Text="Requires Marksmith Pro license to apply to DOCX exports." Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Advanced" HorizontalAlignment="Stretch" Margin="0,4,0,0">
                                <StackPanel Spacing="14">
                                    <CheckBox Content="No emoji mode" IsChecked="{Binding NoEmoji, Mode=TwoWay}" />
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Em dashes (—)" FontSize="12" Opacity="0.7" />
                                        <ComboBox SelectedIndex="{Binding DashMode, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Keep as-is" />
                                            <ComboBoxItem Content="Replace with hyphen (-)" />
                                            <ComboBoxItem Content="Replace with spaced ( - )" />
                                            <ComboBoxItem Content="Custom…" />
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBox PlaceholderText="Custom replacement (used when 'Custom…' is selected)"
                                             Text="{Binding DashCustom, Mode=TwoWay}" />

                                    <Rectangle Height="1" Fill="{DynamicResource CardStrokeColorDefaultBrush}" />
                                    <TextBlock Text="Formatting" FontWeight="SemiBold" />

                                    <ui:FANumberBox Header="Heading level shift" Value="{Binding HeadingShift, Mode=TwoWay}"
                                                  SpinButtonPlacementMode="Inline" Minimum="-5" Maximum="5" SmallChange="1" />

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Bold" FontSize="12" Opacity="0.7" />
                                        <ComboBox SelectedIndex="{Binding BoldMode, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Keep" />
                                            <ComboBoxItem Content="Remove (plain text)" />
                                            <ComboBoxItem Content="Convert to italic" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Italic" FontSize="12" Opacity="0.7" />
                                        <ComboBox SelectedIndex="{Binding ItalicMode, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Keep" />
                                            <ComboBoxItem Content="Remove (plain text)" />
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <TextBlock Grid.Column="3" Text="→" FontSize="20" Opacity="0.35" VerticalAlignment="Center" Margin="8,0" />

            <!-- ============ 3 · PREVIEW & EXPORT ============ -->
            <Grid Grid.Column="4" RowDefinitions="Auto,*,Auto,Auto,Auto">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource SystemAccentColor}">
                            <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Preview &amp; export" FontWeight="SemiBold" />
                            <TextBlock Text="Live preview of the final document" Opacity="0.6" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border CornerRadius="12" Padding="10,4" Background="{DynamicResource AccentFillColorSecondaryBrush}"
                                VerticalAlignment="Center" IsVisible="{Binding DetectedSourceText, Converter={x:Static conv:StringNotEmptyConverter.Instance}}">
                            <TextBlock Text="{Binding DetectedSourceText}" FontSize="12" Foreground="White" />
                        </Border>
                        <Button ToolTip.Tip="Export history">
                            <TextBlock Text="History" FontSize="12" />
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <Grid RowDefinitions="Auto,*" Width="380">
                                        <TextBlock Grid.Row="0" Text="Export history" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <ListBox x:Name="HistoryList" Grid.Row="1" MaxHeight="420"
                                                 SelectionChanged="OnHistoryItemSelected">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:HistoryEntry">
                                                    <StackPanel Margin="0,6" Spacing="2">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Click="OnSettingsClick" ToolTip.Tip="Settings" Content="Settings" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,10">
                    <webview:NativeWebView x:Name="PreviewWebView" Margin="1" />
                </Border>

                <ui:FAInfoBar Grid.Row="2" IsOpen="True" IsClosable="False"
                            Severity="{Binding StatusSeverity, Converter={x:Static conv:StatusSeverityConverter.Instance}}"
                            Message="{Binding StatusText}" />

                <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                    <TextBox Grid.Column="0" Text="{Binding OutputFolder, Mode=TwoWay}"
                             PlaceholderText="Output folder (defaults to next to the input file)"
                             ToolTip.Tip="Output folder" />
                    <Button Grid.Column="1" VerticalAlignment="Stretch" Click="OnBrowseFolderClick"
                            ToolTip.Tip="Choose output folder" Content="…" Margin="4,0,0,0" />
                    <Button Grid.Column="2" VerticalAlignment="Stretch" Click="OnOpenOutputClick"
                            IsEnabled="{Binding HasOutput}" ToolTip.Tip="Open last output" Content="Open output" Margin="4,0,0,0" />
                </Grid>

                <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,Auto,Auto" Margin="0,8,0,0">
                    <Button Grid.Column="0" Height="40" Classes="accent"
                            Click="OnConvertPdfClick" IsEnabled="{Binding IsNotBusy}" Content="Generate PDF" FontWeight="SemiBold" />
                    <Button Grid.Column="1" Height="40" Click="OnConvertDocxClick" IsEnabled="{Binding IsNotBusy}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Export DOCX" />
                            <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="4" Padding="5,1"
                                    VerticalAlignment="Center" IsVisible="{Binding ShowProBadge}">
                                <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Height="40" Content="Cancel" Margin="8,0,0,0"
                            Command="{Binding CancelConversionCommand}" IsEnabled="{Binding IsBusy}" />
                    <ui:FAProgressRing Grid.Column="3" IsActive="{Binding IsBusy}" Width="22" Height="22"
                                  VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

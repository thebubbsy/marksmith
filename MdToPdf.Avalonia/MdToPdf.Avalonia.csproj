<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MdToPdf.Avalonia</RootNamespace>
    <AssemblyName>Marksmith</AssemblyName>
    <Version>1.4.1</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\web\**" />
    <!-- Bundled web assets (mermaid, KaTeX + fonts, highlight.js) — served to NativeWebView from a
         loopback HTTP server (see Services\LocalAssetServer.cs), not embedded as avares:// resources,
         since they need to be real files reachable over HTTP for <script src> tags to load. -->
    <Content Include="Assets\web\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <!-- WinUI/Fluent-parity control set (InfoBar, NumberBox, SymbolIcon, ProgressRing) plus a
         FluentAvaloniaTheme that mirrors WinUI's look, so the port doesn't need to hand-build
         replacements for controls Avalonia's own theme doesn't ship. -->
    <PackageReference Include="FluentAvaloniaUI" Version="3.0.1" />
    <!-- Cross-platform native web view (WebView2/WebKit/WebKitGTK) — MIT, first-party AvaloniaUI.
         Drives live preview, PDF export (PrintToPdfStreamAsync) and mermaid harvesting, mirroring
         the WinUI app's WebView2 usage. See MdToPdf.Core/Rendering/IWebRenderHost.cs. -->
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
    <!-- Windows-only escape hatch out of Avalonia.Controls.WebView's page-size-less print API (see
         the long comment on MainWindow.axaml.cs's PrintToPdfAsync): NativeWebView.TryGetPlatformHandle()
         hands back the raw native ICoreWebView2 COM pointer on Windows, and
         CoreWebView2.CreateFromComICoreWebView2(ptr) wraps it in the same managed type WinUI's own
         MainWindow.xaml.cs already drives directly, with the same PageWidth/PageHeight-capable
         CreatePrintSettings()/PrintToPdfAsync API. Same version as MdToPdf/MdToPdf.csproj. Purely
         managed COM-interop code (no Windows-specific TFM needed) — safe to reference unconditionally;
         it's simply never touched on Linux/macOS thanks to the OperatingSystem.IsWindows() guard. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Platform-agnostic engine (Models/Services/ViewModels) shared with the WinUI app. -->
    <ProjectReference Include="..\MdToPdf.Core\MdToPdf.Core.csproj" />
  </ItemGroup>
</Project>

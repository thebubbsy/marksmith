{
    "manifest_version": 3,
    "name": "Marksmith Connector",
    "version": "1.3.0",
    "description": "Send ChatGPT / Gemini / Claude replies to Marksmith as Markdown, plus optional transparent AI-usage governance for managed organizations.",
    "permissions": ["contextMenus", "notifications", "storage", "scripting", "activeTab"],
    "host_permissions": ["http://127.0.0.1/*"],
    "background": { "service_worker": "background.js" },
    "action": {
        "default_title": "Send latest AI reply to Marksmith",
        "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
    },
    "content_scripts": [
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://chat.openai.com/*",
                "https://gemini.google.com/*",
                "https://claude.ai/*"
            ],
            "js": ["governance.js", "autosend.js"],
            "run_at": "document_idle"
        }
    ],
    "storage": { "managed_schema": "managed_schema.json" },
    "options_page": "options.html",
    "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}

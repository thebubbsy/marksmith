<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MarkSmith.WebApp.Server</RootNamespace>
    <AssemblyName>marksmith-webapp-server</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same OpenXml SDK version the (untouched) MarkSmith.Core pins: 3.1.0. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.1.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The collaboration server deliberately does NOT reference MarkSmith.Core. Per the v1
      architecture, Core is a black box we never modify, and the only safe surface for applying
      live edits is the OpenXml SDK's public API directly. The server loads DOCX bytes, mutates
      the in-memory WordprocessingDocument, validates it, renders full HTML, and saves bytes,
      all through DocumentFormat.OpenXml. Core's markdown to docx pipeline is out of scope here.
    -->
  </ItemGroup>

</Project>

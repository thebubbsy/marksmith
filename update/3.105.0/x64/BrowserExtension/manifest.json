{
    "manifest_version": 3,
    "name": "Marksmith Connector",
    "version": "3.4.0",
    "description": "Turn AI chats into polished PDF/DOCX/PPTX/EPUB or a ready-to-send Outlook email — send to Marksmith, download, or email straight from ChatGPT, Gemini, Claude and Copilot.",
    "permissions": [
        "contextMenus",
        "notifications",
        "storage",
        "scripting",
        "activeTab",
        "downloads",
        "alarms",
        "tabs"
    ],
    "host_permissions": [
        "http://127.0.0.1/*"
    ],
    "optional_host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Marksmith — open the control center",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://chat.openai.com/*",
                "https://gemini.google.com/*",
                "https://claude.ai/*",
                "https://copilot.microsoft.com/*"
            ],
            "js": [
                "selectors.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://chat.openai.com/*",
                "https://gemini.google.com/*",
                "https://claude.ai/*",
                "https://copilot.microsoft.com/*"
            ],
            "js": [
                "autosend.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://chat.openai.com/*",
                "https://gemini.google.com/*",
                "https://claude.ai/*",
                "https://copilot.microsoft.com/*"
            ],
            "js": [
                "copybutton.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "commands": {
        "email-latest-reply": {
            "suggested_key": {
                "default": "Alt+Shift+E"
            },
            "description": "Email the latest AI reply as an Outlook draft"
        }
    },
    "storage": {
        "managed_schema": "managed_schema.json"
    },
    "options_page": "options.html",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}

<?xml version="1.0" encoding="utf-8"?>
<dgm:layoutDef xmlns:dgm="http://schemas.openxmlformats.org/drawingml/2006/diagram"
               xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"
               uniqueId="urn:microsoft.com/office/officeart/2005/8/layout/matrix1"
               title="Basic Matrix"
               desc="Grid matrix layout"
               clrgName="Colorful"
               clrType="colorful">
  <dgm:title val="Basic Matrix"/>
  <dgm:desc val="Grid matrix layout"/>
  <dgm:catLst>
    <dgm:cat type="matrix" pri="1"/>
  </dgm:catLst>
  <dgm:layoutNode name="diagram">
    <dgm:alg type="grid"/>
    <dgm:shape type="rect"/>
    <dgm:forEach axis="ch" refNode="node">
      <dgm:layoutNode name="node">
        <dgm:alg type="tx"/>
        <dgm:shape type="rect"/>
        
      </dgm:layoutNode>
    </dgm:forEach>
  </dgm:layoutNode>
</dgm:layoutDef>
<?xml version="1.0" encoding="utf-8"?>
<dgm:layoutDef xmlns:dgm="http://schemas.openxmlformats.org/drawingml/2006/diagram"
               xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"
               uniqueId="urn:microsoft.com/office/officeart/2005/8/layout/cycle1"
               title="Basic Cycle"
               desc="Circular process layout"
               clrgName="Colorful"
               clrType="colorful">
  <dgm:title val="Basic Cycle"/>
  <dgm:desc val="Circular process layout"/>
  <dgm:catLst>
    <dgm:cat type="cycle" pri="1"/>
  </dgm:catLst>
  <dgm:layoutNode name="diagram">
    <dgm:alg type="cycle"/>
    <dgm:shape type="circle"/>
    <dgm:forEach axis="ch" refNode="node">
      <dgm:layoutNode name="node">
        <dgm:alg type="tx"/>
        <dgm:shape type="circle"/>
        
      </dgm:layoutNode>
    </dgm:forEach>
  </dgm:layoutNode>
</dgm:layoutDef>
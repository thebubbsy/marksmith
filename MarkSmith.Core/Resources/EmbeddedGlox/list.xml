<?xml version="1.0" encoding="utf-8"?>
<dgm:layoutDef xmlns:dgm="http://schemas.openxmlformats.org/drawingml/2006/diagram"
               xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"
               uniqueId="urn:microsoft.com/office/officeart/2005/8/layout/default"
               title="Basic List"
               desc="Standard bulleted list layout"
               clrgName="Colorful"
               clrType="colorful">
  <dgm:title val="Basic List"/>
  <dgm:desc val="Standard bulleted list layout"/>
  <dgm:catLst>
    <dgm:cat type="list" pri="1"/>
  </dgm:catLst>
  <dgm:layoutNode name="diagram">
    <dgm:alg type="linear"/>
    <dgm:shape type="roundRect"/>
    <dgm:forEach axis="ch" refNode="node">
      <dgm:layoutNode name="node">
        <dgm:alg type="tx"/>
        <dgm:shape type="roundRect"/>
        
      </dgm:layoutNode>
    </dgm:forEach>
  </dgm:layoutNode>
</dgm:layoutDef>